# Firebase Admin service-account key must never be committed (HTPR-3810)
src/service_key.json
*firebase-adminsdk*.json

# Visual regression gate output (HTPR-5652). Baselines under visual/baseline/
# ARE committed; these are per-run artifacts.
/visual/test-results/
/visual/.run/
/visual/playwright-report/

# Prod smoke QA (HTPR-6199) — holds the session cookie secret at runtime.
/e2e/smoke/.state/
/test-results/
