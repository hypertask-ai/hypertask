# OpenAI-compatible vision-model endpoint. The local proof used OpenRouter.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace-with-an-approved-model-key
MIDSCENE_MODEL_NAME=google/gemini-2.5-flash
MIDSCENE_MODEL_FAMILY=gemini

# Optional override; default is the plain QA account's state, user 2343.
# MIDSCENE_STORAGE_STATE=/home/valentin/.config/hypertask-videos/storageState-qa-normal.json

# Only configure this when your selected gateway needs the existing tunnel.
# MIDSCENE_OPENAI_SOCKS_PROXY=socks5h://127.0.0.1:1088
