# Vercel AI Gateway, OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
OPENAI_API_KEY=your-gateway-key-here

# Vision-capable model to drive Midscene. Tried in this order, first that
# responds through the gateway wins: google/gemini-2.5-flash, openai/gpt-4o,
# qwen/qwen2.5-vl-72b-instruct (set MIDSCENE_USE_QWEN_VL=1 if you pick a Qwen VL model).
MIDSCENE_MODEL_NAME=google/gemini-2.5-flash

# The Contabo VPS IP is bot-challenged by Vercel. Midscene's own AI calls must
# go through the SOCKS proxy tunnel -- use Midscene's native proxy var, NOT
# ALL_PROXY. A global ALL_PROXY also routes the Puppeteer browser's page
# navigation through the tunnel, which breaks it (ERR_EMPTY_RESPONSE) and, for
# plain Node fetch, gets flagged by Vercel's bot check even when curl over the
# same tunnel succeeds (TLS/HTTP client fingerprinting) -- Midscene's
# socks-proxy-agent path does not have that problem.
MIDSCENE_OPENAI_SOCKS_PROXY=socks5h://127.0.0.1:1088
