# Better Auth phase 0 (disabled unless BETTER_AUTH_ENABLED is exactly 1).
BETTER_AUTH_SECRET=local-placeholder-at-least-32-characters
BETTER_AUTH_URL=https://app.hypertask.ai
BETTER_AUTH_ENABLED=0
NEXT_PUBLIC_BETTER_AUTH_ENABLED=0
# Dash plugin (@better-auth/infra) API key, only read when BETTER_AUTH_ENABLED=1.
BETTER_AUTH_API_KEY=

# GitHub PR webhook (HTPR-4437)
# Gates src/app/api/webhooks/github/route.ts; the endpoint fails closed if unset.
GITHUB_WEBHOOK_SECRET=

# Resend inbound replies (HTPR-4163). Both values stay server-side.
# Register /api/webhooks/resend-inbound for the email.received event.
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=reply.hypertask.ai

# Slack integration (HTPR-4370). All values are server-only.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Required by Vercel cron requests and local/manual cron invocations.
CRON_SECRET=
# Shared AES-256-GCM key for BYOK credentials and Slack bot tokens.
BYOK_CIPHER_SECRET=

# Real-time board sync (HTPR-3626) — Pusher-protocol pub/sub.
# If these are unset the app runs normally, just without live updates.
#
# EASIEST PATH (local dev + prod): a free hosted Pusher app (pusher.com).
# No local server process, works on any Node version. Create an app, then copy
# its app_id / key / secret / cluster below. Leave PUSHER_HOST/PORT unset.
#
# Server (secret stays server-side only)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_USE_TLS=true
PUSHER_CLUSTER=mt1
#
# Client (public — no secret here). For hosted Pusher these mirror key/cluster
# and TLS; leave NEXT_PUBLIC_PUSHER_HOST/PORT unset.
NEXT_PUBLIC_PUSHER_KEY=your-key
NEXT_PUBLIC_PUSHER_USE_TLS=true
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
#
# ---------------------------------------------------------------------------
# SELF-HOST option (no vendor): Soketi, Pusher-protocol-compatible.
# Soketi's bundled uWebSockets only runs on Node 14/16/18, so run it via Docker
# (see `npm run realtime:soketi`) rather than npx on a modern Node. Then set:
#   PUSHER_HOST=127.0.0.1   PUSHER_PORT=6001   PUSHER_USE_TLS=false
#   NEXT_PUBLIC_PUSHER_HOST=127.0.0.1   NEXT_PUBLIC_PUSHER_PORT=6001   NEXT_PUBLIC_PUSHER_USE_TLS=false
# and use the demo creds in soketi.json (app-id / app-key / app-secret).
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key
#
# ---------------------------------------------------------------------------
# Voice dictation transcription. Provider is chosen per team in
# Settings -> AI features -> Voice; both keys are server-only secrets.
# Deepgram is the default backend; OpenAI is the switchable alternative.
DEEPGRAM_API_KEY=your-deepgram-secret
OPENAI_API_KEY=your-openai-secret

# Per-account Figma OAuth. Both values stay server-only.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# HTPR-4340: bearer secret for /api/admin/* maintenance endpoints (cleanup-oauth-codes)
ADMIN_SECRET=

# Production error tickets target this visible section by exact title.
ERROR_BOARD_SECTION_TITLE=Bugs

# Product analytics (EU). Leave the key unset to disable PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
