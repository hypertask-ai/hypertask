    {
      "id": "find-overdue",
      "prompt": "Find my overdue tickets on project 99.",
      "mutating": false,
      "mcp": {
        "tools": [
          {
            "name": "hypertask_list_tasks",
            "args": {
              "project_id": 99,
              "assignee": "me"
            }
          }
        ]
      },
      "cli": {
        "commands": [
          {
            "argv": [
              "task",
              "list",
              "--project",
              "99",
              "--assigned-to",
              "me",
              "--has-due-date"
            ]
          }
        ]
      },
      "expect": {
        "stdoutIncludes": [
          "EVAL-1",
          "overdue"
        ],
        "jsonContains": {
          "success": true
        },
        "exitCode": 0
      }
    },
