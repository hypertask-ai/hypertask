{
  "name": "hypertask_projects",
  "does": "List accessible boards, read their column manifests and playbooks, create or rename boards, and manage board settings and members.",
  "use_when": "Use to discover project_id or section_id before ticket changes, or to build a board from a brief using the create action.",
  "do_not_use_when": "Do not use to move individual tickets or change a column; use hypertask_tasks or hypertask_sections instead.",
  "parameters_and_caveats": "action selects an operation; input contains only that operation’s documented fields. response_format defaults to concise for reads; detailed retains full fields. limit defaults to 20 (maximum 50) and offset defaults to 0 for bounded read results; use returned pagination or narrower filters. A project is a board and a section is a column; manifest returns ordered columns and their semantic roles. Creating a board accepts nested tasks and section names, and archive changes visibility without deleting it.",
  "actions": {
    "list": {
      "tool": "hypertask_list_projects",
      "read_only": true,
      "permission": "data"
    },
    "manifest": {
      "tool": "hypertask_board_manifest",
      "read_only": true,
      "permission": "data"
    },
    "playbook": {
      "tool": "hypertask_get_board_playbook",
      "read_only": true,
      "permission": "data"
    },
    "create": {
      "tool": "hypertask_create_board",
      "read_only": false,
      "permission": "data"
    },
    "rename": {
      "tool": "hypertask_rename_board",
      "read_only": false,
      "permission": "data"
    },
    "members": {
      "tool": "hypertask_list_project_members",
      "read_only": true,
      "permission": "data"
    },
    "archive": {
      "tool": "hypertask_project_admin",
      "legacy_action": "archive",
      "read_only": false,
      "permission": "data"
    },
    "invite_member": {
      "tool": "hypertask_project_admin",
      "legacy_action": "invite_member",
      "read_only": false,
      "permission": "data"
    },
    "get_playbook": {
      "tool": "hypertask_board_config",
      "legacy_action": "get_playbook",
      "read_only": true,
      "permission": "data"
    },
    "set_playbook": {
      "tool": "hypertask_board_config",
      "legacy_action": "set_playbook",
      "read_only": false,
      "permission": "data"
    },
    "get_instructions": {
      "tool": "hypertask_board_config",
      "legacy_action": "get_instructions",
      "read_only": true,
      "permission": "data"
    },
    "set_instructions": {
      "tool": "hypertask_board_config",
      "legacy_action": "set_instructions",
      "read_only": false,
      "permission": "data"
    }
  },
  "input_examples": [
    {
      "action": "manifest",
      "input": {
        "project_id": 15
      }
    },
    {
      "action": "create",
      "input": {
        "team_id": "team-example",
        "title": "Release plan",
        "sections": [
          {
            "title": "Todo"
          },
          {
            "title": "Review"
          },
          {
            "title": "Done"
          }
        ],
        "tasks": [
          {
            "title": "Write release notes",
            "section_title": "Todo",
            "priority": 3
          }
        ]
      }
    }
  ]
}
