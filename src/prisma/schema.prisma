generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "relationJoins"]
  // HTPR-4034: always emit the Vercel-lambda (rhel) engine alongside the
  // local (native) one. Without rhel-openssl-3.0.x, a client generated on the
  // VPS (debian) ships only the debian engine, so a prebuilt deploy promoted
  // to the lambda crashes with "Query Engine for rhel-openssl-3.0.x not found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// datasource db {
//   provider = "mongodb"
//   url      = env("DATABASE_URL")
// }

// HTPR-4119: Prisma 7 no longer allows `url` in the schema's datasource block
// (P1012). The connection string now lives in prisma.config.ts (CLI commands)
// and is passed to the driver adapter at runtime (src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

