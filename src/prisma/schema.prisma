  // HTPR-6000: the minute-ly hard-delete sweep deletes TaskSharing rows by
  // taskId with no supporting index, forcing a full table scan per task deleted.
  @@index([taskId])
}

model SavedContent {
  id        String         @id @default(uuid())
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())
  task      Task           @relation(fields: [taskId], references: [id])
  taskId    Int
  comment   Comment?       @relation(fields: [commentId], references: [id])
  commentId Int?
  project   Project        @relation(fields: [projectId], references: [id])
  projectId Int
  type      ViewVisibility @default(Private)

  @@index([taskId, userId, commentId]) // For saved content lookup
  @@index([commentId, taskId, userId, type]) 
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String   @unique
  email     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@index([email]) // For quick email lookups
  @@index([expiresAt]) // For cleanup queries
  @@index([used]) // For verification queries
}

model WebhookEvent {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String   // "Lead" | "CompleteRegistration" | "StartTrial" | "Subscribe"
  success     Boolean  @default(false)
  response    Json?    // Store the response from make.com
  error       String?  // Store error message if failed
  utmData     Json?    // Store UTM data for reference
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, eventType]) // Prevent duplicates for same user + event
  @@index([userId, eventType])
  @@index([success])
}

// Outbound webhook subscription: an agent/operator registers a URL to receive
// signed HTTP callbacks when board events happen (HTPR-4434). Delivery is
// fire-and-forget and HMAC-signed with `secret`. Scoped to one board or team.
model WebhookSubscription {
  id             String    @id @default(uuid())
  // The migration enforces XOR because Prisma schema syntax cannot express CHECK constraints.
  projectId      Int?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  url            String
  secret         String
  events         String[]  // e.g. ["comment.created","task.escalated"]; empty = all
  supportsUnassignedEvent Boolean @default(false)
  active         Boolean   @default(true)
  createdById    Int?
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  agentId        String?
  agent          Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  lastDeliveryAt DateTime?
  lastDeliveryOk Boolean?
  deliveries     BoardWebhookDelivery[]

  @@index([projectId, active])
  @@index([teamId, active])
}

// Durable outbox for board-wide subscriptions (HTPR-4530). Mirrors
// AgentWebhookDelivery: the row is written in the same transaction as the domain
// change, and the row id is the stable deliveryId every retry re-sends so
// receivers can deduplicate.
model BoardWebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         String              @default("pending")
  attemptCount   Int                 @default(0)
  processingAt   DateTime?
  nextAttemptAt  DateTime            @default(now())
  lastAttemptAt  DateTime?
  statusCode       Int?
  error            String?             @db.Text
  deliveredAt      DateTime?
  payloadBody      String?             @db.Text
  payloadHash      String?             @db.VarChar(64)
  sourceDeliveryId String?
  manualRetryKey   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  attempts         BoardWebhookAttempt[]

  // A partial unique index in the migration makes manual retries idempotent.
  @@index([subscriptionId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model BoardWebhookAttempt {
  id            String               @id @default(uuid())
  deliveryId    String
  delivery      BoardWebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber Int
  statusCode    Int?
  durationMs    Int
  error         String?              @db.Text
  attemptedAt   DateTime             @default(now())

  @@unique([deliveryId, attemptNumber])
  @@index([attemptedAt])
}

// One addressed outbound endpoint per managed agent (HTPR-5388). Unlike the
// board-wide WebhookSubscription above, this only receives events whose target
// is this exact agent. projectId is an optional delivery filter; deleting a
// filtered project deletes the subscription rather than widening it globally.
model AgentWebhookSubscription {
  id             String   @id @default(uuid())
  agentId        String   @unique
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url            String
  secret         String
  events         String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastDeliveryAt DateTime?
  lastDeliveryOk Boolean?
  deliveries     AgentWebhookDelivery[]

  @@index([projectId, active])
}

// Durable outbox + operator-visible attempt history. The row id is also the
// stable deliveryId sent on every retry so receivers can deduplicate safely.
model AgentWebhookDelivery {
  id             String   @id @default(uuid())
  subscriptionId String
  subscription   AgentWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         String   @default("pending")
  attemptCount   Int      @default(0)
  processingAt   DateTime?
  nextAttemptAt  DateTime @default(now())
  lastAttemptAt  DateTime?
  statusCode     Int?
  responseBody   String?  @db.Text
  error          String?  @db.Text
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subscriptionId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model OAuthClient {
  client_id     String   @id @db.VarChar(64)
  client_name   String?
  redirect_uris Json     // Array of redirect URIs
  grant_types   Json     @default("[\"authorization_code\"]")
  token_endpoint_auth_method String @default("none")
  owner_id      Int?
  owner         User?    @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
  refreshTokens      OAuthRefreshToken[]

  @@index([client_id])
  @@index([owner_id])
}

model OAuthAuthorizationCode {
  code          String   @id @db.VarChar(64)
  client_id     String   @db.VarChar(64)
  client        OAuthClient @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  redirect_uri  String   @db.VarChar(512)
  code_challenge String  @db.VarChar(128)
  firebase_uid  String   @db.VarChar(128)
  user_id       Int
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  agent_id      String?
  agent         Agent?   @relation(fields: [agent_id], references: [id], onDelete: SetNull)
  used          Boolean  @default(false)
  expires_at    DateTime
  createdAt     DateTime @default(now())

  @@index([code])
  @@index([expires_at])
  @@index([used])
  @@index([user_id])
  @@index([client_id])
  @@index([agent_id])
}

model OAuthRefreshToken {
  id                   String    @id @default(uuid()) @db.Uuid
  familyId             String    @db.Uuid
  tokenHash            String    @unique @db.VarChar(64)
  clientId             String    @db.VarChar(64)
  client               OAuthClient @relation(fields: [clientId], references: [client_id], onDelete: Cascade)
  userId               Int
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firebaseUid          String    @db.VarChar(128)
  accessTokenJti       String    @db.VarChar(64)
  accessTokenExpiresAt DateTime
  expiresAt            DateTime
  revokedAt            DateTime?
  replacedByHash       String?   @db.VarChar(64)
  createdAt            DateTime  @default(now())

  @@index([clientId])
  @@index([familyId, revokedAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RevokedToken {
  jti         String   @id @db.VarChar(255) // JWT ID (token identifier)
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  revoked_at  DateTime @default(now())
  expires_at  DateTime // Token expiration time (for cleanup)

  @@index([user_id])
  @@index([revoked_at])
  @@index([expires_at])
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique @db.VarChar(64)
  keyPrefix  String    @db.VarChar(12)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?

  @@index([userId])
  @@index([userId, revokedAt])
}

model ChatSession {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId Int
  user User @relation(fields: [userId], references: [id])
  taskId Int? // Deliberately no FK: tasks can be hard-deleted while chat history remains.
  projectId Int? // Deliberately no FK: projects can be deleted while chat history remains.
  agentId String? // Set when this session's conversation target is a native agent.
  agent Agent? @relation(fields: [agentId], references: [id])
  title String @default("New AI Chat")
  messages ChatMessage[]
  agentRuns AgentRun[]

  @@index([userId])
  @@index([taskId])
  @@index([projectId])
  // One thread per agent: enforced in the DB (not just app-level dedup) so
  // two concurrent "open this agent's chat" requests can't create two
  // sessions. Postgres treats NULL as distinct, so plain (taskId-only or
  // blank) sessions are unaffected.
  @@unique([userId, agentId])
  // Backs the sweep's stale-session scan (src/pages/api/queues/sweep.ts).
  @@index([updatedAt])
}

model ChatMessage {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  content String
  role ChatRole
  sessionId String
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isDelivered Boolean @default(false)
  attachments   Attachment[]
  // The human message an agent reply answers; doubles as the idempotency key
  // so a retried agent POST cannot duplicate a reply.
  replyToMessageId String? @unique
  ticketProposal ChatTicketProposal?

  @@index([sessionId])
}

model ChatTicketProposal {
  id                   String                   @id @default(cuid())
  messageId            String                   @unique
  message              ChatMessage              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  snapshotVersion      Int                      @default(1)
  outcome              String                   @db.Text
  ticketTitle          String                   @db.VarChar(255)
  targetProjectId      Int
  targetProjectTitle   String                   @db.VarChar(255)
  targetSectionId      Int
  targetSectionTitle   String                   @db.VarChar(255)
  status               ChatTicketProposalStatus @default(PENDING)
  failureMessage       String?                  @db.VarChar(255)
  taskId               Int?                     @unique
  task                 Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  failedAt             DateTime?
  confirmedAt          DateTime?
  dismissedAt          DateTime?

  @@index([targetProjectId, status])
}

enum AgentVisibility {
  PRIVATE
  TEAM
}

model Agent {
  id                        String @id @default(uuid())
  displayName               String
  visibility                AgentVisibility @default(PRIVATE)
  photoURL                  String? @default("https://files.hypertask.app/tasks/attachments/1757584422625image.png")
  createdAt                 DateTime @default(now())
  revokedAt                 DateTime?
  // Archived is about the register, not about power: revokedAt switches an
  // agent off, archivedAt files it away. An archived agent keeps its history,
  // its comments and its board memberships, so this stays separate from delete.
  archivedAt                DateTime?
  // The plaintext credential is never stored. `mcpTokenHash` is the sha256 of
  // the issued bearer token, so a database leak hands out a digest instead of a
  // live key; `mcpTokenJti` is that token's jti, the revocation generation an
  // OAuth access token carries in place of the bearer token itself.
  mcpTokenHash              String?   @db.VarChar(64)
  mcpTokenJti               String?
  mcpTokenExpiresAt         DateTime?
  // Monotonic credential/runtime generation. Heartbeats from a destroyed or
  // rotated token can never replace state from a newer generation.
  runtimeGeneration         Int       @default(1)

  runtimeType               AgentRuntimeType @default(EXTERNAL)
  prompt                    String?   @db.Text
  heartbeatAt               DateTime?
  // A TAiModelOptionId this agent runs on, so a sweeper can use a cheap model
  // and a coordinator an expensive one. Null means the team default. Kept as a
  // plain string, like every other stored model choice, because the option list
  // changes with the model lineup and a DB enum would need a migration per model.
  modelOptionId             String?

  userId                    Int
  user                      User @relation(fields: [userId], references: [id])

  tasks                     Task[]
  comments                  Comment[]
  pages                     Page[]
  reports                   Report[]
  taskEvidence              TaskEvidence[]
  taskSessions              TaskSession[]
  decisionRequests          DecisionRequest[]
  assignees                 Assignees[]    @relation("agentAssignees")
  assigners                 Assignees[]    @relation("agentAssigners")
  notificationsToAgent      Notification[] @relation("toAgent")
  notificationsFromAgent    Notification[] @relation("fromAgent")
  descriptions              Description[]
  priority                  Priority[]
  estimate                  Estimate[] @relation("addedByAgent")
  oauthAuthorizationCodes   OAuthAuthorizationCode[]
  permissions               Json? @default("{}")
  followers                 Follower[]
  members                   Member[]
  webhookSubscriptions      WebhookSubscription[]
  agentWebhookSubscription  AgentWebhookSubscription?
  chatSessions              ChatSession[]
  runs                      AgentRun[]
  byokApiKeys               AgentByokApiKey[]

  @@index([userId])
  @@index([userId, revokedAt])
}

model AgentRun {
  id             String          @id @default(uuid())
  agentId        String
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskId         Int?
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chatSessionId  String?
  chatSession    ChatSession?    @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  chatPromptMessageId String?
  trigger        AgentRunTrigger
  status         AgentRunStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  lastActivityAt DateTime        @default(now())
  stoppedById    Int?
  stoppedBy      User?           @relation("AgentRunStoppedBy", fields: [stoppedById], references: [id], onDelete: SetNull)
  activities     AgentRunActivity[]

  @@index([agentId, status])
  @@index([taskId, status])
  @@index([chatSessionId, status])
  @@index([lastActivityAt, status])
  @@index([stoppedById])
}

model AgentRunActivity {
  id             String               @id @default(uuid())
  runId          String
  run            AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  type           AgentRunActivityType
  text           String               @db.Text
  link           String?              @db.VarChar(2048)
  options        Json?
  idempotencyKey String?              @db.VarChar(256)
  selectedValue  String?              @db.VarChar(256)
  selectedLabel  String?              @db.VarChar(256)
  selectedAt        DateTime?
  selectedById      Int?
  selectedBy        User?                @relation("AgentRunActivitySelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)
  responseCommentId              Int?      @unique
  responseComment                Comment?  @relation("AgentRunActivityResponseComment", fields: [responseCommentId], references: [id], onDelete: SetNull)
  selectionCommentId             Int?      @unique
  selectionComment               Comment?  @relation("AgentRunActivitySelectionComment", fields: [selectionCommentId], references: [id], onDelete: SetNull)
  commentAgentWebhookDeliveryIds String[]  @default([])
  commentBoardWebhookDeliveryIds String[]  @default([])
  commentNotificationsProcessingAt DateTime?
  commentNotificationDeliveryKeys     String[]  @default([])
  commentMentionsAttemptedAt          DateTime?
  commentFcmAttemptedAt               DateTime?
  commentEmailsAttemptedAt            DateTime?
  commentNotificationsCompletedAt     DateTime?
  createdAt                      DateTime   @default(now())

  @@unique([runId, idempotencyKey])
  @@index([runId, createdAt, id])
  @@index([selectedById])
}

/// Agent-scoped BYOK secrets (ciphertext), same shape as TeamByokApiKey.
/// An agent with its own key spends on that provider account instead of the
/// team pot, so its cost is a real invoice rather than an estimate (HTPR-5389).
model AgentByokApiKey {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider   String
  ciphertext String?  @db.Text
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agentId, provider])
  @@index([agentId])
}

model AiUsage {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  userId       Int
  teamId       String?
  projectId    Int?
  // Historical attribution only: intentionally no foreign keys, so metering
  // survives a task hard-delete or an agent being revoked/deleted.
  taskId       Int?
  agentId      String?
  provider     String
  model        String
  feature      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)

  @@index([teamId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
}

// Typed proof-of-work attached to a ticket (HTPR-4443): a test run, screenshot,
// deploy link, or diff — so evidence isn't buried in comment threads.
model TaskEvidence {
  id        Int          @id @default(autoincrement())
  createdAt DateTime     @default(now())
  taskId    Int
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      EvidenceType @default(Other)
  title     String?
  url       String?
  summary   String?
  // Who attached it: a human user and/or the MCP session agent. FK-backed like
  // Comment, so ids can't go stale and a creator/agent include is available.
  creatorId Int?
  creator   User?        @relation(fields: [creatorId], references: [id])
  agentId   String?
  agent     Agent?       @relation(fields: [agentId], references: [id])

  @@index([taskId])
}

// A structured agent work-session on a ticket (HTPR-4436): the resume command to
// pick up where it left off, its liveness, and who started it. Keyed by the
// session UUID so repeated heartbeats upsert one row instead of piling up.
model TaskSession {
  id            Int           @id @default(autoincrement())
  sessionId     String        @unique
  taskId        Int
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resumeCommand String?
  status        SessionStatus @default(Active)
  agentId       String?
  agent         Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  startedById   Int?
  startedBy     User?         @relation(fields: [startedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  lastSeenAt    DateTime      @default(now())

  @@index([taskId])
}
