  processingStartedAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
}

model Reaction {
  id      String   @id @default(uuid())
  unified String
  size    Int?
  emoji   String
  names   String[]

  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  descriptionId String?
  description   Description? @relation(fields: [descriptionId], references: [id])

  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id])

  taskId Int
  task   Task @relation(fields: [taskId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  Notification Notification[]

  @@index([commentId, isDeleted, emoji, unified])
  // HTPR-6000: the minute-ly hard-delete sweep deletes Reaction rows by taskId
  // with no supporting index, forcing a full table scan per task deleted.
  @@index([taskId])
}

