model User {
  id                 Int            @id @default(autoincrement())
  uid                String         @unique
  displayName        String?
  photoURL           String?        @default("https://files.hypertask.app/tasks/attachments/1757584422625image.png")
  email              String
  joinedAt           DateTime       @default(now())
  // HTPR-4146: Better Auth phase 0 columns, unused until BETTER_AUTH_ENABLED=1.
  emailVerified      Boolean        @default(false)
  updatedAt          DateTime       @default(now()) @updatedAt
  mcpTokensRevokedAt DateTime?     // Timestamp when all MCP tokens were revoked for this user
  tasks              Task[]
  comments           Comment[]
  assignees          Assignees[]    @relation("assignees")
  assigners          Assignees[]    @relation("assigners")
  projects           Project[]
  notifications      Notification[] @relation("toUser")
  fromNotificaitons  Notification[] @relation("fromUser")
  members            Member[]
  members_teams      Member_Team[]
  stripe_customer_id String?

  UserSettingId String?
  UserSetting   UserSetting?
  userPicture   UserPicture?

  invites                   Invite[]
  unreadMessages            ReadStatus[]
  taskReadStates            TaskReadState[]
  followers                 Follower[]                  @relation("FollowersUser")
  // account   GoogleAccount 
  accountId                 String?
  devices                   SubscribedDevices[]
  descriptions              Description[]
  logs                      Logs[]
  Priority                  Priority[]
  Reaction                  Reaction[]
  Reminders                 Reminder[]
  Estimate                  Estimate[]
  drafts                    Drafts[]
  // notification_invitesFromSelf Notification_Invite[] @relation("userTo")
  user_notification_invites User_Notification_Invites[]
  user_activity             User_Activity?
  userAnnouncements         UserAnnouncement[]
  project_views             View[]
  calendar_views            Calendar_View[]
  ViewLastUsed              View_Last_Used[]
  tasksSharing              TaskSharing[]
  savedContent              SavedContent[]
  webhookEvents             WebhookEvent[]
  oauthAuthorizationCodes  OAuthAuthorizationCode[]
  oauthClients             OAuthClient[]
  oauthRefreshTokens       OAuthRefreshToken[]
  revokedTokens             RevokedToken[]
  apiKeys                   ApiKey[]
  chatSessions              ChatSession[]
  agents                    Agent[]
  timeEntries               TimeEntry[]
  taskMutes                 TaskMute[]
  projectMutes              ProjectMute[]
  pagesCreated              Page[]                      @relation("PageCreatedBy")
  docVersions              DocVersion[]                @relation("DocVersionAuthor")
  taskLeases               TaskLease[]
  taskEvidence             TaskEvidence[]
  taskSessions             TaskSession[]
  taskSectionEvents        TaskSectionEvent[]
  decisionRequestsCreated  DecisionRequest[]             @relation("DecisionRequestCreatedBy")
  decisionRequestsAnswered DecisionRequest[]             @relation("DecisionRequestAnsweredBy")
  webhookSubscriptions     WebhookSubscription[]
  stoppedAgentRuns         AgentRun[]                    @relation("AgentRunStoppedBy")
  selectedAgentRunActivities AgentRunActivity[]           @relation("AgentRunActivitySelectedBy")
  aiSkills                  AI_Skill[]                  @relation("AI_SkillOwner")
  createdAiSkills           AI_Skill[]                  @relation("AI_SkillCreator")
  slackInstalls             SlackInstall[]
  slackUserLinks            SlackUserLink[]
  reportsCreated            Report[]                    @relation("ReportCreator")
  projectMilestonesCreated  ProjectMilestone[]          @relation("ProjectMilestoneCreator")
  projectStatusUpdates      ProjectStatusUpdate[]       @relation("ProjectStatusUpdateAuthor")
  // HTPR-4146: Better Auth phase 0 relations, unused until BETTER_AUTH_ENABLED=1.
  betterAuthSessions        BetterAuthSession[]
  betterAuthAccounts        BetterAuthAccount[]
  passkeys                  Passkey[]
  betterAuthApiKeys         BetterAuthApiKey[]
}

// HTPR-4146: Better Auth phase 0 tables, inert until BETTER_AUTH_ENABLED=1.
model BetterAuthSession {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BetterAuthAccount {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model BetterAuthVerification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Passkey {
  id           Int       @id @default(autoincrement())
  name         String?
  publicKey    String
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

// HTPR-4340: account-scoped management API keys (htmk_), managed by the
// better-auth apiKey plugin. Key material is stored hashed in `key`.
model BetterAuthApiKey {
  id                  Int       @id @default(autoincrement())
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              Int
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([key])
  @@index([userId])
}

//Using this model for User Profile. Creating another model for name would be weird given both
//have the same purpose. Live with the name.
model UserPicture {
  id           String  @id @default(uuid())
  userId       Int     @unique
  user         User    @relation(fields: [userId], references: [id])
  photoSet     Boolean @default(false)
  basePhotoURL String?
  nameSet      Boolean @default(false)
  displayName  String?
}

model User_Activity {
  id              Int @id @default(autoincrement())
  totalTeamsOwned Int

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  lastActiveAt   DateTime?
  activityStatus String    @default("inactive")
  metadata       Json?
  events         Events[]

  // activityId Int
  // activity   Activity @relation(fields: [activityId], references: [id])
}

model User_Notification_Invites {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  notificationInviteBy Notification_Invite[] @relation("userBy")
  notificationInviteTo Notification_Invite[] @relation("userTo")
}

model SubscribedDevices {
  id                String  @id @default(uuid())
  firebaseId        String
  sendNotifications Boolean @default(true)
  userId            Int
  user              User    @relation(fields: [userId], references: [id])

  @@unique([firebaseId])
}

model FeatureFlag {
  key       String          @id
  mode      FeatureFlagMode @default(OWNER_AND_QA)
  updatedAt DateTime        @updatedAt
}

model UserSetting {
  id                       String        @id @default(uuid())
  userId                   Int           @unique
  user                     User          @relation(fields: [userId], references: [id])
  notification             Boolean
  notificationPreference   MentionPreference        @default(all)
  commentsStacked          Boolean       @default(true)
  shareReadReceipts        Boolean       @default(false)
  scrollSetting            ScrollSetting @default(Bottom)
  displayAvatar            DisplayAvatar @default(Hidden)      
  favorites                Favorites[]
  onboardingTourStatus     Boolean       @default(false)
  onboardingTutorialStatus Boolean       @default(false)
  trialStatus              Boolean       @default(false)
  isVerified               Boolean       @default(true)
  productTours             Json          @default("{}")
  aiModelPreferences       Json?
  snippets                 Json          @default("[]")
  muteAnnouncements        Boolean       @default(false)
  // All Tasks date-range selector (HTPR-5678). Null = never chosen; the view
  // then opens on the Last 7 days default. Chosen value syncs across devices.
  allTasksDateRange        String?
  playGifs                 Boolean       @default(true)
  autoDescriptionSuggestions Boolean      @default(true)
  notificationMatrix       Json          @default("{}")
  // Per-user voice-dictation language (Deepgram Nova-3 code, or "multi" for
  // auto code-switching). Defaults to English. See @/lib/dictationProvider.
  dictationLanguage        String        @default("en")
  // Inbox behaviour: sending a comment on a task that carries an inbox
  // notification archives that notification and moves on to the next task.
  inboxAdvanceOnSend       Boolean       @default(true)
  // Mirror of emoji-mart's frequently-used {emojiId: count} map, so the picker's Frequently row persists across devices.
  emojiFrequency           Json?
  calendarViews            Json?
}

model Favorites {
  id            String      @id @default(uuid())
  userSettingId String
  userSetting   UserSetting @relation(fields: [userSettingId], references: [id])
  projectId     Int
  project       Project     @relation(fields: [projectId], references: [id])
  index         Int
  // {'0':{projectId:2}}
}

// organzation account basically

model GoogleAccount {
  id                 String             @id @default(uuid())
  userId             Int
  stripe_customer_id String
  // user User      @relation(fields: [userId], references: [id])
  subscriptionPlans  SubscriptionPlan[]
  teams              Team[]
  members            Member_Team[]
  projects           Project[]
}

// a team can have one active subscription plan id.
// but there can be x number of subscription plans, only ONE active, rest all expired. 
model Team {
  id                           String             @id @default(uuid())
  title                        String?
  description                  String?
  projects                     Project[]
  members                      Member_Team[]
  totalSeats                   Int
  activeSubscriptionPlanItemId String?
  activeSubscriptionPlanId     String?
  compedUntil                  DateTime?
  subscriptionPlan             SubscriptionPlan[]
  stripe_customer_id           String?
  createdAt                    DateTime           @default(now())
  invites                      Invite[]
  survey                       Json?
  googleAccountId              String
  googleAccount                GoogleAccount      @relation(fields: [googleAccountId], references: [id])
  team_activity                Team_Activity?
  byokApiKeys                  TeamByokApiKey[]
  slackInstall                 SlackInstall?
  aiProviderSettings           Json?
  webhookSubscriptions         WebhookSubscription[]
  // HTPR-2572: signups on these email domains auto-join this team, billed a seat like an invite.
  allowedEmailDomains          String[]           @default([])
}

/// Team-scoped BYOK secrets (ciphertext). provider matches byokAiProviders.source in app code.
/// Future: add nullable personalUserId + new unique constraint for per-user keys (migration).
model TeamByokApiKey {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  provider     String
  ciphertext   String?  @db.Text
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teamId, provider])
  @@index([teamId])
}

model SlackInstall {
  id                String               @id @default(uuid())
  slackTeamId       String               @unique
  slackTeamName     String
  encryptedBotToken String               @db.Text
  botUserId         String
  teamId            String               @unique
  team              Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  defaultProjectId  Int?
  defaultProject    Project?             @relation("SlackDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)
  installedByUserId Int
  installedBy       User                 @relation(fields: [installedByUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  watchedThreads    SlackWatchedThread[]
  userLinks         SlackUserLink[]

  @@index([installedByUserId])
  @@index([defaultProjectId])
}

model SlackUserLink {
  id          String       @id @default(uuid())
  installId   String
  install     SlackInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  slackUserId String
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([installId, slackUserId])
  @@unique([installId, userId])
  @@index([userId])
}

model SlackEventReceipt {
  eventId   String   @id
  createdAt DateTime @default(now())
}

model SlackWatchedThread {
  id               String       @id @default(uuid())
  installId        String
  install          SlackInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  channelId        String
  threadTs         String
  matchedTaskIds   Int[]        @default([])
  lastMessageTs    String
  lastSummarizedTs String?
  createdAt        DateTime     @default(now())

  @@unique([installId, channelId, threadTs])
  @@index([lastMessageTs])
}

model Team_Activity {
  id     String   @id @default(uuid())
  teamId String   @unique
  team   Team     @relation(fields: [teamId], references: [id])
  events Events[]

  total_tasks       Int       @default(0)
  lastActiviyAt     DateTime?
  activityStatus    String    @default("inactive")
  hasCompletedTrial Boolean   @default(false)

  metadata Json?

  // activityId Int
  // activity   Activity @relation(fields: [activityId], references: [id])
}

model Events {
  id        String    @id @default(uuid())
  eventType EventType
  createdAt DateTime  @default(now())

  team_activity_id String?
  team_activity    Team_Activity? @relation(fields: [team_activity_id], references: [id])

  user_activity_id Int?
  user_activity    User_Activity? @relation(fields: [user_activity_id], references: [id])

  metadata         Json? // this contains metadata about the event, such as type, content, origin etc, define them locally in code.
  keyboardShortcut String?
}

model Project {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  title                  String?
  description            String?
  ownerId                Int
  owner                  User                     @relation(fields: [ownerId], references: [id])
  tasks                  Task[]
  pages                  Page[]
  createdAt              DateTime                 @default(now())
  members                Member[]
  sections               String[]                 @default(["Todo", "Doing", "Done"])
  section                Section[]
  invites                Invite[]
  notifications          Notification[]
  status                 Status                   @default(Normal)
  googleAccountId        String?
  googleAccount          GoogleAccount?           @relation(fields: [googleAccountId], references: [id])
  favorites              Favorites[]
  teamId                 String?
  priorities             Priority[]
  team                   Team?                    @relation(fields: [teamId], references: [id])
  sorting_mode           SortingMode              @default(Priority)
  estimates              Estimate[]
  labels                 Label[]
  Reminders              Reminder[]
  uniqueIdentifier       String?
  project_view           Project_View?
  ai_custom_instructions AI_Custom_Instructions[]
  tasksSharing           TaskSharing[]
  savedContent           SavedContent[]
  timeTrackingEnabled    Boolean                  @default(false)
  showTimeTotals         Boolean                  @default(false)
  stalenessEnabled       Boolean                  @default(false)
  staleWarnDays          Int?
  staleHotDays           Int?
  staleNudgeEnabled      Boolean                  @default(false)
  // null = auto-archive off; N = archive tasks untouched (no edit, no comment) for N days.
  autoArchiveAfterDays   Int?
  cyclesEnabled          Boolean                  @default(false)
  cycles                 Cycle[]
  aiSkills               AI_Skill[]
  reports                Report[]
  // Per-board playbook agents fetch: working rules + a definition-of-done
  // checklist they must satisfy before marking work done (HTPR-4442). null = unset.
  playbook               Json?
  webhookSubscriptions   WebhookSubscription[]
  agentWebhookSubscriptions AgentWebhookSubscription[]
  slackDefaultInstalls   SlackInstall[]           @relation("SlackDefaultProject")
  taskTemplates          TaskTemplate[]
  customFields           CustomField[]
  projectMutes           ProjectMute[]
  targetDate             DateTime?
  milestones             ProjectMilestone[]
  statusUpdates          ProjectStatusUpdate[]

  // @@index([status, teamId]) // For WHERE status="Normal" AND teamId IS NOT NULL
  // @@index([ownerId, status]) // For owner-based queries
  
}

enum ProjectHealth {
  OnTrack
  AtRisk
  OffTrack
}

model Cycle {
  id           Int       @id @default(autoincrement())
  projectId    Int
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       Int
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  rolledOverAt DateTime?
  createdAt    DateTime  @default(now())
  tasks        Task[]

  @@unique([projectId, id])
  @@unique([projectId, number])
  @@unique([projectId, startDate])
  @@index([projectId, endDate, rolledOverAt])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  targetDate  DateTime
  completedAt DateTime?
  createdById Int
  createdBy   User      @relation("ProjectMilestoneCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([projectId, targetDate])
}

model ProjectStatusUpdate {
  id        String        @id @default(cuid())
  projectId Int
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  health    ProjectHealth
  message   String
  authorId  Int
  author    User          @relation("ProjectStatusUpdateAuthor", fields: [authorId], references: [id])
  createdAt DateTime      @default(now())

  @@index([projectId, createdAt])
}

model AI_Custom_Instructions {
  id                Int            @id @default(autoincrement())
  visibility        ViewVisibility @default(Public)
  projectId         Int
  project           Project        @relation(fields: [projectId], references: [id])
  customInstruction String
  source_selected   String?
  model_selected    String?
  lastUpdatedAt     DateTime       @default(now())
  attachments       Attachment[] // usually for RAG
}

model AI_Skill {
  id           Int      @id @default(autoincrement())
  projectId    Int?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?    @relation("AI_SkillOwner", fields: [userId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  description  String?
  argumentHint String?
  body         String   @db.Text
  sourceUrl    String?
  enabled      Boolean  @default(true)
  createdById  Int?
  createdBy    User?    @relation("AI_SkillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, slug])
  @@unique([userId, slug])
}

model Report {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  bodyHtml    String   @db.Text
  bodyText    String   @db.Text @default("")
  createdById Int?
  createdBy   User?    @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, updatedAt])
}

model View_Last_Used {
  id                   String         @id @default(uuid())
  createdAt            DateTime       @default(now())
  lastUsedAt            DateTime?
  board_empty_sections EmptySections?
  userId                Int
  user       User      @relation(fields: [userId], references: [id])
  viewId     String
  view       View      @relation(fields: [viewId], references: [id])

  @@unique([userId, viewId], name: "user_view_last_used")
}

model View {
  id                      String        @id @default(uuid())
  userId                  Int
  owner                   User          @relation(fields: [userId], references: [id])
  createdAt               DateTime      @default(now())
  applied_in_project_view Project_View?

  user_project_views        User_Project_View[]
  unsaved_User_Project_View User_Project_View[] @relation(name: "unsaved_view")

  visibility      ViewVisibility @default(Public)
  title           String?
  project_view_id String
  project_view    Project_View   @relation(name: "ProjectViewViews", fields: [project_view_id], references: [id])
  slug            String?

  lastUsedAt            DateTime?
  board_sorting_mode    SortingMode      @default(Manual)
  board_sorting_order   SortingOrder     @default(Descending)
  board_subtask_setting SubtaskSetting   @default(Flattened_Card)
  board_empty_sections  EmptySections    @default(Show)
