model Notification_Invite {
  id             Int            @id @default(autoincrement())
  inviteURL      String
  notificationId Int            @unique
  notification   Notification[]
  inviteId       String
  invite         Invite         @relation(fields: [inviteId], references: [id])
  createdAt      DateTime       @default(now())

  userIdTo Int
  userTo   User_Notification_Invites @relation(fields: [userIdTo], references: [id], name: "userTo")

  userIdBy Int
  userBy   User_Notification_Invites @relation(fields: [userIdBy], references: [id], name: "userBy")
}

model Notification {
  id     Int              @id @default(autoincrement())
  type   NotificationType @default(Comment)
  userId Int
  user   User             @relation(fields: [userId], references: [id], name: "toUser")
  //If provided notification is created for the agent
  agentId             String?
  agent               Agent?          @relation(fields: [agentId], references: [id], name: "toAgent")

  archivedAt            DateTime?
  returnedFromReminders Boolean?
  // Retained for rollback compatibility and raw-SQL bridging.
  // @ignore excludes it from Prisma Client.
  tutorialKey           String?   @unique @ignore
  // A response to a person's explicit agent invocation. Unlike routine agent
  // output, this is addressed to that requester and belongs in Important.
  directReply           Boolean          @default(false)
  // Agent-targeted Mentioned notifications double as durable invocations.
  agentReplyConsumedAt  DateTime?
  agentReplyCommentId   Int?

  createdAt  DateTime @default(now())
  seen       Boolean  @default(false)
  status     Status   @default(Normal)
  fromUserId Int?
  fromUser   User?    @relation(fields: [fromUserId], references: [id], name: "fromUser")
  //If provided notification is created by the agent
  fromAgentId             String?
  fromAgent               Agent?          @relation(fields: [fromAgentId], references: [id], name: "fromAgent")

  ReadStatus ReadStatus[]

  reactionId String?
  reaction   Reaction? @relation(fields: [reactionId], references: [id])

  projectId Int?     @default(1)
  project   Project? @relation(fields: [projectId], references: [id])

  memberId Int?
  member   Member? @relation(fields: [memberId], references: [id])

  assignId Int?
  assignee Assignees? @relation(fields: [assignId], references: [id])

  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id])

  member_team_Id String?
  member_team    Member_Team? @relation(fields: [member_team_Id], references: [id])

  taskId Int?  @default(1)
  task   Task? @relation(fields: [taskId], references: [id])

  notification_inviteId Int?
  notification_invite   Notification_Invite? @relation(fields: [notification_inviteId], references: [id])

  // Free-text body for AgentMessage notifications. Every other type derives
  // its display text from a related entity (comment/task/reaction); a
  // proactive agent message has none of those, so it needs its own text.
  message String? @db.Text

  @@index([taskId, userId, status, createdAt])
  @@index([userId, status, agentId, createdAt])
  @@index([userId, status, archivedAt])
  @@index([agentId, taskId, type, agentReplyConsumedAt])
}

model Reminder {
  id              Int                @id @default(autoincrement())
  createdAt       DateTime           @default(now())
  status          Status             @default(Normal)
  invokeCondition ReminderConditions @default(DurationComplete)
  updatedAt       DateTime?

  remindAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  taskId Int
  task   Task @relation(fields: [taskId], references: [id])

  @@index([taskId, status])
  // Backs the sweep's due-reminder claim (src/pages/api/queues/sweep.ts).
  @@index([status, remindAt])
}

model Logs {
  id   Int     @id @default(autoincrement())
  log  String
  type LogType

  createdAt  DateTime @default(now())
  LoggedById Int?
  LoggedBy   User?    @relation(fields: [LoggedById], references: [id])
  status     Status
}

model Announcments {
