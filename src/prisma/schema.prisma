  ranking   String             @default("A0200") // column/field order — same scheme as Section.ranking
  showInRail  Boolean?         @default(true) // null/true = visible; only explicit false hides (manage-fields modal)
  showInTable Boolean?         @default(true)
  createdAt DateTime           @default(now())
  values    CustomFieldValue[]

  @@unique([projectId, name]) // no two fields with the same name on a board
  @@index([projectId])
