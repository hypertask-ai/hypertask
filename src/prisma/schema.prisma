// One row per (field, task). value is canonical display; numericValue is the sort/filter key for Number/Date.
model CustomFieldValue {
  id           String      @id @default(uuid())
  fieldId      String
  field        CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  taskId       Int
  task         Task        @relation(fields: [taskId], references: [id])
  value        String // Text/Select(label)/Checkbox("true"|"false")/Number(as text)/Date(ISO-8601)
  numericValue Float? // Number = the number; Date = epoch ms; else null. Native orderBy avoids lexical string sort.
  updatedAt    DateTime    @updatedAt

  @@unique([fieldId, taskId])
  @@index([taskId])
  @@index([fieldId, numericValue]) // sort/filter a board by one field (e.g. ICE desc)
}

