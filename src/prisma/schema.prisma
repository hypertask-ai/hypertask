model Task {
  id                  Int             @id @default(autoincrement())
  uniqueIndex         Int
  ticketNumber        String?
  ranking             String          @default("")
  section             String
  title               String
  description         String
  projectId           Int
  project             Project         @relation(fields: [projectId], references: [id])
  cycleId             Int?
  cycle               Cycle?          @relation(fields: [projectId, cycleId], references: [projectId, id])
  status              Status          @default(Normal)
  userId              Int
  user                User            @relation(fields: [userId], references: [id])
  comments            Comment[]
  assignees           Assignees[]
  followers           Follower[]
  createdAt           DateTime        @default(now())
  sectionChangedAt    DateTime        @default(now())
  lastCommentAt       DateTime?
  staleNudgedAt       DateTime?
  waitingOnUserId     Int?
  waitingOnSetById    Int?
  waitingOnSetAt      DateTime?
  dueDate             DateTime?
  // Optional planned start (HTPR-4884). Display + My Tasks grouping only —
  // no sweep or notification fires off it.
  startDate           DateTime?
  // Repeat cadence (HTPR-4885); null = not recurring. Moving the task to a
  // done column or archiving it spawns the next occurrence and moves the rule.
  recurrence          RecurrenceRule?
  riskLevel           RiskLevel?
  acceptanceCriteria  String?
  verifyCommand       String?
  // Set once the overdue notification has fired for the current dueDate value.
  // Reset to null whenever dueDate changes (see setDueDate.ts / createGlobally.ts).
  // Guards invokeDueDate + the sweep (src/pages/api/queues/sweep.ts) against double-firing.
  dueDateNotifiedAt   DateTime?
  deletedAt           DateTime?
  archivedAt          DateTime?
  updatedAt           DateTime?
  permanentlyDeleteAt DateTime?
  // Set by the hard-delete sweep while a row is being processed. A stale value is
  // retryable, which prevents overlapping sweeps from processing the same task.
  hardDeleteProcessingAt DateTime?
  totalComments       Int             @default(0)
  sectionId           Int?
  descriptionJson     Json?           @default("{\"content\": [], \"type\": \"\"}")
  ReadStatus          ReadStatus[]
  taskReadStates      TaskReadState[]
  notifications       Notification[]
  attachments         Attachment[]
  descriptionId       String?
  description_        Description?
  priority            Priority?
  reactions           Reaction[]
  // Comment_Reactions Comment_Reactions[]
  estimate            Estimate?
  taskLabels          TaskLabel[]
  Reminders           Reminder[]
  drafts              Drafts[]
  decisionRequests    DecisionRequest[]
  Task_Summary        Task_Summary[]
  parentTaskId        Int?
  parentTask          Task?           @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks            Task[]          @relation("SubTasks")
  tasksSharing        TaskSharing[]
  savedContent        SavedContent[]
  relatedToTasks      TaskRelations[] @relation("RelatedToTasks")
  relatedFromTasks    TaskRelations[] @relation("RelatedFromTasks")
  evidence            TaskEvidence[]
  taskSessions        TaskSession[]
  sectionEvents       TaskSectionEvent[]
  pullRequests        TaskPullRequest[]
  customFieldValues   CustomFieldValue[]
  updatedByUserIds    Int[]
  //If provided, task is created by an agent
  agentId             String?
  agent               Agent?          @relation(fields: [agentId], references: [id])
  // Written with the task row, then cleared by the task.created outbox handoff.
  // The sweep retries rows left pending if post-create work never runs.
  agentTaskCreatedPendingAt DateTime?
  // Set only after post-create column auto-assignment has completed. Recovery
  // must not emit task.created from the pending marker before this point.
  agentTaskCreatedReadyAt DateTime?
  agentTaskCreatedEmittedAt DateTime?
  timeEntries         TimeEntry[]
  taskMutes           TaskMute[]
  pages               Page[]
  taskLease           TaskLease?
  agentRuns           AgentRun[]
  chatTicketProposal  ChatTicketProposal?

  // @@index([projectId, deletedAt, updatedAt]) // Composite index for your exact query
  // @@index([updatedAt]) // For ordering
  // @@index([deletedAt]) // For filtering deleted tasks
  // @@index([status]) // If you filter by status frequently
  @@index([projectId, status])
  @@index([projectId, cycleId, status])
  @@index([projectId, status, archivedAt])
  @@index([parentTaskId, status])
  // Back the minute-ly sweep (src/pages/api/queues/sweep.ts) so its due-date and
  // permanent-delete scans don't full-scan the table every tick.
  @@index([status, permanentlyDeleteAt])
  @@index([status, permanentlyDeleteAt, hardDeleteProcessingAt])
  @@index([dueDate, dueDateNotifiedAt])
  @@index([waitingOnUserId])
  @@index([agentTaskCreatedPendingAt, agentTaskCreatedReadyAt, agentTaskCreatedEmittedAt])
  // Backs the ticketNumber lookup in linkifyTicketRefs.ts (AI responses linkify
  // ticket refs on most turns); applied to prod Neon via CREATE INDEX CONCURRENTLY.
  @@index([ticketNumber])
  @@unique([projectId, uniqueIndex])
}

