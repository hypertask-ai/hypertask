{
  "$comment": "Pointer manifest, not a second source of truth. Per-theme colour values live in the theme CSS files and are not copied here, because a copy rots. `node scripts/design-lint.mjs --verify-tokens` checks the typography scale below against tailwind.config.ts.",
  "canonicalGuide": "openwiki/style-guide.md",
  "gateGuide": "docs/design/STYLE-GUIDE.md",
  "sources": {
    "utilities": "tailwind.config.ts",
    "themes": [
      "src/styles/tailwindThemes/amoled.css",
      "src/styles/tailwindThemes/graphite.css",
      "src/styles/tailwindThemes/porcelain.css",
      "src/styles/tailwindThemes/dia.css"
    ],
    "legacyThemes": [
      "src/styles/tailwindThemes/dark.css",
      "src/styles/tailwindThemes/light.css"
    ],
    "globals": "src/styles/globals.scss"
  },
  "typography": {
    "source": "tailwind.config.ts fontSize",
    "scale": {
      "micro": "11px",
      "meta": "12px",
      "dense": "13px",
      "content": "14px",
      "emphasis": "16px",
      "subheading": "18px",
      "heading": "24px",
      "display": "32px"
    },
    "legacyAlias": {
      "modalSmall": "16px"
    },
    "families": {
      "amoled": "IBM Plex Sans (--font-plex)",
      "graphite": "IBM Plex Sans (--font-plex)",
      "porcelain": "IBM Plex Sans (--font-plex)",
      "dia": "italic Newsreader (--font-newsreader) for board, column, modal and h1-h3",
      "fallback": "Inter (font-sans)"
    }
  },
  "radius": {
    "2px": "keyboard badges and very small inset marks",
    "4px": "compact controls, menu rows, chips",
    "5px": "cards, panels, modals, sheets",
    "8px": "mobile comment input well only",
    "full": "avatars, status dots, established circular icon actions",
    "scopedException": {
      "dia": "10px kanban cards and posted comments, 12px modals, scoped under .dia only"
    }
  },
  "spacing": {
    "base": "4px",
    "steps": [4, 8, 12, 16, 20, 24, 32],
    "halfSteps": [2, 6],
    "mobileTouchTarget": "44px via MOBILE_TARGET"
  },
  "brand": {
    "$comment": "Static accents, not themed. Accents only, never a substitute for a themed surface or text token.",
    "hypertasks-purple": "#4455BB",
    "hypertasks-green": "#C2CFA5",
    "hypertasks-ai-purple": "#C668FF",
    "hypertasks-header-blue": "rgb(35, 131, 226)"
  },
  "semanticColour": {
    "$comment": "Utility and CSS variable per role. Per-theme values are in the theme files listed under sources.themes.",
    "page": { "utility": "bg-pageBackground", "var": "--bg-pageBackground" },
    "card": { "utility": "bg-cardBackground", "var": "--bg-cardBackground" },
    "modalOrMenu": { "utility": "bg-modalBackground", "var": "--bg-modalBackground" },
    "commentSurface": { "utility": "bg-comment-description", "var": "--bg-comment-description" },
    "mobileCommentWell": { "utility": "bg-newcomment-well", "var": "--bg-newcomment-well" },
    "primaryText": { "utility": "text-white-black", "var": "--color-white-black" },
    "mutedText": { "utility": "text-text-light-gray", "var": "--color-text-light-gray" },
    "quietBorder": { "utility": "border-border-light-gray-thin", "var": "--border-light-gray-thin" },
    "primaryAction": { "utility": "bg-shadcn-primary", "var": "--shadcn-primary" },
    "hover": { "utility": "bg-hover-active", "var": "--bg-hover-active" }
  },
  "icons": {
    "family": "lucide-react",
    "sizes": {
      "14": "dense secondary actions and board-header neighbours",
      "16": "default menu, field and toolbar icons",
      "18": "navigation and medium-emphasis actions",
      "20": "primary toolbar actions",
      "22": "mobile comment Send arrow"
    },
    "stroke": "1.5 from the core themes; keep-stroke marks a deliberate exception"
  }
}
