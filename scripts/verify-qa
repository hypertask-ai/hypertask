#!/usr/bin/env bash
set -euo pipefail
ref=${1:-$(git branch --show-current)}
journey=${2:-inbox-cycle}
workflow_ref=${3:-production}
if [ "$#" -gt 3 ] || ! git check-ref-format "refs/heads/$ref" >/dev/null 2>&1; then
  echo 'Usage: scripts/verify-qa [pushed-branch] [inbox-cycle|inbox-cycle-broken] [workflow-ref]' >&2
  exit 2
fi
case "$journey" in inbox-cycle|inbox-cycle-broken) ;; *) echo 'Unknown verify-qa journey' >&2; exit 2 ;; esac
sha=$(git ls-remote --exit-code origin "refs/heads/$ref" | cut -f1)
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Push the branch to origin before verification.' >&2
  exit 1
fi
printf 'Candidate: %s @ %s; journey: %s\n' "$ref" "$sha" "$journey"
gh workflow run visual-regression.yml --repo hypertask-ai/hypertask --ref "$workflow_ref" -f "head=$sha" -f "journey=$journey"
printf '%s\n' 'Use the returned run URL: gh run watch <run-id> --exit-status --interval 30; gh run download <run-id> --dir <evidence-dir>'
