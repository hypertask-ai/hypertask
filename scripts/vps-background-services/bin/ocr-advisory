#!/usr/bin/env bash
# Advisory second-opinion reviews via open-code-review (ocr) on open production PRs.
# Non-gating by design: posts one clearly labeled comment per PR head SHA and is
# never read by automerge (no APPROVE/CONCERNS prefix, no reviewed-commit marker).
#
# Runs on the Codex subscription by default (OCR delegation mode: ocr picks the
# files and rules with no LLM call, codex does the reasoning). Set
# OCR_ADVISORY_MODE=metered to fall back to `ocr review` against the Vercel AI
# Gateway key in ~/.opencodereview/config.json.
# Disable with: systemctl --user disable --now ocr-advisory.timer
set -euo pipefail
REPO=hypertask-ai/hypertask
WORKDIR="$HOME/projects/hypertask-oss"
REMOTE=agent-origin
EXPECTED_REMOTE=https://github.com/hypertask-ai/hypertask.git
STATE="$HOME/.local/state/ocr-advisory"
MODE="${OCR_ADVISORY_MODE:-delegate}"
mkdir -p "$STATE"
cd "$WORKDIR"

actual_remote=$(git remote get-url "$REMOTE")
if [[ "$actual_remote" != "$EXPECTED_REMOTE" ]]; then
  echo "ocr-advisory: $REMOTE points at an unexpected repository" >&2
  exit 1
fi
git fetch -q "$REMOTE" production
base_sha=$(git rev-parse "$REMOTE/production")

open_prs=$(gh pr list --repo "$REPO" --base production --state open --limit 1000 \
  --json number,headRefName,headRefOid,isDraft \
  --jq '.[] | "\(.number) \(.headRefName) \(.headRefOid) \(.isDraft)"')
while read -r pr branch sha is_draft; do
  [ -n "$sha" ] || continue
  marker_file="$STATE/$pr-$sha"
  legacy_marker="$STATE/$sha"
  if [ -e "$legacy_marker" ] && [ ! -e "$marker_file" ]; then
    mv -- "$legacy_marker" "$marker_file"
  fi
  [ "$is_draft" = false ] || continue
  [ -e "$marker_file" ] && continue
  review_ref="refs/ocr-advisory/$pr"
  git fetch -q "$REMOTE" "+pull/$pr/head:$review_ref" || continue
  if [[ "$(git rev-parse "$review_ref")" != "$sha" ]]; then
    git update-ref -d "$review_ref"
    continue
  fi
  if ! merge_base=$(git merge-base "$base_sha" "$sha"); then
    git update-ref -d "$review_ref"
    continue
  fi
  out=$(mktemp)
  if [ "$MODE" = metered ]; then
    review_cmd=(ocr review --from "$merge_base" --to "$sha" --format json)
  else
    review_cmd=(ocr-delegate-review --from "$merge_base" --to "$sha" --repo "$WORKDIR")
  fi
  if ! timeout 1500 "${review_cmd[@]}" >"$out" 2>"$STATE/last-error.log"; then
    rm -f "$out"
    git update-ref -d "$review_ref"
    continue  # transient failure: retry on the next timer run
  fi
  if ! body=$(python3 - "$out" "$sha" <<'EOF'
import json, sys
d = json.load(open(sys.argv[1]))
comments = d.get("comments") or d.get("findings") or []

def inert(value, limit=None):
    text = " ".join(str(value).split())
    if limit is not None:
        text = text[:limit]
    unsafe = "\\`*_{}[]()#+-.!|<>@"
    return "".join(f"&#{ord(char)};" if char in unsafe else char for char in text)

engine = inert((d.get("summary") or {}).get("engine", "open-code-review"))
lines = [f"<strong>OCR advisory (non-gating)</strong> for <code>{sys.argv[2][:12]}</code> "
         f"via open-code-review delegation ({engine}). {len(comments)} finding(s); "
         "the required AI review stays authoritative.", ""]
rank = {"critical": 0, "high": 1, "medium": 2, "low": 3}
for c in sorted(comments, key=lambda c: rank.get(str(c.get("severity")), 3))[:8]:
    sev = inert(str(c.get("severity", "?")).upper())
    path = inert(c.get("file") or c.get("path") or "?")
    text = inert(c.get("title") or c.get("content") or c.get("body") or "", 300)
    try:
        line = int(c.get("start_line") or 0)
    except (TypeError, ValueError):
        line = 0
    loc = f":{line}" if line > 0 else ""
    lines.append(f"- <strong>{sev}</strong> <code>{path}{loc}</code>: {text}")
if len(comments) > 8:
    session = inert(d.get("session_id", "?"), 8)
    lines.append(f"- ...and {len(comments) - 8} more (session {session} on the VPS)")
if not comments:
    lines.append("No findings.")
print("\n".join(lines))
EOF
); then
    rm -f "$out"
    git update-ref -d "$review_ref"
    continue
  fi
  gh pr comment "$pr" --repo "$REPO" --body "$body" >/dev/null && touch "$marker_file"
  rm -f "$out"
  git update-ref -d "$review_ref"
done <<< "$open_prs"
# Age out markers only after their PR closes, preserving one comment per PR head SHA.
while IFS= read -r -d '' marker_file; do
  marker=${marker_file##*/}
  pr=${marker%%-*}
  if ! awk -v pr="$pr" '$1 == pr { found=1 } END { exit !found }' <<< "$open_prs"; then
    rm -f -- "$marker_file"
  fi
done < <(find "$STATE" -type f -mtime +30 -print0)
