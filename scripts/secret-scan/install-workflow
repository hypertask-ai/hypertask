#!/bin/sh
set -e
src=$(cd "$(dirname "$0")" && pwd)
if [ "$#" != 1 ]; then
  echo "Usage: install-workflow <repo checkout dir>" >&2
  exit 1
fi
cd "$1"
if ! origin=$(git remote get-url origin 2>/dev/null) || [ -z "$origin" ]; then
  echo "install-workflow: cannot read checkout origin; refusing to install." >&2
  exit 1
fi
if ! visibility=$(gh repo view "$origin" --json visibility --jq '.visibility' 2>/dev/null); then
  echo "install-workflow: cannot read origin repository visibility; refusing to install." >&2
  exit 1
fi
case "$visibility" in
  PUBLIC) runner=ubuntu-latest ;;
  PRIVATE|INTERNAL) runner='[self-hosted, ci-fast]' ;;
  *)
    echo "install-workflow: unknown repository visibility; refusing to install." >&2
    exit 1
    ;;
esac
mkdir -p .github/workflows
workflow=$(sed "s/^    runs-on: ubuntu-latest$/    runs-on: $runner/" "$src/gitleaks.yml")
if ! printf '%s\n' "$workflow" | grep -qxF "    runs-on: $runner"; then
  echo "install-workflow: template has no 'runs-on: ubuntu-latest' line to set; refusing to install." >&2
  exit 1
fi
printf '%s\n' "$workflow" > .github/workflows/gitleaks.yml
echo "install-workflow: installed .github/workflows/gitleaks.yml ($visibility, $runner)."
