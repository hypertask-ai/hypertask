#!/bin/sh
# Stops a commit when its staged changes contain a key (YPER4-324): gitleaks for anything
# key-shaped, then trufflehog (any hit blocks: its live check can say "dead" for a working
# key). A false hit gets `trufflehog:ignore` on its line. Called by the global git hooks and by
# husky's init.sh; bypass once with git commit --no-verify.
leaks=$(command -v gitleaks || echo "$HOME/.local/bin/gitleaks")
truffle=$(command -v trufflehog || echo "$HOME/.local/bin/trufflehog")
for tool in "$leaks" "$truffle"; do
  if [ ! -x "$tool" ]; then
    echo "secret-scan: $(basename "$tool") is not installed, so this commit cannot be checked for keys." >&2
    echo "secret-scan: install it to ~/.local/bin, or commit with --no-verify if you are sure." >&2
    exit 1
  fi
done
top=$(git rev-parse --show-toplevel) || exit 1
set -- git --pre-commit --staged --redact --no-banner --log-level=warn
# The repo's own rules win; otherwise the base rules installed next to this script.
if [ -f "$top/.gitleaks.toml" ]; then
  set -- "$@" "--config=$top/.gitleaks.toml"
elif [ -f "$(dirname "$0")/gitleaks.toml" ]; then
  set -- "$@" "--config=$(dirname "$0")/gitleaks.toml"
fi
if ! "$leaks" "$@" "$top"; then
  echo "secret-scan: commit blocked, a staged change looks like a key (value hidden above)." >&2
  echo "secret-scan: remove it and keep keys in the key safe (stack-key)." >&2
  exit 1
fi

# trufflehog reads the staged version of each changed file, copied to a private temp folder.
# Any failure to list or copy the staged files blocks the commit rather than skip the scan.
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/staged" || exit 1
if ! git diff --cached --name-only -z --diff-filter=ACMRT > "$tmp/list"; then
  echo "secret-scan: could not list the staged files; commit blocked." >&2
  exit 1
fi
[ -s "$tmp/list" ] || exit 0
if ! xargs -0 git checkout-index --prefix="$tmp/staged/" -- < "$tmp/list"; then
  echo "secret-scan: could not copy the staged files for trufflehog; commit blocked." >&2
  exit 1
fi
"$truffle" filesystem "$tmp/staged" --fail --no-update --json >"$tmp/found" 2>/dev/null
code=$?
# A finding whose value is a git commit SHA is not a key: trufflehog's Cloudflare detectors read
# any 40-character hex run as a key, and a GitHub URL or a commit note carries one (HYCI-405).
# A package lockfile repeats the same package's 32-character peer hash per peer set, which its
# Alchemy detector reads as a key. Both pass only in those proven places; the same shape
# anywhere else still blocks.
proven() {
  hit=$1
  det=$(printf '%s' "$hit" | sed -n 's/.*"DetectorName":"\([^"]*\)".*/\1/p')
  file=$(printf '%s' "$hit" | sed -n 's/.*"file":"\([^"]*\)".*/\1/p')
  line=$(printf '%s' "$hit" | sed -n 's/.*"line":\([0-9]*\).*/\1/p')
  raw=$(printf '%s' "$hit" | sed -n 's/.*"Raw":"\([^"]*\)".*/\1/p')
  case $det in
    Alchemy)
      case $file in
        */pnpm-lock.yaml | */package-lock.json | */yarn.lock | */npm-shrinkwrap.json) return 0 ;;
      esac
      return 1 ;;
  esac
  # A 40-character lowercase hex commit SHA, on a line that quotes it as a commit.
  case $raw in '' | *[!0-9a-f]*) return 1 ;; esac
  [ ${#raw} -eq 40 ] || return 1
  case $line in '' | *[!0-9]*) return 1 ;; esac
  [ -f "$file" ] || return 1
  text=$(sed -n "${line}p" "$file" 2>/dev/null) || return 1
  case $text in *"$raw"*) ;; *) return 1 ;; esac
  masked=$(printf '%s' "$text" | sed "s/$raw/<sha>/g")
  printf '%s\n' "$masked" | grep -Eq '/(tree|commits?|blob)/<sha>|(commit|sha|at) `<sha>`|#<sha>`|"(sha|commit|commits|previousCommit|previousSha|sourceCommit|provenanceCommit|pinnedCommit|mergeCommit|headCommit)"[[:space:]]*:[[:space:]]*"<sha>"'
}

if [ "$code" = 183 ]; then
  : > "$tmp/blocking"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    proven "$hit" || printf '%s\n' "$hit" >> "$tmp/blocking"
  done < "$tmp/found"
  if [ -s "$tmp/blocking" ]; then
    echo "secret-scan: commit blocked, trufflehog found a key (working or not, it blocks either way):" >&2
    grep -o '"DetectorName":"[^"]*"' "$tmp/blocking" | sort -u >&2
    echo "secret-scan: remove it (roll it if it was ever real), keep keys in the key safe (stack-key)." >&2
    exit 1
  fi
  echo "secret-scan: trufflehog matched only quoted commit SHAs and package-lockfile peer hashes, which are not keys." >&2
  code=0
fi
if [ "$code" != 0 ]; then
  echo "secret-scan: trufflehog failed (exit $code); commit blocked. Retry, or --no-verify if you are sure." >&2
  exit 1
fi
