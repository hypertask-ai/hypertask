#!/usr/bin/env python3
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

LIMIT_SECONDS = "180"
BOARD = re.compile(r"Hypertask board:\s*(\d+)\b([^\n]*)")
LABEL = re.compile(r",\s*label:\s*([^()\n]+)")


def repo_root():
    return Path(__file__).resolve().parents[2]


def board_line(root):
    for filename in ("AGENTS.md", "CLAUDE.md"):
        path = root / filename
        try:
            text = path.read_text()
        except OSError:
            continue
        match = BOARD.search(text)
        if not match:
            continue
        label_match = LABEL.search(match.group(2))
        label = label_match.group(1).strip().strip(".") if label_match else ""
        return match.group(1), label
    return "", ""


def login_module(home):
    path = Path(home) / ".claude/skills/hypertask-work/session_login.py"
    if not path.is_file():
        return None
    loader = importlib.machinery.SourceFileLoader("board_sync_session_login", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def chat_name(home):
    module = login_module(home)
    if module is None:
        return ""
    login = module.login_for_session(os.environ)
    if not login:
        return ""
    return str(login[0]).strip()


def sync_script(home):
    return Path(home) / ".claude/skills/board-drain/sync"


def timer():
    found = shutil.which("timeout")
    if found:
        return found
    fallback = Path("/usr/bin/timeout")
    return str(fallback) if fallback.is_file() else ""


def main():
    home = Path(os.environ.get("HOME") or str(Path.home()))
    board, label = board_line(repo_root())
    if not board:
        return 0
    name = chat_name(home)
    if not name:
        return 0
    target = sync_script(home)
    if not target.is_file():
        print(f"board-sync: missing {target}", file=sys.stderr)
        return 1
    limit = timer()
    if not limit:
        print("board-sync: missing timeout", file=sys.stderr)
        return 1
    subprocess.Popen(
        [limit, LIMIT_SECONDS, sys.executable, str(target),
         "--board", board, "--label", label or name, "--name", name],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
