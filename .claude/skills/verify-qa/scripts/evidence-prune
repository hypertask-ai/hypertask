#!/usr/bin/env python3
import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time

DAY = 86400
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
BUILD_NAMES = ('.next', 'node_modules', 'build-*', '.pnpm-store', 'node-v[0-9]*')


class Pruner:
    def __init__(self, apply=False):
        self.apply = apply
        self.now = time.time()
        self.skipped = set()
        self.freed = dict(builds=0, videos=0, tmp=0)
        self.planned = dict(self.freed)
        self.tickets = {}

    def skip(self, path, error):
        self.skipped.add(str(path))
        print(f'SKIP {path}: {error}', file=sys.stderr)

    @contextmanager
    def directory(self, path):
        path = Path(os.path.abspath(path))
        fd = os.open('/', DIRECTORY_FLAGS)
        try:
            for part in path.parts[1:]:
                child = os.open(part, DIRECTORY_FLAGS, dir_fd=fd)
                os.close(fd)
                fd = child
            yield fd
        finally:
            os.close(fd)

    @contextmanager
    def parent(self, root, path):
        relative = path.relative_to(root)
        if not relative.parts or '..' in relative.parts:
            raise ValueError('refusing path outside root')
        with self.directory(root) as root_fd:
            device = os.fstat(root_fd).st_dev
            fd = os.dup(root_fd)
            try:
                for part in relative.parts[:-1]:
                    child = os.open(part, DIRECTORY_FLAGS, dir_fd=fd)
                    os.close(fd)
                    fd = child
                    if os.fstat(fd).st_dev != device:
                        raise OSError('filesystem boundary')
                yield fd, relative.name, device
            finally:
                os.close(fd)

    def snapshot(self, parent, name, device):
        info = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if info.st_dev != device:
            raise OSError('filesystem boundary')
        if stat.S_ISLNK(info.st_mode):
            return info.st_mtime, info.st_blocks * 512, info, {}
        if stat.S_ISREG(info.st_mode):
            return info.st_mtime, info.st_blocks * 512, info, {}
        if not stat.S_ISDIR(info.st_mode):
            raise OSError('not a regular file or directory')
        fd = os.open(name, DIRECTORY_FLAGS, dir_fd=parent)
        try:
            if os.fstat(fd).st_ino != info.st_ino:
                raise OSError('directory changed during scan')
            children = {entry: self.snapshot(fd, entry, device) for entry in os.listdir(fd)}
        finally:
            os.close(fd)
        newest = max((child[0] for child in children.values()), default=info.st_mtime)
        size = info.st_blocks * 512 + sum(child[1] for child in children.values())
        return newest, size, info, children

    def remove(self, parent, name, tree, category=None):
        newest, size, info, children = tree
        current = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if (current.st_dev, current.st_ino, current.st_mode, current.st_mtime_ns) != (
                info.st_dev, info.st_ino, info.st_mode, info.st_mtime_ns):
            raise OSError('entry changed during scan')
        if stat.S_ISDIR(info.st_mode):
            fd = os.open(name, DIRECTORY_FLAGS, dir_fd=parent)
            try:
                for child, snapshot in children.items():
                    self.remove(fd, child, snapshot, category)
            finally:
                os.close(fd)
            os.rmdir(name, dir_fd=parent)
        else:
            os.unlink(name, dir_fd=parent)
        if category is not None and (stat.S_ISDIR(current.st_mode) or current.st_nlink == 1):
            self.freed[category] += current.st_blocks * 512

    def candidate(self, root, path, category, days):
        try:
            with self.parent(root, path) as (fd, name, device):
                tree = self.snapshot(fd, name, device)
                if tree[0] >= self.now - days * DAY:
                    return
                self.planned[category] += tree[1]
                print(f'{"DELETE" if self.apply else "WOULD DELETE"} {category} {path} {tree[1] / 1e9:.6f} GB')
                if self.apply:
                    self.remove(fd, name, tree, category)
        except (OSError, ValueError) as error:
            self.skip(path, error)

    def done(self, ticket):
        if ticket not in self.tickets:
            self.tickets[ticket] = False
            try:
                result = subprocess.run(['hypertask', 'tasks', 'get', ticket, '--json'],
                                        capture_output=True, text=True, check=True, timeout=30)
                data = json.loads(result.stdout)
                if not isinstance(data, dict) or data.get('success') is not True or len(data['tasks']) != 1:
                    raise ValueError('unexpected ticket response')
                self.tickets[ticket] = data['tasks'][0]['section'] == 'Done'
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
                self.skip(ticket, 'board read failed; keeping videos')
        return self.tickets[ticket]

    def evidence(self, root):
        try:
            with self.directory(root):
                pass
        except FileNotFoundError:
            return
        except OSError as error:
            self.skip(root, error)
            return
        names = []
        for name in BUILD_NAMES:
            if names:
                names.append('-o')
            names.extend(['-name', name])
        names.extend(['-o', '-path', '*/.cache/ms-playwright'])
        command = ['find', '-P', str(root), '-xdev', '-mindepth', '1',
                   '(', '-type', 'd', '(', *names, ')', '-print0', '-prune', ')',
                   '-o', '(', '-type', 'f', '-name', '*.webm', '-print0', ')']
        result = subprocess.run(command, capture_output=True)
        for error in os.fsdecode(result.stderr).splitlines():
            self.skip(error, 'find could not inspect path')
        if result.returncode and not result.stderr:
            self.skip(root, 'find failed')
        for raw in result.stdout.split(b'\0'):
            if not raw:
                continue
            path = Path(os.fsdecode(raw))
            try:
                with self.parent(root, path) as (fd, name, device):
                    info = os.stat(name, dir_fd=fd, follow_symlinks=False)
                    if info.st_dev != device:
                        raise OSError('filesystem boundary')
                    if stat.S_ISDIR(info.st_mode):
                        category = 'builds'
                    elif stat.S_ISREG(info.st_mode) and path.suffix == '.webm':
                        ticket = path.relative_to(root).parts[0]
                        if not re.fullmatch(r'(HTPR|YPER4|HYFA)-[1-9][0-9]*', ticket):
                            continue
                        if info.st_mtime >= self.now - 14 * DAY or not self.done(ticket):
                            continue
                        category = 'videos'
                    else:
                        continue
                self.candidate(root, path, category, 14 if category == 'videos' else 2)
            except (OSError, ValueError) as error:
                self.skip(path, error)

    def temporary(self, state):
        try:
            with self.directory(state) as fd:
                names = os.listdir(fd)
        except FileNotFoundError:
            return
        except OSError as error:
            self.skip(state, error)
            return
        for name in names:
            if not re.fullmatch(r'hypertask-(dev|qa)-.+', name):
                continue
            root = state / name / 'tmp'
            try:
                with self.directory(root) as fd:
                    entries = os.listdir(fd)
                    device = os.fstat(fd).st_dev
                    if device != state.stat().st_dev:
                        raise OSError('filesystem boundary')
                    for entry in entries:
                        info = os.stat(entry, dir_fd=fd, follow_symlinks=False)
                        if stat.S_ISLNK(info.st_mode):
                            self.skip(root / entry, 'symlink')
                            continue
                        self.candidate(root, root / entry, 'tmp', 2)
            except FileNotFoundError:
                continue
            except OSError as error:
                self.skip(root, error)


def disk_used():
    result = subprocess.run(['df', '--output=pcent', '/'], capture_output=True, text=True, check=True)
    return int(result.stdout.splitlines()[-1].strip().rstrip('%'))


def main():
    parser = argparse.ArgumentParser(description='Prune old QA builds and scratch; dry-run by default.')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--apply', action='store_true')
    mode.add_argument('--dry-run', action='store_true')
    parser.add_argument('--evidence-root', type=Path,
                        default=Path(os.environ.get('VCC_EVIDENCE_DIR', Path.home() / '.local/state/vcc-evidence')))
    parser.add_argument('--state-root', type=Path, default=Path.home() / '.local/state')
    args = parser.parse_args()
    root = Path(os.path.abspath(args.evidence_root.expanduser()))
    state = Path(os.path.abspath(args.state_root.expanduser()))
    if root == Path('/') or state == Path('/'):
        parser.error('refusing filesystem root')
    log = Path.home() / '.local/state/evidence-prune'
    log.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (log / 'run.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        before = disk_used()
        pruner = Pruner(args.apply)
        pruner.evidence(root)
        pruner.temporary(state)
        summary = dict(time=datetime.now(timezone.utc).isoformat(), apply=args.apply,
                       disk_used_pct_before=before, disk_used_pct_after=disk_used(),
                       bytes_freed=pruner.freed, bytes_planned=pruner.planned,
                       skipped_paths_count=len(pruner.skipped))
        line = json.dumps(summary, sort_keys=True)
        print(line)
        with (log / 'log.jsonl').open('a') as output:
            output.write(line + '\n')


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.SubprocessError) as error:
        sys.exit(f'evidence-prune: {error}')
