#!/usr/bin/env node

const { readFile } = require('node:fs/promises');
const { homedir } = require('node:os');
const { join } = require('node:path');

const appHost = 'app.hypertask.ai';
const teamListPath = '/api/teams/getAllMinimal';
const usagePath = '/api/settings/ai-usage';

const NAMED_TEAMS = [
  { label: 'free', userId: 3411, stateFile: 'state-free.json', teamId: '308dcc93-8076-4e30-a982-ae8b0df82cee', plan: 'Free' },
  { label: 'pro', userId: 3413, stateFile: 'state-pro.json', teamId: '2ce0d9f8-4179-489d-bbce-2b0e197f8067', plan: 'Pro' },
  { label: 'byok', userId: 3412, stateFile: 'state-byok.json', teamId: '977c0c91-c14f-47b0-b8bc-933cc751f19d', plan: 'BYOK' },
];

const EXIT = { ok: 0, mismatch: 1, refused: 2, expired: 3 };

class Expired extends Error {}
class Unavailable extends Error {}

function refuse(message) {
  console.log(`refused: ${message}`);
  process.exitCode = EXIT.refused;
}

function parseArgs(argv) {
  const labels = [];
  let baseUrl = `https://${appHost}`;
  let stateDir = join(homedir(), '.config', 'ht-qa');
  const args = [...argv];
  while (args.length) {
    const arg = args.shift();
    if (arg === '--base-url' || arg === '--state-dir') {
      const value = args.shift();
      if (!value) return { error: `${arg} needs a value` };
      if (arg === '--state-dir') {
        stateDir = value;
        continue;
      }
      try {
        const url = new URL(value);
        if (url.protocol !== 'http:' || url.hostname !== '127.0.0.1' ||
            url.username || url.password || url.pathname !== '/' || url.search || url.hash) {
          throw new Error();
        }
        baseUrl = url.origin;
      } catch {
        return { error: 'test base URL must be an HTTP origin on 127.0.0.1' };
      }
    } else if (NAMED_TEAMS.some(team => team.label === arg)) {
      if (labels.includes(arg)) return { error: `${arg} given twice` };
      labels.push(arg);
    } else {
      return { error: 'not a named test team' };
    }
  }
  return { labels, baseUrl, stateDir };
}

async function loadCookies(file) {
  let state;
  try {
    state = JSON.parse(await readFile(file, 'utf8'));
  } catch {
    throw new Unavailable('cannot read login state');
  }
  if (!state || !Array.isArray(state.cookies)) throw new Unavailable('login state has no cookies');
  const now = Date.now() / 1000;
  const live = [];
  let expired = 0;
  for (const cookie of state.cookies) {
    if (!cookie || typeof cookie.domain !== 'string' || typeof cookie.path !== 'string' ||
        typeof cookie.name !== 'string' || !/^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/.test(cookie.name) ||
        typeof cookie.value !== 'string' || !/^[\x21-\x3A\x3C-\x7E]*$/.test(cookie.value) ||
        !Number.isFinite(cookie.expires)) {
      throw new Unavailable('invalid login cookie');
    }
    const domain = cookie.domain.toLowerCase();
    const matchesDomain = domain.startsWith('.')
      ? appHost === domain.slice(1) || appHost.endsWith(domain)
      : appHost === domain;
    if (!matchesDomain) continue;
    if (cookie.expires === -1 || cookie.expires > now) live.push(cookie);
    else expired += 1;
  }
  if (!live.length && expired) throw new Expired('login expired');
  if (!live.length) throw new Unavailable('no app cookies');
  return live.map(cookie => `${cookie.name}=${cookie.value}`).join('; ');
}

async function call(baseUrl, path, cookie, method) {
  const signal = AbortSignal.timeout(15_000);
  let response;
  try {
    response = await fetch(new URL(path, baseUrl), {
      method,
      headers: { Cookie: cookie, ...(method === 'POST' ? { 'Content-Type': 'application/json' } : {}) },
      body: method === 'POST' ? '{}' : undefined,
      redirect: 'manual',
      signal,
    });
  } catch {
    throw new Unavailable(signal.aborted ? 'request timed out' : 'network error');
  }
  if (response.status === 401 || response.status === 403) {
    await response.body?.cancel();
    throw new Expired('login refused by the server');
  }
  if (!response.ok) {
    await response.body?.cancel();
    throw new Unavailable(`${path.split("?")[0]} answered ${response.status}`);
  }
  try {
    return await response.json();
  } catch {
    throw new Unavailable(`${path.split("?")[0]} answered invalid JSON`);
  }
}

function readPlan(team) {
  const compedUntil = team.compedUntil ? new Date(team.compedUntil) : null;
  const comped = Boolean(compedUntil && compedUntil.getTime() > Date.now());
  if (comped) {
    return {
      plan: team.compedPlan === 'BYOK' ? 'BYOK' : 'Pro',
      compedText: `comped until ${compedUntil.toISOString().slice(0, 10)}`,
      comped,
    };
  }
  return { plan: team.activeSubscriptionPlanId ? 'Paid' : 'Free', compedText: 'not comped', comped };
}

const FUNDING_TEXT = { customer: 'own key', managed: 'managed', shared: 'shared' };

function readUsage(usage) {
  const allowance = usage && usage.allowance;
  const allowanceText = allowance && Number.isFinite(allowance.remainingUsd) && Number.isFinite(allowance.budgetUsd)
    ? `$${allowance.remainingUsd.toFixed(2)} of $${allowance.budgetUsd.toFixed(2)} left${allowance.capped ? ' (capped)' : ''}`
    : 'n/a';
  return { allowanceText, keySource: FUNDING_TEXT[usage && usage.fundingSource] || 'none' };
}

async function health(entry, options) {
  const line = (fields, status) => `${[entry.label, ...fields].join(' | ')} | ${status}`;
  let cookie;
  let teams;
  try {
    cookie = await loadCookies(join(options.stateDir, entry.stateFile));
    teams = await call(options.baseUrl, teamListPath, cookie, 'POST');
  } catch (error) {
    if (error instanceof Expired) return { code: EXIT.expired, text: line(['-', '-', '-'], `EXPIRED: ${error.message}`) };
    return { code: EXIT.mismatch, text: line(['-', '-', '-'], `UNAVAILABLE: ${error.message}`) };
  }
  const team = Array.isArray(teams) ? teams.find(candidate => candidate && candidate.id === entry.teamId) : undefined;
  if (!team) return { code: EXIT.mismatch, text: line(['-', '-', '-'], 'MISMATCH: team not in this login') };
  const plan = readPlan(team);
  let usage;
  try {
    usage = readUsage(await call(options.baseUrl, `${usagePath}?teamId=${encodeURIComponent(entry.teamId)}`, cookie, 'GET'));
  } catch (error) {
    const status = error instanceof Expired ? 'EXPIRED' : 'UNAVAILABLE';
    const code = error instanceof Expired ? EXIT.expired : EXIT.mismatch;
    return { code, text: line([plan.plan, plan.compedText, '-', '-'], `${status}: ${error.message}`) };
  }
  const planMatches = plan.plan === entry.plan && (entry.plan === 'Free' ? !plan.comped : plan.comped);
  return {
    code: planMatches ? EXIT.ok : EXIT.mismatch,
    text: line([plan.plan, plan.compedText, usage.allowanceText, usage.keySource], planMatches ? 'OK' : `MISMATCH: expected ${entry.plan}`),
  };
}

async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  if (parsed.error) return refuse(parsed.error);
  const entries = parsed.labels.length
    ? NAMED_TEAMS.filter(team => parsed.labels.includes(team.label))
    : NAMED_TEAMS;
  const results = [];
  for (const entry of entries) results.push(await health(entry, parsed));
  for (const result of results) console.log(result.text);
  const codes = results.map(result => result.code);
  process.exitCode = codes.includes(EXIT.expired) ? EXIT.expired : codes.includes(EXIT.mismatch) ? EXIT.mismatch : EXIT.ok;
}

main().catch(() => {
  console.log('refused: team check failed');
  process.exitCode = EXIT.refused;
});
