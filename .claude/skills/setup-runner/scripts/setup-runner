#!/usr/bin/env bash
set +x
set -euo pipefail
for runner_command_dir in "$HOME/.local/bin" "$HOME/.npm-global/bin"; do
  [ -d "$runner_command_dir" ] || continue
  case ":${PATH-}:" in
    *":$runner_command_dir:"*) ;;
    *) PATH="$runner_command_dir${PATH:+:$PATH}" ;;
  esac
done
export PATH
unset runner_command_dir
umask 077
SELF=$(readlink -f "$0")
CREDS=$HOME/.config/hypertask-agents/credentials
fail() { printf 'setup-runner: %s\n' "$1" >&2; exit 1; }

[ "$#" -le 1 ] || fail 'usage: setup-runner [positive runner number]'
if [ "$#" -eq 1 ]; then
  [[ "$1" =~ ^[1-9][0-9]*$ ]] || fail 'runner number must be a positive integer (no leading zeros)'
fi

# Match ship-identity: the nearest ancestor session and user-supplied name.
pid=$$
own_pid=
name=${SHIP_SESSION_NAME:-}
while [ "$pid" -gt 1 ]; do
  f=$HOME/.claude/sessions/$pid.json
  if [ -f "$f" ]; then
    own_pid=$pid
    if [ -z "$name" ]; then
      name=$(jq -er 'if .nameSource == "user" then (.name // "") else "" end' "$f") || fail 'cannot read this session name'
    fi
    break
  fi
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  [ -n "$pid" ] || fail 'cannot find parent process'
done
name=${name%% | *}

mkdir -p "$CREDS"
# Serialize picking and provisioning so simultaneous setups cannot claim one number.
exec 9>"$CREDS/.setup-runner.lock"
flock -x 9
live_numbers=()
shopt -s nullglob
for f in "$HOME"/.claude/sessions/*.json; do
  session_pid=${f##*/}
  session_pid=${session_pid%.json}
  [[ "$session_pid" =~ ^[1-9][0-9]*$ ]] || fail 'invalid session filename'
  [ "$session_pid" != "$own_pid" ] || continue
  if kill -0 "$session_pid" 2>/dev/null; then
    live_name=$(jq -er '.name // ""' "$f") || fail 'cannot read a live session name'
    live_name=${live_name%% | *}
    if [[ "$live_name" =~ ^RUNNER\ ([1-9][0-9]*)$ ]]; then
      live_numbers+=("${BASH_REMATCH[1]}")
    fi
  fi
done
busy() {
  local used
  for used in "${live_numbers[@]}"; do
    [ "$used" != "$1" ] || return 0
  done
  return 1
}
if [[ "$name" =~ ^RUNNER\ ([1-9][0-9]*)$ ]]; then
  n=${BASH_REMATCH[1]}
elif [ "$#" -eq 1 ]; then
  n=$1
else
  n=1
  while [ -e "$CREDS/runner-$n-agent-token" ] || [ -L "$CREDS/runner-$n-agent-token" ] || busy "$n"; do
    n=$((n + 1))
  done
fi
if busy "$n"; then fail "RUNNER $n is already used by another live session"; fi
if [ "$name" = "RUNNER $n" ]; then
  set -- --identity-required
else
  set --
fi
exec "${SELF%/*}/../../setup-agents/scripts/setup-agents" --name "Runner $n" --identity "RUNNER $n" "$@"
