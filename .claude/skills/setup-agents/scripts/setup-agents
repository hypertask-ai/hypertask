#!/usr/bin/env bash
# One agent onboarding path: check the machine, then set up or reuse one agent login.
# Prints no token and never replaces an existing credential.
set +x
set -euo pipefail
for dir in "$HOME/.local/bin" "$HOME/.npm-global/bin"; do
  [ -d "$dir" ] || continue
  case ":${PATH-}:" in
    *":$dir:"*) ;;
    *) PATH="$dir${PATH:+:$PATH}" ;;
  esac
done
export PATH
umask 077
SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
CREDS=${VCC_CREDENTIALS_DIR:-$HOME/.config/hypertask-agents/credentials}
SESSION_CREDS=${VCC_SESSION_CREDENTIALS_DIR:-$CREDS/sessions}
fail() { printf 'setup-agents: %s\n' "$1" >&2; exit 1; }
usage() {
  cat <<'EOF'
usage: setup-agents [--name "<name>"] [--identity "<session>"] [--check]

Sets up or reuses one Hypertask agent login here, then asks the server to verify
it. Prints no token and never replaces an existing credential.
  --name "<name>"     display name (or the first plain argument)
  --identity "<name>" session name that owns the login (default: --name)
  --check             tools and login smoke only, no writes; with --name, that
                      agent's existing credential
  --identity-required this session carries the name; a mismatch is fatal
  -h, --help          show this text
Needs: hypertask jq flock mktemp ln cat readlink sed tr.
EOF
}

name=
identity_name=
check_only=0
identity_required=0
while [ "$#" -gt 0 ]; do
  case $1 in
    --name|--identity)
      [ "$#" -ge 2 ] || fail "$1 needs a value"
      if [ "$1" = --name ]; then name=$2; else identity_name=$2; fi
      shift 2
      ;;
    --check) check_only=1; shift ;;
    --identity-required) identity_required=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) fail "unknown option: $1 (run setup-agents --help)" ;;
    *) [ -z "$name" ] || fail "unexpected argument: $1 (run setup-agents --help)"; name=$1; shift ;;
  esac
done

missing=0
for tool in hypertask jq flock mktemp ln cat readlink sed tr; do
  command -v "$tool" >/dev/null 2>&1 && continue
  missing=1
  case $tool in
    hypertask) fix='install it from https://github.com/hypertask-ai/cli' ;;
    jq) fix='install it with: sudo apt-get install jq' ;;
    flock) fix='install it with: sudo apt-get install util-linux' ;;
    *) fix='install it with your package manager' ;;
  esac
  printf 'setup-agents: missing %s; %s\n' "$tool" "$fix" >&2
done
if [ "$missing" -eq 1 ]; then
  printf 'setup-agents: nothing was created; install the tools above and rerun\n' >&2
  exit 2
fi

slug_of() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

login_ok() {
  local status
  status=$(hypertask --json "$@" status 2>/dev/null) \
    || fail 'the server rejected this login; run hypertask login or pass a management key, then rerun (CLI output withheld to protect tokens)'
  jq -e '.authenticated == true and .verified == true' <<<"$status" >/dev/null 2>&1 \
    || fail 'the login is not authenticated; run hypertask login or pass a management key, then rerun (CLI output withheld to protect tokens)'
}

if [ "$check_only" -eq 1 ]; then
  check_args=()
  if [ -n "$name" ]; then
    check_token=$CREDS/$(slug_of "$name")-agent-token
    { [ -f "$check_token" ] && [ -s "$check_token" ]; } \
      || fail "no readable credential for \"$name\"; set it up with --name \"$name\" or run --check without --name for the ambient login"
    check_args=(--token "$(cat "$check_token")")
  fi
  login_ok "${check_args[@]}"
  printf 'setup-agents: check ok (tools present, login ok)\n'
  exit 0
fi

[ -n "$name" ] || { usage >&2; fail 'no agent name: pass --name "<agent name>" or a name as the first argument'; }
identity_name=${identity_name:-$name}
for value in "$name" "$identity_name"; do
  case $value in
    *[[:cntrl:]]*|*'|'*|*'${'*) fail 'a name has a control character, a pipe or a template marker; use plain words' ;;
  esac
  [ "${#value}" -le 64 ] || fail "a name is ${#value} characters; the limit is 64"
done
case $name in
  ht_*|htmk_*|eyJ*) fail 'agent name looks like a credential; pass the agent display name instead' ;;
esac
slug=$(slug_of "$name")
[[ $slug =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail 'agent name needs at least one letter or digit'
[ "$(slug_of "$identity_name")" = "$slug" ] \
  || fail 'the identity name and the display name must share a slug; use names that differ only in case or punctuation'

mkdir -p "$CREDS"
exec 8>"$CREDS/.setup-agents.lock"
flock -x 8
token=$CREDS/$slug-agent-token
record=$CREDS/$slug-agent-name
if [ -f "$record" ] && [ "$(cat "$record")" != "$name" ]; then
  fail "the credential $token already belongs to \"$(cat "$record")\"; rerun with that name or pick a name with a different slug"
fi
tmp=
trap '[ -z "$tmp" ] || rm -f "$tmp"' EXIT
if [ ! -e "$token" ] && [ ! -L "$token" ]; then
  response=$(hypertask agents create --name "$name" --project 15 --project 11514 --json 2>/dev/null) \
    || fail "could not create agent \"$name\": log in as a board owner (hypertask login) or pass a management key, then rerun (CLI output withheld to protect tokens)"
  tmp=$(mktemp "$CREDS/.$slug-token.XXXXXX")
  jq -er '.token | select(type == "string" and length > 0 and (test("\\s") | not))' <<<"$response" >"$tmp" 2>/dev/null \
    || fail 'agent creation returned no usable token; nothing was saved, rerun after checking the board'
  ln "$tmp" "$token" || fail "a credential for \"$name\" appeared while setup was running; rerun to reuse it"
  rm -f "$tmp"
  tmp=
  unset response
fi
[ -f "$token" ] && [ -s "$token" ] && [ -r "$token" ] \
  || fail "the existing credential $token is empty, unreadable or not a regular file; refusing to replace it"
mkdir -p "$SESSION_CREDS"
link=$SESSION_CREDS/$slug-agent-token
if [ -e "$link" ] && [ ! -L "$link" ]; then
  fail "the session credential $link is not a symlink; refusing to overwrite it"
fi
if [ "$SESSION_CREDS" = "$CREDS/sessions" ]; then
  ln -sfn "../$slug-agent-token" "$link"
else
  ln -sfn "$token" "$link"
fi
login_ok --token "$(cat "$token")"
[ -f "$record" ] || printf '%s\n' "$name" >"$record"

identity=$("${SELF%/*}/../../ship/scripts/ship-identity") || fail 'identity verification failed'
if [ "$identity" = "$identity_name"$'\t'"$link" ]; then
  printf '%s: login ok, identity ok\n' "$identity_name"
elif [ "$identity_required" -eq 1 ] || [ "${identity%%$'\t'*}" = "$identity_name" ]; then
  fail "ship-identity does not match the agent credential: expected $identity_name, got ${identity%%$'\t'*}"
else
  printf '%s: login ok; type /rename %s then rerun\n' "$identity_name" "$identity_name"
  printf '/rename %s\n' "$identity_name"
fi
