#!/usr/bin/env python3
# Merges queued or labelled pull requests whose required pstack-verifier status is success.
# One pass, one JSON document on stdout. Never passes --admin; the merge is pinned to the head
# whose verifier status was read, so a push during the pass refuses instead of merging unverified.
#   pr-merge-pass --queue <file>          numbers, one per line; merged or closed lines are removed
#   pr-merge-pass --label <label>         open PRs carrying the label
#   pr-merge-pass --pr 123 --pr 456       explicit numbers
# Options: --repo, --context, --app-login, --dry-run, --limit.
# Exit: 0 all handled, 1 a merge was refused or a PR could not be read, 2 bad input.
# SHIP_REPO sets the default repository.
import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DEFAULT_REPO = "hypertask-ai/hypertask"
DEFAULT_CONTEXT = "pstack-verifier"
DEFAULT_APP_LOGIN = "hypertask-runners[bot]"


def die(error, detail=None):
    payload = {"error": error}
    if detail:
        payload["detail"] = detail
    print(json.dumps(payload))
    sys.exit(2)


def gh(*args):
    result = subprocess.run(["gh", *args], capture_output=True, text=True)
    return result.returncode, result.stdout, result.stderr


def repo_name(value):
    name = re.sub(r"^github\.com/", "", value.strip(), flags=re.I)
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", name):
        die("repository must be owner/name", value)
    return name


def queue_numbers(path):
    if not path.exists():
        die("queue file does not exist", str(path))
    return [line.split("#", 1)[0].strip() for line in path.read_text().splitlines()
            if line.split("#", 1)[0].strip()]


def labelled(repo, label, limit):
    code, out, err = gh("pr", "list", "--repo", repo, "--label", label, "--state", "open",
                        "--limit", str(limit), "--json", "number")
    if code != 0:
        die("cannot list PRs labelled " + label, err.strip())
    return [str(item["number"]) for item in json.loads(out or "[]")]


def view(repo, number):
    code, out, err = gh("pr", "view", number, "--repo", repo,
                        "--json", "number,state,isDraft,headRefOid,mergeStateStatus,url")
    if code != 0:
        return None, err.strip() or "gh pr view failed"
    return json.loads(out), None


def verifier_state(repo, sha, context, app_login):
    code, out, err = gh("api", "repos/%s/commits/%s/statuses?per_page=100" % (repo, sha))
    if code != 0:
        return "unreadable", err.strip()
    ours = [status for status in json.loads(out or "[]")
            if status.get("context") == context
            and (status.get("creator") or {}).get("login") == app_login]
    if not ours:
        return "missing", "no %s status from %s" % (context, app_login)
    return str(ours[0].get("state", "missing")).lower(), str(ours[0].get("description") or "")


def drop(queue, numbers):
    kept = [line for line in queue.read_text().splitlines()
            if line.split("#", 1)[0].strip() not in numbers]
    queue.write_text("\n".join(kept) + ("\n" if kept else ""))


def run_one(repo, number, context, app_login, dry_run):
    pr, error = view(repo, number)
    if pr is None:
        return {"pr": number, "action": "error", "reason": error}
    result = {"pr": number, "action": "skipped", "head": pr.get("headRefOid"), "url": pr.get("url")}
    if pr.get("state") != "OPEN":
        return dict(result, action="closed" if pr.get("state") == "CLOSED" else "already-merged")
    if pr.get("isDraft"):
        return dict(result, reason="draft")
    state, detail = verifier_state(repo, pr["headRefOid"], context, app_login)
    result["verifier"] = state
    if state != "success":
        return dict(result, reason="verifier " + state + (": " + detail if detail else ""))
    if pr.get("mergeStateStatus") == "BEHIND":
        return dict(result, reason="behind the base; run ship-check fresh " + number)
    if pr.get("mergeStateStatus") == "DIRTY":
        return dict(result, reason="conflicts with the base")
    if dry_run:
        return dict(result, action="would-merge")
    code, out, err = gh("pr", "merge", number, "--repo", repo, "--merge",
                        "--match-head-commit", pr["headRefOid"])
    after, _ = view(repo, number)
    if after and after.get("state") == "MERGED":
        return dict(result, action="merged")
    detail = (err or out).strip().splitlines()
    return dict(result, action="refused", reason=detail[-1] if detail else "gh pr merge exited %d" % code)


def main(argv):
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--repo", default=os.environ.get("SHIP_REPO") or DEFAULT_REPO)
    parser.add_argument("--queue", type=Path)
    parser.add_argument("--label")
    parser.add_argument("--pr", action="append", default=[])
    parser.add_argument("--context", default=DEFAULT_CONTEXT)
    parser.add_argument("--app-login", default=DEFAULT_APP_LOGIN)
    parser.add_argument("--limit", type=int, default=50)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)

    repo = repo_name(args.repo)
    if not args.queue and not args.label and not args.pr:
        die("give --queue, --label or --pr")
    numbers = list(dict.fromkeys(args.pr + (queue_numbers(args.queue) if args.queue else [])
                                 + (labelled(repo, args.label, args.limit) if args.label else [])))
    numbers = numbers[:args.limit]

    results = []
    for number in numbers:
        if not re.fullmatch(r"[0-9]+", number):
            results.append({"pr": number, "action": "error", "reason": "not a PR number"})
            continue
        results.append(run_one(repo, number, args.context, args.app_login, args.dry_run))

    if args.queue and not args.dry_run:
        drop(args.queue, {r["pr"] for r in results
                          if r["action"] in ("merged", "already-merged", "closed")})
    counts = {}
    for result in results:
        counts[result["action"]] = counts.get(result["action"], 0) + 1
    print(json.dumps({"repo": repo, "context": args.context, "app": args.app_login,
                      "queue": str(args.queue) if args.queue else None,
                      "dry_run": args.dry_run, "results": results, "counts": counts}, indent=2))
    return 1 if counts.get("refused") or counts.get("error") else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
