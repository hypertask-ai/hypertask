#!/usr/bin/env bash
# runner-deliver <n>: type one message (stdin) into the live "RUNNER <n>" Claude session through tmux (YPER4-256).
# Falls back to the "INFRA MANAGER" session with a "No live Runner <n>:" prefix; if neither is live the message is
# queued in $STATE/runner-<n>.pending.jsonl for the next runner-pickup tick. Exit 0 delivered, 3 queued, 2 usage.
# Claude Code queues typed input while busy, so this works for idle and busy sessions. Text is sent literally (-l).
set -uo pipefail
STATE=${RUNNER_INBOX_DIR:-$HOME/.local/state/runner-inbox}
TMUX=${RUNNER_PICKUP_TMUX:-tmux}
SESSIONS=${RUNNER_PICKUP_SESSIONS_DIR:-$HOME/.claude/sessions}
MAXLEN=${RUNNER_DELIVER_MAXLEN:-3000}
# <target> is a runner number or a named slug. Slug table: "slug|session name|fall back to INFRA MANAGER (1/0)".
SLUGS='infra-manager|INFRA MANAGER|0
speed-runner|SPEED RUNNER|1'
n=${1:-}; fallback=1
if [[ $n =~ ^[1-9][0-9]*$ ]]; then session="RUNNER $n"
elif row=$(grep "^$n|" <<<"$SLUGS" 2>/dev/null) && [ -n "$n" ]; then IFS='|' read -r _ session fallback <<<"$row"
else echo 'usage: runner-deliver <runner number|infra-manager|speed-runner> < message' >&2; exit 2; fi

# Single literal line: control characters out, whitespace collapsed, capped.
text=$(head -c 20000 | tr '\000-\037\177' ' ' | tr -s ' ')
text=${text# }; text=${text% }
[ -n "$text" ] || exit 0
[ "${#text}" -le "$MAXLEN" ] || text="${text:0:$MAXLEN}..."

# Live claude pid of the session named $1 (user-given name, text after " | " ignored).
find_pid() {
  local f name pid
  for f in "$SESSIONS"/*.json; do
    [ -f "$f" ] || continue
    name=$(jq -r 'select(.nameSource == "user") | .name // empty' "$f" 2>/dev/null) || continue
    [ "${name%% | *}" = "$1" ] || continue
    pid=$(jq -r '.pid // empty' "$f" 2>/dev/null); [[ $pid =~ ^[0-9]+$ ]] || pid=$(basename "$f" .json)
    if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then echo "$pid"; return 0; fi
  done
  return 1
}
# tmux pane whose pane_pid is the claude pid or one of its ancestors.
find_pane() {
  local pid=$1 panes hit
  panes=$("$TMUX" list-panes -a -F '#{pane_id} #{pane_pid}' 2>/dev/null) || return 1
  while [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ]; do
    hit=$(awk -v p="$pid" '$2 == p {print $1; exit}' <<<"$panes")
    if [ -n "$hit" ]; then echo "$hit"; return 0; fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
  return 1
}
# Text plus Enter under a per-pane lock, so two writers never interleave their lines in one prompt.
send() {
  mkdir -p "$STATE" 2>/dev/null
  ( flock -w 10 9 || exit 1
    "$TMUX" send-keys -t "$1" -l "$2" >/dev/null 2>&1 && "$TMUX" send-keys -t "$1" Enter >/dev/null 2>&1 ) 9>"$STATE/pane-${1//[^A-Za-z0-9]/_}.lock"
}

pane=""; prefix=""
if [ "$session" != "INFRA MANAGER" ]; then
  if pid=$(find_pid "$session"); then pane=$(find_pane "$pid") || pane=""; fi
  if [ -n "$pane" ] && send "$pane" "$text"; then echo "delivered to $session"; exit 0; fi
  pane=""; prefix="No live ${session,,}: "; [[ $n =~ ^[1-9] ]] && prefix="No live Runner $n: "
fi
if [ "$fallback" = 1 ] || [ "$session" = "INFRA MANAGER" ]; then
  if pid=$(find_pid "INFRA MANAGER"); then pane=$(find_pane "$pid") || pane=""; fi
  if [ -n "$pane" ] && send "$pane" "$prefix$text"; then echo "delivered to INFRA MANAGER"; exit 0; fi
fi
# Queue under the per-target lock that runner-pickup also takes when it drains the file. Exit 3 only once the line is written.
line=$(jq -nc --arg t "$text" --argjson ts "$(date +%s)" '{ts:$ts, text:$t}') || exit 1
mkdir -p "$STATE" || exit 1
( flock -w 10 9 || exit 1; printf '%s\n' "$line" >> "$STATE/runner-$n.pending.jsonl" ) 9>"$STATE/runner-$n.queue.lock" || { echo "could not queue for $n" >&2; exit 1; }
echo "queued for $n"; exit 3
