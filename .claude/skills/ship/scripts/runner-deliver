#!/usr/bin/env bash
# runner-deliver <n>: hand one message (stdin) to the live "RUNNER <n>" Claude session (YPER4-256, YPER4-284).
# A session whose events hook is installed and enabled gets the message in its own inbox file
# ($STATE/<slot>.events.jsonl, slot runner-<n>, infra-manager or speed-runner); the hook (.claude/hooks/runner-inbox-stop.sh)
# hands it over as its own message between tool calls, at turn end, or by waking the idle session. Nothing is typed.
# Only a live session without the hook (its slot not listed in $STATE/events-hook.enabled, or no $STATE/<slot>.hook-alive
# naming its pid) still gets the old tmux typing, and every such use is logged to $STATE/typing-fallback.log.
# Falls back to the "INFRA MANAGER" session with a "No live Runner <n>:" prefix; if neither is live the message is
# queued in $STATE/runner-<n>.pending.jsonl for the next runner-pickup tick. Exit 0 delivered, 3 queued, 2 usage,
# 5 a hooked session's inbox could not be written (never typed; the event stays undelivered).
# $RUNNER_DELIVER_ID names the event: the same id never enters an inbox twice. Without it every call is a new event.
# A pane whose input box holds Valentin's half-typed text is never typed into: the message is queued and retried (YPER4-274).
set -uo pipefail
STATE=${RUNNER_INBOX_DIR:-$HOME/.local/state/runner-inbox}
TMUX=${RUNNER_PICKUP_TMUX:-tmux}
SESSIONS=${RUNNER_PICKUP_SESSIONS_DIR:-$HOME/.claude/sessions}
MAXLEN=${RUNNER_DELIVER_MAXLEN:-3000}
EVENT_ID=${RUNNER_DELIVER_ID:-}
FALLBACK_LOG=$STATE/typing-fallback.log
# <target> is a runner number or a named slug. Slug table: "slug|session name|fall back to INFRA MANAGER (1/0)".
SLUGS='infra-manager|INFRA MANAGER|0
speed-runner|SPEED RUNNER|1'
n=${1:-}; fallback=1
if [[ $n =~ ^[1-9][0-9]*$ ]]; then session="RUNNER $n"
elif row=$(grep "^$n|" <<<"$SLUGS" 2>/dev/null) && [ -n "$n" ]; then IFS='|' read -r _ session fallback <<<"$row"
else echo 'usage: runner-deliver <runner number|infra-manager|speed-runner> < message' >&2; exit 2; fi

# Single literal line: control characters out, whitespace collapsed, capped.
text=$(head -c 20000 | tr '\000-\037\177' ' ' | tr -s ' ')
text=${text# }; text=${text% }
[ -n "$text" ] || exit 0
[ "${#text}" -le "$MAXLEN" ] || text="${text:0:$MAXLEN}..."

# Live claude pid of the session named $1 (user-given name, text after " | " ignored).
find_pid() {
  local f name pid
  for f in "$SESSIONS"/*.json; do
    [ -f "$f" ] || continue
    name=$(jq -r 'select(.nameSource == "user") | .name // empty' "$f" 2>/dev/null) || continue
    [ "${name%% | *}" = "$1" ] || continue
    pid=$(jq -r '.pid // empty' "$f" 2>/dev/null); [[ $pid =~ ^[0-9]+$ ]] || pid=$(basename "$f" .json)
    if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then echo "$pid"; return 0; fi
  done
  return 1
}
# Inbox slot for a session name: RUNNER <n> -> runner-<n>, INFRA MANAGER -> infra-manager, SPEED RUNNER -> speed-runner.
slot_for() { case "$1" in "RUNNER "*) echo "runner-${1#RUNNER }" ;; *) local s=${1,,}; echo "${s// /-}" ;; esac; }
# True when the session with pid $2 runs the events hook: its slot is enabled and its hook-alive marker names that pid.
# Such a session is never typed into, waiter or not.
hook_alive() {
  local enabled=$STATE/events-hook.enabled mpid
  [ -f "$enabled" ] && grep -qxE "\*|$1" "$enabled" 2>/dev/null || return 1
  mpid=$(jq -r '.pid // empty' "$STATE/$1.hook-alive" 2>/dev/null) || return 1
  [ -n "$mpid" ] && [ "$mpid" = "$2" ]
}
# Logs (never types) when an event enters the inbox of session $1 (slot $2, pid $3) while no waiter holds its lock:
# it is handed over at that session's next prompt, tool call or turn end. The probe holds the lock for an instant only;
# a starting waiter waits 0.5 s for it.
no_waiter_log() {
  local lock=$STATE/$2.waiter.$3.lock
  if [ -e "$lock" ]; then ( flock -n 9 ) 9<"$lock" 2>/dev/null || return 0; fi
  printf '%s queued in the %s inbox with no live waiter: handed over at its next activity\n' "$(date -Is)" "$1" >> "$FALLBACK_LOG" 2>/dev/null
}
# Append {id, ts, text, delivered:false} to the slot's inbox under its lock unless that id is already there (temp file + rename).
inbox_add() {
  local slot=$1 msg=$2 f=$STATE/$1.events.jsonl id=$EVENT_ID line
  [ -n "$id" ] || id="gen:$(date +%s%N)-$$-$RANDOM"
  line=$(jq -nc --arg id "$id" --arg t "$msg" --argjson ts "$(date +%s)" '{id:$id, ts:$ts, text:$t, delivered:false}') || return 1
  mkdir -p "$STATE" || return 1
  ( flock -w 10 9 || exit 1
    if [ -f "$f" ] && jq -s -e --arg id "$id" 'any(.[]; .id == $id)' "$f" >/dev/null 2>&1; then exit 0; fi
    { cat "$f" 2>/dev/null; printf '%s\n' "$line"; } > "$f.tmp.$$" && mv "$f.tmp.$$" "$f" ) 9>"$STATE/$slot.events.lock"
}
# inbox_add with a short retry. A hooked session is never typed into: a final failure is logged and ends the run (exit 5).
inbox_add_or_die() {
  local _i
  for _i in 1 2 3; do inbox_add "$1" "$2" && return 0; sleep 0.3; done
  mkdir -p "$STATE" 2>/dev/null
  printf '%s could not write to the %s inbox: not typed, left undelivered for the pickup backstop\n' "$(date -Is)" "$1" >> "$FALLBACK_LOG" 2>/dev/null
  echo "could not write to the $1 inbox" >&2; exit 5
}
fallback_log() { mkdir -p "$STATE" 2>/dev/null; printf '%s typed into %s (pane %s): no events hook in that session\n' "$(date -Is)" "$1" "$2" >> "$FALLBACK_LOG" 2>/dev/null; }
# tmux pane whose pane_pid is the claude pid or one of its ancestors.
find_pane() {
  local pid=$1 panes hit
  panes=$("$TMUX" list-panes -a -F '#{pane_id} #{pane_pid}' 2>/dev/null) || return 1
  while [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ]; do
    hit=$(awk -v p="$pid" '$2 == p {print $1; exit}' <<<"$panes")
    if [ -n "$hit" ]; then echo "$hit"; return 0; fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
  return 1
}
# Prints the text typed in the pane's Claude Code input box (after the last "❯" prompt, up to the rule line below it).
# Dim text there is a placeholder or a suggestion, not typing, so it is dropped. Fails when no prompt is on screen
# (a dialog, a menu, an unreadable pane): such a pane is treated as busy, never typed into (YPER4-274).
typed_input() {
  "$TMUX" capture-pane -p -e -t "$1" 2>/dev/null | perl -CSD -e '
    my @l = split /\n/, do { local $/; <STDIN> } // ""; my $i; for (0..$#l) { $i = $_ if $l[$_] =~ /\x{276F}/ } exit 1 unless defined $i;
    my ($t, $end) = ("", 0);
    for my $j ($i + 1 .. $#l) { if ($l[$j] =~ /^(?:\e\[[0-9;]*m)*\x{2500}/) { $end = $j; last } }
    $t = join "\n", $end ? @l[$i .. $end - 1] : $l[$i];
    $t =~ s/^.*?\x{276F}//s; $t =~ s/\e\[2m.*?(?:\e\[(?:0|22)m|$)//mg; $t =~ s/\e\[[0-9;?]*[A-Za-z]//g; $t =~ s/[\s\x{a0}]+//g;
    print $t; exit 0'
}
# Text plus Enter under a per-pane lock, so two writers never interleave their lines in one prompt.
# Exit 4 when Valentin has text in the input box (or it cannot be read): his text stays untouched and the caller queues.
send() {
  mkdir -p "$STATE" 2>/dev/null
  ( flock -w 10 9 || exit 1
    typed=$(typed_input "$1") && [ -z "$typed" ] || exit 4
    "$TMUX" send-keys -t "$1" -l "$2" >/dev/null 2>&1 && "$TMUX" send-keys -t "$1" Enter >/dev/null 2>&1 ) 9>"$STATE/pane-${1//[^A-Za-z0-9]/_}.lock"
}
# Queue under the per-target lock that runner-pickup also takes when it drains the file. Exit 3 only once the line is written.
queue() {
  local line
  line=$(jq -nc --arg t "$text" --arg id "$EVENT_ID" --argjson ts "$(date +%s)" '{ts:$ts, text:$t} + (if $id == "" then {} else {id:$id} end)') || exit 1
  mkdir -p "$STATE" || exit 1
  ( flock -w 10 9 || exit 1; printf '%s\n' "$line" >> "$STATE/runner-$n.pending.jsonl" ) 9>"$STATE/runner-$n.queue.lock" || { echo "could not queue for $n" >&2; exit 1; }
  echo "queued for $n${1:+ ($1)}"; exit 3
}

pane=""; prefix=""
if [ "$session" != "INFRA MANAGER" ]; then
  if pid=$(find_pid "$session"); then
    slot=$(slot_for "$session")
    if hook_alive "$slot" "$pid"; then inbox_add_or_die "$slot" "$text"; no_waiter_log "$session" "$slot" "$pid"; echo "delivered to the $session inbox"; exit 0; fi
    pane=$(find_pane "$pid") || pane=""
  fi
  if [ -n "$pane" ]; then
    send "$pane" "$text"; rc=$?
    [ "$rc" = 0 ] && { fallback_log "$session" "$pane"; echo "delivered to $session"; exit 0; }
    [ "$rc" = 4 ] && queue "$session is typing"
  fi
  pane=""; prefix="No live ${session,,}: "; [[ $n =~ ^[1-9] ]] && prefix="No live Runner $n: "
fi
if [ "$fallback" = 1 ] || [ "$session" = "INFRA MANAGER" ]; then
  if pid=$(find_pid "INFRA MANAGER"); then
    if hook_alive infra-manager "$pid"; then inbox_add_or_die infra-manager "$prefix$text"; no_waiter_log "INFRA MANAGER" infra-manager "$pid"; echo "delivered to the INFRA MANAGER inbox"; exit 0; fi
    pane=$(find_pane "$pid") || pane=""
  fi
  if [ -n "$pane" ] && send "$pane" "$prefix$text"; then fallback_log "INFRA MANAGER" "$pane"; echo "delivered to INFRA MANAGER"; exit 0; fi
fi
queue
