#!/usr/bin/env python3
"""Plan runner work read-only by default; --go enables local claims and dispatch."""
import argparse
import fcntl
import html
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

SCRIPTS = Path(__file__).resolve().parent
STATE = Path.home() / ".local/state"
CLAIMS = STATE / "runner-queue/claims"
LOOP = STATE / "runner-loop"
OWNER = "HT Product Lead"
ACTIVE = {"In Progress", "AI Review", "QA"}
MAINTENANCE = ACTIVE | {"Valentin Review", "UX Sign-off"}
COLUMNS = ((15, "Backlog"), (15, "Bugs"), (15, "Todo"), (15, "Features"), (15, "Improvements"), (4060, "Backlog"))
ELIGIBLE = {f"RUNNER {n}" for n in range(1, 8)}
SPEED = "SPEED RUNNER"
SPEED_STATES = {"done", "idle", "waiting_valentin"}
PENDING_DELIVERY_TTL = 900
FAILED_DELIVERY_TTL = 3600
CLEAR_CONTEXT = 80_000
ALARM_CONTEXT = 150_000
ALARM_EVERY = 6 * 3600
SESSION_TAIL = 2 * 1024 * 1024
RESEARCH_EVERY = 6 * 3600
RESEARCH_PROMPT = ("/speed-analyst No free [SPEED] ticket is on the board. Read .claude/skills/speed-analyst/GOALS.md, "
                   "run the daily read, then either file and ship the biggest measured slow spot toward the next milestone "
                   "or run a research round and file its best experiment as a [SPEED] ticket. Never break behaviour: "
                   "identical output, tests and live QA before Done.")


def is_speed(task):
    labels = " ".join(str(l.get("name", l) if isinstance(l, dict) else l) for l in task.get("labels") or [])
    return "[speed]" in task["title"].casefold() or "speed" in labels.casefold()


def command(*args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=60)
    if result.returncode:
        raise RuntimeError(f"{args[0]} failed: {result.stderr.strip()}")
    return result.stdout


def pages(args, key, reads=None):
    items, cursor, seen = [], None, set()
    while True:
        if reads is not None:
            reads["task_pages" if key == "tasks" else "comment_pages"] += 1
        data = json.loads(command(*args, *(("--cursor", cursor) if cursor else ())))
        if data.get("success") is not True:
            raise ValueError(f"Unsuccessful {key} response")
        if not isinstance(data.get(key), list):
            raise ValueError(f"Invalid {key} page")
        if key == "comments" and not all(isinstance(c, dict) for c in data[key]):
            raise ValueError("Invalid comment entry")
        items.extend(data[key])
        cursor = data.get("nextCursor")
        if not cursor:
            # Comment pages can retain has_more=true even on the final page.
            if (data["total"] > len(items) if "total" in data else data.get("has_more")):
                raise ValueError(f"Incomplete {key} response without a cursor")
            return items
        if cursor in seen:
            raise ValueError(f"Repeated {key} cursor")
        seen.add(cursor)


SNAPSHOT_CANDIDATES = (SCRIPTS / "runner-snapshot", Path.home() / ".claude/skills/runners/scripts/runner-snapshot")


def snapshot_script():
    for candidate in SNAPSHOT_CANDIDATES:
        if candidate.is_file():
            return candidate
    raise RuntimeError("runner-snapshot not found in: " + ", ".join(map(str, SNAPSHOT_CANDIDATES)))


def snapshots():
    rows = [json.loads(line) for line in command(str(snapshot_script())).splitlines() if line.strip()]
    try:
        panes = command("tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{session_name}\t#{pane_title}")
    except RuntimeError as error:
        if not any(message in str(error) for message in ("no server running", "(No such file or directory)")):
            raise
        panes = ""
    by_pane = {row["pane"]: row for row in rows}
    for line in panes.splitlines():
        pane, session, title = line.split("\t", 2)
        if (re.match(r"^(hax-pool-|(?:ht-)?hax-runner-|tl-.*-hax(?:$|-))", session)
                or re.fullmatch(r"RUNNER [1-9][0-9]* hax", title)):
            by_pane[pane] = {"runner": f"HAX {session}", "pane": pane, "state": "busy"}
    return list(by_pane.values())


def read_boards(reads=None):
    return {project: pages(("hypertask", "tasks", "list", "--project", str(project),
                            "--limit", "500", "--json"), "tasks", reads)
            for project in (15, 4060)}


def read_comments(boards, cache=None, *, full_refresh=False, reads=None):
    comments, entries, seen = {}, {}, set()
    for project, tasks in boards.items():
        wanted = MAINTENANCE | {column for board, column in COLUMNS if board == project}
        for task in tasks:
            ticket = task["ticketNumber"]
            key = f"{project}:{ticket}"
            if task["section"] not in wanted or key in seen:
                continue
            seen.add(key)
            updated, count = task.get("updatedAt"), task.get("commentCount")
            metadata = (isinstance(updated, str) and bool(updated)
                        and type(count) is int and count >= 0)
            entry = (cache or {}).get(key)
            valid = (isinstance(entry, dict) and metadata
                     and entry.get("updatedAt") == updated and type(entry.get("commentCount")) is int
                     and entry.get("commentCount") == count
                     and isinstance(entry.get("comments"), list)
                     and all(isinstance(c, dict) for c in entry["comments"])
                     and len(entry["comments"]) >= count)
            if valid and not full_refresh:
                listed = entry["comments"]
                if reads is not None:
                    reads["cache_hits"] += 1
            else:
                listed = pages(("hypertask", "comment", "list", ticket,
                                "--limit", "50", "--json"), "comments", reads)
            # Counts may include hidden activities: use complete short lists, but always refetch them.
            if type(count) is int and count >= 0 and len(listed) < count:
                if reads is not None:
                    reads["uncacheable"] += 1
            else:
                entries[key] = {"updatedAt": updated, "commentCount": count, "comments": listed}
            comments[ticket] = [c for c in listed if c.get("type") != "activity"]
            offset, activity_ids = 0, set()
            while True:
                suffix = f"&offset={offset}" if offset else ""
                activity = json.loads(command("ht", "GET", f"/mcp/tasks/{ticket}/agent-activity?limit=100{suffix}"))
                if (activity.get("success") is not True or not isinstance(activity.get("activities"), list)
                        or len(activity["activities"]) > 100
                        or not all(isinstance(a, dict) and isinstance(a.get("id"), str)
                                   and isinstance(a.get("text"), str) and isinstance(a.get("createdAt"), str)
                                   and isinstance(a.get("agentName"), str) for a in activity["activities"])):
                    raise ValueError(f"Invalid agent activity for {ticket}")
                page_ids = {a["id"] for a in activity["activities"]}
                if len(page_ids) != len(activity["activities"]) or activity_ids.intersection(page_ids):
                    raise ValueError(f"Repeated agent activity for {ticket}; retry the scan")
                activity_ids.update(page_ids)
                comments[ticket].extend(dict(a, type="activity", agent={"displayName": a["agentName"]})
                                        for a in activity["activities"])
                if len(activity["activities"]) < 100:
                    break
                offset += len(activity["activities"])
    if cache is not None:
        cache.clear()
        cache.update(entries)
    return comments


def claims(comments):
    return [comment for comment in comments
            if "Claimed." in (comment.get("text") or comment.get("commentText") or "")]


def held_tickets(boards, comments, sections=ACTIVE):
    held = {}
    for tasks in boards.values():
        for task in tasks:
            ticket = task["ticketNumber"]
            if task["section"] not in sections:
                continue
            claimed = claims(comments[ticket])
            if claimed:
                newest = max(claimed, key=lambda c: (c["createdAt"],
                    (0, c["id"]) if type(c.get("id")) is int else (1, str(c.get("id", "")))))
                name = (newest.get("agent") or {}).get("displayName", "").casefold()
                held.setdefault(name, []).append(ticket)
    return held


def free_tickets(boards, comments, claim_dir):
    free = []
    for project, column in COLUMNS:
        for task in boards[project]:
            ticket = task["ticketNumber"]
            if task["section"] != column or "do not touch" in task["title"].casefold():
                continue
            assignees = task.get("assignees") or []
            if (claims(comments[ticket]) or task.get("agents")
                    or any(a.get("agent") for a in assignees)
                    or "abdul" in json.dumps(assignees, ensure_ascii=False).casefold()
                    or os.path.lexists(claim_dir / f"{ticket}.json")):
                continue
            free.append(ticket)
    priority_file = claim_dir.parent.parent / "runner-loop" / "priority.txt"
    first = priority_file.read_text().split() if priority_file.exists() else []
    return [t for t in first if t in free] + [t for t in free if t not in first]


def read_last(loop):
    path = loop / "last-dispatch.json"
    try:
        data = json.loads(path.read_text())
        if (not isinstance(data, dict) or
                any(type(value) not in (int, float) or not 0 <= value < float("inf")
                    for value in data.values())):
            raise ValueError("invalid dispatch timestamps")
        return data
    except FileNotFoundError:
        return {}
    except ValueError:
        print("runner-dispatch: malformed last-dispatch.json; using empty state", file=sys.stderr)
        return {}


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        temporary.write_text(json.dumps(data) + "\n")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def acquire_claim(ticket, row, claim_dir, now):
    claim_dir.mkdir(parents=True, exist_ok=True)
    target = claim_dir / f"{ticket}.json"
    temporary = claim_dir / f"{ticket}.json.tmp.{os.getpid()}"
    try:
        with temporary.open("x", encoding="utf-8") as stream:
            json.dump({"ticket": ticket, "pane": row["pane"], "runner": row["runner"],
                       "owner": OWNER, "at": datetime.fromtimestamp(now, timezone.utc).isoformat(),
                       "pending_until": now + PENDING_DELIVERY_TTL}, stream)
        try:
            os.link(temporary, target)
        except FileExistsError:
            return False
        return True
    finally:
        temporary.unlink(missing_ok=True)


def cleanup_claims(boards, claim_dir, now):
    done = {task["ticketNumber"] for tasks in boards.values() for task in tasks if task["section"] == "Done"}
    for path in claim_dir.glob("*.json"):
        try:
            data = json.loads(path.read_text())
        except (FileNotFoundError, ValueError):
            continue
        if not isinstance(data, dict):
            continue
        expires = data.get("failed_delivery_until", data.get("pending_until"))
        if data.get("owner") == OWNER and (path.stem in done or
                (type(expires) in (int, float) and expires <= now)):
            path.unlink()
            print(f"runner-dispatch: released claim {path.stem}", file=sys.stderr)


def timestamp(value):
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (AttributeError, TypeError, ValueError):
        return 0


def session_metrics(row, home=None):
    """Bound IO even for long-running sessions; missing tail evidence forbids clearing."""
    home = home or Path.home()
    sessions = []
    for path in (home / ".claude/sessions").glob("*.json"):
        try:
            data = json.loads(path.read_text())
            if (data.get("tmux", "").rsplit(".", 1)[-1] == row["pane"]
                    and data.get("name", "").split(" | ", 1)[0] == row["runner"]):
                sessions.append(data)
        except (OSError, ValueError, AttributeError):
            continue
    if len(sessions) != 1:
        return None
    session = sessions[0]
    try:
        sid, cwd, started = session["sessionId"], session["cwd"], session["startedAt"]
        if type(started) not in (int, float) or not 0 < started < float("inf"):
            return None
        unknown = {"session": sid, "context": None, "activity": 0,
                   "usage_at": 0, "cleared": 0, "started": started / 1000}
        if not re.fullmatch(r"[a-zA-Z0-9-]+", sid):
            return None
        project = re.sub(r"[^a-zA-Z0-9-]", "-", cwd)
        path = home / ".claude/projects" / project / f"{sid}.jsonl"
        try:
            with path.open("rb") as stream:
                stream.seek(0, 2)
                start = max(0, stream.tell() - SESSION_TAIL)
                stream.seek(start)
                if start:
                    stream.readline()  # Discard a possibly partial JSON record.
                lines = stream.read(SESSION_TAIL).decode("utf-8").splitlines()
        except (OSError, UnicodeError):
            return unknown
        context, activity, cleared, usage_at = None, 0, 0, 0
        comment_tools = set()
        for line in lines:
            try:
                event = json.loads(line)
            except ValueError:
                return unknown
            if event.get("isSidechain") or event.get("sessionId", sid) != sid:
                continue
            at = timestamp(event.get("timestamp"))
            if event.get("subtype") == "compact_boundary":
                context, usage_at = None, 0
            message = event.get("message") or {}
            content = message.get("content") or []
            if isinstance(content, str):
                if "<command-name>/clear</command-name>" in content:
                    cleared = at
                    context, usage_at, activity = None, 0, 0
                continue
            usage = message.get("usage")
            if event.get("type") == "assistant" and isinstance(usage, dict):
                fields = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")
                if all(type(usage.get(k, 0)) is int and usage.get(k, 0) >= 0 for k in fields):
                    context = sum(usage.get(k, 0) for k in fields)
                    usage_at = at
            for block in content:
                if block.get("type") == "tool_use":
                    # Only a standalone comment write is exempt, never a shell batch that
                    # might also change files. This lets a runner checkpoint several tickets.
                    name = block.get("name", "")
                    text = (block.get("input") or {}).get("command", "")
                    try:
                        words = shlex.split(text)
                        # Preserve quotes and tokenize bare characters so even --text="..."
                        # keeps quoted newlines/operators distinct from shell syntax.
                        shell = shlex.shlex(text, posix=False)
                        shell.wordchars, shell.whitespace, shell.commenters = "", " \t\r", ""
                        operators = any(token in ";&|<>()`\\\n"
                                        or (token.startswith('"') and re.search(r"`|\$\(", token))
                                        for token in shell)
                    except ValueError:
                        words = []
                    comment = (name == "Bash" and len(words) >= 4
                               and words[:3] in (["vcc", "comment", "add"],
                                                ["hypertask", "comment", "add"],
                                                ["vcc", "activity", "add"])
                               and not operators)
                    if comment:
                        comment_tools.add(block.get("id"))
                    else:
                        activity = max(activity, at)
                elif block.get("type") == "tool_result" and block.get("tool_use_id") not in comment_tools:
                    activity = max(activity, at)
        return {"session": sid, "context": context, "activity": activity,
                "usage_at": usage_at, "cleared": cleared,
                "started": started / 1000}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None


def current_checkpoint(ticket, runner, comments, since):
    # Explicit fields are a conservative proxy for recoverable state, not a claim or ledger mtime.
    candidates = [c for c in comments.get(ticket, []) if c.get("type") == "activity"
                  and (c.get("agent") or {}).get("displayName", "").casefold() == runner.casefold()]
    if not candidates:
        return False
    comment = max(candidates, key=lambda c: max(timestamp(c.get("createdAt")), timestamp(c.get("editedAt"))))
    at = max(timestamp(comment.get("createdAt")), timestamp(comment.get("editedAt")))
    if at <= since:
        return False
    text = comment.get("text") or comment.get("commentText") or ""
    text = re.sub(r"</(?:p|li|div|ul|ol)>|<br\s*/?>", "\n", text, flags=re.I)
    text = html.unescape(re.sub(r"<[^>]*>", "", text))
    fields = {}
    for key in ("next", "helpers", "branch/pr", "outputs"):
        match = re.search(r"(?:^|\n)[ \t]*" + re.escape(key) + r"[ \t]*:[ \t]*([^\n]+)", text, re.I)
        if match:
            fields[key] = match[1].strip()
    return (len(fields) == 4 and all(fields.values())
            and (fields["helpers"].casefold() == "none"
                 or bool(re.search(r"(?:^|\s)/[\w./-]+|\b[A-Z][A-Z0-9]*-\d+\b", fields["outputs"]))))


def queue_clear_alarm(state, runner, text, now, *, key=None, every=ALARM_EVERY):
    inbox = state / "runner-inbox"
    inbox.mkdir(parents=True, exist_ok=True)
    key = key or f"runner-clear:{runner}"
    ident = f"{key}:{int(now // every)}"
    path = inbox / "infra-manager.events.jsonl"
    with (inbox / "infra-manager.events.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        raw = path.read_text() if path.exists() else ""
        for line in raw.splitlines():
            event = json.loads(line)
            if (event.get("id", "").startswith(f"{key}:")
                    and type(event.get("ts")) in (int, float) and now - event["ts"] < every):
                return False
        temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
        try:
            event = {"id": ident, "ts": now, "text": text, "delivered": False}
            temporary.write_text(raw + json.dumps(event, separators=(",", ":")) + "\n")
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)
    return True


def live_claude(row):
    # Pane text and session files can outlive Claude; inspect the actual pane tree.
    try:
        panes = command("tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{pane_pid}")
        roots = [int(pid) for pane, pid in (line.split() for line in panes.splitlines())
                 if pane == row["pane"]]
        if len(roots) != 1:
            return False
        pending, seen = roots, set()
        root_args = ["-p", str(roots[0])]
        while pending:
            result = subprocess.run(
                ["ps", *root_args, "--ppid", ",".join(map(str, pending)), "-o", "pid=,ppid=,stat=,comm="],
                capture_output=True, text=True, timeout=15)
            # ps exits 1 when there are no remaining children.
            if result.returncode not in (0, 1) or (result.returncode == 1 and result.stderr):
                return False
            pending, root_args = [], []
            for line in result.stdout.splitlines():
                pid, parent, status, name = line.split(None, 3)
                pid = int(pid)
                if pid in seen:
                    continue
                seen.add(pid)
                if name == "claude" and status[0] not in "ZX":
                    return True
                if pid != roots[0]:
                    pending.append(pid)
        return False
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        return False


def maintain_runner(row, holding, comments, now, *, loop, state, allow_clear=True):
    if not (re.fullmatch(r"RUNNER [1-9][0-9]*", row["runner"]) or row["runner"] == SPEED):
        return False
    if not live_claude(row):
        return False
    metrics = session_metrics(row)
    if metrics is None:
        return False
    path = loop / "runner-clear.json"
    try:
        records = json.loads(path.read_text())
        if not isinstance(records, dict):
            raise ValueError("invalid clear state")
    except FileNotFoundError:
        records = {}
    except ValueError:
        # A lost throttle must not become an alarm storm or an unsafe clear.
        print("runner-dispatch: malformed runner-clear.json; maintenance skipped", file=sys.stderr)
        return False
    before = json.dumps(records)
    runner = row["runner"]
    record = records.setdefault(runner, {})
    if (not isinstance(record, dict)
            or any(not isinstance(record[k], str) for k in ("session", "reason") if k in record)
            or any(type(v) not in (int, float) or not 0 <= v < float("inf")
                   for k, v in record.items() if k not in {"session", "reason"}
                   and not (k == "context" and v is None))):
        print(f"runner-dispatch: malformed clear record {runner}; maintenance skipped", file=sys.stderr)
        return False
    # Session start is a conservative baseline, not a fabricated successful clear.
    record.setdefault("first_seen", min(now, metrics["started"]))
    context = metrics["context"]
    external_at = metrics["cleared"]
    session_changed = (record.get("session") is not None and record["session"] != metrics["session"])
    # Old numeric-only records still prove a restart if this session began after their baseline.
    legacy_restart = ("session" not in record and "reason" not in record
                      and metrics["started"] > record["first_seen"])
    if session_changed:
        # /clear can rotate the id without changing the process's registry start time.
        external_at = max(external_at, now)
    elif legacy_restart:
        external_at = max(external_at, min(now, metrics["started"]))
    if (record.get("session") == metrics["session"] and context is not None
            and record.get("context") is not None and context < record["context"] * 0.3
            and metrics["usage_at"] > record.get("usage_at", 0)):
        external_at = max(external_at, min(now, metrics["usage_at"]))
    if external_at > record.get("last_clear", 0):
        record.update(last_clear=external_at, reason="external")
        print(f"cleared {runner} reason=external context={context} last_clear={external_at}", file=sys.stderr)
    record.setdefault("last_clear", 0)
    # Keep the last known usage across an unreadable tail, but never across sessions.
    if (record.get("session") != metrics["session"]
            or (context is not None and metrics["usage_at"] > record.get("usage_at", 0))):
        record.update(context=context, usage_at=metrics["usage_at"])
    record["session"] = metrics["session"]
    last_clear = record["last_clear"]
    age = now - (last_clear or record["first_seen"])
    reasons = []
    if age >= ALARM_EVERY:
        reasons.append("no_clear_6h")
    if context is not None and context > ALARM_CONTEXT:
        reasons.append("context_150k")
    if reasons and now - record.get("last_alarm", 0) >= ALARM_EVERY:
        text = f"alarm {runner} reason={'+'.join(reasons)} context={context} last_clear={last_clear or 'never'}"
        queued = queue_clear_alarm(state, runner, text, now)
        record["last_alarm"] = now
        if queued:
            print(text, file=sys.stderr)
    if json.dumps(records) != before:
        write_json(path, records)
    if not allow_clear:
        return False
    trigger = "context_80k" if context is not None and context > CLEAR_CONTEXT else row["state"]
    if (row["state"] not in {"idle", "waiting_bg", "done", "waiting_valentin"}
            or row.get("input_box") not in {"empty", "dim"} or row.get("spinner")
            or context is None or context <= CLEAR_CONTEXT
            or not metrics["activity"] or metrics["usage_at"] <= last_clear
            or now - last_clear < 600
            or not all(current_checkpoint(t, runner, comments, max(metrics["activity"], last_clear))
                       for t in holding)):
        return False
    # Recheck the real typed-text guard immediately before sending, not just the tick snapshot.
    fresh = [r for r in snapshots() if r["pane"] == row["pane"] and r["runner"] == runner]
    if (len(fresh) != 1 or fresh[0]["state"] != row["state"]
            or fresh[0].get("input_box") not in {"empty", "dim"}
            or fresh[0].get("spinner") or os.getloadavg()[0] > 12):
        return False
    # Tool activity must also be unchanged since checkpoint evaluation.
    if not live_claude(row) or session_metrics(row) != metrics:
        return False
    resume = "resume: read your held tickets' latest comments and agent log: " + (", ".join(holding) or "none")
    command("tmux", "send-keys", "-t", row["pane"], "-l", "/clear")
    command("tmux", "send-keys", "-t", row["pane"], "Enter")
    record.update(last_clear=now, reason=trigger, context=None, usage_at=0)
    # The next sample establishes the post-clear baseline, not another external clear.
    record.pop("session", None)
    write_json(path, records)
    print(f"cleared {runner} reason={trigger} context={context} held={','.join(holding) or 'none'}", file=sys.stderr)
    time.sleep(3)
    fresh = [r for r in snapshots() if r["pane"] == row["pane"] and r["runner"] == runner]
    if (len(fresh) != 1 or fresh[0]["state"] not in {"idle", "waiting_bg", "done", "waiting_valentin"}
            or fresh[0].get("input_box") not in {"empty", "dim"} or fresh[0].get("spinner")):
        print(f"runner-dispatch: {runner} resume withheld: pane no longer safe", file=sys.stderr)
        return True
    send(row["pane"], resume)
    return True


def send(pane, text, claim_path=None):
    started = False
    try:
        command("tmux", "send-keys", "-t", pane, "-l", text)
        started = True
        time.sleep(1)
        command("tmux", "send-keys", "-t", pane, "Enter")
        if claim_path is not None:
            data = json.loads(claim_path.read_text())
            data.pop("pending_until", None)
            temporary = claim_path.with_name(f"{claim_path.name}.tmp.{os.getpid()}")
            try:
                temporary.write_text(json.dumps(data) + "\n")
                os.replace(temporary, claim_path)
            finally:
                temporary.unlink(missing_ok=True)
    except Exception as error:
        if claim_path is not None:
            if not started and isinstance(error, (RuntimeError, OSError)):
                claim_path.unlink()
                print(f"runner-dispatch: delivery not started, released {claim_path.stem}", file=sys.stderr)
            else:
                data = json.loads(claim_path.read_text())
                data["failed_delivery_until"] = time.time() + FAILED_DELIVERY_TTL
                temporary = claim_path.with_name(f"{claim_path.name}.tmp.{os.getpid()}")
                try:
                    temporary.write_text(json.dumps(data) + "\n")
                    os.replace(temporary, claim_path)
                finally:
                    temporary.unlink(missing_ok=True)
                print(f"runner-dispatch: delivery uncertain, retained {claim_path.stem} "
                      f"until {data['failed_delivery_until']}", file=sys.stderr)
        raise


def dispatch(rows, boards, comments, load, now, *, go=False, claim_dir=CLAIMS, loop=LOOP, state=STATE):
    held = held_tickets(boards, comments)
    maintenance_held = held_tickets(boards, comments, MAINTENANCE)
    last = read_last(loop)
    tasks = {task["ticketNumber"]: task for board in boards.values() for task in board}
    if go and load <= 12:
        cleanup_claims(boards, claim_dir, now)
    all_free = free_tickets(boards, comments, claim_dir)
    speed_free = [t for t in all_free if is_speed(tasks[t])]
    free = [t for t in all_free if t not in speed_free]
    output = []
    for row in rows:
        runner, pane = row["runner"], row["pane"]
        holding = held.get(runner.casefold(), [])
        result = dict(row, held=holding, ticket=None, action="planned")
        output.append(result)
        if go and load <= 12 and maintain_runner(row, maintenance_held.get(runner.casefold(), []),
                                               comments, now, loop=loop, state=state):
            result["action"] = "cleared"
            continue
        blocking = holding if row["state"] != "done" else []
        if runner == SPEED:
            if (load > 12 or row["state"] not in SPEED_STATES
                    or blocking or now - last.get(pane, 0) < 600):
                continue
            if speed_free:
                ticket = speed_free.pop(0)
            elif now - last.get("speed-research", 0) >= RESEARCH_EVERY:
                ticket = "research"
            else:
                continue
            if go:
                claim_path = claim_dir / f"{ticket}.json" if ticket != "research" else None
                if claim_path is not None and not acquire_claim(ticket, row, claim_dir, now):
                    continue
                try:
                    fresh = [r for r in snapshots() if r["pane"] == pane and r["runner"] == runner]
                    if (len(fresh) != 1 or fresh[0]["state"] not in SPEED_STATES
                            or (fresh[0]["state"] != "done" and holding) or os.getloadavg()[0] > 12):
                        if claim_path is not None:
                            claim_path.unlink()
                        if len(fresh) == 1:
                            result["state"] = fresh[0]["state"]
                        continue
                except Exception:
                    if claim_path is not None:
                        claim_path.unlink()
                    raise
                send(pane, RESEARCH_PROMPT if ticket == "research" else f"/ship {ticket}", claim_path)
                last[pane] = now
                if ticket == "research":
                    last["speed-research"] = now
                result["action"] = "sent"
            result["ticket"] = ticket
            if go and result["action"] == "sent":
                write_json(loop / "last-dispatch.json", last)
                with (loop / "dispatch.log").open("a", encoding="utf-8") as stream:
                    stream.write(json.dumps({"at": datetime.fromtimestamp(now, timezone.utc).isoformat(),
                                             "runner": runner, "pane": pane, "ticket": result["ticket"],
                                             "owner": OWNER}) + "\n")
            continue
        if (load > 12 or runner not in ELIGIBLE or row["state"] not in {"done", "idle"}
                or blocking or now - last.get(pane, 0) < 600):
            continue
        while free:
            ticket = free.pop(0)
            if go:
                if not acquire_claim(ticket, row, claim_dir, now):
                    continue
                try:
                    capture = command("tmux", "capture-pane", "-p", "-t", pane)
                    saved = re.findall(r"\bsave\s+(\d+(?:\.\d+)?)k\b", capture, re.IGNORECASE)
                    before = saved[-1] + "k" if saved else "unknown"
                    # Snapshot all panes because runner-snapshot has no pane filter.
                    fresh = [r for r in snapshots() if r["pane"] == pane and r["runner"] == runner]
                    if (len(fresh) != 1 or fresh[0]["state"] not in {"done", "idle"}
                            or (fresh[0]["state"] != "done" and holding) or os.getloadavg()[0] > 12):
                        (claim_dir / f"{ticket}.json").unlink()
                        free.insert(0, ticket)
                        if len(fresh) == 1:
                            result["state"] = fresh[0]["state"]
                        break
                except Exception:
                    (claim_dir / f"{ticket}.json").unlink()
                    raise
                at = time.time()
                send(pane, f"/ship {ticket}", claim_dir / f"{ticket}.json")
                last[pane] = at
                write_json(loop / "last-dispatch.json", last)
                with (state / "fresh-session-trial.log").open("a", encoding="utf-8") as stream:
                    stream.write(f"{datetime.fromtimestamp(at).strftime('%H:%M')} {runner} before={before} {ticket} auto\n")
                with (loop / "dispatch.log").open("a", encoding="utf-8") as stream:
                    stream.write(json.dumps({"at": datetime.fromtimestamp(at, timezone.utc).isoformat(),
                                             "runner": runner, "pane": pane, "ticket": ticket,
                                             "before": before, "owner": OWNER}) + "\n")
                result["action"] = "sent"
            result["ticket"] = ticket
            break
    return output


def run(go, *, cache_path, claim_dir=CLAIMS, loop=LOOP, state=STATE):
    reads = {"task_pages": 0, "comment_pages": 0, "cache_hits": 0, "uncacheable": 0}
    full_refresh, skipped = False, False
    try:
        load = os.getloadavg()[0]
        if load > 12:
            if go:
                for row in snapshots():
                    maintain_runner(row, [], {}, time.time(), loop=loop, state=state, allow_clear=False)
            skipped = True
            print(f"Load {load:.2f} > 12: dispatch skipped", file=sys.stderr)
            return
        try:
            cache = json.loads(cache_path.read_text())
        except (OSError, ValueError):
            cache = None
        if (not isinstance(cache, dict) or type(cache.get("schema")) is not int or cache["schema"] != 1
                or type(cache.get("runs")) is not int or cache["runs"] < 0
                or not isinstance(cache.get("entries"), dict)):
            cache = {"schema": 1, "runs": 0, "entries": {}}
            full_refresh = True
        full_refresh = full_refresh or (go and (cache["runs"] + 1) % 12 == 0)
        rows = snapshots()
        if not rows:
            reserve_path = state / "token-ladder/reserve.json"
            reserve = json.loads(reserve_path.read_text()) if reserve_path.exists() else {}
            if reserve.get("runners_paused") is not True:
                text = "runner-dispatch: 0 runner panes found"
                print(text, file=sys.stderr)
                if go:
                    queue_clear_alarm(state, "", text, time.time(), key="runner-zero", every=3600)
        if go:
            for row in rows:
                maintain_runner(row, [], {}, time.time(), loop=loop, state=state, allow_clear=False)
        boards = read_boards(reads)
        comments = read_comments(boards, cache["entries"], full_refresh=full_refresh, reads=reads)
        for row in dispatch(rows, boards, comments, load, time.time(), go=go,
                            claim_dir=claim_dir, loop=loop, state=state):
            print(f"{row['runner']} state={row['state']} held={','.join(row['held']) or 'none'} "
                  f"{row['action']}={row['ticket'] or 'none'}")
        if go:
            cache["runs"] += 1
            cache_path.parent.mkdir(parents=True, exist_ok=True)
            temporary = None
            try:
                with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=cache_path.parent,
                                                 prefix=cache_path.name + ".tmp.", delete=False) as stream:
                    temporary = Path(stream.name)
                    json.dump(cache, stream)
                    stream.write("\n")
                os.replace(temporary, cache_path)
            finally:
                if temporary is not None:
                    temporary.unlink(missing_ok=True)
    finally:
        print(f"runner-dispatch reads task_pages={reads['task_pages']} "
              f"comment_pages={reads['comment_pages']} cache_hits={reads['cache_hits']} "
              f"full_refresh={str(full_refresh).lower()} skipped={str(skipped).lower()} "
              f"uncacheable={reads['uncacheable']}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--go", action="store_true", help="Acquire claims, log and send keys (default: dry run)")
    args = parser.parse_args()
    command(str(Path.home() / ".local/bin/session-policy-guard"),
            "--project", str(Path.home() / "projects/hypertask"))
    if args.go:
        LOOP.mkdir(parents=True, exist_ok=True)
        # Serialize this dispatcher's panes as well as using shared per-ticket locks.
        with (LOOP / "dispatch.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            run(True, cache_path=LOOP / "comments-cache.json")
    else:
        run(False, cache_path=LOOP / "comments-cache.json")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"runner-dispatch: {error}", file=sys.stderr)
        sys.exit(1)
