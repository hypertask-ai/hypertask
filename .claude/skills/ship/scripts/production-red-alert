#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { execFileSync } = require('node:child_process');
const { createHash } = require('node:crypto');
const { PREFIX, owner, incidents, pages, logs } = require('./release-incidents.cjs');
const REPO = 'hypertask-ai/hypertask';
const STATE = path.join(os.homedir(), '.local/state/production-red-alert');
const CHECKOUT = path.join(os.homedir(), 'projects/ht-skills-live');
const SHA = /^[a-f0-9]{40}$/;
const QUERY = `query { repository(owner:"hypertask-ai",name:"hypertask") {
  ref(qualifiedName:"refs/heads/production") { target { ... on Commit { history(first:40) { nodes {
    oid committedDate messageHeadline parents(first:2) { nodes { oid } }
    associatedPullRequests(first:10) { nodes { number title mergedAt baseRefName mergeCommit { oid } } }
    statusCheckRollup { contexts(first:100) { pageInfo { hasNextPage } nodes {
      ... on CheckRun { name status conclusion completedAt startedAt detailsUrl databaseId }
      ... on StatusContext { context state createdAt targetUrl }
    } } }
  } } } } }
} }`;
function command(bin, args, options = {}) {
  try {
    return execFileSync(bin, args, { encoding: 'utf8', timeout: 25000,
      maxBuffer: 32 * 1024 * 1024, stdio: ['pipe', 'pipe', 'pipe'], ...options });
  } catch { throw new Error(`${bin} failed or timed out; no credentials or arguments logged`); }
}
function json(value) {
  const data = JSON.parse(value);
  if (data.success === false || data.errors) throw new Error('API refused request');
  return data;
}
function requiredChecks(file = path.join(__dirname, '../../../../docs/ci-policy.yml')) {
  const policy = fs.readFileSync(file, 'utf8');
  const match = policy.match(/^required_checks:\n(?:[ \t].*\n)*?  contexts: \[([^\]]+)\]/m);
  if (!match) throw new Error('Cannot read canonical required checks');
  return match[1].split(',').map(name => name.trim());
}
function snapshot(data) {
  const commits = data.data?.repository?.ref?.target?.history?.nodes;
  if (!Array.isArray(commits) || !commits.length) throw new Error('Missing production history');
  return commits.map(commit => {
    if (!SHA.test(commit.oid) || commit.statusCheckRollup?.contexts?.pageInfo?.hasNextPage) {
      throw new Error('Incomplete production checks');
    }
    const contexts = new Map();
    for (const row of commit.statusCheckRollup?.contexts?.nodes || []) {
      const name = row.name || row.context;
      const state = row.status && row.status !== 'COMPLETED' ? 'PENDING' : row.conclusion || row.state;
      const at = row.completedAt || row.startedAt || row.createdAt;
      const existing = contexts.get(name);
      if (!existing || Date.parse(at) > Date.parse(existing.at) ||
          (at === existing.at && (row.databaseId || 0) > (existing.id || 0))) {
        contexts.set(name, { name, state, at, url: row.detailsUrl || row.targetUrl, id: row.databaseId });
      }
    }
    return { sha: commit.oid, parents: commit.parents.nodes.map(parent => parent.oid),
      title: commit.messageHeadline, at: commit.committedDate, contexts: [...contexts.values()],
      prs: commit.associatedPullRequests.nodes.filter(pr => pr.baseRefName === 'production' && pr.mergeCommit?.oid === commit.oid) };
  });
}
function plan(commits, required, now = Date.now()) {
  if (!commits.length || commits.some(commit => !SHA.test(commit.sha))) throw new Error('Invalid production snapshot');
  const failures = [], recovered = [];
  for (const name of required) {
    const observations = commits.flatMap(commit => {
      const check = commit.contexts.find(row => row.name === name && Date.parse(row.at) <= now);
      return check && ['SUCCESS', 'FAILURE', 'ERROR', 'TIMED_OUT', 'ACTION_REQUIRED', 'STARTUP_FAILURE'].includes(check.state)
        ? [{ commit, check }] : [];
    });
    if (!observations.length) continue;
    if (observations[0].check.state === 'SUCCESS') { recovered.push(name); continue; }
    const boundary = observations.findIndex(row => row.check.state === 'SUCCESS');
    const first = observations[(boundary < 0 ? observations.length : boundary) - 1];
    const green = boundary < 0 ? null : observations[boundary];
    const culprit = green && first.commit.parents.length === 1 && first.commit.parents[0] === green.commit.sha ? first.commit.sha : null;
    failures.push({ name, first, green, culprit,
      key: `${first.commit.sha}:${green?.commit.sha || 'unknown'}` });
  }
  const head = commits[0];
  const mergedAt = Math.max(Date.parse(head.at), ...head.prs.map(pr => Date.parse(pr.mergedAt)));
  return { head: head.sha, failures, recovered, stalled: now - mergedAt >= 7200000, mergedAt };
}
function load(dir) {
  try { return json(fs.readFileSync(path.join(dir, 'state.json'), 'utf8')); }
  catch (error) { if (error.code === 'ENOENT') return { incidents: {}, stalls: {} }; throw error; }
}
function save(dir, state) {
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  const temporary = path.join(dir, `state.${process.pid}.tmp`);
  fs.writeFileSync(temporary, JSON.stringify(state, null, 2) + '\n', { mode: 0o600 });
  fs.renameSync(temporary, path.join(dir, 'state.json'));
}
const html = value => value.replace(/[&<>"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[char]));
const marker = key => `shared-check-incident:${createHash('sha256').update(key).digest('hex')}`;
function live(run = command) {
  let env;
  const auth = () => {
    if (!env) {
      const token = run('gh-app-token', []).trim();
      if (!token) throw new Error('Runner App token unavailable; no user-login fallback');
      env = { ...process.env, GH_TOKEN: token };
    }
    return env;
  };
  const gh = args => json(run('gh', args, { env: auth() }));
  const task = ticket => {
    const rows = json(run('hypertask', ['tasks', 'get', ticket, '--json'])).tasks;
    if (rows?.length !== 1) throw new Error('Cannot read incident ticket');
    return rows[0];
  };
  const write = args => {
    const [name] = run(path.join(os.homedir(), '.agents/skills/ship/scripts/ship-identity'), []).trim().split('\t');
    if (!name || name.startsWith('Valentins Claude Code')) throw new Error('Dedicated agent identity required');
    const output = run('vcc', args[0] === 'activity' ? args : [...args, '--json']);
    const result = args[0] === 'activity' ? {} : json(output);
    const ticket = args[1] === 'create' ? result.task?.ticketNumber || result.tasks?.[0]?.ticketNumber : args[2];
    if (ticket) task(ticket);
    return result;
  };
  return {
    collect: () => snapshot(gh(['api', 'graphql', '-f', `query=${QUERY}`])),
    task,
    logs: ticket => logs(ticket, run),
    open: () => incidents(pages('hypertask', ['tasks', 'list', '--project', '4060', '--status', 'Normal', '--limit', '500'], 'tasks', run)),
    write,
    recover: tag => {
      const found = pages('hypertask', ['tasks', 'list', '--project', '4060', '--search', tag, '--limit', '100'], 'tasks', run)
        .filter(row => row.description?.includes(tag));
      if (found.length !== 1) throw new Error('Creation outcome unknown; reconcile saved intent, do not create again');
      return found[0].ticketNumber;
    },
    propose: (failure, head, ticket) => propose(failure, head, ticket, { run, gh, env: auth() })
  };
}
function propose(failure, head, ticket, { run = command, gh, env, checkout = CHECKOUT, remote = `https://github.com/${REPO}.git` } = {}) {
  if (![failure.culprit, head].every(value => SHA.test(value || ''))) throw new Error('No unique adjacent culprit; manual investigation required');
  const branch = `shared-check-revert/${failure.culprit}`;
  const existing = gh(['api', `repos/${REPO}/pulls?state=all&head=hypertask-ai:${branch}`]);
  if (existing.length) return existing[0].html_url;
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'shared-check-revert-'));
  const git = (...args) => run('git', ['-C', dir, ...args], { env, timeout: 60000 }).trim();
  try {
    run('git', ['clone', '--no-checkout', '--shared', checkout, dir], { env, timeout: 60000 });
    git('remote', 'set-url', 'origin', remote);
    git('-c', 'credential.helper=!gh auth git-credential', 'fetch', '--no-tags', 'origin', 'production');
    if (git('rev-parse', 'FETCH_HEAD') !== head) throw new Error('Production moved; collect again before proposing');
    git('checkout', '--detach', head);
    git('merge-base', '--is-ancestor', failure.culprit, head);
    git('revert', '--no-commit', failure.culprit);
    const tree = git('write-tree');
    const prior = git('-c', 'credential.helper=!gh auth git-credential', 'ls-remote', 'origin', `refs/heads/${branch}`).split(/\s/)[0];
    if (prior) {
      git('-c', 'credential.helper=!gh auth git-credential', 'fetch', 'origin', branch);
      if (git('rev-parse', `${prior}^`) !== head || git('rev-parse', `${prior}^{tree}`) !== tree) throw new Error('Existing revert branch differs; owner must reconcile');
    } else {
      git('-c', 'user.name=hypertask-agents[bot]', '-c', 'user.email=hypertask-agents[bot]@users.noreply.github.com',
        'commit', '-m', `${ticket} [INFRA] Revert shared-check regression`, '-m', `This reverts commit ${failure.culprit}.`);
      const production = git('-c', 'credential.helper=!gh auth git-credential', 'ls-remote', 'origin', 'refs/heads/production').split(/\s/)[0];
      if (production !== head) throw new Error('Production moved; no branch pushed');
      git('-c', 'credential.helper=!gh auth git-credential', 'push', 'origin', `HEAD:refs/heads/${branch}`);
    }
    const body = `Summary for non-engineers\n\nPropose undoing the first red production commit.\n\nWhat went wrong\n${failure.name} first failed after ${failure.culprit}; its immediate parent passed.\n\nWhat changes\nOnly that commit is reverted on ${head}. Later changes remain.\n\nWhat you will see\nNo production change until required checks pass and the owner merges.\n\nWatch out for\nRun history identifies a candidate, not proof of causation. This proposal still needs CI and review. Auto-merge remains off.\n\nEvidence: ${failure.first.check.url}\nTicket: https://app.hypertask.ai/detail/project-4060/${ticket.split('-')[1]}\nNo user-visible change: incident tooling only.\n`;
    return gh(['api', '--method', 'POST', `repos/${REPO}/pulls`, '-f', `head=${branch}`, '-f', 'base=production',
      '-f', `title=${ticket} [INFRA] Revert shared-check regression`, '-f', `body=${body}`]).html_url;
  } finally { fs.rmSync(dir, { recursive: true, force: true }); }
}
async function tick({ dir = STATE, api = live(), now = Date.now(), required = requiredChecks(), dryRun = false } = {}) {
  const state = load(dir);
  if (!state.incidents) state.incidents = {};
  if (!state.stalls) state.stalls = {};
  if (!dryRun && state.until > now) return { action: 'backoff' };
  try {
    const p = plan(await api.collect(), required, now);
    if (dryRun) return { dryRun: true, ...p };
    const persist = () => save(dir, state);
    const open = api.open();
    for (const failure of p.failures) {
      let key = failure.key;
      if (state.incidents[key]?.closed) key += `:${failure.first.check.at}`;
      let entry = state.incidents[key];
      if (!entry && !failure.green) {
        entry = Object.values(state.incidents).find(value => !value.closed && value.checks.includes(failure.name));
      }
      if (!entry) {
        entry = state.incidents[key] = { marker: marker(key), checks: [failure.name], head: p.head };
        const matched = open.find(task => task.description?.includes(entry.marker));
        if (matched) entry.ticket = matched.ticketNumber;
        persist();
        if (!entry.ticket) {
          const result = api.write(['task', 'create', '--project', '4060', '--section', 'In Progress', '--priority', 'urgent', '--labels', 'Infra',
            '--title', `${PREFIX}: ${failure.name}`, '--description',
            `Blocked on the live incident claimant. No new tickets until recovery.\nFirst red: ${failure.first.check.url}\nCandidate: ${failure.culprit || 'unknown; missing or non-adjacent green boundary'}\nLast green: ${failure.green?.check.url || 'not present in bounded history'}\n${entry.marker}`]);
          entry.ticket = result.task?.ticketNumber || result.tasks?.[0]?.ticketNumber;
          if (!/^YPER4-\d+$/.test(entry.ticket || '')) throw new Error('Creation receipt missing; reconcile intent');
          persist();
        }
      } else if (!entry.ticket) { entry.ticket = api.recover(entry.marker); persist(); }
      entry.checks = [...new Set([...entry.checks, failure.name])]; persist();
      const claimed = owner(api.logs(entry.ticket), now);
      if (!entry.blockedOn || entry.blockedOn !== (claimed?.id || 'HT Product Lead')) {
        if (entry.blocking) throw new Error('Blocker comment outcome unknown; reconcile intent');
        entry.blocking = true; persist();
        api.write(['comment', 'add', entry.ticket, '--text', claimed
          ? `<p>Blocked on <span data-type="mention" class="mention" data-id="${html(claimed.name)}" data-label="agent-${html(claimed.id)}">${html(claimed.name)}</span>. Live claim owns this incident. Revert first; keep every check.</p>`
          : '<p>Blocked on <span data-type="mention" class="mention" data-id="HT Product Lead" data-label="agent-9b0f3a93-5e88-4093-b558-cad1c229bc51">HT Product Lead</span>. No live claimant. Assignments and manager comments cannot override claims. Claim this incident before taking new work.</p>']);
        entry.blockedOn = claimed?.id || 'HT Product Lead'; entry.blocking = false; persist();
      }
      if (!entry.proposal && !entry.proposalError) {
        try { entry.proposal = api.propose(failure, p.head, entry.ticket); }
        catch (error) { entry.proposalError = error.message; }
        persist();
      }
      if (entry.proposal && !entry.linked) {
        api.write(['task', 'update', entry.ticket, '--pull-request', entry.proposal]);
        entry.linked = true; persist();
      }
      if (entry.proposalError && !entry.errorNotified) {
        if (entry.notifyingError) throw new Error('Proposal error notification outcome unknown; reconcile intent');
        entry.notifyingError = true; persist();
        api.write(['comment', 'add', entry.ticket, '--text',
          `<p>Blocked on <span data-type="mention" class="mention" data-id="HT Product Lead" data-label="agent-9b0f3a93-5e88-4093-b558-cad1c229bc51">HT Product Lead</span>. Revert proposal failed. Reconcile before retry.</p>`]);
        entry.errorNotified = true; entry.notifyingError = false; persist();
      }
    }
    for (const entry of Object.values(state.incidents)) {
      if (!entry.closed && entry.checks.every(check => p.recovered.includes(check)) && entry.ticket) {
        if (entry.closing) throw new Error('Recovery activity outcome unknown; reconcile intent');
        entry.closing = true; persist();
        api.write(['activity', 'add', entry.ticket, `Required check green on production ${p.head}. Owner must verify live and close the incident before ticket picking resumes.`]);
        entry.closed = true; entry.closing = false; persist();
      }
    }
    if (p.stalled) {
      let stall = state.stalls[p.head];
      if (!stall) {
        stall = state.stalls[p.head] = { marker: marker(`stall:${p.head}`) }; persist();
        const result = api.write(['task', 'create', '--project', '4060', '--section', 'In Progress', '--priority', 'high', '--labels', 'Infra',
          '--title', 'Shipping stalled: no production merge for two hours', '--description',
          `Blocked on HT Product Lead. Last production merge: ${new Date(p.mergedAt).toISOString()}.\nProduction: https://github.com/${REPO}/commit/${p.head}\n${stall.marker}`]);
        stall.ticket = result.task?.ticketNumber || result.tasks?.[0]?.ticketNumber;
        if (!/^YPER4-\d+$/.test(stall.ticket || '')) throw new Error('Stall receipt missing; reconcile intent');
        persist();
      } else if (!stall.ticket) { stall.ticket = api.recover(stall.marker); persist(); }
      if (!stall.notified) {
        if (stall.notifying) throw new Error('Stall comment outcome unknown; reconcile intent');
        stall.notifying = true; persist();
        api.write(['comment', 'add', stall.ticket, '--text', '<p>Blocked on <span data-type="mention" class="mention" data-id="HT Product Lead" data-label="agent-9b0f3a93-5e88-4093-b558-cad1c229bc51">HT Product Lead</span>. No production merge for two hours. Restore shipping before taking more work.</p>']);
        stall.notified = true; stall.notifying = false; persist();
      }
    }
    state.fails = 0; state.until = 0; persist();
    return { action: p.failures.length ? 'incident' : 'green', incidents: p.failures.map(row => row.key), stalled: p.stalled };
  } catch (error) {
    state.fails = Math.min((state.fails || 0) + 1, 10);
    state.until = now + Math.min(300000 * 2 ** state.fails, 3600000);
    if (!dryRun) save(dir, state);
    throw error;
  }
}
function units(lib, session = process.env.SHIP_SESSION_NAME) {
  if (!/^[A-Za-z][A-Za-z0-9 -]+$/.test(session || '')) throw new Error('Dedicated agent session required');
  if (/[\n\r"%]/.test(lib + os.homedir())) throw new Error('Unsupported systemd path');
  return {
    service: `[Unit]\nDescription=Stop shipping on shared required check incidents\n[Service]\nType=oneshot\nWorkingDirectory=%h\nEnvironment="PATH=${os.homedir()}/.local/bin:/usr/local/bin:/usr/bin:/bin"\nEnvironment="SHIP_SESSION_NAME=${session}"\nExecStart=/usr/bin/nice -n 19 "${lib}/production-red-alert"\nTimeoutStartSec=240\nUMask=0077\n`,
    timer: '[Unit]\nDescription=Check required production checks every five minutes\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=5min\n[Install]\nWantedBy=timers.target\n'
  };
}
function install() {
  const [session] = command(path.join(os.homedir(), '.agents/skills/ship/scripts/ship-identity'), []).trim().split('\t');
  if (session !== process.env.SHIP_SESSION_NAME || session === 'Valentins Claude Code') throw new Error('Dedicated agent identity required');
  const lib = path.join(os.homedir(), '.local/lib/hypertask/production-red-alert');
  const unitDir = path.join(os.homedir(), '.config/systemd/user');
  fs.mkdirSync(lib, { recursive: true }); fs.mkdirSync(unitDir, { recursive: true });
  for (const file of ['production-red-alert', 'release-incidents.cjs', 'user-unit-check']) {
    fs.copyFileSync(path.join(__dirname, file), path.join(lib, file)); fs.chmodSync(path.join(lib, file), 0o755);
  }
  fs.copyFileSync(path.join(__dirname, '../../../../docs/ci-policy.yml'), path.join(lib, 'ci-policy.yml'));
  const u = units(lib);
  fs.writeFileSync(path.join(unitDir, 'production-red-alert.service'), u.service);
  fs.writeFileSync(path.join(unitDir, 'production-red-alert.timer'), u.timer);
  command(path.join(lib, 'user-unit-check'), [path.join(unitDir, 'production-red-alert.service'), path.join(unitDir, 'production-red-alert.timer')]);
  command('systemctl', ['--user', 'daemon-reload']);
  command('systemctl', ['--user', 'enable', '--now', 'production-red-alert.timer']);
}
async function main(args) {
  if (args[0] === 'install' && args.length === 1) return install();
  const dryRun = args.length === 1 && args[0] === '--dry-run';
  if (args.length && !dryRun) throw new Error('usage: production-red-alert [--dry-run] | install');
  if (!dryRun && !process.env.PRODUCTION_RED_ALERT_LOCKED) {
    fs.mkdirSync(STATE, { recursive: true, mode: 0o700 });
    return process.stdout.write(command('flock', ['-n', path.join(STATE, 'tick.lock'), process.execPath, __filename], {
      timeout: 240000, env: { ...process.env, PRODUCTION_RED_ALERT_LOCKED: '1' }
    }));
  }
  const policy = fs.existsSync(path.join(__dirname, 'ci-policy.yml')) ? path.join(__dirname, 'ci-policy.yml') : undefined;
  console.log(JSON.stringify(await tick({ dryRun, required: requiredChecks(policy) }), null, 2));
}
module.exports = { requiredChecks, snapshot, plan, live, propose, tick, units, main };
if (require.main === module) main(process.argv.slice(2)).catch(error => { console.error(`production-red-alert: ${error.message}`); process.exitCode = 1; });
