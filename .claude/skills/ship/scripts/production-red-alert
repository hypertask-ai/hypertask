#!/usr/bin/env node
// One free, agent-owned alert per production-red streak and failing-file set.
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { execFileSync } = require('node:child_process');
const { createHash } = require('node:crypto');
const REPO = 'hypertask-ai/hypertask';
const IDENTITY = 'INFRA MANAGER';
const UUID = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i;
const STATE = path.join(os.homedir(), '.local/state/production-red-alert');

function command(bin, args, options = {}) {
  try {
    return execFileSync(bin, args, { encoding: 'utf8', timeout: 25000,
      maxBuffer: 32 * 1024 * 1024, stdio: ['pipe', 'pipe', 'pipe'], ...options });
  } catch {
    // Never echo command arguments: vcc descriptions and credential-handling tools are not diagnostics.
    throw new Error(`${bin} failed or timed out; retry after backoff`);
  }
}
function json(text) {
  const value = JSON.parse(text);
  if (value.success === false) throw new Error('API returned success=false');
  return value;
}
function agent(task) {
  const agents = new Map((task.assignees || []).filter(a => UUID.test(a.agent?.id || ''))
    .map(a => [a.agent.id, { id: a.agent.id, name: a.agent.displayName }]));
  if (agents.size !== 1) throw new Error('Chosen PR ticket must have exactly one assigned agent; refusing a human or ambiguous fixer');
  return [...agents.values()][0];
}
function identity(run = command) {
  const helper = path.join(os.homedir(), '.agents/skills/ship/scripts/ship-identity');
  const expected = path.join(os.homedir(), '.config/hypertask-agents/credentials/sessions/infra-manager-agent-token');
  const [name, tokenPath] = run(helper, [], { env: { ...process.env, SHIP_SESSION_NAME: IDENTITY } }).trim().split('\t');
  if (name !== IDENTITY || tokenPath !== expected || !fs.statSync(expected).isFile() || fs.statSync(expected).size === 0) {
    throw new Error('INFRA MANAGER session credential unavailable; refusing the Valentin fallback');
  }
  return { name, credentialPath: expected };
}
function live(run = command, repoDir = process.cwd()) {
  const api = route => json(run('gh', ['api', '-X', 'GET', `repos/${REPO}/${route}`]));
  const git = args => run('git', ['-C', repoDir, ...args]).trim();
  const jobs = id => {
    const all = [];
    for (let page = 1; ; page++) {
      const rows = api(`actions/runs/${id}/jobs?per_page=100&page=${page}`).jobs;
      if (!Array.isArray(rows)) throw new Error('Unreadable CI jobs');
      all.push(...rows);
      if (rows.length < 100) break;
    }
    return all.filter(j => j.name === 'ci-tests').sort((a, b) => b.id - a.id)[0];
  };
  return {
    async collect(runId) {
      const target = runId ? api(`actions/runs/${runId}`) : null;
      if (target && (target.name !== 'CI Tests' || target.head_branch !== 'production' || target.status !== 'completed')) {
        throw new Error('--run must be a completed production CI Tests run');
      }
      let red, firstRed, green;
      for (let page = 1; !green; page++) {
        const route = target ? `actions/workflows/${target.workflow_id}/runs` : 'actions/workflows/ci-tests.yml/runs';
        const rows = api(`${route}?branch=production&status=completed&per_page=100&page=${page}${target ? `&created=<=${target.created_at}` : ''}`).workflow_runs;
        if (!Array.isArray(rows)) throw new Error('Unreadable production runs');
        if (!rows.length) break;
        for (const r of rows.sort((a, b) => b.id - a.id)) {
          if (r.name !== 'CI Tests' || r.head_branch !== 'production' || r.status !== 'completed' ||
              r.conclusion === 'cancelled' || (target && r.id > target.id)) continue;
          const job = jobs(r.id);
          if (!job || job.status !== 'completed') throw new Error(`Missing completed ci-tests job for run ${r.id}`);
          if (!red) {
            if (job.conclusion !== 'failure') return { status: job.conclusion, run: r };
            red = { ...r, job }; firstRed = r;
          } else if (job.conclusion === 'success') { green = r; break; }
          else if (job.conclusion === 'failure') firstRed = r;
        }
      }
      if (!red) return { status: 'none' };
      if (!green) throw new Error('No last green production run found; refusing an incomplete PR range');
      const failures = json(run('python3', [path.join(__dirname, 'ci-test-failures.py'), '--json'], {
        input: run('gh', ['api', '-X', 'GET', `repos/${REPO}/actions/jobs/${red.job.id}/logs`])
      }));
      if (!failures.length) throw new Error('Failed ci-tests log names no failing test file; refusing to guess');
      for (const sha of [green.head_sha, red.head_sha, firstRed.head_sha]) {
        if (!/^[0-9a-f]{40}$/.test(sha)) throw new Error('Invalid CI commit SHA');
      }
      git(['merge-base', '--is-ancestor', red.head_sha, 'origin/production']);
      git(['merge-base', '--is-ancestor', green.head_sha, red.head_sha]);
      const commits = git(['log', '--first-parent', '--format=%H\t%s', `${green.head_sha}..${red.head_sha}`]);
      const prs = [];
      for (const line of commits.split('\n').filter(Boolean)) {
        const [sha, title] = line.split('\t');
        const number = title.match(/\(#(\d+)\)$/)?.[1];
        if (!number) throw new Error(`Non-squash commit ${sha} in production range; refusing to omit it`);
        const files = [];
        for (let page = 1; ; page++) {
          const rows = api(`pulls/${number}/files?per_page=100&page=${page}`);
          if (!Array.isArray(rows)) throw new Error('Unreadable PR files');
          files.push(...rows.flatMap(f => [f.filename, f.previous_filename].filter(Boolean)));
          if (rows.length < 100) break;
          if (page >= 30) throw new Error('GitHub PR file limit reached; refusing a partial range');
        }
        prs.push({ number: Number(number), title: title.replace(/ \(#\d+\)$/, ''),
          url: `https://github.com/${REPO}/pull/${number}`, files });
      }
      return { status: 'failure', run: red, firstRed, green, failures, prs };
    },
    task(ticket) {
      const tasks = json(run('hypertask', ['tasks', 'get', ticket, '--json'])).tasks;
      if (tasks?.length !== 1) throw new Error(`Cannot read chosen PR ticket ${ticket}`);
      return tasks[0];
    },
    identity: () => identity(run),
    write(args) {
      return run('vcc', args, { env: { ...process.env, SHIP_SESSION_NAME: IDENTITY } });
    },
    recover(title, marker) {
      const rows = json(run('hypertask', ['tasks', 'list', '--project', '4060', '--search', title, '--limit', '100', '--json'])).tasks;
      if (!Array.isArray(rows) || rows.length >= 100) throw new Error('Cannot safely reconcile alert creation');
      const matches = rows.filter(t => t.title === title).map(t => this.task(t.ticketNumber))
        .filter(t => t.description?.includes(marker));
      if (matches.length !== 1) throw new Error('Alert creation outcome unknown; reconcile the saved intent manually before retrying (no duplicate created)');
      return matches[0].ticketNumber;
    }
  };
}
async function plan(data, api) {
  if (data.status !== 'failure') return { action: data.status === 'success' ? 'green' : 'none', run: data.run };
  const files = [...new Set(data.failures.map(f => f.file))].sort();
  const touched = data.prs.find(pr => pr.files.some(f => files.includes(f)));
  const chosen = touched || data.prs[0];
  if (!chosen) throw new Error('Red range contains no PR; refusing to invent a fixer');
  const ticket = chosen.title.match(/^((?:HTPR|YPER4|HYFA)-\d+)\b/)?.[1];
  if (!ticket) throw new Error('Chosen PR title has no recognized ticket prefix');
  const fixer = agent(await api.task(ticket));
  const key = `${data.firstRed.head_sha}:${files.join(',')}`;
  const marker = `production-red-alert:${createHash('sha256').update(key).digest('hex')}`;
  const why = touched ? `PR #${chosen.number} is the newest PR in this range that changed a failing test file.`
    : `No PR in this range changed a failing test file, so PR #${chosen.number}, the newest PR, owns the fix.`;
  const description = [
    'Production tests are failing. One agent owns this fix so runners do not duplicate the work.', '',
    'Failing tests (first error for each file):', ...data.failures.map(f => `- ${f.file}: ${f.error}`), '',
    `Red run: ${data.run.html_url}`, `Last green run: ${data.green.html_url}`, '',
    'PRs merged since the last green run (newest first):', ...data.prs.map(pr => `- #${pr.number} ${pr.title} ${pr.url}`), '',
    `Fixer: ${fixer.name} (${fixer.id}), the agent assigned to ${ticket}. ${why}`, '', marker
  ].join('\n');
  return { action: 'alert', key, marker, firstRed: data.firstRed.head_sha, run: data.run,
    green: data.green, failures: data.failures, prs: data.prs, chosenPR: chosen.number, fixer, why,
    title: `Production red: ${data.failures[0].file}`, description, project: 4060, section: 'In Progress' };
}
function load(dir) {
  try { return json(fs.readFileSync(path.join(dir, 'state.json'), 'utf8')); }
  catch (e) { if (e.code === 'ENOENT') return { alerts: {}, fails: 0, until: 0 }; throw e; }
}
function save(dir, state) {
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  const tmp = path.join(dir, `state.${process.pid}.tmp`);
  fs.writeFileSync(tmp, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(tmp, path.join(dir, 'state.json'));
}
async function apply(p, state, api, persist) {
  if (p.action === 'green') {
    for (const a of Object.values(state.alerts)) {
      if (a.closed || a.runId > p.run.id) continue;
      if (!a.ticket) { a.ticket = api.recover(a.title, a.marker); persist(); }
      // Ambiguous activity writes are not retried: retain the intent for operator reconciliation.
      if (a.closing) throw new Error('Recovery note outcome unknown; reconcile saved closing intent manually');
      a.closing = true; persist();
      api.write(['activity', 'add', a.ticket, `Production green again: ${p.run.html_url} (${a.marker}).`]);
      a.closed = true; a.closing = false; persist();
    }
    return;
  }
  if (p.action !== 'alert') return;
  await apply({ action: 'green', run: p.green }, state, api, persist);
  let a = state.alerts[p.key];
  if (a?.closed || a?.assigned) return;
  if (!a) {
    // Save an intent before the non-idempotent create. An interrupted create is reconciled, never blindly repeated.
    a = state.alerts[p.key] = { title: p.title, marker: p.marker, firstRed: p.firstRed, runId: p.run.id, fixer: p.fixer };
    persist();
    const result = json(api.write(['task', 'create', '--project', '4060', '--section', 'In Progress',
      '--title', p.title, '--description', p.description, '--json']));
    if (result.success !== true) throw new Error('Create returned no success receipt; reconcile saved intent');
    a.ticket = result.task?.ticketNumber || result.tasks?.[0]?.ticketNumber;
    if (!/^YPER4-\d+$/.test(a.ticket || '')) throw new Error('Create returned no alert ticket reference; reconcile saved intent');
    persist();
  } else if (!a.ticket) { a.ticket = api.recover(a.title, a.marker); persist(); }
  if (!UUID.test(a.fixer.id)) throw new Error('Refusing non-agent assignment');
  if (json(api.write(['task', 'assign', a.ticket, '--assignee', a.fixer.id, '--json'])).success !== true) {
    throw new Error('Assignment returned no success receipt');
  }
  a.assigned = true; persist();
}
async function tick({ dryRun = false, runId, dir = STATE, api = live(), now = Math.floor(Date.now() / 1000) } = {}) {
  const state = load(dir);
  if (!dryRun && state.until > now) return { action: 'backoff', until: state.until };
  try {
    const p = await plan(await api.collect(runId), api);
    if (dryRun) {
      let writer;
      try { writer = api.identity(); } catch { writer = { name: IDENTITY, refused: 'Session credential unavailable; writes refused (no Valentin fallback)' }; }
      return { dryRun: true, identity: writer, ...p, alreadyAlerted: p.key ? !!state.alerts[p.key] : false };
    }
    api.identity();
    await apply(p, state, api, () => save(dir, state));
    state.fails = 0; state.until = 0; save(dir, state);
    return { action: p.action, key: p.key };
  } catch (e) {
    if (!dryRun) {
      state.fails = Math.min((state.fails || 0) + 1, 10);
      state.until = now + Math.min(300 * 2 ** state.fails, 3600); save(dir, state);
    }
    throw e;
  }
}
function units(lib, repoDir) {
  if (/[\n\r"%]/.test(lib + repoDir)) throw new Error('Unsupported systemd path');
  return {
    service: `[Unit]\nDescription=One assigned fixer for production-red tests\n[Service]\nType=oneshot\nWorkingDirectory="${repoDir}"\nEnvironment="PATH=${os.homedir()}/.local/bin:/usr/local/bin:/usr/bin:/bin"\nExecStart=/usr/bin/nice -n 19 "${lib}/production-red-alert"\nTimeoutStartSec=240\nUMask=0077\n`,
    timer: '[Unit]\nDescription=Check production CI every five minutes\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=5min\n[Install]\nWantedBy=timers.target\n'
  };
}
function install(repoDir = process.cwd()) {
  identity();
  command('git', ['-C', repoDir, 'rev-parse', '--verify', 'origin/production']);
  const lib = path.join(os.homedir(), '.local/lib/hypertask/production-red-alert');
  const unitDir = path.join(os.homedir(), '.config/systemd/user');
  for (const dir of [lib, unitDir, STATE]) fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  for (const file of ['production-red-alert', 'ci-test-failures.py']) {
    fs.copyFileSync(path.join(__dirname, file), path.join(lib, file)); fs.chmodSync(path.join(lib, file), 0o755);
  }
  const u = units(lib, path.resolve(repoDir));
  fs.writeFileSync(path.join(unitDir, 'production-red-alert.service'), u.service);
  fs.writeFileSync(path.join(unitDir, 'production-red-alert.timer'), u.timer);
  command('systemctl', ['--user', 'daemon-reload']);
  command('systemctl', ['--user', 'enable', '--now', 'production-red-alert.timer']);
  console.log('production-red-alert: installed production-red-alert.timer (5 minutes, error backoff to 1 hour)');
}
async function main(args) {
  if (args[0] === 'install' && args.length === 1) return install();
  let dryRun = false, runId;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--dry-run') dryRun = true;
    else if (args[i] === '--run' && /^\d+$/.test(args[i + 1] || '')) runId = args[++i];
    else throw new Error('usage: production-red-alert [--dry-run] [--run ID] | install');
  }
  if (runId && !dryRun) throw new Error('--run is replay-only; add --dry-run');
  // Timer and manual writes take the same lock before reading state; dry-run never creates a lock.
  if (!dryRun && !process.env.PRODUCTION_RED_ALERT_LOCKED) {
    fs.mkdirSync(STATE, { recursive: true, mode: 0o700 });
    return process.stdout.write(command('flock', ['-n', path.join(STATE, 'tick.lock'), process.execPath, __filename], {
      env: { ...process.env, PRODUCTION_RED_ALERT_LOCKED: '1' }
    }));
  }
  console.log(JSON.stringify(await tick({ dryRun, runId }), null, 2));
}
module.exports = { agent, identity, live, plan, apply, tick, units, install, main };
if (require.main === module) main(process.argv.slice(2)).catch(e => { console.error(`production-red-alert: ${e.message}`); process.exitCode = 1; });
