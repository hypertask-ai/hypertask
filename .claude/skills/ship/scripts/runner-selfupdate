#!/usr/bin/env bash
# runner-selfupdate: refresh installed runner code from production, or install its five-minute timer.
set -euo pipefail
LIVE=${RUNNER_SELFUPDATE_LIVE:-$HOME/projects/ht-skills-live}
LIB=${RUNNER_SELFUPDATE_LIB:-$HOME/.local/lib/hypertask/runner-pickup}
UNITS=${RUNNER_PICKUP_UNIT_DIR:-$HOME/.config/systemd/user}
STATE=${RUNNER_SELFUPDATE_STATE:-$HOME/.local/state/runner-selfupdate}
SYSTEMCTL=${RUNNER_SELFUPDATE_SYSTEMCTL:-systemctl}
GIT=${RUNNER_SELFUPDATE_GIT:-git}
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
sha=unknown
backup=
restarted=0
log() { printf 'runner-selfupdate: %s\n' "$*" >&2; }

alert() {
  local reason=$1 text=$2 deliver=$LIB/runner-deliver id rc=0
  id=runner-selfupdate-$reason-${sha:0:12}
  log "$text ($sha); old version still running"
  [ ! -e "$STATE/$id" ] || return 0
  [ -x "$deliver" ] || deliver=$LIVE/.claude/skills/ship/scripts/runner-deliver
  printf '%s\n' "$text ($sha); old version still running" |
    RUNNER_DELIVER_ID=$id "$deliver" ht-product-lead >/dev/null || rc=$?
  # Exit 3 means queued for the next live session, not a failed alert.
  if [ "$rc" = 0 ] || [ "$rc" = 3 ]; then touch "$STATE/$id"; fi
}

install_timer() {
  local repo
  repo=$(cd "$HERE/../../.." && pwd)
  mkdir -p "$UNITS"
  install -m 0644 "$repo/systemd/runner-selfupdate.service" "$repo/systemd/runner-selfupdate.timer" "$UNITS/"
  "$SYSTEMCTL" --user daemon-reload
  "$SYSTEMCTL" --user enable --now runner-selfupdate.timer
}

run() {
  local scripts source changed=0 webhook_changed=0 enabled n dirty i
  local shell_files=(runner-pickup runner-deliver runner-chat-reply ship-identity)
  local unit_files=(runner-pickup@.service runner-pickup@.timer runner-webhook.service runner-selfupdate.service runner-selfupdate.timer)
  local sources=() targets=()
  mkdir -p "$STATE"
  exec 9>"$STATE/update.lock"
  flock -n 9 || return 0
  sha=$("$GIT" -C "$LIVE" rev-parse HEAD 2>/dev/null) || sha=unknown
  if ! "$GIT" -C "$LIVE" fetch -q origin production; then
    alert fetch 'Could not fetch the merged runner update'; return 1
  fi
  sha=$("$GIT" -C "$LIVE" rev-parse origin/production) || { alert checkout 'Could not identify production'; return 1; }
  if ! "$GIT" -C "$LIVE" checkout -q --detach origin/production ||
    [ "$("$GIT" -C "$LIVE" rev-parse HEAD)" != "$sha" ]; then
    alert checkout 'Runner checkout is not the merged production version'; return 1
  fi
  # A detached production HEAD can still carry local edits that must not be installed.
  dirty=$("$GIT" -C "$LIVE" status --porcelain -- .claude/skills/ship/scripts .claude/hooks/runner-inbox-stop.sh .claude/systemd) || {
    alert checkout 'Could not verify the production runner sources'; return 1;
  }
  if [ -n "$dirty" ]; then alert checkout 'Runner sources have unmerged local changes'; return 1; fi
  scripts=$LIVE/.claude/skills/ship/scripts
  for source in "${shell_files[@]}" runner-webhook; do
    sources+=("$scripts/$source"); targets+=("$LIB/$source")
  done
  sources+=("$LIVE/.claude/hooks/runner-inbox-stop.sh"); targets+=("$LIB/runner-inbox-stop.sh")
  for source in "${unit_files[@]}"; do
    sources+=("$LIVE/.claude/systemd/$source"); targets+=("$UNITS/$source")
  done
  sources+=("$LIVE/.claude/systemd/agent-events-port.conf"); targets+=("$UNITS/agent-events.service.d/port.conf")
  for i in "${!sources[@]}"; do
    cmp -s "${sources[$i]}" "${targets[$i]}" || changed=1
  done
  [ "$changed" = 1 ] || return 0
  cmp -s "$scripts/runner-webhook" "$LIB/runner-webhook" &&
    cmp -s "$LIVE/.claude/systemd/runner-webhook.service" "$UNITS/runner-webhook.service" || webhook_changed=1
  for source in "${shell_files[@]}"; do
    if ! bash -n "$scripts/$source"; then alert syntax 'Runner update contains invalid shell code'; return 1; fi
  done
  if ! bash -n "$LIVE/.claude/hooks/runner-inbox-stop.sh" ||
    ! python3 - "$scripts/runner-webhook" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
compile(path.read_bytes(), str(path), 'exec')
PY
  then alert syntax 'Runner update contains invalid hook or webhook code'; return 1; fi
  if ! enabled=$("$SYSTEMCTL" --user list-unit-files 'runner-pickup@*.timer' --state=enabled --no-legend --no-pager); then
    alert runners 'Could not find enabled runner timers'; return 1
  fi
  n=$(awk '$1 ~ /^runner-pickup@[1-9][0-9]*\.timer$/ && $2 == "enabled" {sub(/^runner-pickup@/, "", $1); sub(/\.timer$/, "", $1); print $1}' <<<"$enabled" | sort -n | head -1)
  [ -n "$n" ] || return 0
  if ! backup=$(mktemp -d); then alert backup 'Could not create a backup of the running version'; return 1; fi
  trap 'rm -rf "$backup"' EXIT
  if ! backup_files; then alert backup 'Could not back up the running version'; return 1; fi
  if ! install_files "$n"; then rollback; alert install 'Runner installation failed'; return 1; fi
  if [ "$webhook_changed" = 1 ]; then
    restarted=1
    if ! "$SYSTEMCTL" --user restart runner-webhook.service ||
      ! "$SYSTEMCTL" --user is-active --quiet runner-webhook.service; then
      rollback; alert webhook 'Updated webhook did not start'; return 1
    fi
  fi
  log "installed production $sha"
}

backup_files() {
  local i
  if [ -e "$LIB" ]; then cp -a "$LIB" "$backup/lib" || return 1; fi
  mkdir -p "$backup/units" || return 1
  for i in "${!targets[@]}"; do
    [[ ${targets[$i]} == "$UNITS/"* ]] || continue
    if [ -e "${targets[$i]}" ]; then cp -a "${targets[$i]}" "$backup/units/$i" || return 1; fi
  done
}

install_files() (
  # runner-pickup has literal systemctl calls and a fixed lib path. Redirect both without changing that installer.
  systemctl() { command "$RUNNER_SELFUPDATE_SYSTEMCTL" "$@"; }
  install() {
    local args=("$@") last=$(( $# - 1 ))
    if [ "${args[$last]%/}" = "$HOME/.local/lib/hypertask/runner-pickup" ]; then
      mkdir -p "$RUNNER_SELFUPDATE_LIB" || exit 1
      args[last]=$RUNNER_SELFUPDATE_LIB/
    fi
    command install "${args[@]}" || exit 1
  }
  export -f systemctl install
  export RUNNER_SELFUPDATE_SYSTEMCTL=$SYSTEMCTL RUNNER_SELFUPDATE_LIB=$LIB RUNNER_PICKUP_UNIT_DIR=$UNITS
  "$scripts/runner-pickup" install "$1" >/dev/null || exit 1
  "$scripts/runner-pickup" install-webhook >/dev/null || exit 1
  install -m 0644 "$LIVE/.claude/systemd/runner-selfupdate.service" "$LIVE/.claude/systemd/runner-selfupdate.timer" "$UNITS/"
  systemctl --user daemon-reload
)

rollback() {
  local i failed=0
  rm -rf "$LIB" || failed=1
  if [ -e "$backup/lib" ]; then cp -a "$backup/lib" "$LIB" || failed=1; fi
  for i in "${!targets[@]}"; do
    [[ ${targets[$i]} == "$UNITS/"* ]] || continue
    if [ -e "$backup/units/$i" ]; then
      cp -a "$backup/units/$i" "${targets[$i]}" || failed=1
    else
      rm -f "${targets[$i]}" || failed=1
    fi
  done
  "$SYSTEMCTL" --user daemon-reload || failed=1
  if [ "$restarted" = 1 ]; then
    "$SYSTEMCTL" --user restart runner-webhook.service &&
      "$SYSTEMCTL" --user is-active --quiet runner-webhook.service || failed=1
  fi
  [ "$failed" = 0 ] || log 'rollback needs attention; could not fully restore the running version'
}

case "${1:-}" in
  run) run ;;
  install) install_timer ;;
  *) echo 'usage: runner-selfupdate run | install' >&2; exit 2 ;;
esac
