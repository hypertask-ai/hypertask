#!/usr/bin/env bash
# ci-wait: wait for a PR's checks without polling GitHub (YPER4-881).
# GitHub's repo webhook reaches runner-webhook (POST /github/notify), which rewrites
# $GH_NOTIFY_DIR/<owner>__<repo>/<branch>.json whenever a workflow finishes or the PR closes.
# ci-wait blocks on that file's mtime (a local stat every few seconds, no network) and reads the checks
# with one gh call only after a change, at most once per CI_WAIT_GAP seconds, plus a slow fallback read
# every CI_WAIT_FALLBACK seconds (never under 600) in case an event is lost.
# Usage: ci-wait <pr-number> [--repo OWNER/REPO] [--timeout SECONDS] --head SHA
# Exit: 0 all checks passed or the PR merged, 1 a check failed or the PR closed unmerged, 2 timed out, 3 usage or gh error.
set -uo pipefail
usage() { echo "usage: ci-wait <pr-number> [--repo OWNER/REPO] [--timeout SECONDS] --head SHA" >&2; exit 3; }
pr=${1:-}; [[ $pr =~ ^[0-9]+$ ]] || usage; shift
repo="" timeout=5400 head=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo=${2:-}; [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || usage; shift 2 || usage ;;
    --timeout) timeout=${2:-}; shift 2 || usage ;;
    --head) head=${2:-}; [[ $head =~ ^[0-9a-fA-F]{40}$ ]] || usage; head=${head,,}; shift 2 || usage ;;
    *) usage ;;
  esac
done
[[ $timeout =~ ^[0-9]+$ && -n $head ]] || usage
if [ -z "$repo" ]; then
  url=$(git remote get-url origin 2>/dev/null || true)
  repo=$(sed -E 's#^(https://github\.com/|git@github\.com:)##; s#\.git$##' <<<"$url")
fi
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || repo=hypertask-ai/hypertask
GH=${CI_WAIT_GH:-gh}
DIR=${GH_NOTIFY_DIR:-$HOME/.local/state/gh-notify}
TICK=${CI_WAIT_TICK:-5}
GAP=${CI_WAIT_GAP:-300}
FALLBACK=${CI_WAIT_FALLBACK:-600}
[ "$FALLBACK" -ge 600 ] 2>/dev/null || FALLBACK=600

initial=$("$GH" pr view "$pr" --repo "$repo" --json headRefName 2>/dev/null) || { echo "ci-wait: cannot read PR $pr in $repo" >&2; exit 3; }
branch=$(jq -r '.headRefName // empty' <<<"$initial")
[ -n "$branch" ] || { echo "ci-wait: PR $pr has no head branch" >&2; exit 3; }
key() { LC_ALL=C sed -E 's/[^A-Za-z0-9._-]/_/g' <<<"$1" | cut -c1-200; }
state="$DIR/$(key "${repo/\//__}")/$(key "$branch").json"
mkdir -p "$DIR/waiters"
printf '%s %s\n' "$repo" "$branch" > "$DIR/waiters/$$"
trap 'rm -f "$DIR/waiters/$$"' EXIT
trap 'exit 2' INT TERM

# inode + nanosecond mtime: runner-webhook replaces the file atomically, so every event gives a new inode.
mtime() { stat -c '%i %y' "$state" 2>/dev/null || echo 0; }
verdict() {
  jq -er --arg head "$head" '
    if (.errors // [] | length) > 0 then error("GraphQL errors")
    elif .data.repository.pullRequest.state == "MERGED" then "merged"
    elif .data.repository.pullRequest.state == "CLOSED" then "closed"
    elif .data.repository.pullRequest.state != "OPEN" then error("missing PR state")
    elif ((.data.repository.pullRequest.headRefOid // "") | ascii_downcase) != $head
      or ((.data.repository.object.oid // "") | ascii_downcase) != $head then "pending"
    else .data.repository.object.statusCheckRollup.contexts as $ctx
      | if ($ctx.nodes | type) != "array" or $ctx.pageInfo.hasNextPage != false or ($ctx.nodes | length) == 0
        or any($ctx.nodes[]; if .name? != null then (.status == null or (.status == "COMPLETED" and .conclusion == null)) else (.context == null or .state == null) end) then "pending"
        else
      def risk:
        if .st == "COMPLETED" and (.s | IN("SUCCESS", "NEUTRAL", "SKIPPED", "PENDING", "EXPECTED", "QUEUED", "IN_PROGRESS", "") | not) then 2
        elif .st != "COMPLETED" or (.s | IN("SUCCESS", "NEUTRAL", "SKIPPED") | not) then 1
        else 0 end;
      [ $ctx.nodes[] |
        {
          n: (.name // .context // "?"),
          s: ((.conclusion // .state // "") | ascii_upcase),
          st: ((.status // "COMPLETED") | ascii_upcase),
          t: (if .__typename == "StatusContext" then .createdAt else .startedAt end // ""),
          action: ((.detailsUrl // "") |
            (capture("/actions/runs/(?<run>[0-9]+)/job/(?<job>[0-9]+)")? |
              {run: (.run | tonumber), job: (.job | tonumber)}) // null),
          identity: [.__typename, (.name // .context // "?"), (.checkSuite.workflowRun.workflow.name // "")]
        }
      ]
      | group_by(.identity)
      | map(
          (map(select(.action != null)) |
            if length > 0 then [max_by([.action.run, .action.job, .t, risk])] else [] end)
          + (map(select(.action == null)) |
            map(select(.t == "" or .t == "0001-01-01T00:00:00Z"))
            + (map(select(.t != "" and .t != "0001-01-01T00:00:00Z")) |
              if length > 0 then [max_by([.t, risk])] else [] end))
        )
      | (add // []) as $c
        | ([$c[] | select(.st == "COMPLETED" and (.s | IN("SUCCESS", "NEUTRAL", "SKIPPED", "PENDING", "EXPECTED", "QUEUED", "IN_PROGRESS", "") | not)) | "\(.n) (\(.s | ascii_downcase))"]) as $f
        | if ($f | length) > 0 then "fail " + ($f | join(", "))
          elif any($c[]; .st != "COMPLETED" or (.s | IN("SUCCESS", "NEUTRAL", "SKIPPED") | not)) then "pending"
          else "pass" end
        end
    end'
}
check() {
  local json
  json=$("$GH" api graphql -f query='query($owner:String!, $repo:String!, $pr:Int!, $head:GitObjectID!) {
    repository(owner:$owner, name:$repo) {
      pullRequest(number:$pr) { state headRefOid }
      object(oid:$head) { ... on Commit { oid statusCheckRollup { contexts(first:100) {
        nodes { __typename ... on CheckRun { name status conclusion startedAt detailsUrl checkSuite { workflowRun { workflow { name } } } } ... on StatusContext { context state createdAt } }
        pageInfo { hasNextPage }
      } } } }
    }
  }' -f owner="${repo%/*}" -f repo="${repo#*/}" -F pr="$pr" -f head="$head" 2>/dev/null) || return 1
  verdict <<<"$json"
}

start=$(date +%s) last_check=0 seen=$(mtime) calls=0
while :; do
  now=$(date +%s)
  cur=$(mtime)
  if [ "$last_check" = 0 ] || { [ "$cur" != "$seen" ] && [ $((now - last_check)) -ge "$GAP" ]; } || [ $((now - last_check)) -ge "$FALLBACK" ]; then
    seen=$cur last_check=$now calls=$((calls + 1))
    if verdict=$(check); then
      case "$verdict" in
        pass) echo "ci-wait: PR $pr ($repo) all checks passed after $(( (now - start) / 60 )) min, $calls gh reads"; exit 0 ;;
        merged) echo "ci-wait: PR $pr ($repo) is merged"; exit 0 ;;
        closed) echo "ci-wait: PR $pr ($repo) was closed without merging"; exit 1 ;;
        fail*) echo "ci-wait: PR $pr ($repo) failed: ${verdict#fail }"; exit 1 ;;
      esac
    else
      echo "ci-wait: gh read failed; next try on the next notify or in $FALLBACK s" >&2
    fi
  fi
  [ $((now - start)) -lt "$timeout" ] || { echo "ci-wait: PR $pr ($repo) still pending after $timeout s"; exit 2; }
  sleep "$TICK"
done
