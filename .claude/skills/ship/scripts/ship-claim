#!/usr/bin/env bash
# ship-claim: the whole claim step, with a race check (YPER4-264).
#   ship-claim <TICKET> ["<resume command>"]            claim, re-read the comments, step back if another runner claimed first
#   ship-claim decide <CLAIM_ID> <comments.json> [idle-ids] [assigned-ids] [self-resume]   pure decision from a saved comments read (tests use this)
#   ship-claim hold <TICKET>                            read-only: would unfinished work, the queue brake or infra first refuse this claim?
# Exit codes: 0 we hold the claim, 3 STEP BACK (another runner claimed first: do not start work), 2 error,
#   4 HOLD (this RUNNER n has open PRs or unfinished merged work: finish it, claim nothing new; or, for an app
#   ticket, the PR queue is full (more than QUEUE_MAX open non-draft PRs: infra only) or a free Fleet Infra ticket waits).
# Winner: the earliest "Claimed." comment by createdAt; equal times go to the lower comment id, then log ids.
# Ownership is the claim id in the comment text, not the agent name: the harness session id, or the
# last word of the resume command when the harness gives none. Assignment is never
# consulted (a claimer may have posted but not assigned yet). A competing claim older than 6 h
# before ours is ignored only when its agent has no ticket activity in the last 6 h (`vcc activity
# last`); if that read fails the old claim counts. Losing to the same agent identity (another
# session) never unassigns, because that would remove the winner.
# A claim also stops counting (YPER4-269) when (a) its agent is no longer assigned to the ticket (read once
# with `hypertask tasks get`; skipped if that read fails, if no agent is assigned, or if the claim is within
# 5 min of ours, because a claimer may not have assigned itself yet), or (b) the same agent later posted a
# comment whose visible text starts with Handing over / Handed over / Stepping back / Released / Unclaimed.
# A claim whose claim id starts with "-" (a flag recorded as the id, e.g. "[--resume]") names no session and never counts.
# Resume command: 2nd argument (or --resume <cmd>), else SHIP_CLAIM_RESUME, else CLAUDE_CODE_SESSION_ID, else CODEX_SESSION_ID / CODEX_THREAD_ID.
# Env overrides for tests: SHIP_CLAIM_VCC, SHIP_CLAIM_HYPERTASK, SHIP_CLAIM_RESUME.
set -uo pipefail

# decide <claim-id> <comments.json> [idle-ids] [assigned-ids] [self-resume]
# Prints "WIN", "NOOURS" or "LOSE<TAB>name<TAB>agent id<TAB>old(0|1)<TAB>same-agent(0|1)".
# idle-ids-file: agent ids (one per line) with no recent activity; their claims older than 6 h are ignored.
# assigned-ids-file: agent ids (one per line) now assigned; empty or missing = unknown, rule (a) is skipped.
decide() {
  local idle=${3:-/dev/null} asg=${4:-/dev/null} self=${5:-}
  jq -r --arg rid "$1" --arg self "$self" --rawfile idle "$idle" --rawfile asg "$asg" '
    def txt: ((.text // .commentText // "") | gsub("<[^>]*>"; " "));
    def key: (.agent.id // .agent_id // .agent.displayName // .agent_display_name // "");
    def name: (.agent.displayName // .agent_display_name // key | tostring);
    def at: [(.createdAt // ""), ((.id // 0) | (tonumber? // .) | if type == "number" then [0, .] else [1, tostring] end)];
    def secs: (.createdAt | sub("\\.[0-9]+"; "") | fromdateiso8601);
    def sess: (txt as $t | ($t | capture("[Cc]laim id:[[:space:]]*\\[(?<s>[^\\]]+)\\]").s?)
      // ($t | capture("[Cc]laim id:[[:space:]]*(?<s>[^[:space:]<.,]+)").s?)
      // ($t | capture("resume[[:space:]]+(?<s>[^[:space:]]+)").s?) // "");
    def legacy: ((txt | test("[Cc]laim id:")) | not);
    def resume: (txt as $t | ($t | capture("[Rr]esume( this [Cc]laude session)?:[[:space:]]*(?<r>[^<]*)").r?) // "");
    def ours: (sess == $rid) or ($self != "" and legacy and (txt | contains($self)));
    def norm: (gsub("[[:space:]]+"; " ") | sub("^ "; "") | sub(" $"; ""));
    def retires($k; $r): (sess != "" and sess == ($k | sess))
      or ((legacy or ($k | legacy))
        and ((($r | norm) as $rn | $rn != "" and (((($k | txt) | norm)) | contains($rn)))));
    def handover: (txt | sub("^[[:space:]]+"; "") | test("^(Handing over|Handed over|Stepping back|Released|Unclaimed)"; "i"));
    ($idle | split("\n") | map(select(. != ""))) as $idle
    | ($asg | split("\n") | map(select(. != ""))) as $asg
    | [(.comments[], (.activities[]? | {id, createdAt, text, agent: {id: .agentId, displayName: .agentName}})) | select(key != "")] as $c
    | [$c[] | select(txt | test("Stepping back"))] as $back
    | [$c[] | select(handover)] as $gone
    | ([$c[] | select(ours) | secs] | min // 0) as $mine
    | [$c[] | select(txt | contains("Claimed.")) | select(sess | startswith("-") | not)
        | . as $k | select(([$back[] | select(retires($k; resume) and at > ($k | at))] | length) == 0)
        | select(([$gone[] | select(key == ($k | key) and ((legacy and resume == "") or retires($k; resume))
              and at > ($k | at))] | length) == 0)
        | select(($asg | length) == 0 or ($asg | index($k | key)) or (($k | secs) > $mine - 300))] as $claims
    | [$claims[] | select(ours)] as $ours
    | if ($ours | length) == 0 then "NOOURS"
      else ($ours | sort_by(at) | first) as $me
        | ([$claims[] | select((ours | not)
              and at < ($me | at)
              and ((($me | secs) - secs) <= 21600 or (key as $k | $idle | index($k) | not)))]
            | sort_by(at) | first // null) as $other
        | if $other == null then "WIN"
          else "LOSE\t" + ($other | name) + "\t" + ($other | key) + "\t"
            + (if (($me | secs) - ($other | secs)) > 21600 then "1" else "0" end) + "\t"
            + (if ($other | key) == ($me | key) then "1" else "0" end)
          end
      end' "$2"
}

QUEUE_MAX=20  # queue brake: above this many open non-draft PRs, RUNNER n may claim YPER4 (Fleet Infra) tickets only

# Infra first (Valentin, 2026-10-27: "infrastructure fixes always go first, in code, not prose"). After the open-PR and
# unfinished-merged-work holds, a NEW app (non-YPER4) claim is refused while more than QUEUE_MAX non-draft PRs are open
# or while board 4060 Backlog has a free ticket (no agent, no agent assignee, not "do not touch"). Reads every page.
# A ticket that already has an open PR is adoption, not new work, and is never braked.
infra_free() {
  local page offset=0 total count found=""
  while :; do
    page=$(${SHIP_CLAIM_HYPERTASK:-hypertask} tasks list --project 4060 --status Normal --limit 100 --offset "$offset" --json) || return 1
    jq -e '.success == true and (.tasks | type == "array") and all(.tasks[];
      (.ticketNumber | type == "string") and (.section | type == "string"))' <<<"$page" >/dev/null || return 1
    total=$(jq '.total // (.tasks | length)' <<<"$page"); count=$(jq '.tasks | length' <<<"$page")
    found+=$(jq -r '[.tasks[]
      | select(.section == "Backlog" and ((.title // "") | ascii_downcase | contains("do not touch") | not)
          and .agent == null and ([.assignees[]? | select(.agent)] | length) == 0)
      | .ticketNumber] | join(" ")' <<<"$page") || return 1
    found+=' '
    [ "$((offset + count))" -lt "$total" ] || break
    [ "$count" -gt 0 ] || return 1
    offset=$((offset + count))
  done
  read -ra found <<<"$found"; echo "${found[*]:0:3}"
}

hold_check() {
  local t=$1 rn open n free board page total offset count expected_total candidates ticket project number merged matches seen unfinished=''
  [[ ${SHIP_SESSION_NAME:-} =~ ^RUNNER\ ([1-9][0-9]*)$ ]] || return 0
  rn=${BASH_REMATCH[1]}
  open=$(${SHIP_CLAIM_GH:-gh} pr list -R hypertask-ai/hypertask --state open --limit 300 --json number,headRefName,title,isDraft) \
    || { echo "ship-claim: HOLD. Cannot read open PRs, so no new claim for RUNNER $rn. Retry later." >&2; return 4; }
  jq -e 'type == "array" and length < 300 and all(.[];
    (.number | type == "number") and (.headRefName | type == "string") and (.title | type == "string")
    and (.isDraft | type == "boolean"))' <<<"$open" >/dev/null \
    || { echo "ship-claim: HOLD. Open PR read is malformed or incomplete for RUNNER $rn." >&2; return 4; }
  HELD=$(jq -r --arg n "$rn" --arg t "$t" '
    [.[] | select(.headRefName | test("(^|[/_-])runner-?" + $n + "($|[/_-])"; "i"))
      | select(.headRefName | test("^ci-runner-"; "i") | not)] as $m
    | if any($m[]; (.title | ascii_upcase | startswith($t + " ")) or (.headRefName | ascii_upcase | test("(^|[^0-9A-Z])" + $t + "($|[^0-9])")))
      then "RESUME" else ($m | map("https://github.com/hypertask-ai/hypertask/pull/\(.number)") | join(" ")) end' <<<"$open") \
    || { echo "ship-claim: HOLD. Cannot parse open PRs for RUNNER $rn." >&2; return 4; }
  [ "$HELD" != RESUME ] || return 0
  for board in 15 4060; do
    offset=0; expected_total=''; seen=''
    while :; do
      page=$(${SHIP_CLAIM_HYPERTASK:-hypertask} tasks list --project "$board" --status Normal --limit 100 --offset "$offset" --json) \
        || { echo "ship-claim: HOLD. Cannot read board $board; finish existing work before claiming." >&2; return 4; }
      jq -e '.success == true and (.total | type == "number" and . >= 0 and floor == .)
        and (.tasks | type == "array") and all(.tasks[];
          (.ticketNumber | type == "string") and (.section | type == "string") and (.assignees | type == "array"))' <<<"$page" >/dev/null \
        || { echo "ship-claim: HOLD. Cannot parse board $board." >&2; return 4; }
      total=$(jq .total <<<"$page"); count=$(jq '.tasks | length' <<<"$page")
      [ -n "$expected_total" ] || expected_total=$total
      if [ "$total" != "$expected_total" ] || [ "$((offset + count))" -gt "$total" ] || { [ "$count" = 0 ] && [ "$offset" -lt "$total" ]; }; then
        echo "ship-claim: HOLD. Board $board read is incomplete or changed while paging." >&2; return 4
      fi
      seen+=$(jq -r '.tasks[].ticketNumber' <<<"$page"); seen+=$'\n'
      if [ "$(printf '%s' "$seen" | sed '/^$/d' | sort -u | wc -l)" -ne "$((offset + count))" ]; then
        echo "ship-claim: HOLD. Board $board repeated a ticket while paging." >&2; return 4
      fi
      candidates=$(jq -r --arg runner "runner $rn" '.tasks[]
        | select(.section | IN("In Progress", "QA", "AI Review"))
        | select(any(.assignees[]; (.agent.displayName // "" | ascii_downcase) == $runner))
        | [.ticketNumber, .projectId, .uniqueIndex] | @tsv' <<<"$page") \
        || { echo "ship-claim: HOLD. Cannot read RUNNER $rn assignments." >&2; return 4; }
      while IFS=$'\t' read -r ticket project number; do
        [ -n "$ticket" ] || continue
        [[ $ticket =~ ^(HTPR|HYFA|YPER4|HYCI)-[0-9]+$ && $project =~ ^[1-9][0-9]*$ && $number =~ ^[1-9][0-9]*$ ]] \
          || { echo "ship-claim: HOLD. Invalid assigned ticket on board $board." >&2; return 4; }
        merged=$(${SHIP_CLAIM_GH:-gh} pr list -R hypertask-ai/hypertask --state merged --base production --search "$ticket in:title" --limit 100 --json number,title) \
          || { echo "ship-claim: HOLD. Cannot read merged PRs for $ticket." >&2; return 4; }
        jq -e 'type == "array" and length < 100 and all(.[]; (.number | type == "number") and (.title | type == "string"))' <<<"$merged" >/dev/null \
          || { echo "ship-claim: HOLD. Merged PR read is malformed or incomplete for $ticket." >&2; return 4; }
        matches=$(jq --arg t "$ticket" '[.[] | select(.title | ascii_upcase | startswith($t + " "))] | length' <<<"$merged")
        [ "$matches" = 0 ] && continue
        [ "$ticket" != "$t" ] || return 0
        [ -n "$unfinished" ] || unfinished="https://app.hypertask.ai/detail/project-$project/$number ($ticket)"
      done <<<"$candidates"
      offset=$((offset + count))
      [ "$offset" -lt "$total" ] || break
    done
  done
  if [ -n "$HELD" ]; then
    echo "ship-claim: HOLD. RUNNER $rn still has open PRs: $HELD"
    echo "ship-claim: do NOT claim $t or any other ticket. Drive one of these PRs to merged, live and Done first."
    return 4
  fi
  if [ -n "$unfinished" ]; then
    echo "ship-claim: HOLD. RUNNER $rn has unfinished merged work: $unfinished."
    echo "ship-claim: finish live QA, verify its flag, then move it to Done before claiming $t. Resume the unfinished ticket instead."
    return 4
  fi
  # Finishing an existing PR is never new work (Valentin, 2026-10-28 and 2026-10-29: the PR queue goes first). A ticket
  # with any open PR, whoever opened it, stays claimable: that is adoption, and the brake only stops new app work.
  if jq -e --arg t "$t" 'any(.[];
      (.title | ascii_upcase | startswith($t + " "))
      or (.headRefName | ascii_upcase | test("(^|[^0-9A-Z])" + $t + "($|[^0-9])")))' <<<"$open" >/dev/null; then
    return 0
  fi
  [[ $t == YPER4-* ]] && return 0  # Fleet Infra work is never braked
  n=$(jq -e '[.[] | select(.isDraft | not)] | length' <<<"$open") \
    || { echo "ship-claim: HOLD. Cannot count open PRs for RUNNER $rn." >&2; return 4; }
  if [ "$n" -gt "$QUEUE_MAX" ]; then
    echo "ship-claim: HOLD. queue full: infra only ($n open non-draft PRs > $QUEUE_MAX). Do NOT claim $t; claim a YPER4 (Fleet Infra) ticket or nothing."
    return 4
  fi
  free=$(infra_free) \
    || { echo "ship-claim: HOLD. Cannot read board 4060 to check infra first, so no app claim for RUNNER $rn." >&2; return 4; }
  if [ -n "$free" ]; then
    echo "ship-claim: HOLD. infra first: free Fleet Infra tickets wait ($free). Do NOT claim $t; claim one of those."
    return 4
  fi
  return 0
}

if [ "${1:-}" = hold ]; then
  [[ ${2:-} =~ ^(HTPR|HYFA|YPER4|HYCI)-[0-9]+$ ]] || { echo "usage: ship-claim hold <TICKET>" >&2; exit 2; }
  hold_check "$2"; rc=$?; [ "$rc" = 0 ] && echo "ship-claim: no hold for ${SHIP_SESSION_NAME:-this session} on $2"; exit "$rc"
fi

if [ "${1:-}" = decide ]; then
  [ $# -ge 3 ] || { echo "usage: ship-claim decide <claim-id> <comments.json> [idle-ids] [assigned-ids] [self-resume]" >&2; exit 2; }
  jq -e '.comments | type == "array"' "$3" >/dev/null 2>&1 || { echo "ship-claim: $3 is not readable comments JSON" >&2; exit 2; }
  decide "$2" "$3" "${4:-}" "${5:-}" "${6:-}" || exit 2
  exit 0
fi

T=${1:-}
[[ $T =~ ^(HTPR|HYFA|YPER4|HYCI)-[0-9]+$ ]] || { echo "usage: ship-claim <HTPR|HYFA|YPER4|HYCI-NNNN> [\"<resume command>\"]" >&2; exit 2; }
# The board a ticket lives on, so a refusal can name it. HYCI is the CI board (11514), owned by CI Boss.
case "$T" in HTPR-*|HYFA-*) TICKET_BOARD=15 ;; YPER4-*) TICKET_BOARD=4060 ;; HYCI-*) TICKET_BOARD=11514 ;; *) TICKET_BOARD='' ;; esac
ticket_board_name() { case "$1" in 15) echo "Hypertask" ;; 4060) echo "Fleet Infra" ;; 11514) echo "Hypertask CI" ;; *) echo "its own" ;; esac; }
VCC=${SHIP_CLAIM_VCC:-vcc}; HT=${SHIP_CLAIM_HYPERTASK:-hypertask}; HT_API=${SHIP_CLAIM_HT:-ht}
SID=${CLAUDE_CODE_SESSION_ID:-}
case "${2:-}" in
  --resume) RESUME=${3:-} ;;
  --resume=*) RESUME=${2#--resume=} ;;
  *) RESUME=${2:-${SHIP_CLAIM_RESUME:-}} ;;
esac
[[ $RESUME != -* ]] || { echo "ship-claim: resume command '$RESUME' looks like a flag; pass it as: ship-claim $T \"<resume command>\"" >&2; exit 2; }
[ -n "$RESUME" ] || { [ -n "$SID" ] && RESUME="claude --resume $SID"; }
CSID=${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}
[ -n "$RESUME" ] || { [ -n "$CSID" ] && RESUME="codex resume $CSID"; }
[ -n "$RESUME" ] || { echo "ship-claim: no session id found; pass the resume command: ship-claim $T \"<resume command>\"" >&2; exit 2; }
# The claim id tells two sessions apart. Codex and hax runners all resume through a tmux attach line,
# so the resume command is not unique; the harness session id is, and never matches another runner's claim.
# A claim id is the whole resume command: two runners never share one, and the same runner keeps it across a
# restart, so a restarted runner still owns the claim its previous session left.
RID=$(printf '%s' "$RESUME" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')

hold_check "$T" || exit $?

if [[ $T == HTPR-* ]]; then
  task=$("$HT" tasks get "$T" --json) || { echo "ship-claim: cannot read alert before claiming" >&2; exit 2; }
  printf '%s' "$task" | node "$(dirname "$(readlink -f "$0")")/error-collector/claim-incident.mjs"
  rc=$?
  [ "$rc" = 0 ] || exit "$rc"
fi

if [[ ${SHIP_SESSION_NAME:-} =~ ^RUNNER\ ([1-9][0-9]*)$ ]]; then
  python3 "$(dirname "$(readlink -f "$0")")/runner-domain-admit.py" "${BASH_REMATCH[1]}" "$T" \
    || { echo "ship-claim: HOLD. Domain admission failed." >&2; exit 4; }
fi

assigned=$("$VCC" task assign "$T" --self 2>&1 >/dev/null) || {
  if grep -qi 'not a member' <<< "$assigned"; then
    me=${SHIP_SESSION_NAME:-$("$(dirname "$(readlink -f "$0")")/ship-identity" | cut -f1)}
    echo "ship-claim: REFUSED. board $TICKET_BOARD ($(ticket_board_name "$TICKET_BOARD")) does not list member \"$me\" for $T." >&2
    echo "ship-claim: the board decides who may join it; ask its owner to add \"$me\". Do NOT start work." >&2
    exit 4
  fi
  echo "ship-claim: assign failed: $assigned" >&2; exit 2
}
"$VCC" activity add "$T" "Claimed. Session working it now. Claim id: [$RID]
Next: I examine and fix it. Resume: $RESUME" >/dev/null \
  || { echo "ship-claim: claim activity failed" >&2; exit 2; }
"$VCC" task move "$T" --section "In Progress" >/dev/null || { echo "ship-claim: move failed" >&2; exit 2; }

W=$(mktemp); IDLE=$(mktemp); ASG=$(mktemp); LOG=$(mktemp); PAGE=$(mktemp); MERGED=$(mktemp); trap 'rm -f "$W" "$IDLE" "$ASG" "$LOG" "$PAGE" "$MERGED"' EXIT
"$HT" comment list "$T" --sort createdAt:desc --limit 100 --json > "$W" \
  && jq -e '.comments | type == "array"' "$W" >/dev/null \
  || { echo "ship-claim: cannot re-read comments on $T; do not start work until the claim is confirmed" >&2; exit 2; }

printf '{"success":true,"activities":[]}' > "$LOG"
offset=0
while :; do
  suffix=''; [ "$offset" = 0 ] || suffix="&offset=$offset"
  "$HT_API" GET "/mcp/tasks/$T/agent-activity?limit=100$suffix" > "$PAGE" \
    && jq -e '.success == true and (.activities | type == "array" and length <= 100)' "$PAGE" >/dev/null \
    && jq -s '.[0] + {activities: (.[0].activities + .[1].activities)}' "$LOG" "$PAGE" > "$MERGED" \
    && jq -e '.activities | length == (unique_by(.id) | length)' "$MERGED" >/dev/null \
    && mv "$MERGED" "$LOG" \
    || { echo "ship-claim: cannot read complete agent log on $T; retry before working" >&2; exit 2; }
  count=$(jq '.activities | length' "$PAGE")
  [ "$count" -eq 100 ] || break
  offset=$((offset + count))
done
jq -s '.[0] + {activities: .[1].activities}' "$W" "$LOG" > "$MERGED" && mv "$MERGED" "$W" \
  || { echo "ship-claim: cannot combine claim history on $T" >&2; exit 2; }

# Agents now assigned (one read). A failed read leaves the file empty, which skips rule (a).
"$HT" tasks get "$T" --json > "$MERGED" 2>/dev/null \
  && jq -r '.tasks[0] | [.agent.id?, (.assignees[]?.agent.id?)] | .[] | select(. != null)' "$MERGED" > "$ASG" 2>/dev/null || : > "$ASG"

# An old competing claim is ignored only when its agent shows no activity in the last 6 h. Read failure = still active.
agent_idle() {
  local line when
  if [ "$2" = 1 ]; then
    line=$(jq -r --arg agent "$1" --arg rid "$RID" '[.activities[] | select(.agentId == $agent) | select(.text | contains($rid) | not)] | max_by(.createdAt) | .createdAt // ""' "$LOG") || return 1
  else
    line=$(VCC_ACTIVITY_AGENT_ID="$1" "$VCC" activity last "$T" 2>/dev/null) || return 1
  fi
  [ -n "$line" ] || return 0
  when=$(date -d "$(cut -f1 <<< "$line")" +%s 2>/dev/null) || return 1
  [ $(( $(date +%s) - when )) -gt 21600 ]
}

res=NOOURS
for _ in 1 2 3 4 5 6 7 8; do
  res=$(decide "$RID" "$W" "$IDLE" "$ASG" "$RESUME") || { echo "ship-claim: cannot judge comments on $T" >&2; exit 2; }
  case "$res" in
    LOSE*)
      IFS=$'\t' read -r _ other oid old same <<< "$res"
      if [ "$old" = 1 ] && agent_idle "$oid" "$same"; then echo "$oid" >> "$IDLE"; continue; fi ;;
  esac
  break
done
case "$res" in
  WIN)
    if jq -e --arg rid "$RID" '[.comments[], .activities[]?] | any(.[];
      (.text // .commentText // "") | gsub("<[^>]*>"; " ") | contains("Claimed.") and (contains($rid) | not))' "$W" >/dev/null; then
      project=$(jq -r '.tasks[0] | .projectId // .boardId // empty' "$MERGED" 2>/dev/null)
      case "$T" in HTPR-*) project=${project:-15} ;; YPER4-*) project=${project:-4060} ;; esac
      questions=$(jq -r --arg project "$project" --arg number "${T#*-}" '
        .comments | sort_by(.createdAt, .id) | .[]
        | ((.text // .commentText // "") | gsub("<[^>]*>"; " ") | gsub("[[:space:]]+"; " ")) as $text
        | select($text | test("Question:"; "i"))
        | (if $project == "" then "comment-" + (.id | tostring)
           else "https://app.hypertask.ai/detail/project-" + $project + "/" + $number + "#comment-" + (.id | tostring) end)
          + " " + $text' "$W") || exit 2
      echo "ship-claim: takeover. Read existing questions, replies and reactions before asking anything."
      echo "ship-claim: reuse any unanswered question; edit your own or bump the original in agent activity, never post it again."
      [ -z "$questions" ] || printf '%s\n' "$questions"
      links=$(printf '%s\n' "$questions" | cut -d' ' -f1 | paste -sd ' ' -)
      "$VCC" activity add "$T" "Takeover: review questions and replies; reuse unanswered questions, never re-ask. ${links:-Read older comment pages before asking.} Claim id: [$RID]. Resume: $RESUME" >/dev/null \
        || { echo "ship-claim: takeover handoff failed" >&2; exit 2; }
    fi
    echo "ship-claim: $T claimed, you are first. Start work."; exit 0 ;;
  NOOURS) echo "ship-claim: own claim comment not visible yet on $T; re-run ship-claim read-only check before working" >&2; exit 2 ;;
  LOSE*)
    IFS=$'\t' read -r _ other oid old same <<< "$res"
    if [ "$same" = 1 ]; then
      echo "ship-claim: same agent identity won; not unassigning (that would remove the winner)." >&2
    else
      "$VCC" task unassign "$T" --self >/dev/null || echo "ship-claim: unassign failed, remove yourself by hand" >&2
    fi
    "$VCC" activity add "$T" "Stepping back: $other claimed this first. Claim id: [$RID]
Next: $other carries on. Resume: $RESUME" >/dev/null \
      || echo "ship-claim: step-back comment failed" >&2
    echo "ship-claim: STEP BACK, $other claimed $T first. Do NOT start work; pick another ticket."
    exit 3 ;;
  *) echo "ship-claim: unexpected decision: $res" >&2; exit 2 ;;
esac
