#!/usr/bin/env bash
# ship-claim: the whole claim step, with a race check (YPER4-264).
#   ship-claim <TICKET> ["<resume command>"]            claim, re-read the comments, step back if another runner claimed first
#   ship-claim decide <RESUME_ID> <comments.json> [idle-ids-file]   pure decision from a saved comments read (tests use this)
#   ship-claim hold <TICKET>                            read-only: would the open-PR hold refuse this claim?
# Exit codes: 0 we hold the claim, 3 STEP BACK (another runner claimed first: do not start work), 2 error,
#   4 HOLD (this RUNNER n still has an open PR on its own branch: finish that PR, claim nothing new).
# Winner: the earliest "Claimed." comment by createdAt; equal times go to the lower comment id, then log ids.
# Ownership is the session resume id in the comment text, not the agent name. Assignment is never
# consulted (a claimer may have posted but not assigned yet). A competing claim older than 6 h
# before ours is ignored only when its agent has no ticket activity in the last 6 h (`vcc activity
# last`); if that read fails the old claim counts. Losing to the same agent identity (another
# session) never unassigns, because that would remove the winner.
# A claim also stops counting (YPER4-269) when (a) its agent is no longer assigned to the ticket (read once
# with `hypertask tasks get`; skipped if that read fails, if no agent is assigned, or if the claim is within
# 5 min of ours, because a claimer may not have assigned itself yet), or (b) the same agent later posted a
# comment whose visible text starts with Handing over / Handed over / Stepping back / Released / Unclaimed.
# Resume command: 2nd argument, else SHIP_CLAIM_RESUME, else CLAUDE_CODE_SESSION_ID, else CODEX_SESSION_ID / CODEX_THREAD_ID.
# Env overrides for tests: SHIP_CLAIM_VCC, SHIP_CLAIM_HYPERTASK, SHIP_CLAIM_RESUME.
set -uo pipefail

# decide <resume-id> <comments.json> [idle-ids-file]
# Prints "WIN", "NOOURS" or "LOSE<TAB>name<TAB>agent id<TAB>old(0|1)<TAB>same-agent(0|1)".
# idle-ids-file: agent ids (one per line) with no recent activity; their claims older than 6 h are ignored.
# assigned-ids-file: agent ids (one per line) now assigned; empty or missing = unknown, rule (a) is skipped.
decide() {
  local idle=${3:-/dev/null} asg=${4:-/dev/null}
  jq -r --arg rid "$1" --rawfile idle "$idle" --rawfile asg "$asg" '
    def txt: ((.text // .commentText // "") | gsub("<[^>]*>"; " "));
    def key: (.agent.id // .agent_id // .agent.displayName // .agent_display_name // "");
    def name: (.agent.displayName // .agent_display_name // key | tostring);
    def at: [(.createdAt // ""), ((.id // 0) | (tonumber? // .) | if type == "number" then [0, .] else [1, tostring] end)];
    def secs: (.createdAt | sub("\\.[0-9]+"; "") | fromdateiso8601);
    def sess: (txt | capture("resume[[:space:]]+(?<s>[^[:space:]]+)").s? // "");
    def handover: (txt | sub("^[[:space:]]+"; "") | test("^(Handing over|Handed over|Stepping back|Released|Unclaimed)"; "i"));
    ($idle | split("\n") | map(select(. != ""))) as $idle
    | ($asg | split("\n") | map(select(. != ""))) as $asg
    | [(.comments[], (.activities[]? | {id, createdAt, text, agent: {id: .agentId, displayName: .agentName}})) | select(key != "")] as $c
    | [$c[] | select(txt | test("Stepping back"))] as $back
    | [$c[] | select(handover)] as $gone
    | ([$c[] | select(txt | contains($rid)) | secs] | min // 0) as $mine
    | [$c[] | select(txt | contains("Claimed."))
        | . as $k | select(([$back[] | select(sess == ($k | sess) and at > ($k | at))] | length) == 0)
        | select(([$gone[] | select(key == ($k | key) and (sess == "" or sess == ($k | sess)) and at > ($k | at))] | length) == 0)
        | select(($asg | length) == 0 or ($asg | index($k | key)) or (($k | secs) > $mine - 300))] as $claims
    | [$claims[] | select(txt | contains($rid))] as $ours
    | if ($ours | length) == 0 then "NOOURS"
      else ($ours | sort_by(at) | first) as $me
        | ([$claims[] | select((txt | contains($rid) | not)
              and at < ($me | at)
              and ((($me | secs) - secs) <= 21600 or (key as $k | $idle | index($k) | not)))]
            | sort_by(at) | first // null) as $other
        | if $other == null then "WIN"
          else "LOSE\t" + ($other | name) + "\t" + ($other | key) + "\t"
            + (if (($me | secs) - ($other | secs)) > 21600 then "1" else "0" end) + "\t"
            + (if ($other | key) == ($me | key) then "1" else "0" end)
          end
      end' "$2"
}

# Open-PR hold (Valentin, 2026-10-27: "stay on the PR until they are unblocked to actually ship it and not pick up new stuff").
# Only for SHIP_SESSION_NAME "RUNNER n". Its PRs are open hypertask PRs whose branch names it (runner<n> or runner-<n>
# as a whole word). Claiming the ticket of one of those PRs is allowed; anything else is refused. A failed read refuses.
hold_check() {
  local t=$1 rn open
  [[ ${SHIP_SESSION_NAME:-} =~ ^RUNNER\ ([1-9][0-9]*)$ ]] || return 0
  rn=${BASH_REMATCH[1]}
  open=$(${SHIP_CLAIM_GH:-gh} pr list -R hypertask-ai/hypertask --state open --limit 300 --json number,headRefName,title) \
    || { echo "ship-claim: HOLD. Cannot read open PRs, so no new claim for RUNNER $rn. Retry later." >&2; return 4; }
  HELD=$(jq -r --arg n "$rn" --arg t "$t" '
    [.[] | select(.headRefName | test("(^|[/_-])runner-?" + $n + "($|[/_-])"; "i"))] as $m
    | if any($m[]; (.title | ascii_upcase | startswith($t + " ")) or (.headRefName | ascii_upcase | test("(^|[^0-9A-Z])" + $t + "($|[^0-9])")))
      then "" else ($m | map("https://github.com/hypertask-ai/hypertask/pull/\(.number)") | join(" ")) end' <<<"$open") \
    || { echo "ship-claim: HOLD. Cannot parse open PRs for RUNNER $rn." >&2; return 4; }
  [ -z "$HELD" ] && return 0
  echo "ship-claim: HOLD. RUNNER $rn still has open PRs: $HELD"
  echo "ship-claim: do NOT claim $t or any other ticket. Drive one of these PRs to merged, live and Done first."
  return 4
}

if [ "${1:-}" = hold ]; then
  [[ ${2:-} =~ ^(HTPR|HYFA|YPER4)-[0-9]+$ ]] || { echo "usage: ship-claim hold <TICKET>" >&2; exit 2; }
  hold_check "$2"; rc=$?; [ "$rc" = 0 ] && echo "ship-claim: no hold for ${SHIP_SESSION_NAME:-this session} on $2"; exit "$rc"
fi

if [ "${1:-}" = decide ]; then
  [ $# -ge 3 ] || { echo "usage: ship-claim decide <resume-id> <comments.json> [idle-ids-file]" >&2; exit 2; }
  jq -e '.comments | type == "array"' "$3" >/dev/null 2>&1 || { echo "ship-claim: $3 is not readable comments JSON" >&2; exit 2; }
  decide "$2" "$3" "${4:-}" "${5:-}" || exit 2
  exit 0
fi

T=${1:-}
[[ $T =~ ^(HTPR|HYFA|YPER4)-[0-9]+$ ]] || { echo "usage: ship-claim <HTPR|HYFA|YPER4-NNNN> [\"<resume command>\"]" >&2; exit 2; }
VCC=${SHIP_CLAIM_VCC:-vcc}; HT=${SHIP_CLAIM_HYPERTASK:-hypertask}; HT_API=${SHIP_CLAIM_HT:-ht}
SID=${CLAUDE_CODE_SESSION_ID:-}
RESUME=${2:-${SHIP_CLAIM_RESUME:-}}
[ -n "$RESUME" ] || { [ -n "$SID" ] && RESUME="claude --resume $SID"; }
CSID=${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}
[ -n "$RESUME" ] || { [ -n "$CSID" ] && RESUME="codex resume $CSID"; }
[ -n "$RESUME" ] || { echo "ship-claim: no session id found; pass the resume command: ship-claim $T \"<resume command>\"" >&2; exit 2; }
RID=${RESUME##* }

hold_check "$T" || exit $?

if [[ $T == HTPR-* ]]; then
  task=$("$HT" tasks get "$T" --json) || { echo "ship-claim: cannot read alert before claiming" >&2; exit 2; }
  printf '%s' "$task" | node "$(dirname "$(readlink -f "$0")")/error-collector/claim-incident.mjs"
  rc=$?
  [ "$rc" = 0 ] || exit "$rc"
fi

"$VCC" comment add "$T" --text "<p><strong>Claimed.</strong> Session working it now.</p><p>Next: I examine and fix it. Requested by Valentin in a Claude session, $(date +%F). Resume this Claude session: $RESUME</p>" >/dev/null \
  || { echo "ship-claim: claim comment failed" >&2; exit 2; }
"$VCC" task assign "$T" --self >/dev/null || { echo "ship-claim: assign failed" >&2; exit 2; }
"$VCC" task move "$T" --section "In Progress" >/dev/null || { echo "ship-claim: move failed" >&2; exit 2; }

W=$(mktemp); IDLE=$(mktemp); ASG=$(mktemp); LOG=$(mktemp); MERGED=$(mktemp); trap 'rm -f "$W" "$IDLE" "$ASG" "$LOG" "$MERGED"' EXIT
"$HT" comment list "$T" --sort createdAt:desc --limit 100 --json > "$W" \
  && jq -e '.comments | type == "array"' "$W" >/dev/null \
  || { echo "ship-claim: cannot re-read comments on $T; do not start work until the claim is confirmed" >&2; exit 2; }

"$HT_API" GET "/mcp/tasks/$T/agent-activity?limit=100" > "$LOG" \
  && jq -e '.success == true and (.activities | type == "array")' "$LOG" >/dev/null \
  && jq -s '.[0] + {activities: .[1].activities}' "$W" "$LOG" > "$MERGED" \
  && mv "$MERGED" "$W" \
  || { echo "ship-claim: cannot re-read agent log on $T; do not start work until the claim is confirmed" >&2; exit 2; }

# Agents now assigned (one read). A failed read leaves the file empty, which skips rule (a).
"$HT" tasks get "$T" --json > "$MERGED" 2>/dev/null \
  && jq -r '.tasks[0] | [.agent.id?, (.assignees[]?.agent.id?)] | .[] | select(. != null)' "$MERGED" > "$ASG" 2>/dev/null || : > "$ASG"

# An old competing claim is ignored only when its agent shows no activity in the last 6 h. Read failure = still active.
agent_idle() {
  local line when
  line=$(VCC_ACTIVITY_AGENT_ID="$1" "$VCC" activity last "$T" 2>/dev/null) || return 1
  [ -n "$line" ] || return 0
  when=$(date -d "$(cut -f1 <<< "$line")" +%s 2>/dev/null) || return 1
  [ $(( $(date +%s) - when )) -gt 21600 ]
}

res=NOOURS
for _ in 1 2 3 4 5 6 7 8; do
  res=$(decide "$RID" "$W" "$IDLE" "$ASG") || { echo "ship-claim: cannot judge comments on $T" >&2; exit 2; }
  case "$res" in
    LOSE*)
      IFS=$'\t' read -r _ other oid old same <<< "$res"
      if [ "$old" = 1 ] && agent_idle "$oid"; then echo "$oid" >> "$IDLE"; continue; fi ;;
  esac
  break
done
case "$res" in
  WIN)
    if jq -e --arg rid "$RID" '[.comments[], .activities[]?] | any(.[];
      (.text // .commentText // "") | gsub("<[^>]*>"; " ") | contains("Claimed.") and (contains($rid) | not))' "$W" >/dev/null; then
      project=$(jq -r '.tasks[0] | .projectId // .boardId // empty' "$MERGED" 2>/dev/null)
      case "$T" in HTPR-*) project=${project:-15} ;; YPER4-*) project=${project:-4060} ;; esac
      questions=$(jq -r --arg project "$project" --arg number "${T#*-}" '
        .comments | sort_by(.createdAt, .id) | .[]
        | ((.text // .commentText // "") | gsub("<[^>]*>"; " ") | gsub("[[:space:]]+"; " ")) as $text
        | select($text | test("Question:"; "i"))
        | (if $project == "" then "comment-" + (.id | tostring)
           else "https://app.hypertask.ai/detail/project-" + $project + "/" + $number + "#comment-" + (.id | tostring) end)
          + " " + $text' "$W") || exit 2
      echo "ship-claim: takeover. Read existing questions, replies and reactions before asking anything."
      echo "ship-claim: reuse any unanswered question; edit your own or bump the original in agent activity, never post it again."
      [ -z "$questions" ] || printf '%s\n' "$questions"
      links=$(printf '%s\n' "$questions" | cut -d' ' -f1 | paste -sd ' ' -)
      "$VCC" activity add "$T" "Takeover: review questions and replies; reuse unanswered questions, never re-ask. ${links:-Read older comment pages before asking.} Resume: $RESUME" >/dev/null \
        || { echo "ship-claim: takeover handoff failed" >&2; exit 2; }
    fi
    echo "ship-claim: $T claimed, you are first. Start work."; exit 0 ;;
  NOOURS) echo "ship-claim: own claim comment not visible yet on $T; re-run ship-claim read-only check before working" >&2; exit 2 ;;
  LOSE*)
    IFS=$'\t' read -r _ other oid old same <<< "$res"
    if [ "$same" = 1 ]; then
      echo "ship-claim: same agent identity won; not unassigning (that would remove the winner)." >&2
    else
      "$VCC" task unassign "$T" --self >/dev/null || echo "ship-claim: unassign failed, remove yourself by hand" >&2
    fi
    "$VCC" comment add "$T" --text "<p><strong>Stepping back: $other claimed this first.</strong></p><p>Next: $other carries on; nothing for you to do. Requested by Valentin in a Claude session, $(date +%F). Resume this Claude session: $RESUME</p>" >/dev/null \
      || echo "ship-claim: step-back comment failed" >&2
    echo "ship-claim: STEP BACK, $other claimed $T first. Do NOT start work; pick another ticket."
    exit 3 ;;
  *) echo "ship-claim: unexpected decision: $res" >&2; exit 2 ;;
esac
