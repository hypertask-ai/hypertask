[Unit]
Description=Collect production errors into grouped bug tickets

[Service]
Type=oneshot
UMask=0077
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="SHIP_SESSION_NAME=Error Collector"
EnvironmentFile=-%h/.config/hypertask-agents/error-collector.env
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/error-collector
ExecStart=/usr/bin/flock --nonblock %h/.local/state/error-collector/timer.lock %h/.local/lib/hypertask/error-collector/collector.mjs --once
TimeoutStartSec=14min
