#!/usr/bin/env bash
set -u
STATE=$HOME/.local/state/ht-hax-runners
REPO=$HOME/projects/hypertask
FIRST=6
SELF=$(readlink -f "$0")
GUARD=$HOME/.local/bin/session-policy-guard
LAUNCH=(hax --provider=codex --model=gpt-6.1-sol --effort=medium)
mkdir -p "$STATE"
target() { cat "$STATE/target" 2>/dev/null || echo 10; }
maxcap() { cat "$STATE/max" 2>/dev/null || echo 20; }
validate_targets() {
  t=$(target); cap=$(maxcap)
  [[ "$t" =~ ^[1-9][0-9]?$ && "$cap" =~ ^[1-9][0-9]?$ ]] &&
    [ "$t" -le "$cap" ] && [ "$cap" -le 20 ] || { echo "target/max must satisfy 1 <= target <= max <= 20" >&2; return 1; }
}
log() { echo "$(date -u +%FT%TZ) $*" >> "$STATE/keeper.log"; }

green() {
  local cores load5 avail proc=${HT_HAX_PROC_ROOT:-/proc}
  GREEN_WHY='resource reading unavailable'
  cores=$(nproc) && load5=$(awk '{print $2}' "$proc/loadavg") &&
    avail=$(awk '/MemAvailable/{print int($2/1048576)}' "$proc/meminfo") || return 1
  [[ "$cores" =~ ^[1-9][0-9]*$ && "$load5" =~ ^[0-9]+([.][0-9]+)?$ && "$avail" =~ ^[0-9]+$ ]] || return 1
  GREEN_WHY="load5=$load5 cores=$cores avail=${avail}G status=$(head -c 40 "$HOME/.local/state/vps-load/status" 2>/dev/null)"
  grep -q '^add' "$HOME/.local/state/vps-load/status" 2>/dev/null || return 1
  awk -v l="$load5" -v c="$cores" 'BEGIN{exit !(l/c<1.0)}' || return 1
  [ "$avail" -gt 24 ]
}

admit() {
  "$GUARD" --project "$REPO" -- "${LAUNCH[@]}" || { log "launch refused by session policy"; return 1; }
}

start_one() {
  local n=$1 sess="ht-hax-runner-$1"
  tmux has-session -t "$sess" 2>/dev/null && { echo "running: $sess"; return 0; }
  admit || return 1
  ( cd "$REPO" && SHIP_SESSION_NAME="RUNNER $n" .claude/skills/setup-runner/scripts/setup-runner "$n" ) >/dev/null 2>&1 \
    || { log "RUNNER $n: setup-runner failed, not started"; echo "login failed: RUNNER $n"; return 1; }
  tmux new-session -d -s "$sess" -x 200 -y 50 -c "$REPO" "$SELF $n --loop" || return 1
  tmux select-pane -t "$sess" -T "RUNNER $n hax"
  log "started $sess"; echo "started: $sess"
}

case "${1:-}" in
  check) admit ;;
  install)
    here=$(dirname "$SELF")
    lib=$HOME/.local/lib/hypertask/ht-hax-runner
    units=$HOME/.config/systemd/user
    mkdir -p "$lib" "$units" "$HOME/.local/bin" || exit 1
    stage=$(mktemp -d "$HOME/.local/lib/hypertask/ht-hax-runner.install.XXXXXX") || exit 1
    trap 'rm -rf "$stage"' EXIT
    install -m 0755 "$here/ht-hax-runner" "$here/user-unit-check" "$here/pr-drain-pick" "$stage/" || exit 1
    bash -n "$stage/ht-hax-runner" || exit 1
    python3 -c 'import pathlib, sys; p = pathlib.Path(sys.argv[1]); compile(p.read_bytes(), str(p), "exec")' "$stage/pr-drain-pick" || exit 1
    sed "s|%h/.local/lib/hypertask/ht-hax-runner/ht-hax-runner|$stage/ht-hax-runner|" "$here/../../../systemd/ht-hax-runner-keeper.service" > "$stage/ht-hax-runner-keeper.service" || exit 1
    cp "$here/../../../systemd/ht-hax-runner-keeper.timer" "$stage/" || exit 1
    "$stage/user-unit-check" "$stage/ht-hax-runner-keeper.service" "$stage/ht-hax-runner-keeper.timer" || exit 1
    install -m 0755 "$stage/ht-hax-runner" "$stage/user-unit-check" "$stage/pr-drain-pick" "$lib/" || exit 1
    install -m 0644 "$here/../../../systemd/ht-hax-runner-keeper.service" "$here/../../../systemd/ht-hax-runner-keeper.timer" "$units/" || exit 1
    ln -sfn "$lib/ht-hax-runner" "$HOME/.local/bin/ht-hax-runner" || exit 1
    ln -sfn "$lib/pr-drain-pick" "$HOME/.local/bin/pr-drain-pick" || exit 1
    systemctl --user daemon-reload && systemctl --user enable --now ht-hax-runner-keeper.timer
    ;;
  top-up)
    exec 9>"$STATE/.keeper.lock"; flock -n 9 || exit 0
    [ -f "$STATE/PAUSED" ] && exit 0
    validate_targets || exit 2
    live=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | awk '/^ht-hax-runner-[0-9]+$/ {n++} END {print n+0}')
    started=0
    for n in $(seq $FIRST $((FIRST + $(maxcap) + 9))); do
      [ "$live" -ge "$t" ] && break
      tmux has-session -t "ht-hax-runner-$n" 2>/dev/null && continue
      [ -f "$STATE/stop-$n" ] && continue
      [ "$started" -ge 2 ] && break
      if green; then start_one "$n" && { started=$((started+1)); live=$((live+1)); sleep 20; } || break
      else log "hold: $GREEN_WHY"; break; fi
    done
    [ -e "$STATE/last-start" ] || touch "$STATE/last-start"
    last=$(stat -c %Y "$STATE/last-start")
    [ "$started" -gt 0 ] && touch "$STATE/last-start"
    if [ "$started" -eq 0 ] && [ "$live" -ge "$t" ] && [ $(( $(date +%s) - last )) -ge 900 ] && [ "$t" -lt "$(maxcap)" ] && green; then
      echo $((t+1)) > "$STATE/target"; touch "$STATE/last-start"; log "target raised to $((t+1)): $GREEN_WHY"
    fi ;;
  status)
    echo "target=$(target) max=$(maxcap)"; green && echo "green: $GREEN_WHY" || echo "not green: $GREEN_WHY"
    tmux ls 2>/dev/null | grep '^ht-hax-runner-' || echo "no ht-hax-runner sessions" ;;
  stop-all)
    for s in $(tmux ls -F '#{session_name}' 2>/dev/null | grep '^ht-hax-runner-'); do tmux kill-session -t "$s"; echo "stopped $s"; done ;;
  ''|-h|--help) echo 'ht-hax-runner <n> | top-up | check | status | stop-all | install' ;;
  *)
    n=$1
    [[ "$n" =~ ^[1-9][0-9]*$ ]] && [ "$n" -ge $FIRST ] || { echo "runner number must be >= $FIRST"; exit 2; }
    [ "${2:-}" = --loop ] || { start_one "$n"; exit; }
    rlog="$STATE/runner-$n.log"
    runlog="$STATE/runner-$n.latest.log"
    unset HAX_SUBAGENT_DEPTH
    export SHIP_SESSION_NAME="RUNNER $n" SHIP_CLAIM_RESUME="tmux attach -t ht-hax-runner-$n (hax RUNNER $n)"
    brief="Token ladder mode: CODEX. You are RUNNER $n, a standing Hypertask runner on Codex (hax). Codex only: never call Claude or any other provider, never start Claude helpers. No fast mode. Your board identity is RUNNER $n: SHIP_SESSION_NAME is set, so vcc writes as you; check with ~/.agents/skills/ship/scripts/ship-identity before any write. Read ~/projects/hypertask/.claude/skills/ship/SKILL.md fully and follow it end to end from Before anything else, with no ticket given: run its board check, respect claims and stale-ticket rules. Finish before you start: if an open PR on a branch named runner$n/ or runner-$n/ is yours, or a ticket assigned to you where Valentin or HT Product Lead answered after your last comment, this run drives it to merged, live and Done (rebase, rerun failed checks, fix) instead of a new ticket. PR queue first (Valentin 2026-10-29): next run ~/.local/bin/pr-drain-pick; if it prints PR <number> <branch> <ticket> <title>, adopt that PR, claim its ticket with ship-claim while respecting active claims and stale-ticket rules, recover its branch in your own worktree, rebase on origin/production, fix checks, mark it ready, merge, deploy, prove live, Done. If its ticket is Done or obsolete, verify first and close the obsolete PR with a reason on its ticket. If the picker prints WAIT, or fails, stop without claiming new work; never treat either as NONE. Only exception: an urgent Bug or Error Log ticket on board 15 may go first. Only if it prints NONE, pick the top free ticket: urgent board 15 (product) tickets first, then urgent board 4060, then the rest of board 15, then the rest of board 4060 (never from Later (parked), Valentin Review or Agent Blocked), ship-claim refuses a new app ticket while board 4060 Backlog has a free Fleet Infra ticket or more than 20 non-draft PRs are open (infra only), and still allows a ticket that already has an open PR; claim it FIRST with ship-claim (resume command: \"$SHIP_CLAIM_RESUME\"), work in your own worktree, one small PR per ticket, QA, merge, deploy, live proof, Done, clean-up. Exactly one ticket this run. Use the unlazy skill (~/.agents/skills/unlazy/SKILL.md): write GATES.md first and prove every gate before your final answer. Run tests in CI only; never run tests or builds on the VPS. A local SIGKILL or exit 137 is not a blocker: push and let CI decide. Name any independent blocker on a separate Blocker: line. On board 15, Flag: Everyone, Flag: Only Me + QA and No Flag all mean done; Flag: Off does not. Close a verified release in its declared mode without widening flags. Record every branch you create with ship-check branch; record none only if you created none. Cleanup judges only this session's recorded branches, never another session's old worktree. Never message Valentin directly. Work autonomously and talk only on tickets: never session-say, SendMessage or ping HT Product Lead, any manager or any session. Claims, releases, status, handoffs and resume commands go only in vcc activity add. People comments are only plain-language questions, QA verdicts and done summaries. Stay on your own open PR until it is merged, live and Done; an earlier blocked mark, the old freeze or an old GitHub limit is not a block today: rebase, rerun checks and retry once first; only if that fails with a new exact error, mark the ticket blocked with a plain comment naming that error and end the run (do not take another ticket). A decision, money or keys question: Valentin Review plus a Question for Valentin. Final line: the word RUNNER, then either DONE <ticket> <state>, or IDLE <reason> when nothing can be picked."
    while :; do
      if [ -f "$STATE/PAUSED" ] || [ -f "$STATE/stop-$n" ]; then sleep 300; continue; fi
      if grep -q '^hold' "$HOME/.local/state/vps-load/status" 2>/dev/null; then
        echo "$(date -u +%FT%TZ) gate: vps load hold" >> "$rlog"; sleep 300; continue
      fi
      admit || exit 1
      # A runner writes as its own agent or not at all: an empty login would post as Valentin (YPER4-960).
      IFS=$'\t' read -r ident token_file < <("$HOME/.agents/skills/ship/scripts/ship-identity")
      [ "$ident" = "RUNNER $n" ] && [ -s "$token_file" ] \
        || { echo "identity check failed for RUNNER $n: no board login" >&2; log "RUNNER $n: no board login, not started"; exit 1; }
      HT_TOKEN=$(cat "$token_file") || exit 1
      [ -n "$HT_TOKEN" ] || { echo "identity check failed for RUNNER $n: empty board login" >&2; exit 1; }
      export HT_TOKEN
      unset CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID
      CODEX_SESSION_ID=$(cat /proc/sys/kernel/random/uuid) || exit 1
      export CODEX_SESSION_ID
      recovery=$HOME/.local/lib/hypertask/runner-pickup/runner-pickup
      recovery_brief=''
      if [ -x "$recovery" ]; then
        recovery_brief=$("$recovery" drain "$n") || { log "RUNNER $n: freeze recovery failed"; exit 1; }
      fi
      recovery_ticket=${recovery_brief#Resume }; recovery_ticket=${recovery_ticket%%:*}
      run_brief="$brief${recovery_brief:+ Recovery: $recovery_brief}"
      echo "$(date -u +%FT%TZ) start" >> "$rlog"
      clear; tmux clear-history -t "$TMUX_PANE"
      tmux select-pane -t "$TMUX_PANE" -T "RUNNER $n hax"
      : > "$runlog"
      : > "$STATE/runner-$n.result"
      (
        sleep 15
        tmux send-keys -t "$TMUX_PANE" -l "$run_brief"
        sleep 1
        tmux send-keys -t "$TMUX_PANE" C-m
        result=TIMEOUT
        provider_retries=0
        retry_due=1
        for poll in $(seq 1 480); do
          sleep 30
          if completed=$(python3 - "$$" "$REPO" "$recovery_ticket" <<'PYTHON'
import json
import os
from pathlib import Path
import re
import sys

proc = Path(os.environ.get('HT_HAX_PROC_ROOT', '/proc'))
try:
    children = (proc / sys.argv[1] / 'task' / sys.argv[1] / 'children').read_text().split()
    for child in children:
        for fd in (proc / child / 'fd').iterdir():
            path = fd.resolve()
            if path.suffix != '.jsonl':
                continue
            with path.open() as stream:
                header = json.loads(next(stream))
                if header.get('type') != 'session' or header.get('version') != 1 or header.get('cwd') != sys.argv[2]:
                    continue
                last = tail = None
                for line in stream:
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if item.get('type') == 'user_turn':
                        continue
                    tail = item
                    if item.get('kind') not in ('turn_usage', 'reasoning'):
                        last = item
                if tail and tail.get('kind') == 'turn_usage' and last and last.get('kind') == 'assistant' and not last.get('origin'):
                    final = last.get('text', '').strip().splitlines()
                    match = re.fullmatch(r'(?:[•*-] )?RUNNER (?:DONE (?P<ticket>(?:HTPR|YPER4|HYFA)-[0-9]+|https://\S+) (?P<state>.+)|IDLE .+)', final[-1]) if final else None
                    if match:
                        ticket = sys.argv[3]
                        project = {'HTPR': '15', 'YPER4': '4060'}.get(ticket.split('-')[0])
                        url = f'https://app.hypertask.ai/detail/project-{project}/{ticket.split("-")[-1]}'
                        if ticket and match['ticket'] in (ticket, url) and match['state'] == 'Done':
                            print('DONE_MATCH')
                        else:
                            print('IDLE' if match['ticket'] is None else 'DONE')
                        sys.exit(0)
except (OSError, ValueError, StopIteration):
    pass
sys.exit(1)
PYTHON
          ); then
            result=${completed%_MATCH}
            if [ "$completed" = DONE_MATCH ]; then
              "$recovery" ack "$n" "$recovery_ticket" || log "RUNNER $n: recovery acknowledgement failed"
            fi
            break
          fi
          prompt=$(tmux capture-pane -p -e -t "$TMUX_PANE" -S -8 2>/dev/null | awk '
            NF {
              previous_error = error
              line = $0
              gsub(/\033\[[0-9;]*m/, "", line)
              error = $0 ~ /^\033\[2m/ && line == "[provider error — enter to retry]"
              last = line
            }
            END { if (previous_error && (last == "❯" || last == ">")) print "provider-error" }')
          if [ "$prompt" = provider-error ] &&
             [ "$(tmux display-message -p -t "$TMUX_PANE" '#{session_attached} #{cursor_x}')" = '0 2' ]; then
            if [ "$provider_retries" -ge 3 ]; then
              echo "$(date -u +%FT%TZ) provider retry limit reached; runner paused" >> "$rlog"
              touch "$STATE/stop-$n"
              result=PROVIDER_ERROR
              break
            fi
            if [ "$poll" -ge "$retry_due" ] &&
               [ "$(tmux if-shell -F -t "$TMUX_PANE" '#{&&:#{==:#{session_attached},0},#{==:#{cursor_x},2}}' \
                    "send-keys -t '$TMUX_PANE' C-m ; display-message -p provider-retried")" = provider-retried ]; then
              provider_retries=$((provider_retries + 1))
              echo "$(date -u +%FT%TZ) provider retry $provider_retries/3" >> "$rlog"
              retry_due=$((poll + (1 << provider_retries)))
            fi
          fi
        done
        printf '%s\n' "$result" > "$STATE/runner-$n.result"
        tmux capture-pane -p -t "$TMUX_PANE" -S - | tee -a "$rlog" > "$runlog"
        tmux send-keys -t "$TMUX_PANE" C-d
      ) </dev/null >/dev/null 2>&1 &
      watcher=$!
      "${LAUNCH[@]}"
      kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null
      echo "$(date -u +%FT%TZ) end" >> "$rlog"
      if grep -qx IDLE "$STATE/runner-$n.result"; then sleep 900; else sleep 30; fi
    done ;;
esac
