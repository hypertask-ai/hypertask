#!/usr/bin/env bash
set -u
STATE=$HOME/.local/state/ht-hax-runners
REPO=$HOME/projects/hypertask
FIRST=6
SELF=$(readlink -f "$0")
GUARD=$HOME/.local/bin/session-policy-guard
LAUNCH=(hax --provider=codex --model=gpt-6.1-sol --effort=high)
mkdir -p "$STATE"
target() { cat "$STATE/target" 2>/dev/null || echo 10; }
maxcap() { cat "$STATE/max" 2>/dev/null || echo 20; }
validate_targets() {
  t=$(target); cap=$(maxcap)
  [[ "$t" =~ ^[1-9][0-9]?$ && "$cap" =~ ^[1-9][0-9]?$ ]] &&
    [ "$t" -le "$cap" ] && [ "$cap" -le 20 ] || { echo "target/max must satisfy 1 <= target <= max <= 20" >&2; return 1; }
}
log() { echo "$(date -u +%FT%TZ) $*" >> "$STATE/keeper.log"; }

green() {
  local cores load5 avail proc=${HT_HAX_PROC_ROOT:-/proc}
  GREEN_WHY='resource reading unavailable'
  cores=$(nproc) && load5=$(awk '{print $2}' "$proc/loadavg") &&
    avail=$(awk '/MemAvailable/{print int($2/1048576)}' "$proc/meminfo") || return 1
  [[ "$cores" =~ ^[1-9][0-9]*$ && "$load5" =~ ^[0-9]+([.][0-9]+)?$ && "$avail" =~ ^[0-9]+$ ]] || return 1
  GREEN_WHY="load5=$load5 cores=$cores avail=${avail}G status=$(head -c 40 "$HOME/.local/state/vps-load/status" 2>/dev/null)"
  grep -q '^add' "$HOME/.local/state/vps-load/status" 2>/dev/null || return 1
  awk -v l="$load5" -v c="$cores" 'BEGIN{exit !(l/c<1.0)}' || return 1
  [ "$avail" -gt 24 ]
}

admit() {
  local launcher=$HOME/.local/bin/ht-hax-runner installed=$HOME/.local/lib/hypertask/ht-hax-runner/ht-hax-runner
  if [ ! -L "$launcher" ] || [ "$(readlink -f "$launcher")" != "$installed" ] ||
      ! cmp -s "$installed" "$REPO/.claude/skills/ship/scripts/ht-hax-runner"; then
    log "launch refused: launcher drift; reinstall ht-hax-runner from the repo"
    return 1
  fi
  "$GUARD" --project "$REPO" -- "${LAUNCH[@]}" || { log "launch refused by session policy"; return 1; }
}

start_one() {
  local n=$1 sess="ht-hax-runner-$1"
  tmux has-session -t "$sess" 2>/dev/null && { echo "running: $sess"; return 0; }
  admit || return 1
  ( cd "$REPO" && SHIP_SESSION_NAME="RUNNER $n" .claude/skills/setup-runner/scripts/setup-runner "$n" ) >/dev/null 2>&1 \
    || { log "RUNNER $n: setup-runner failed, not started"; echo "login failed: RUNNER $n"; return 1; }
  tmux new-session -d -s "$sess" -x 200 -y 50 -c "$REPO" "$SELF $n --loop" || return 1
  tmux select-pane -t "$sess" -T "RUNNER $n hax"
  log "started $sess"; echo "started: $sess"
}

case "${1:-}" in
  check) admit ;;
  install)
    here=$(dirname "$SELF")
    lib=$HOME/.local/lib/hypertask/ht-hax-runner
    units=$HOME/.config/systemd/user
    mkdir -p "$lib" "$units" "$HOME/.local/bin" || exit 1
    stage=$(mktemp -d "$HOME/.local/lib/hypertask/ht-hax-runner.install.XXXXXX") || exit 1
    trap 'rm -rf "$stage"' EXIT
    install -m 0755 "$here/ht-hax-runner" "$here/user-unit-check" "$stage/" || exit 1
    bash -n "$stage/ht-hax-runner" || exit 1
    sed "s|%h/.local/lib/hypertask/ht-hax-runner/ht-hax-runner|$stage/ht-hax-runner|" "$here/../../../systemd/ht-hax-runner-keeper.service" > "$stage/ht-hax-runner-keeper.service" || exit 1
    cp "$here/../../../systemd/ht-hax-runner-keeper.timer" "$stage/" || exit 1
    "$stage/user-unit-check" "$stage/ht-hax-runner-keeper.service" "$stage/ht-hax-runner-keeper.timer" || exit 1
    install -m 0755 "$stage/ht-hax-runner" "$stage/user-unit-check" "$lib/" || exit 1
    install -m 0644 "$here/../../../systemd/ht-hax-runner-keeper.service" "$here/../../../systemd/ht-hax-runner-keeper.timer" "$units/" || exit 1
    ln -sfn "$lib/ht-hax-runner" "$HOME/.local/bin/ht-hax-runner" || exit 1
    systemctl --user daemon-reload && systemctl --user enable --now ht-hax-runner-keeper.timer
    ;;
  top-up)
    exec 9>"$STATE/.keeper.lock"; flock -n 9 || exit 0
    [ -f "$STATE/PAUSED" ] && exit 0
    validate_targets || exit 2
    live=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | awk '/^ht-hax-runner-[0-9]+$/ {n++} END {print n+0}')
    started=0
    for n in $(seq $FIRST $((FIRST + $(maxcap) + 9))); do
      [ "$live" -ge "$t" ] && break
      tmux has-session -t "ht-hax-runner-$n" 2>/dev/null && continue
      [ -f "$STATE/stop-$n" ] && continue
      [ "$started" -ge 2 ] && break
      if green; then start_one "$n" && { started=$((started+1)); live=$((live+1)); sleep 20; } || break
      else log "hold: $GREEN_WHY"; break; fi
    done
    [ -e "$STATE/last-start" ] || touch "$STATE/last-start"
    last=$(stat -c %Y "$STATE/last-start")
    [ "$started" -gt 0 ] && touch "$STATE/last-start"
    if [ "$started" -eq 0 ] && [ "$live" -ge "$t" ] && [ $(( $(date +%s) - last )) -ge 900 ] && [ "$t" -lt "$(maxcap)" ] && green; then
      echo $((t+1)) > "$STATE/target"; touch "$STATE/last-start"; log "target raised to $((t+1)): $GREEN_WHY"
    fi ;;
  status)
    echo "target=$(target) max=$(maxcap)"; green && echo "green: $GREEN_WHY" || echo "not green: $GREEN_WHY"
    tmux ls 2>/dev/null | grep '^ht-hax-runner-' || echo "no ht-hax-runner sessions" ;;
  stop-all)
    for s in $(tmux ls -F '#{session_name}' 2>/dev/null | grep '^ht-hax-runner-'); do tmux kill-session -t "$s"; echo "stopped $s"; done ;;
  ''|-h|--help) echo 'ht-hax-runner <n> | top-up | check | status | stop-all | install' ;;
  *)
    n=$1
    [[ "$n" =~ ^[1-9][0-9]*$ ]] && [ "$n" -ge $FIRST ] || { echo "runner number must be >= $FIRST"; exit 2; }
    [ "${2:-}" = --loop ] || { start_one "$n"; exit; }
    rlog="$STATE/runner-$n.log"
    runlog="$STATE/runner-$n.latest.log"
    unset HAX_SUBAGENT_DEPTH
    export SHIP_SESSION_NAME="RUNNER $n" SHIP_CLAIM_RESUME="tmux attach -t ht-hax-runner-$n (hax RUNNER $n)"
    seconds=${HT_HAX_TICKET_TIMEOUT:-14400}
    [[ "$seconds" =~ ^[1-9][0-9]*$ ]] || { log "invalid ticket timeout"; exit 2; }
    trap 'exit 0' TERM INT
    brief="Token ladder mode: CODEX. You are RUNNER $n, a standing Hypertask runner on Codex (hax). Codex only. No fast mode. Your board identity is RUNNER $n. SHIP_SESSION_NAME is set; verify with ~/.agents/skills/ship/scripts/ship-identity before any write. Follow ~/projects/hypertask/.claude/skills/ship/SKILL.md end to end for the given ticket, already claimed by the outer loop. Resume command: $SHIP_CLAIM_RESUME. Work in your own worktree. Exactly one ticket this run. Use the unlazy skill (~/.agents/skills/unlazy/SKILL.md): write GATES.md first and prove every gate before your final answer. Run targeted tests only; CI runs the full suite. Never message Valentin or any session. Talk only on tickets. Stuck after two tries: mark this ticket blocked on HT Product Lead, record why, then end this run. Decision, money or keys: Valentin Review plus a Question. Never pick another ticket. Final line: RUNNER DONE <ticket> <state>."
    while :; do
      if [ -f "$STATE/PAUSED" ] || [ -f "$STATE/stop-$n" ]; then sleep 300; continue; fi
      if grep -q '^hold' "$HOME/.local/state/vps-load/status" 2>/dev/null; then
        echo "$(date -u +%FT%TZ) gate: vps load hold" >> "$rlog"; sleep 300; continue
      fi
      admit || exit 1
      identity=$("$REPO/.claude/skills/ship/scripts/ship-identity") || exit 1
      [ "${identity%%$'\t'*}" = "$SHIP_SESSION_NAME" ] || { log "launch refused: runner identity mismatch"; exit 1; }
      ticket=$(cd "$REPO" && .claude/skills/ship/scripts/ship-claim next "$SHIP_CLAIM_RESUME")
      picked=$?
      if [ "$picked" != 0 ]; then
        echo "$(date -u +%FT%TZ) pick=$picked" >> "$rlog"
        sleep 300; continue
      fi
      [[ "$ticket" =~ ^(HTPR|YPER4|HYFA)-[0-9]+$ ]] || { log "invalid picked ticket"; exit 2; }
      echo "$(date -u +%FT%TZ) start $ticket" >> "$rlog"
      : > "$runlog"
      timeout --kill-after=30s "${seconds}s" "${LAUNCH[@]}" -p "$brief Ticket: $ticket" 2>&1 | tee "$runlog"
      status=${PIPESTATUS[0]}
      result=DONE-UNKNOWN
      if [ "$status" = 124 ] || [ "$status" = 137 ]; then result=TIMEOUT
      elif [ "$status" != 0 ]; then result=EXIT-$status
      elif tail -n 1 "$runlog" | grep -Eq "^(・ |[•*-] )?RUNNER DONE $ticket .+"; then result=DONE; fi
      printf '%s\n' "$result" > "$STATE/runner-$n.result"
      cat "$runlog" >> "$rlog"
      echo "$(date -u +%FT%TZ) end $ticket result=$result" >> "$rlog"
      sleep 30
    done ;;
esac
