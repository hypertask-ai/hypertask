#!/usr/bin/env bash
# ship-check: proof checks for /ship sessions (Valentin, 2026-10-01).
# Used by the ledger gates (ship-gates) and by the Claude Code PreToolUse hook (guard).
#   ship-check bind <T> <pr>     record this session's PR for the ticket (run right after opening it)
#   ship-check branch <T> <b|none> record the branch this session made (required on the duplicate path)
#   ship-check duplicate <T> <ORIG> <pr>  T was already fixed by ORIG's merged PR: gates then check that PR
#   ship-check pr <T>            the ticket's PR exists and is named right
#   ship-check premerge <pr>     released-flag browser proof for the current PR head (hookless sessions)
#   ship-check premerge-status <pr> publish that proof as the required current-head GitHub status
#   ship-check title <pr>        PR title is "PREFIX-NNNN [TYPE] ..." and that ticket exists
#   ship-check ticket <T>        ticket exists on the board
#   ship-check merged <T>        the ticket's newest PR is merged into the base branch
#   ship-check deployed <T>      the Production deployment for that merge is success (app repo only)
#   ship-check proof <T>         ~/.local/state/vcc-evidence/<T>/proof.md follows the verify-qa contract for that merge
#   ship-check done <T>          ticket is in Done
#   ship-check cleaned <T>       no worktree, local branch or GitHub branch is left for the ticket's PR
#   ship-check guard             hook mode: reads the hook JSON on stdin, exit 2 blocks the command
# CLI work: SHIP_REPO=hypertask-ai/cli SHIP_BASE=main ship-check ...
# Every gate binds to the PR recorded with `bind` (required), so another
# PR's merge never stands in for this fix, and every GitHub lookup fails closed.
set -uo pipefail
REPO=${SHIP_REPO:-hypertask-ai/hypertask}
BASE=${SHIP_BASE:-production}
EVID=${VCC_EVIDENCE_DIR:-$HOME/.local/state/vcc-evidence}
TITLE_RE='^(HTPR|HYFA|YPER4)-[0-9]+ \[(BUGFIX|FEATURE|IMPROVE|CLI/MCP/AI|SPEED|FEEDBACK|DASH|QA|BOARD|COST|PLAN|INFRA|REFACTOR)\] [^ ]'

fail() { echo "FAIL: $*"; exit 1; }

check_ticket() {
  hypertask tasks get "$1" --json 2>/dev/null | jq -e '.success == true and (.tasks | length) > 0' >/dev/null \
    || fail "ticket $1 not found on the board"
  echo "ticket ok"
}

check_title() {
  local t; t=$(gh pr view "$1" -R "$REPO" --json title --jq .title 2>/dev/null) || fail "PR $1 not found"
  [[ $t =~ $TITLE_RE ]] || fail "PR $1 title \"$t\" must be PREFIX-NNNN [TYPE] description"
  ( check_ticket "${t%% *}" ) >/dev/null || fail "PR $1 names ${t%% *}, which is not on the board"
  echo "title ok"
}

# Newest PR for the ticket into BASE, as "number state mergeSha". Exits 1 if GitHub cannot be read.
newest_pr() {
  local json; json=$(gh pr list -R "$REPO" --state all --base "$BASE" --search "$1 in:title" --limit 50 \
    --json number,title,state,createdAt,mergeCommit 2>/dev/null) || return 1
  jq -r --arg t "$1 " '[.[] | select(.title | startswith($t))] | sort_by(.createdAt) | last
    | if . == null then "" else "\(.number) \(.state) \(.mergeCommit.oid // "-")" end' <<<"$json"
}

bound_pr() { local f="$EVID/$1/pr"; [ -s "$f" ] && tr -dc '0-9' < "$f"; }
# The ticket whose PR title the bound PR must carry: the ticket itself, or the one it duplicates.
# Older merged PRs put the type first ("[BUGFIX] HTPR-6501 ..."). Accepted only for a duplicate's fixing PR.
OLD_TITLE_RE='^\[(BUGFIX|FEATURE|IMPROVE|CLI/MCP/AI|SPEED|FEEDBACK|DASH|QA|BOARD|COST|PLAN|INFRA|REFACTOR)\] (HTPR|HYFA|YPER4)-[0-9]+ [^ ]'

pr_owner() { local f="$EVID/$1/duplicate-of"; if [ -s "$f" ]; then tr -dc 'A-Z0-9-' < "$f"; else echo "$1"; fi; }

pr_row() {
  local n json; n=$(bound_pr "$1")
  if [ -n "$n" ]; then
    json=$(gh pr view "$n" -R "$REPO" --json number,title,state,mergeCommit,baseRefName 2>/dev/null) || return 1
    local dup=false; [ -s "$EVID/$1/duplicate-of" ] && dup=true
    jq -r --arg t "$(pr_owner "$1") " --arg b "$BASE" --argjson dup "$dup" 'if ((.title | startswith($t))
        or ($dup and (.title | test("^\\[[A-Z/]+\\] " + $t)))) and .baseRefName == $b
      then "\(.number) \(.state) \(.mergeCommit.oid // "-")" else "" end' <<<"$json"
  else echo "FAIL: no PR bound for $1; run ship-check bind $1 <pr number> right after opening it"; return 1; fi
}

check_branch() {
  [[ ${2:-} =~ ^[A-Za-z0-9._/-]+$ ]] || fail "usage: ship-check branch <T> <branch|none>"
  [ -s "$EVID/$1/duplicate-of" ] || fail "ship-check branch is only for the duplicate path; run ship-check duplicate first"
  mkdir -p "$EVID/$1" && echo "$2" > "$EVID/$1/branch" && echo "recorded branch $2 for $1"
}

check_bind() {
  local t; t=$(gh pr view "$2" -R "$REPO" --json title --jq .title 2>/dev/null) || fail "PR $2 not found in $REPO"
  [[ $t == "$1 "* ]] || fail "PR $2 is titled \"$t\", not $1"
  mkdir -p "$EVID/$1" && echo "$2" > "$EVID/$1/pr" && rm -f "$EVID/$1/duplicate-of" "$EVID/$1/branch" && echo "bound $1 to PR $2"
}

check_duplicate() {
  local t; t=$(gh pr view "$3" -R "$REPO" --json title,state --jq '"\(.state) \(.title)"' 2>/dev/null) || fail "PR $3 not found in $REPO"
  [[ $t == "MERGED $2 "* || ( $t == "MERGED ["* && ${t#MERGED } =~ $OLD_TITLE_RE && ${t#MERGED } == *"] $2 "* ) ]] \
    || fail "PR $3 must be the merged PR of $2, got: $t"
  ( check_ticket "$1" ) >/dev/null || fail "ticket $1 not found on the board"
  # The fix is already merged, so a deleted original ticket does not block the duplicate path.
  ( check_ticket "$2" ) >/dev/null || echo "note: $2 is no longer on the board; PR $3 is merged, so it still counts"
  mkdir -p "$EVID/$1" && rm -f "$EVID/$1/branch" && echo "$3" > "$EVID/$1/pr" && echo "$2" > "$EVID/$1/duplicate-of" \
    && echo "bound $1 as a duplicate of $2 (PR $3)"
}

merge_sha() {
  local row n state sha
  row=$(pr_row "$1") || fail "${row#FAIL: }"
  [ -n "$row" ] || fail "no PR titled \"$1 [TYPE] ...\" into $BASE (or the bound PR does not match)"
  read -r n state sha <<<"$row"
  [ "$state" = MERGED ] || fail "the PR for $1 (#$n) is $state, not merged"
  echo "$sha"
}

check_pr() {
  local row; row=$(pr_row "$1") || fail "${row#FAIL: }"
  [ -n "$row" ] || fail "no PR titled \"$1 [TYPE] ...\""
  # A duplicate's PR was checked at bind time and is merged; its original ticket may since be deleted.
  if [ -s "$EVID/$1/duplicate-of" ]; then
    local t; t=$(gh pr view "${row%% *}" -R "$REPO" --json title --jq .title 2>/dev/null)
    [[ $t =~ $TITLE_RE || $t =~ $OLD_TITLE_RE ]] \
      || fail "PR ${row%% *} title must be PREFIX-NNNN [TYPE] description"
    echo "title ok"
  else
    check_title "${row%% *}"
    if [[ $row == *" OPEN "* ]]; then check_premerge_status "${row%% *}"; fi
  fi
}

check_merged() { local s; s=$(merge_sha "$1") || { echo "$s"; exit 1; }; echo "merged ok"; }

check_deployed() {
  local sha id state
  sha=$(merge_sha "$1") || { echo "$sha"; exit 1; }
  if [ "$REPO" != hypertask-ai/hypertask ]; then
    local tag cmp releases runs jobs
    if ! tag=$(gh release view -R "$REPO" --json tagName --jq .tagName 2>/dev/null); then
      if [ -n "${SHIP_WORKER:-}" ]; then
        releases=$(gh release list -R "$REPO" --limit 1 --json tagName 2>/dev/null) || fail "could not read releases in $REPO"
        jq -e 'length == 0' <<<"$releases" >/dev/null || fail "no release found in $REPO"
        [[ ${SHIP_CHECKOUT:-} == /* ]] || fail "set SHIP_CHECKOUT to the local checkout of $REPO"
        [[ $SHIP_WORKER =~ ^[A-Za-z0-9._/\ -]+$ && $SHIP_WORKER != /* && /$SHIP_WORKER/ != *'/../'* ]] \
          || fail "SHIP_WORKER must be a relative worker directory inside SHIP_CHECKOUT"
        [[ $sha =~ ^[0-9a-f]{40}$ ]] || fail "invalid merge sha for worker deployment: $sha"
        local deployment version worker="$SHIP_CHECKOUT/$SHIP_WORKER"
        local name= account_id= line field checkout neutral parent contents
        local config_re="^[[:space:]]*(name|account_id)[[:space:]]*=[[:space:]]*([\"'])([A-Za-z0-9_-]+)\\2[[:space:]]*(#.*)?$"
        [ -f "$worker/wrangler.toml" ] && [ -r "$worker/wrangler.toml" ] || fail "could not read worker wrangler.toml"
        while IFS= read -r line || [ -n "$line" ]; do
          [[ $line =~ ^[[:space:]]*\[ ]] && break
          if [[ $line =~ ^[[:space:]]*(name|account_id)[[:space:]]*= ]]; then
            [[ $line =~ $config_re ]] || fail "invalid worker name or account_id in wrangler.toml"
            field=${BASH_REMATCH[1]}
            [ -z "${!field}" ] || fail "duplicate worker $field in wrangler.toml"
            printf -v "$field" '%s' "${BASH_REMATCH[3]}"
          fi
        done < "$worker/wrangler.toml"
        [[ $name =~ ^[A-Za-z0-9_-]+$ && $account_id =~ ^[0-9a-f]{32}$ ]] \
          || fail "missing or invalid worker name or account_id in wrangler.toml"
        checkout=$(cd "$SHIP_CHECKOUT" && pwd -P) || fail "could not read SHIP_CHECKOUT"
        neutral="${XDG_CACHE_HOME:-$HOME/.cache}/ship-check-wrangler"
        [[ $neutral == /* && ! -L $neutral ]] || fail "unsafe neutral wrangler directory"
        mkdir -p "$neutral" || fail "could not create neutral wrangler directory"
        neutral=$(cd "$neutral" && pwd -P) || fail "could not read neutral wrangler directory"
        [[ $neutral != "$checkout" && $neutral != "$checkout/"* ]] || fail "neutral wrangler directory must be outside SHIP_CHECKOUT"
        contents=$(find "$neutral" -mindepth 1 -maxdepth 1 -print -quit) || fail "could not inspect neutral wrangler directory"
        [ -z "$contents" ] || fail "neutral wrangler directory must be empty"
        # npx also searches ancestors for local packages and executables.
        parent=$neutral
        while :; do
          [[ ! -e $parent/package.json && ! -e $parent/node_modules && ! -e $parent/.git ]] \
            || fail "neutral wrangler directory must be outside checkouts and local npm packages"
          [ "$parent" = / ] && break
          parent=${parent%/*}; parent=${parent:-/}
        done
        local -a wrangler=(npx --yes wrangler@3.114.17)
        deployment=$(cd "$neutral" && CLOUDFLARE_ACCOUNT_ID="$account_id" "${wrangler[@]}" deployments status --name "$name" --json 2>/dev/null) \
          || fail "could not read worker deployment in $worker"
        id=$(jq -er '.versions | select(type == "array" and length == 1) | .[0]
          | select(.percentage == 100) | .version_id | select(type == "string" and length > 0)' <<<"$deployment" 2>/dev/null) \
          || fail "worker deployment must have exactly one version at 100%"
        version=$(cd "$neutral" && CLOUDFLARE_ACCOUNT_ID="$account_id" "${wrangler[@]}" versions view "$id" --name "$name" --json 2>/dev/null) \
          || fail "could not read worker version $id"
        jq -e --arg sha "$sha" --arg tag "${sha:0:12}" \
          '.annotations["workers/message"] == $sha or .annotations["workers/tag"] == $tag' <<<"$version" >/dev/null 2>&1 \
          || fail "worker version $id does not match merge $sha"
        echo "deployed ok (worker $id)"; return
      fi
      if [[ $REPO == hypertask-ai/docs && $BASE == main ]]; then
        releases=$(gh release list -R "$REPO" --limit 1 --json tagName 2>/dev/null) || fail "could not read releases in $REPO"
        jq -e 'length == 0' <<<"$releases" >/dev/null || fail "no release found in $REPO"
        runs=$(gh api "repos/$REPO/actions/workflows/deploy.yml/runs?head_sha=$sha&event=push&per_page=100" 2>/dev/null) \
          || fail "could not read workflow runs for $sha"
        id=$(jq -r --arg sha "$sha" '[.workflow_runs[] | select(.path == ".github/workflows/deploy.yml"
          and .name == "Build and Deploy" and .event == "push" and .head_branch == "main"
          and .head_sha == $sha and .conclusion == "success")] | first | .id // empty' <<<"$runs") \
          || fail "could not read publishing workflow identity for $sha"
        [ -n "$id" ] || fail "no successful production publishing push for $sha"
        jobs=$(gh api "repos/$REPO/actions/runs/$id/jobs?per_page=100" 2>/dev/null) || fail "could not read publishing jobs for $sha"
        jq -e 'any(.jobs[]; .name == "Build and deploy to Cloudflare Pages" and .conclusion == "success")' <<<"$jobs" >/dev/null \
          || fail "no successful production deploy job for $sha"
        echo "deployed ok (workflow)"; return
      fi
      [[ $REPO == hypertask-ai/analytics && $BASE == master ]] || fail "no release found in $REPO"
      releases=$(gh release list -R "$REPO" --limit 1 --json tagName 2>/dev/null) || fail "could not read releases in $REPO"
      jq -e 'length == 0' <<<"$releases" >/dev/null || fail "no release found in $REPO"
      runs=$(gh api "repos/$REPO/actions/workflows/deploy.yml/runs?head_sha=$sha&event=push&per_page=100" 2>/dev/null) \
        || fail "could not read workflow runs for $sha"
      id=$(jq -r --arg sha "$sha" '[.workflow_runs[] | select(.path == ".github/workflows/deploy.yml"
        and .name == "Publish hypertask.app" and .event == "push" and .head_branch == "master"
        and .head_sha == $sha and .conclusion == "success")] | first | .id // empty' <<<"$runs") \
        || fail "could not read publishing workflow identity for $sha"
      [ -n "$id" ] || fail "no successful production publishing push for $sha"
      # This workflow can succeed with its production deploy job disabled.
      jobs=$(gh api "repos/$REPO/actions/runs/$id/jobs?per_page=100" 2>/dev/null) || fail "could not read publishing jobs for $sha"
      jq -e 'any(.jobs[]; .name == "deploy" and .conclusion == "success")' <<<"$jobs" >/dev/null \
        || fail "no successful production deploy job for $sha"
      echo "deployed ok (workflow)"; return
    fi
    cmp=$(gh api "repos/$REPO/compare/$sha...$tag" --jq .status 2>/dev/null) || fail "could not compare $sha with release $tag"
    [[ $cmp == ahead || $cmp == identical ]] || fail "latest release $tag of $REPO does not contain $sha yet"
    echo "deployed ok (release $tag)"; return
  fi
  local ignored
  ignored=$(gh api "repos/$REPO/commits/$sha/status" --jq '[.statuses[] | select(.context == "Vercel")][0]
    | select(.state == "success" and ((.description // "") | contains("Ignored Build Step"))) | .description' 2>/dev/null) \
    || fail "could not read Vercel commit status for $sha"
  if [ -n "$ignored" ]; then
    echo "deployed ok (no app build needed)"; return
  fi
  id=$(gh api "repos/$REPO/deployments?sha=$sha&environment=Production" --jq '.[0].id // empty' 2>/dev/null) \
    || fail "could not read deployments for $sha"
  [ -n "$id" ] || fail "no Production deployment for $sha"
  state=$(gh api "repos/$REPO/deployments/$id/statuses" --jq '.[0].state // empty' 2>/dev/null) \
    || fail "could not read deployment status for $sha"
  if [ "$state" != success ]; then
    # A failed build can still go live inside the next successful Production deploy.
    local live cmp
    live=$(newest_successful_production_sha) || fail "Production deployment for $sha is \"$state\""
    cmp=$(gh api "repos/$REPO/compare/$sha...$live" --jq .status 2>/dev/null) || fail "could not compare $sha with live $live"
    [[ $cmp == ahead || $cmp == identical ]] || fail "Production deployment for $sha is \"$state\""
    echo "deployed ok (live in ${live:0:9})"; return
  fi
  echo "deployed ok"
}

newest_successful_production_sha() {
  local d s
  for d in $(gh api "repos/$REPO/deployments?environment=Production&per_page=10" --jq '.[] | "\(.id):\(.sha)"' 2>/dev/null); do
    s=$(gh api "repos/$REPO/deployments/${d%%:*}/statuses" --jq '.[0].state // empty' 2>/dev/null) || return 1
    [ "$s" = success ] && { echo "${d#*:}"; return 0; }
  done
  return 1
}

check_proof() {
  local d="$EVID/$1" p="$EVID/$1/proof.md" sha run line f n=0
  [ -s "$p" ] || fail "missing $p (verify-qa evidence contract)"
  sha=$(merge_sha "$1") || { echo "$sha"; exit 1; }
  grep -qE '^[[:space:]]*Feature map: \.claude/skills/verify-qa/reference/feature-map/[a-z0-9-]+\.md' "$p" \
    || fail "proof.md has no 'Feature map: .claude/skills/verify-qa/reference/feature-map/<page>.md' line"
  grep -qE "^[[:space:]]*Doctor:.*${sha:0:9}.*success" "$p" \
    || fail "proof.md 'Doctor:' line must name the latest merge sha ${sha:0:9} and 'success' (stale proof?)"
  run=$(sed -nE 's/^[[:space:]]*Run:[[:space:]]*([0-9]{4}-[0-9]{2}-[0-9]{2}-qa-run-[0-9]+)[[:space:]]*$/\1/p' "$p" | head -1)
  [ -n "$run" ] && [ -d "$d/$run" ] || fail "proof.md needs a 'Run: <YYYY-MM-DD>-qa-run-<n>' line naming a folder under $d"
  grep -qE '^[[:space:]]*## Cases' "$p" || fail "proof.md has no '## Cases' section"
  ! grep -qE '^[[:space:]]*- FAIL:' "$p" || fail "proof.md still lists a FAIL case"
  # Every PASS bullet must end in "-> <file>" and that file must be non-empty inside the current run folder.
  while IFS= read -r line; do
    n=$((n+1))
    [[ $line =~ -\>[[:space:]]*([A-Za-z0-9._/-]+)[[:space:]]*$ ]] || fail "PASS line without a single evidence file: $line"
    f=${BASH_REMATCH[1]}
    [[ $f != *..* ]] && [ -s "$d/$run/$f" ] || fail "PASS evidence \"$f\" is missing or empty in $d/$run"
  done < <(grep -E '^[[:space:]]*- PASS:' "$p")
  [ "$n" -gt 0 ] || fail "proof.md has no '- PASS: <case> -> <evidence file>' line"
  [ -n "$(find "$d/$run" -name '*.png' -size +0 -print -quit)" ] || fail "no screenshot (*.png) in $d/$run"
  echo "proof ok"
}

check_done() {
  local s; s=$(hypertask tasks get "$1" --json 2>/dev/null | jq -r '.tasks[0].section // empty')
  [ "$s" = Done ] || fail "$1 is in \"$s\", not Done"
  echo "done ok"
}

check_cleaned() {
  local n b rc wt repo=${SHIP_CHECKOUT:-}
  if [ -z "$repo" ]; then
    [ "$REPO" = hypertask-ai/hypertask ] || fail "set SHIP_CHECKOUT to the local checkout of $REPO"
    repo=$HOME/projects/hypertask
  fi
  # Normal ticket: the bound PR's own branch. Duplicate (bound to another ticket's PR): the branch it
  # recorded with `ship-check branch` after `ship-check duplicate` (rebinding clears that record).
  if [ -s "$EVID/$1/duplicate-of" ]; then
    [ -s "$EVID/$1/branch" ] || fail "duplicate: record this session's branch first: ship-check branch $1 <branch>, or ship-check branch $1 none"
    b=$(cat "$EVID/$1/branch")
    [ "$b" = none ] && { echo "cleaned ok (duplicate, session recorded no branch)"; return 0; }
  else
    n=$(bound_pr "$1") || fail "no PR bound for $1"
    b=$(gh pr view "$n" -R "$REPO" --json headRefName --jq .headRefName 2>/dev/null) || fail "cannot read PR $n"
    [ -n "$b" ] || fail "PR $n has no branch name"
  fi
  wt=$(git -C "$repo" worktree list --porcelain) || fail "cannot list worktrees in $repo"
  grep -qxF "branch refs/heads/$b" <<<"$wt" && fail "a worktree still uses $b; run /clean-up"
  git -C "$repo" show-ref --verify --quiet "refs/heads/$b"; rc=$?
  [ "$rc" = 0 ] && fail "local branch $b still exists; run /clean-up"
  [ "$rc" = 1 ] || fail "cannot check local branch $b (git exit $rc)"
  git -C "$repo" ls-remote --exit-code --heads origin "$b" >/dev/null 2>&1; rc=$?
  [ "$rc" = 0 ] && fail "GitHub branch $b still exists; run /clean-up"
  [ "$rc" = 2 ] || fail "cannot check GitHub branch $b (git exit $rc)"
  echo "cleaned ok"
}

check_premerge() {
  [ "$REPO" = hypertask-ai/hypertask ] || return 0
  python3 - "$REPO" "$1" "$EVID" "${2:-}" <<'PY'
import base64, json, os, re, subprocess, sys, time, urllib.parse, urllib.request
from pathlib import Path

repo, pr, evidence, expected_sha = sys.argv[1:]
def gh(*args):
    result = subprocess.run(['gh', *args], capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise ValueError('cannot read the PR diff or source from GitHub; retry before merging')
    if '--paginate' not in args:
        return json.loads(result.stdout)
    pages, text = [], result.stdout.strip()
    while text:
        page, end = json.JSONDecoder().raw_decode(text)
        pages.append(page)
        text = text[end:].strip()
    return pages

cache = {}
def source(path, sha):
    if (path, sha) not in cache:
        row = gh('api', f'repos/{repo}/contents/{urllib.parse.quote(path, safe="/")}?ref={sha}')
        if row.get('encoding') != 'base64':
            raise ValueError('cannot read complete PR source; retry before merging')
        cache[path, sha] = base64.b64decode(row['content']).decode()
    return cache[path, sha]

def constants(text):
    return {m[0]: m[2] for m in re.findall(r'\bconst\s+(\w+)(?:\s*:\s*[^=;\n]+)?\s*=\s*([\'\"])(.*?)\2', text)}

def resolve(arg, keys):
    arg = arg.strip()
    if re.fullmatch(r'[\'\"][a-z0-9-]+[\'\"]', arg):
        return arg[1:-1]
    return keys.get(arg)

try:
    # Mutable PR endpoints can briefly serve an earlier head after a push.
    freshness = time.time_ns()
    row = gh('api', f'repos/{repo}/pulls/{pr}?premerge={freshness}')
    sha, base = row['head']['sha'], row['base']['sha']
    if not re.fullmatch(r'[0-9a-f]{40}', sha):
        raise ValueError('cannot read the full PR head sha')
    if expected_sha and sha != expected_sha:
        raise ValueError('PR head changed while checking evidence; retry')
    ticket = row['title'].split()[0]
    pages = gh('api', f'repos/{repo}/pulls/{pr}/files?per_page=100&premerge={freshness}', '--paginate')
    files = [f for page in pages for f in page]
    if len(files) != row['changed_files']:
        raise ValueError('cannot read the complete PR diff; retry before merging')
    touched, base_touched, unknown = set(), set(), False
    for f in files:
        versions = []
        if f['status'] != 'added':
            versions.append((f.get('previous_filename', f['filename']), base))
        if f['status'] != 'removed':
            versions.append((f['filename'], sha))
        for path, ref in versions:
            if not re.search(r'^src/.*\.(?:[cm]?js|jsx|ts|tsx)$', path):
                continue
            text = source(path, ref)
            readers = ['useFlag', 'isFeatureEnabled'] + re.findall(r'\b(?:useFlag|isFeatureEnabled)\s+as\s+(\w+)', text)
            for call in re.finditer(r'\b(?:' + '|'.join(readers) + r')\s*\(\s*([^,)\n]+)', text):
                if re.search(r'\bfunction\s*$', text[:call.start()]):
                    continue
                keys = constants(source('src/lib/flags/keys.ts', ref)) | constants(text)
                key = resolve(call[1], keys)
                if not key:
                    # Follow one `import { NAME } from "@/..."` hop to the module that defines the key.
                    name = call[1].strip()
                    imp = re.search(r'import\s*\{[^}]*\b' + re.escape(name) + r'\b[^}]*\}\s*from\s*[\'\"]@/([^\'\"]+)[\'\"]', text)
                    for ext in (('.ts', '.tsx', '/index.ts') if imp else ()):
                        try:
                            key = resolve(name, constants(source('src/' + imp[1] + ext, ref)))
                        except Exception:
                            continue
                        break
                if key:
                    touched.add(key)
                    if ref == base:
                        base_touched.add(key)
                else:
                    unknown = True
    if not touched and not unknown:
        print('no released flag touched')
        sys.exit(0)
    modes = None
    token = os.environ.get('AGENT_TOKEN') or os.environ.get('HYPERTASKS_JWT_TOKEN')
    if token:
        try:
            request = urllib.request.Request('https://app.hypertask.ai/api/admin/flags', headers={'Authorization': f'Bearer {token}'})
            with urllib.request.urlopen(request, timeout=10) as response:
                flags = json.load(response)['flags']
            if not all(f.get('mode') in ('OFF', 'OWNER_ONLY', 'OWNER_AND_QA', 'EVERYONE') for f in flags):
                raise ValueError('invalid modes')
            modes = {f['key']: f['mode'] for f in flags}
        except Exception:
            pass
    if modes is None:
        # /api/admin/flags is owner-only. A flag that is on for the plain QA account (user 2343, never in the QA group) is on for Everyone.
        # An expired or anonymous session gets 401, so this fails closed.
        state = os.environ.get('SHIP_CHECK_PLAIN_QA_STATE', os.path.expanduser('~/.config/hypertask-videos/storageState-qa-normal.json'))
        try:
            cookies = json.load(open(state))['cookies']
            cookie = '; '.join(f"{c['name']}={c['value']}" for c in cookies if 'hypertask' in c.get('domain', ''))
            request = urllib.request.Request('https://app.hypertask.ai/api/flags', headers={'Cookie': cookie})
            with urllib.request.urlopen(request, timeout=10) as response:
                seen = json.load(response)['flags']
            if not isinstance(seen, dict) or not seen or not all(isinstance(v, bool) for v in seen.values()):
                raise ValueError('invalid flags')
            modes = {key: 'EVERYONE' if on else 'NOT_EVERYONE' for key, on in seen.items()}
        except Exception:
            pass
    registry = source('src/lib/flags.ts', base)
    keys = constants(source('src/lib/flags/keys.ts', base))
    default = re.search(r'\bDEFAULT_FEATURE_FLAG_MODE[^=]*=\s*[\'\"](\w+)[\'\"]', registry)
    definitions_pattern = r'\bFEATURE_FLAG_DEFINITIONS\s*=\s*\[([\s\S]*?)\]\s*as const'
    definitions = re.search(definitions_pattern, registry)
    if not definitions:
        definitions = re.search(definitions_pattern, source('src/lib/flags/definitions.ts', base))
    if not default or not definitions:
        raise ValueError('cannot resolve flag registry defaults; record premerge evidence before merging')
    defaults = {}
    for block in re.findall(r'\{([^{}]*)\}', definitions[1]):
        key = re.search(r'\bkey:\s*([\'\"][^\'\"]+[\'\"]|\w+)', block)
        if key:
            defaults[resolve(key[1], keys)] = default[1]
    live = modes is not None
    if not live:
        print('note: live flag modes unavailable; registry defaults cannot prove a flag is not released')
        modes = defaults
    released = {key for key in touched if modes.get(key) == 'EVERYONE'}
    # A flag this PR defines (in head keys.ts, not in base keys.ts or registry, not read before) starts at Owner + QA.
    base_values = set(keys.values()) | set(defaults)
    head_values = set(constants(source('src/lib/flags/keys.ts', sha)).values())
    added = {key for key in touched if key in head_values and key not in base_values and key not in base_touched}
    unknown = unknown or not live or any(key not in modes and key not in added for key in touched)
    if not released and not unknown:
        print('no released flag touched')
        sys.exit(0)
    folder = Path(evidence) / ticket
    record = folder / 'premerge.md'
    reason = ', '.join(sorted(released)) if released else 'unresolved flag reads'
    message = f'{reason}: record a browser click-through on a real board against this PR build with live flag states in {record}'
    if not live:
        raise ValueError(message + ' (live flag modes unavailable; retry before merging)')
    missing_live = touched - modes.keys() - added
    if missing_live:
        raise ValueError(message + ' (live state unknown for ' + ', '.join(sorted(missing_live)) + ')')
    if not record.is_file():
        raise ValueError(message)
    fields = {key: value.strip() for key, value in re.findall(r'^(\w+):([^\n]*)', record.read_text(), re.M)}
    if fields.get('Commit') != sha:
        raise ValueError(f'{record} must name PR head sha {sha}; repeat the click-through after each push')
    for field in ('Account', 'Flags', 'Board', 'Build'):
        if not fields.get(field):
            expected = ', '.join(f'{key}=EVERYONE' for key in sorted(released))
            hint = f'; expected Flags: {expected}' if field == 'Flags' and expected else ''
            raise ValueError(message + f' (missing {field}:{hint})')
    board = urllib.parse.urlsplit(fields['Board'])
    board_ids = urllib.parse.parse_qs(board.query).get('id', [])
    canonical_board = board.path == '/project' and len(board_ids) == 1 and re.fullmatch(r'[1-9][0-9]*', board_ids[0])
    legacy_board = re.fullmatch(r'/projects/project-[1-9][0-9]*(?:[/?#]\S*)?', board.path)
    if board.scheme not in ('http', 'https') or not board.netloc or re.search(r'\s', fields['Board']) or not (canonical_board or legacy_board):
        raise ValueError(message + ' (Board: must name a real board URL, not /demo)')
    states = dict(part.strip().split('=', 1) for part in fields['Flags'].split(','))
    for key in sorted(touched):
        mode = modes.get(key)
        if key not in states and key in modes and mode != 'EVERYONE':
            continue
        # Plain QA proves only not-Everyone; an explicit non-Everyone mode remains compatible.
        valid = states.get(key) in ('OFF', 'OWNER_ONLY', 'OWNER_AND_QA', 'EVERYONE')
        if mode == 'NOT_EVERYONE':
            valid = states.get(key) in ('OFF', 'OWNER_ONLY', 'OWNER_AND_QA', 'NOT_EVERYONE')
        elif key in modes:
            valid = valid and states.get(key) == mode
        if not valid:
            expected = mode or 'OWNER_AND_QA'
            raise ValueError(message + f' (expected Flags: {key}={expected})')
    if not re.match(r'PASS\s+\S', fields.get('Click', '')) or not fields.get('Recording'):
        raise ValueError(message + ' (missing passing click or recording)')
    video = (folder / fields['Recording']).resolve()
    if not video.is_relative_to(folder.resolve()) or not video.is_file() or not video.stat().st_size:
        raise ValueError(message + ' (recording must be non-empty and inside the ticket evidence folder)')
    print('premerge ok')
except Exception as error:
    print('FAIL: ' + (str(error) if isinstance(error, ValueError) else 'cannot verify released-flag premerge evidence; retry before merging'))
    sys.exit(1)
PY
}

check_premerge_status() (
  [ "$REPO" = hypertask-ai/hypertask ] || return 0
  local sha current out lock state=failure description rc=1
  local state_dir=${PREMERGE_STATUS_STATE:-$HOME/.local/state/premerge-evidence}
  mkdir -p "$state_dir" && exec {lock}>"$state_dir/publish.lock" \
    && flock -x -w 600 "$lock" || fail "cannot lock premerge publisher; no success posted"
  local query='select(.state == "OPEN" and .baseRefName == "production").headRefOid'
  sha=$(gh pr view "$1" -R "$REPO" --json headRefOid,baseRefName,state --jq "$query" 2>/dev/null) \
    || fail "cannot read PR $1 head; no success posted"
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || fail "premerge status requires an open production PR with a full head sha; no status posted"
  if out=$(check_premerge "$1" "$sha"); then
    case "$out" in
      'no released flag touched') state=success; description=$out; rc=0 ;;
      'premerge ok'|*$'\npremerge ok') state=success; description='click record ok'; rc=0 ;;
      *) description='cannot verify premerge result; retry' ;;
    esac
  else
    echo "$out"
    description=${out##*$'\n'}; description=${description#FAIL: }
    if [[ $description == *' ('*')' ]]; then
      description=${description##* (}; description=${description%)}
    fi
  fi
  current=$(gh pr view "$1" -R "$REPO" --json headRefOid,baseRefName,state --jq "$query" 2>/dev/null) || current=''
  if [ "$current" != "$sha" ]; then
    state=failure; description='cannot confirm unchanged PR head; retry'; rc=1
  fi
  description=${description:-cannot verify premerge evidence; retry}
  gh api "repos/$REPO/statuses/$sha" --method POST -f context=premerge-evidence \
    -f "state=$state" -f "description=${description:0:140}" >/dev/null 2>&1 \
    || fail "cannot post premerge-evidence for PR $1; retry before merging"
  echo "premerge-evidence: $state ($description)"
  return "$rc"
)

guard() {
  local cmd seg rest t c pr out checks setting v part unquoted
  local fragment="(\"[^\"]*\"|'[^']*'|[^[:space:]\"']+)" assignment
  assignment="^([A-Za-z_][A-Za-z0-9_]*)=($fragment*)[[:space:]]+"
  local checkout=${SHIP_CHECKOUT:-} worker=${SHIP_WORKER:-}
  local SHIP_CHECKOUT=$checkout SHIP_WORKER=$worker
  export SHIP_CHECKOUT SHIP_WORKER
  local merge='gh[[:space:]]+pr[[:space:]]+merge([[:space:]]|$)'
  local done="vcc[[:space:]]+tasks?[[:space:]]+move[[:space:]]+[\"']?((HTPR|HYFA|YPER4)-[0-9]+)[\"']?[[:space:]].*--section[[:space:]=]+[\"']?Done"
  cmd=$(jq -r '.tool_input.command // empty')
  # Reset to process defaults so segment overrides cannot leak into later commands.
  while IFS= read -r seg; do
    REPO=${SHIP_REPO:-hypertask-ai/hypertask}; BASE=${SHIP_BASE:-production}
    SHIP_CHECKOUT=$checkout; SHIP_WORKER=$worker
    [[ $seg =~ ^[[:space:]]* ]]; rest=${seg:${#BASH_REMATCH[0]}}
    while [[ $rest =~ $assignment ]]; do
      setting=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
      rest=${rest:${#BASH_REMATCH[0]}}
      unquoted=""
      while [[ $v =~ ^$fragment ]]; do
        part=${BASH_REMATCH[0]}; v=${v:${#part}}
        [[ $part == \"* || $part == \'* ]] && part=${part:1:${#part}-2}
        unquoted+=$part
      done
      case $setting in
        SHIP_REPO) REPO=$unquoted ;;
        SHIP_BASE) BASE=$unquoted ;;
        SHIP_CHECKOUT|SHIP_WORKER) printf -v "$setting" '%s' "$unquoted" ;;
      esac
    done
    # Unparseable assignment prefixes must not hide a protected command.
    if [[ $seg =~ ^[[:space:]]*[^[:space:]]*= && ! $rest =~ ^$merge && ! $rest =~ ^$done \
      && ( $seg =~ (^|[[:space:]])$merge || $seg =~ (^|[[:space:]])$done ) ]]; then
      echo "ship-check blocked: cannot parse the leading environment assignments before the protected command." >&2; exit 2
    fi
    # PR merge: the PR must be named right and its ticket must exist.
    if [[ $rest =~ ^$merge ]]; then
      [[ $seg =~ (-R|--repo)[[:space:]=]+([^[:space:]]+) ]] && REPO=${BASH_REMATCH[2]}
      pr=""; [[ $seg =~ merge[[:space:]]+([0-9]+) ]] && pr=${BASH_REMATCH[1]}
      [ -n "$pr" ] || { echo "ship-check blocked the merge: name the PR number." >&2; exit 2; }
      out=$(check_title "$pr") || { echo "ship-check blocked the merge: ${out#FAIL: }. Retitle the PR to PREFIX-NNNN [TYPE] ... (create the ticket via vcc if it does not exist)." >&2; exit 2; }
      out=$(check_premerge_status "$pr") || { echo "ship-check blocked the merge: ${out#FAIL: }. Follow .claude/skills/verify-qa/SKILL.md before merging." >&2; exit 2; }
    fi
    # Move to Done: needs the merge and the deploy; app tickets also need proof.md.
    if [[ $rest =~ ^$done ]]; then
      [[ $rest =~ (HTPR|HYFA|YPER4)-[0-9]+ ]]; t=${BASH_REMATCH[0]}
      checks="merged deployed"; [[ $t == HTPR-* ]] && checks="merged deployed proof"
      for c in $checks; do
        out=$("check_$c" "$t") || { echo "ship-check blocked moving $t to Done: ${out#FAIL: }. Follow .claude/skills/verify-qa/SKILL.md first." >&2; exit 2; }
      done
    fi
  done < <(sed -E 's/(&&|\|\||;|\||&|\(|\))/\n/g' <<<"$cmd")
  exit 0
}

case "${1:-}" in
  bind) check_bind "$2" "$3" ;;
  branch) check_branch "$2" "${3:-}" ;;
  duplicate) check_duplicate "$2" "$3" "$4" ;;
  premerge) check_title "$2"; check_premerge "$2" ;;
  premerge-status) check_premerge_status "$2" ;;
  title) check_title "$2" ;;
  ticket) check_ticket "$2" ;;
  pr) check_pr "$2" ;;
  merged) check_merged "$2" ;;
  deployed) check_deployed "$2" ;;
  proof) check_proof "$2" ;;
  done) check_done "$2" ;;
  cleaned) check_cleaned "$2" ;;
  guard) guard ;;
  *) sed -n '2,18p' "$0"; exit 1 ;;
esac
