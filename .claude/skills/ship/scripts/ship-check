#!/usr/bin/env bash
# ship-check: proof checks for /ship sessions (Valentin, 2026-10-01).
# Used by the ledger gates (ship-gates) and by the Claude Code PreToolUse hook (guard).
#   ship-check bind <T> <pr>     record this session's PR for the ticket (run right after opening it)
#   ship-check branch <T> <b|none> record each branch this session created, or none
#   ship-check duplicate <T> <ORIG> <pr>  T was already fixed by ORIG's merged PR: gates then check that PR
#   ship-check dropped <T> <pr>  Valentin decided against T: PR is closed unmerged and a comment opens with Decided against: Valentin, <date>: "<words>"
#   ship-check elsewhere <T> [pr] the work landed elsewhere: the bound PR (or the given one) is merged in another repo or
#                                closed as outdated, and the ticket carries a comment opening "Resolved without a change:" that
#                                links that PR. Then pr, merged, deployed and proof pass; docs keeps its own rule.
#   ship-check nochange <T>      ticket (HTPR, YPER4, HYFA) solved with no code change: needs a comment opening "Resolved without a change:"
#                                with evidence (an https URL or a <pre>/<code> block), no open PR titled with T, no bound PR, and no origin
#                                branch named *<t lowercased>* with commits not in the base branch. Then merged, deployed, proof, pr and cleaned pass.
#   ship-check pr <T>            the ticket's PR exists and is named right
#   ship-check premerge <pr>     test click removed for every PR (hookless sessions)
#   ship-check premerge-status <pr> publish the required current-head GitHub status
#   ship-check title <pr>        PR title is "PREFIX-NNNN [TYPE] ..." and that ticket exists
#   ship-check ci-tests <pr>     latest ci-tests on the PR head passes; failures name tests and production status
#   ship-check ticket <T>        ticket exists on the board
#   ship-check deeper <T>        newest "Deeper:" agent activity names field, raw source, method, outside proof, breaks if and a
#                                proof gate <T>.deeper-<name> with CHECK: and EXPECT: in the ticket's ~/.unlazy/ledgers/<T>/gates/*.md
#   ship-check merged <T>        the ticket's newest PR is merged into the base branch
#   ship-check deployed <T>      the Production deployment for that merge is success (app repo only)
#   ship-check docs <T>          FEATURE/IMPROVE: docs PR merged and deployed, or a No user-visible change: reason
#   ship-check proof <T>         ~/.local/state/vcc-evidence/<T>/proof.md follows the verify-qa contract for that merge
#   ship-check done <T>          ticket is in the done column its own board names
#   ship-check cleaned <T>       only this session's recorded branches and worktrees are gone
#   ship-check move <T> <section> [project] [destination]  enforce completion before a board section write
#   ship-check guard             hook mode: reads the hook JSON on stdin, exit 2 blocks the command
# CLI work: SHIP_REPO=hypertask-ai/cli SHIP_BASE=main ship-check ...; a repo listed in NON_RELEASING_REPOS, or any repo with SHIP_DEPLOY=none, is checked against its workflow runs instead of a release.
# Every gate binds to the PR recorded with `bind` (required), so another
# PR's merge never stands in for this fix, and every GitHub lookup fails closed.
set -uo pipefail
REPO=${SHIP_REPO:-hypertask-ai/hypertask}
BASE=${SHIP_BASE:-production}
readonly -a NON_RELEASING_REPOS=(hypertask-ai/cli-node valentinyeo/ceo)
EVID=${VCC_EVIDENCE_DIR:-$HOME/.local/state/vcc-evidence}
PREFIXES='HTPR|HYFA|YPER4|HYCI|IGSH|MARK|HEFE'
TITLE_RE="^($PREFIXES)-[0-9]+ \\[(BUG|BUGFIX|FEATURE|IMPROVE|CLI/MCP/AI|SPEED|FEEDBACK|DASH|QA|BOARD|COST|PLAN|INFRA|REFACTOR)\\] [^ ]"

fail() { echo "FAIL: $*"; exit 1; }

check_ticket() {
  hypertask tasks get "$1" --json 2>/dev/null | jq -e '.success == true and (.tasks | length) > 0' >/dev/null \
    || fail "ticket $1 not found on the board"
  echo "ticket ok"
}

# One folder per ticket, outside the project: ship-gates writes the ledger here and every
# gate tool reads it from the same place.
ledger_gates_dir() { printf '%s/.unlazy/ledgers/%s/gates' "${SHIP_STATE_ROOT:-$HOME}" "$1"; }

deeper_gate_runnable() {
  local f
  for f in "$(ledger_gates_dir "$1")"/*.md; do
    [ -f "$f" ] || continue
    awk -v id="$2" '
      /^- \[[ xX]\] / { inside = substr($0, 7, length(id) + 1) == id ":"; next }
      /^[^ ]/ { inside = 0 }
      inside && /^  CHECK: *[^ ]/ { check = 1 }
      inside && /^  EXPECT: *[^ ]/ { expect = 1 }
      END { exit !(check && expect) }' "$f" && return 0
  done
  return 2
}

check_deeper() {
  local t=${1:-} acts text label id
  [[ $t =~ ^($PREFIXES)-[0-9]+$ ]] || fail "deeper needs a ticket id like HTPR-123, YPER4-123 or HYFA-123; ${t:-<none>} is not one"
  acts=$(ht GET "/mcp/tasks/$t/agent-activity?limit=100" 2>/dev/null) || fail "cannot read agent activity of $t"
  text=$(jq -er '[.activities[] | select(.type == "thought" and ((.text // "") | test("^\\s*Deeper:")))]
    | max_by(.createdAt) | .text' <<<"$acts" 2>/dev/null) \
    || fail "$t has no agent activity starting with \"Deeper:\"; write it right after ship-gates (/ship step 3a)"
  for label in field 'raw source' method 'outside proof' 'breaks if' 'proof gate'; do
    grep -qi "$label:" <<<"$text" || fail "the Deeper: activity on $t has no \"$label:\" part"
  done
  id=$(grep -oE "proof gate: *$t\.deeper-[a-z0-9-]+" <<<"$text" | head -1 | sed -E 's/^proof gate: *//')
  [ -n "$id" ] || fail "the Deeper: activity on $t must name its proof gate as \"proof gate: $t.deeper-<name>\""
  deeper_gate_runnable "$t" "$id" \
    || fail "$id has no gate with CHECK: and EXPECT: in $(ledger_gates_dir "$t")/*.md; a manual note does not count"
  echo "deeper ok"
}

check_title() {
  local t; t=$(gh pr view "$1" -R "$REPO" --json title --jq .title 2>/dev/null) || fail "PR $1 not found"
  [[ $t =~ $TITLE_RE ]] || fail "PR $1 title \"$t\" must be PREFIX-NNNN [TYPE] description"
  ( check_ticket "${t%% *}" ) >/dev/null || fail "PR $1 names ${t%% *}, which is not on the board"
  echo "title ok"
}

latest_ci_tests() {
  local json; json=$(gh api "repos/$REPO/commits/$1/check-runs?per_page=100&filter=all" --paginate 2>/dev/null) || return 1
  jq -cs 'if length > 0 and all(.[]; (.check_runs | type) == "array") then
    [.[].check_runs[] | select(.name == "ci-tests")] | max_by([.id, .started_at])
    else error("cannot read check runs") end' <<<"$json"
}

ci_test_failures() {
  local id url log names
  id=$(jq -r '.id' <<<"$1"); url=$(jq -r '.html_url' <<<"$1")
  if log=$(gh api "repos/$REPO/actions/jobs/$id/logs" 2>/dev/null); then
    names=$(python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ci-test-failures.py" <<<"$log")
    [ -z "$names" ] || { echo "$names"; return 0; }
  fi
  echo "see $url"
}

check_ci_tests() {
  local sha run status conclusion reason production details
  local unreadable="cannot read ci-tests for PR $1; retry"
  # Only the app repo has ci-tests; other repos must not depend on these API reads.
  [ "$REPO" = hypertask-ai/hypertask ] || return 0
  sha=$(gh api "repos/$REPO/pulls/$1" --jq .head.sha 2>/dev/null) || fail "$unreadable"
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || fail "$unreadable"
  run=$(latest_ci_tests "$sha") || fail "$unreadable"
  if [ "$run" = null ]; then
    fail "ci-tests is missing on head ${sha:0:7}; wait for the current-head run, or retrigger it (gh workflow run, or push the branch again)"
  fi
  status=$(jq -r '.status' <<<"$run"); conclusion=$(jq -r '.conclusion' <<<"$run")
  if [ "$status" != completed ]; then fail "ci-tests has not finished on head ${sha:0:7}"; fi
  # Only a real green run counts: a newer skipped or neutral run must not hide a failed one (ci-tests.yml).
  case "$conclusion" in success)
    # A green run on an older base can hide a test that fails on today's red production (PR 1392).
    production=$(latest_ci_tests "$BASE") || fail "$unreadable"
    if [ "$(jq -r '.status' <<<"$production")" = completed ] \
      && [[ $(jq -r '.conclusion' <<<"$production") =~ ^(failure|cancelled|timed_out|action_required|stale)$ ]] \
      && [[ $(jq -r '.started_at' <<<"$run") < $(jq -r '.started_at' <<<"$production") ]]; then
      fail "production ci-tests is red ($(ci_test_failures "$production")) and this PR's ci-tests passed before that on an older production; rerun ci-tests on head ${sha:0:7}"$'\n'"run ci-why $(jq -r '.html_url' <<<"$production") for the failed step"
    fi
    echo "ci-tests ok"; return 0 ;;
  esac
  details=$(ci_test_failures "$run")
  reason="ci-tests $conclusion on head ${sha:0:7} ($details)"
  production=$(latest_ci_tests "$BASE") || fail "$unreadable"
  status=$(jq -r '.status' <<<"$production"); conclusion=$(jq -r '.conclusion' <<<"$production")
  if [ "$status" = completed ]; then
    case "$conclusion" in
      success) reason+="; production ci-tests is green, so this PR broke it" ;;
      failure|cancelled|timed_out|action_required|stale)
        details=$(ci_test_failures "$production")
        reason+="; production ci-tests is also red ($details), so check whether your change broke it or it was already broken" ;;
    esac
  fi
  fail "$reason"$'\n'"run ci-why $1 for the failed step"
}

# Newest PR for the ticket into BASE, as "number state mergeSha". Exits 1 if GitHub cannot be read.
newest_pr() {
  local json; json=$(gh pr list -R "$REPO" --state all --base "$BASE" --search "$1 in:title" --limit 50 \
    --json number,title,state,createdAt,mergeCommit 2>/dev/null) || return 1
  jq -r --arg t "$1 " '[.[] | select(.title | startswith($t))] | sort_by(.createdAt) | last
    | if . == null then "" else "\(.number) \(.state) \(.mergeCommit.oid // "-")" end' <<<"$json"
}

bound_pr() { local f="$EVID/$1/pr"; [ -s "$f" ] && tr -dc '0-9' < "$f"; }
# The ticket whose PR title the bound PR must carry: the ticket itself, or the one it duplicates.
# Older merged PRs put the type first ("[BUGFIX] HTPR-6501 ..."). Accepted only for a duplicate's fixing PR.
OLD_TITLE_RE="^\\[(BUG|BUGFIX|FEATURE|IMPROVE|CLI/MCP/AI|SPEED|FEEDBACK|DASH|QA|BOARD|COST|PLAN|INFRA|REFACTOR)\\] ($PREFIXES)-[0-9]+ [^ ]"

pr_owner() { local f="$EVID/$1/duplicate-of"; if [ -s "$f" ]; then tr -dc 'A-Z0-9-' < "$f"; else echo "$1"; fi; }

pr_row() {
  local n json; n=$(bound_pr "$1")
  if [ -n "$n" ]; then
    json=$(gh pr view "$n" -R "$REPO" --json number,title,state,mergeCommit,baseRefName 2>/dev/null) || return 1
    local dup=false; [ -s "$EVID/$1/duplicate-of" ] && dup=true
    jq -r --arg t "$(pr_owner "$1") " --arg b "$BASE" --argjson dup "$dup" 'if ((.title | startswith($t))
        or ($dup and (.title | test("^\\[[A-Z/]+\\] " + $t)))) and .baseRefName == $b
      then "\(.number) \(.state) \(.mergeCommit.oid // "-")" else "" end' <<<"$json"
  else echo "FAIL: no PR bound for $1; run ship-check bind $1 <pr number> right after opening it"; return 1; fi
}

check_branch() {
  local session=${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}} record
  [[ ${2:-} =~ ^[A-Za-z0-9._/-]+$ ]] || fail "usage: ship-check branch <T> <branch|none>"
  [[ $session =~ ^[A-Za-z0-9_-]+$ ]] || fail "cleanup needs this session's full id"
  record="$EVID/$1/cleanup/$session"
  mkdir -p "$(dirname "$record")" || fail "cannot create cleanup record"
  if [ -s "$record" ] && ! grep -qxF -- "$2" "$record"; then
    [ "$2" != none ] && ! grep -qxF none "$record" || fail "cannot replace recorded cleanup ownership with none"
  fi
  grep -qxF -- "$2" "$record" 2>/dev/null || echo "$2" >> "$record" || fail "cannot record cleanup ownership"
  if [ -s "$EVID/$1/duplicate-of" ]; then echo "$2" > "$EVID/$1/branch"; fi
  echo "recorded branch $2 for $1"
}

check_bind() {
  local t; t=$(gh pr view "$2" -R "$REPO" --json title --jq .title 2>/dev/null) || fail "PR $2 not found in $REPO"
  [[ $t == "$1 "* ]] || fail "PR $2 is titled \"$t\", not $1"
  mkdir -p "$EVID/$1" && echo "$2" > "$EVID/$1/pr" && echo "$REPO" > "$EVID/$1/repo" && echo "$BASE" > "$EVID/$1/base" && rm -f "$EVID/$1/duplicate-of" "$EVID/$1/dropped" "$EVID/$1/branch" "$EVID/$1/nochange" "$EVID/$1/elsewhere" && echo "bound $1 to PR $2"
}

check_duplicate() {
  local t; t=$(gh pr view "$3" -R "$REPO" --json title,state --jq '"\(.state) \(.title)"' 2>/dev/null) || fail "PR $3 not found in $REPO"
  [[ $t == "MERGED $2 "* || ( $t == "MERGED ["* && ${t#MERGED } =~ $OLD_TITLE_RE && ${t#MERGED } == *"] $2 "* ) ]] \
    || fail "PR $3 must be the merged PR of $2, got: $t"
  ( check_ticket "$1" ) >/dev/null || fail "ticket $1 not found on the board"
  # The fix is already merged, so a deleted original ticket does not block the duplicate path.
  ( check_ticket "$2" ) >/dev/null || echo "note: $2 is no longer on the board; PR $3 is merged, so it still counts"
  mkdir -p "$EVID/$1" && rm -f "$EVID/$1/branch" "$EVID/$1/dropped" "$EVID/$1/nochange" "$EVID/$1/elsewhere" && echo "$3" > "$EVID/$1/pr" && echo "$2" > "$EVID/$1/duplicate-of" \
    && echo "bound $1 as a duplicate of $2 (PR $3)"
}

# Valentin decided against the ticket: the PR is closed unmerged and a "Decided against:" comment quotes his dated decision.
check_dropped() {
  local s; s=$(gh pr view "$2" -R "$REPO" --json title,state,baseRefName --jq '"\(.state) \(.baseRefName) \(.title)"' 2>/dev/null) \
    || fail "PR $2 not found in $REPO"
  [[ $s == "CLOSED $BASE $1 "* ]] || fail "PR $2 must be a CLOSED (not merged, not open) PR of $1 into $BASE, got: $s"
  # The visible text (tags and their attribute quotes removed, quote entities decoded) must open with the record
  # Decided against: Valentin, 2026-10-10: "his words"   (an optional short note such as ", in chat" may follow the date).
  hypertask comment list "$1" --limit 100 --json 2>/dev/null | jq -e '.comments | any(.[];
      (.text // "") | gsub("<[^>]*>"; "") | gsub("&quot;|&#x22;|&#34;"; "\"")
      | test("^\\s*Decided against:\\s*Valentin,\\s*20[0-9]{2}-[0-9]{2}-[0-9]{2}(,[^:\"“”]{0,40})?:\\s*[\"“][^\"“”]+[\"”]"))' >/dev/null \
    || fail "$1 has no comment opening with: Decided against: Valentin, <YYYY-MM-DD>: \"<his words>\""
  mkdir -p "$EVID/$1" && rm -f "$EVID/$1/duplicate-of" "$EVID/$1/branch" "$EVID/$1/nochange" "$EVID/$1/elsewhere" && echo "$2" > "$EVID/$1/pr" && echo "$2" > "$EVID/$1/dropped" \
    && echo "recorded $1 as dropped (PR $2 closed unmerged)"
}

# Dropped ticket: passes only while the bound PR is still closed and unmerged.
dropped_ok() {
  [ -s "$EVID/$2/dropped" ] || return 1
  local n row state sha; n=$(tr -dc '0-9' < "$EVID/$2/dropped")
  [ "$n" = "$(bound_pr "$2")" ] || fail "dropped PR $n is no longer the bound PR for $2"
  row=$(pr_row "$2") || fail "${row#FAIL: }"
  read -r n state sha <<<"$row"
  [ "$state" = CLOSED ] && [ "$sha" = - ] || fail "dropped PR $n for $2 is $state, not closed unmerged"
  echo "$1 ok (dropped: PR $n closed unmerged)"
}

# Ticket (HTPR, YPER4, HYFA) solved with no code change (YPER4-272, YPER4-283). The "Resolved without a change:" comment must carry evidence,
# and no PR may exist for the ticket: no open PR titled with it, no bound PR, no origin branch named for it that is ahead of BASE.
# nochange_verify prints the reason and returns 1 instead of exiting, so every consumer re-runs it (the marker is only a record).
nochange_checkout() {
  local repo=${SHIP_CHECKOUT:-}
  if [ -z "$repo" ]; then
    [ "$REPO" = hypertask-ai/hypertask ] || { echo "set SHIP_CHECKOUT to the local checkout of $REPO"; return 1; }
    repo=$HOME/projects/hypertask
  fi
  echo "$repo"
}

# Branch names of origin that carry the lowercased ticket id not followed by a digit (yper4-901 does not match yper4-9010).
nochange_origin_branches() {
  local low=${1,,} repo heads
  repo=$(nochange_checkout) || { echo "$repo"; return 1; }
  heads=$(git -C "$repo" ls-remote --heads origin "*$low*" 2>/dev/null) || { echo "cannot list origin branches"; return 1; }
  awk '{print $2}' <<<"$heads" | sed 's#^refs/heads/##' | grep -E -- "${low}([^0-9]|\$)" || true
}

# The closing record: one comment whose visible text (tags removed, leading space dropped) opens with
# "Resolved without a change:" and carries evidence in that same comment: an https URL, or a <pre>/<code>
# block whose visible inner text is not blank. Returns 2 when the comments cannot be read.
resolution_comment() {
  local t=$1 repo=${2:-} pr=${3:-} cmts
  cmts=$(hypertask comment list "$t" --limit 100 --json 2>/dev/null) || return 2
  jq -e --arg repo "$repo" --arg pr "$pr" '
    ($repo | gsub("\\."; "\\.")) as $r
    | .comments | any(.[]; (.text // "") as $x
      | ($x | gsub("<[^>]*>"; "") | test("^\\s*Resolved without a change:"))
      and (($x | test("https://[A-Za-z0-9][^\\s\"<>]*"))
        or ([$x | scan("(?s)<(?:pre|code)[^>]*>(.*?)</(?:pre|code)>") | .[0]
             | gsub("<[^>]*>|&nbsp;|&#160;|&#xa0;"; "") | select(test("\\S"))] | length > 0))
      and ($pr == "" or ($x | test("github\\.com/" + $r + "/pull/" + $pr + "([^0-9]|$)"))))' >/dev/null <<<"$cmts"
}

resolution_comment_reason() {
  echo "$1 has no comment opening with \"Resolved without a change:\" that also carries evidence (an https URL, or a <pre>/<code> block with non-blank command output)"
}

nochange_verify() {
  local t=${1:-} open b ahead rc
  [[ $t =~ ^($PREFIXES)-[0-9]+$ ]] || { echo "nochange needs a ticket id like HTPR-123, YPER4-123 or HYFA-123; ${t:-<none>} is not one"; return 1; }
  if [ -n "$(bound_pr "$t")" ] || [ -s "$EVID/$t/duplicate-of" ] || [ -s "$EVID/$t/dropped" ]; then
    echo "$t has a bound PR (or a duplicate/dropped record); use the normal path"; return 1
  fi
  resolution_comment "$t"; rc=$?
  [ "$rc" = 2 ] && { echo "cannot read comments of $t"; return 1; }
  [ "$rc" = 0 ] || { resolution_comment_reason "$t"; return 1; }
  open=$(gh pr list -R "$REPO" --state open --search "$t in:title" --limit 50 --json number,title 2>/dev/null) \
    || { echo "cannot read open PRs of $REPO"; return 1; }
  if jq -e --arg t "$t " 'any(.[]; .title | startswith($t))' >/dev/null <<<"$open"; then echo "$t has an open PR; use the normal path"; return 1; fi
  b=$(nochange_origin_branches "$t") || { echo "$b"; return 1; }
  while read -r b; do
    [ -n "$b" ] || continue
    ahead=$(gh api "repos/$REPO/compare/$BASE...$b" --jq .ahead_by 2>/dev/null) || { echo "cannot compare origin branch $b with $BASE"; return 1; }
    [ "${ahead:-0}" = 0 ] || { echo "origin branch $b has $ahead commit(s) not in $BASE; ship it or delete it first"; return 1; }
  done <<<"$(nochange_origin_branches "$t")"
  return 0
}

check_nochange() {
  local out; out=$(nochange_verify "${1:-}") || fail "$out"
  mkdir -p "$EVID/$1" && rm -f "$EVID/$1/branch" && date -u +%FT%TZ > "$EVID/$1/nochange" && echo "nochange ok"
}

# Nochange ticket: the marker is only a record. Every use re-runs the full check, so a PR or branch that
# appears after "nochange ok" (or a comment that went away) stops the pass.
nochange_ok() {
  [ -s "$EVID/$2/nochange" ] || return 1
  local out; out=$(nochange_verify "$2") || fail "nochange for $2 no longer holds: $out"
  # The pr gate expects "title ok"; there is no PR title to check, so say why it passes.
  if [ "$1" = pr ]; then echo "title ok (nochange: resolved without a change, no PR)"; else echo "$1 ok (nochange: resolved without a change)"; fi
}

# A ticket finished elsewhere (YPER4-949): the work landed under another ticket or another repo, so its PR is merged
# there, or it was closed as outdated. The record is the closing comment with a link, so the ticket closes without a
# fresh release proof. Like dropped, the marker is only a record: every read re-checks the PR state.
check_elsewhere() {
  local t=${1:-} n prev prev_repo prev_state state rc
  [[ $t =~ ^($PREFIXES)-[0-9]+$ ]] || fail "elsewhere needs a ticket id like HTPR-123, YPER4-123 or HYFA-123; ${t:-<none>} is not one"
  # The binding is a repository and a number; the saved repository is where the old PR has to be read.
  prev=$(bound_pr "$t"); prev_repo=$(cat "$EVID/$t/repo" 2>/dev/null); prev_repo=${prev_repo:-$REPO}
  n=${2:-$prev}
  [[ $n =~ ^[0-9]+$ ]] || fail "$t has no bound PR; run ship-check elsewhere $t <pr number>"
  state=$(gh pr view "$n" -R "$REPO" --json state --jq .state 2>/dev/null) || fail "PR $n not found in $REPO"
  case $state in
    MERGED|CLOSED) ;;
    *) fail "PR $n is $state; elsewhere needs a merged or a closed PR" ;;
  esac
  # Another PR may replace the binding only once it is finished too, so an unrelated closed PR cannot stand in
  # for work that is still open.
  if [ -n "$prev" ] && { [ "$prev" != "$n" ] || [ "$prev_repo" != "$REPO" ]; }; then
    prev_state=$(gh pr view "$prev" -R "$prev_repo" --json state --jq .state 2>/dev/null) \
      || fail "cannot read the bound PR $prev of $t in $prev_repo"
    case $prev_state in
      MERGED|CLOSED) ;;
      *) fail "$t is still bound to PR $prev in $prev_repo ($prev_state); finish or close it before recording another PR" ;;
    esac
  fi
  resolution_comment "$t" "$REPO" "$n"; rc=$?
  [ "$rc" = 2 ] && fail "cannot read comments of $t"
  [ "$rc" = 0 ] || fail "$t has no comment opening with \"Resolved without a change:\" that links https://github.com/$REPO/pull/$n and carries evidence (an https URL, or a <pre>/<code> block with output)"
  mkdir -p "$EVID/$t" && rm -f "$EVID/$t/branch" "$EVID/$t/dropped" "$EVID/$t/nochange" "$EVID/$t/duplicate-of" \
    && echo "$n" > "$EVID/$t/pr" && echo "$REPO" > "$EVID/$t/repo" && echo "$BASE" > "$EVID/$t/base" \
    && echo "$n" > "$EVID/$t/elsewhere" && echo "recorded $t as finished elsewhere (PR $n $state in $REPO)"
}

# Finished elsewhere: passes only while the recorded PR is still merged or closed.
elsewhere_ok() {
  [ -s "$EVID/$2/elsewhere" ] || return 1
  local n state; n=$(tr -dc '0-9' < "$EVID/$2/elsewhere")
  [ "$n" = "$(bound_pr "$2")" ] || fail "elsewhere PR $n is no longer the bound PR for $2"
  state=$(gh pr view "$n" -R "$REPO" --json state --jq .state 2>/dev/null) || fail "cannot read PR $n for $2"
  case $state in
    MERGED|CLOSED) ;;
    *) fail "elsewhere PR $n for $2 is $state, not merged or closed" ;;
  esac
  if [ "$1" = pr ]; then echo "title ok (elsewhere: PR $n $state)"; else echo "$1 ok (elsewhere: PR $n $state)"; fi
}

merge_sha() {
  local row n state sha
  row=$(pr_row "$1") || fail "${row#FAIL: }"
  [ -n "$row" ] || fail "no PR titled \"$1 [TYPE] ...\" into $BASE (or the bound PR does not match)"
  read -r n state sha <<<"$row"
  [ "$state" = MERGED ] || fail "the PR for $1 (#$n) is $state, not merged"
  echo "$sha"
}

check_pr() {
  nochange_ok pr "$1" && return 0
  elsewhere_ok pr "$1" && return 0
  local row; row=$(pr_row "$1") || fail "${row#FAIL: }"
  [ -n "$row" ] || fail "no PR titled \"$1 [TYPE] ...\""
  # A duplicate's PR was checked at bind time and is merged; its original ticket may since be deleted.
  if [ -s "$EVID/$1/duplicate-of" ]; then
    local t; t=$(gh pr view "${row%% *}" -R "$REPO" --json title --jq .title 2>/dev/null)
    [[ $t =~ $TITLE_RE || $t =~ $OLD_TITLE_RE ]] \
      || fail "PR ${row%% *} title must be PREFIX-NNNN [TYPE] description"
    echo "title ok"
  else
    check_title "${row%% *}"
    if [[ $row == *" OPEN "* ]]; then check_premerge_status "${row%% *}"; fi
  fi
}

check_merged() { dropped_ok merged "$1" && return 0; nochange_ok merged "$1" && return 0; elsewhere_ok merged "$1" && return 0; local s; s=$(merge_sha "$1") || { echo "$s"; exit 1; }; echo "merged ok"; }

docs_deploy_ok() {
  local sha=$1 runs id jobs
  runs=$(gh api "repos/hypertask-ai/docs/actions/workflows/deploy.yml/runs?head_sha=$sha&per_page=100" 2>/dev/null) \
    || fail "could not read workflow runs for $sha"
  id=$(jq -r --arg sha "$sha" '[.workflow_runs[] | select(.path == ".github/workflows/deploy.yml"
    and .name == "Build and Deploy" and (.event == "push" or .event == "workflow_dispatch") and .head_branch == "main"
    and .head_sha == $sha and .conclusion == "success")] | first | .id // empty' <<<"$runs") \
    || fail "could not read publishing workflow identity for $sha"
  [ -n "$id" ] || fail "no successful production publishing run for $sha"
  jobs=$(gh api "repos/hypertask-ai/docs/actions/runs/$id/jobs?per_page=100" 2>/dev/null) || fail "could not read publishing jobs for $sha"
  jq -e 'any(.jobs[]; .name == "Build and deploy to Cloudflare Pages" and .conclusion == "success")' <<<"$jobs" >/dev/null \
    || fail "no successful production deploy job for $sha"
}

live_proof_ok() {
  local t=$1 sha=$2 f="$EVID/$1/live-proof" psha source check unit fragment out
  [ -s "$f" ] || return 1
  psha=$(sed -n 's/^sha:[[:space:]]*//p' "$f" | head -1)
  source=$(sed -n 's/^source:[[:space:]]*//p' "$f" | head -1)
  check=$(sed -n 's/^check:[[:space:]]*//p' "$f" | head -1)
  [ "$psha" = "$sha" ] && [[ $sha =~ ^[0-9a-f]{40}$ ]] || return 1
  [[ $source == /* && $source != *..* ]] && [ -d "$source" ] || return 1
  git -C "$source" cat-file -e "$sha^{commit}" 2>/dev/null || return 1
  git -C "$source" merge-base --is-ancestor "$sha" HEAD 2>/dev/null || return 1
  case $check in
    reviewer-workflow)
      [[ $REPO == hypertask-ai/reviewer && $BASE == main ]] || return 1
      local ci review target head url run metadata jobs statuses kind
      ci=$(sed -n 's/^ci:[[:space:]]*//p' "$f" | head -1)
      review=$(sed -n 's/^review:[[:space:]]*//p' "$f" | head -1)
      target=$(sed -n 's/^target:[[:space:]]*//p' "$f" | head -1)
      head=$(sed -n 's/^head:[[:space:]]*//p' "$f" | head -1)
      [[ $target =~ ^https://github\.com/hypertask-ai/hypertask/pull/[1-9][0-9]*$ && $head =~ ^[0-9a-f]{40}$ ]] || return 1
      for kind in ci review; do
        url=$ci; [ "$kind" != review ] || url=$review
        [[ $url =~ ^https://github\.com/hypertask-ai/reviewer/actions/runs/[1-9][0-9]*$ ]] || return 1
        run=${url##*/}
        metadata=$(gh api "repos/$REPO/actions/runs/$run" 2>/dev/null) || return 1
        jq -e --arg sha "$sha" --arg run "$run" --arg kind "$kind" --arg target "${target##*/}" --arg head "$head" '
          (.id | tostring) == $run and .head_sha == $sha and .head_branch == "main"
          and .status == "completed" and .conclusion == "success"
          and (if $kind == "ci" then .path == ".github/workflows/ci.yml" and (.event == "push" or .event == "workflow_dispatch")
            else .path == ".github/workflows/review.yml" and .event == "repository_dispatch"
              and .display_title == ("Review hypertasks PR #" + $target + " @ " + $head) end)' <<<"$metadata" >/dev/null || return 1
        jobs=$(gh api "repos/$REPO/actions/runs/$run/jobs?per_page=100" --paginate 2>/dev/null) || return 1
        jq -es --arg kind "$kind" 'all(.[]; (.jobs | type) == "array") and any(.[].jobs[];
          .status == "completed" and .conclusion == "success"
          and (if $kind == "ci" then .name == "test"
            else any(.steps[]; (.name | startswith("Review pull request with ")) and .conclusion == "success") end))' <<<"$jobs" >/dev/null || return 1
      done
      statuses=$(gh api "repos/hypertask-ai/hypertask/commits/$head/statuses?per_page=100" --paginate 2>/dev/null) || return 1
      jq -es --arg url "$review" 'if all(.[]; type == "array") then add else error("invalid statuses") end
        | [.[] | select(.target_url == $url)] | group_by(.context) | map(max_by(.id))
        | any(.[]; .context == "ai-review" and .state == "success")
          and any(.[]; .context == "claude-review" and .state == "success")' <<<"$statuses" >/dev/null
      ;;
    systemd-user-unit\ *)
      unit=${check#systemd-user-unit }
      [[ $unit =~ ^[A-Za-z0-9@._-]+\.service$ ]] || return 1
      fragment=$(systemctl --user show "$unit" -p FragmentPath --value 2>/dev/null) || return 1
      [ -f "$fragment" ] || return 1
      tmp=$(mktemp -d) || return 1
      if ! git -C "$source" show "$sha:systemd/$unit" > "$tmp/unit" 2>/dev/null; then rm -rf "$tmp"; return 1; fi
      if ! cmp -s "$fragment" "$tmp/unit"; then rm -rf "$tmp"; return 1; fi
      exec=$(sed -n 's/^ExecStart=//p' "$tmp/unit" | head -1)
      target=${exec%% *}
      target=${target/#\%h/$HOME}
      if [[ $target != "$source"/* ]]; then rm -rf "$tmp"; return 1; fi
      relative=${target#"$source"/}
      if ! git -C "$source" show "$sha:$relative" > "$tmp/payload" 2>/dev/null; then rm -rf "$tmp"; return 1; fi
      if ! cmp -s "$target" "$tmp/payload"; then rm -rf "$tmp"; return 1; fi
      rm -rf "$tmp"
      out=$(systemctl --user show "$unit" -p Result -p ExecMainStatus 2>/dev/null) || return 1
      grep -qx 'Result=success' <<<"$out" && grep -qx 'ExecMainStatus=0' <<<"$out"
      ;;
    *) return 1 ;;
  esac
}

check_deployed() {
  dropped_ok deployed "$1" && return 0
  elsewhere_ok deployed "$1" && return 0
  nochange_ok deployed "$1" && return 0
  local sha id state
  sha=$(merge_sha "$1") || { echo "$sha"; exit 1; }
  if [ "$REPO" != hypertask-ai/hypertask ]; then
    local tag cmp releases runs jobs
    if ! tag=$(gh release view -R "$REPO" --json tagName --jq .tagName 2>/dev/null); then
      local no_release=false repo run_url
      for repo in "${NON_RELEASING_REPOS[@]}"; do
        [ "$REPO" != "$repo" ] || no_release=true
      done
      if [[ $no_release == true || ${SHIP_DEPLOY:-} == none ]]; then
        releases=$(gh release list -R "$REPO" --limit 1 --json tagName 2>/dev/null) || fail "could not read releases in $REPO"
        jq -e 'type == "array" and length == 0' <<<"$releases" >/dev/null || fail "no release found in $REPO"
        cmp=$(gh api "repos/$REPO/compare/$BASE...$sha" --jq .status 2>/dev/null) || fail "could not compare merge $sha with $BASE"
        [[ $cmp == identical || $cmp == behind ]] || fail "merge $sha is not on $BASE"
        if [[ $REPO == hypertask-ai/reviewer && $BASE == main ]]; then
          [[ $(sed -n 's/^check:[[:space:]]*//p' "$EVID/$1/live-proof" 2>/dev/null | head -1) == reviewer-workflow ]] && live_proof_ok "$1" "$sha" \
            || fail "reviewer deployment needs exact-engine CI and live review proof in $EVID/$1/live-proof"
          echo "deployed ok (reviewer workflow proof, merged ${sha:0:9} on $BASE)"; return
        fi
        # Paginate so a green first page cannot hide a failed workflow for the same merge.
        runs=$(gh api "repos/$REPO/actions/runs?head_sha=$sha&per_page=100" --paginate 2>/dev/null) \
          || fail "could not read workflow runs for $sha"
        runs=$(jq -cs 'if length > 0 and all(.[]; (.workflow_runs | type) == "array") then
          [.[].workflow_runs[]] else error("invalid workflow runs") end' <<<"$runs" 2>/dev/null) \
          || fail "could not read workflow runs for $sha"
        if jq -e --arg sha "$sha" 'any(.[]; .head_sha == $sha and .conclusion == "failure")' <<<"$runs" >/dev/null; then
          fail "failed workflow run for merge $sha; no-release deployment requires no failures"
        fi
        if jq -e --arg sha "$sha" 'any(.[]; .head_sha == $sha and .status != "completed")' <<<"$runs" >/dev/null; then
          fail "workflow run for merge $sha is still running; wait until every run finishes"
        fi
        run_url=$(jq -r --arg sha "$sha" --arg base "$BASE" '[.[] | select(.head_sha == $sha
          and (.event == "push" or .event == "workflow_dispatch") and .head_branch == $base
          and .conclusion == "success")] | first | .html_url // empty' <<<"$runs") \
          || fail "could not read successful workflow run for $sha"
        [ -n "$run_url" ] || {
          if ! jq -e 'length > 0' <<<"$runs" >/dev/null && live_proof_ok "$1" "$sha"; then
            echo "deployed ok (recorded live proof, merged ${sha:0:9} on $BASE)"; return
          fi
          fail "no successful push or workflow_dispatch run for merge $sha on $BASE; record the live proof in $EVID/$1/live-proof with sha:, source: and check: lines"
        }
        echo "deployed ok (no release: merged ${sha:0:9} on $BASE, green run $run_url)"; return
      fi
      if [ -n "${SHIP_WORKER:-}" ]; then
        releases=$(gh release list -R "$REPO" --limit 1 --json tagName 2>/dev/null) || fail "could not read releases in $REPO"
        jq -e 'length == 0' <<<"$releases" >/dev/null || fail "no release found in $REPO"
        [[ ${SHIP_CHECKOUT:-} == /* ]] || fail "set SHIP_CHECKOUT to the local checkout of $REPO"
        [[ $SHIP_WORKER =~ ^[A-Za-z0-9._/\ -]+$ && $SHIP_WORKER != /* && /$SHIP_WORKER/ != *'/../'* ]] \
          || fail "SHIP_WORKER must be a relative worker directory inside SHIP_CHECKOUT"
        [[ $sha =~ ^[0-9a-f]{40}$ ]] || fail "invalid merge sha for worker deployment: $sha"
        local deployment version worker="$SHIP_CHECKOUT/$SHIP_WORKER"
        local name= account_id= line field checkout neutral parent contents
        local config_re="^[[:space:]]*(name|account_id)[[:space:]]*=[[:space:]]*([\"'])([A-Za-z0-9_-]+)\\2[[:space:]]*(#.*)?$"
        [ -f "$worker/wrangler.toml" ] && [ -r "$worker/wrangler.toml" ] || fail "could not read worker wrangler.toml"
        while IFS= read -r line || [ -n "$line" ]; do
          [[ $line =~ ^[[:space:]]*\[ ]] && break
          if [[ $line =~ ^[[:space:]]*(name|account_id)[[:space:]]*= ]]; then
            [[ $line =~ $config_re ]] || fail "invalid worker name or account_id in wrangler.toml"
            field=${BASH_REMATCH[1]}
            [ -z "${!field}" ] || fail "duplicate worker $field in wrangler.toml"
            printf -v "$field" '%s' "${BASH_REMATCH[3]}"
          fi
        done < "$worker/wrangler.toml"
        [[ $name =~ ^[A-Za-z0-9_-]+$ && $account_id =~ ^[0-9a-f]{32}$ ]] \
          || fail "missing or invalid worker name or account_id in wrangler.toml"
        checkout=$(cd "$SHIP_CHECKOUT" && pwd -P) || fail "could not read SHIP_CHECKOUT"
        neutral="${XDG_CACHE_HOME:-$HOME/.cache}/ship-check-wrangler"
        [[ $neutral == /* && ! -L $neutral ]] || fail "unsafe neutral wrangler directory"
        mkdir -p "$neutral" || fail "could not create neutral wrangler directory"
        neutral=$(cd "$neutral" && pwd -P) || fail "could not read neutral wrangler directory"
        [[ $neutral != "$checkout" && $neutral != "$checkout/"* ]] || fail "neutral wrangler directory must be outside SHIP_CHECKOUT"
        contents=$(find "$neutral" -mindepth 1 -maxdepth 1 -print -quit) || fail "could not inspect neutral wrangler directory"
        [ -z "$contents" ] || fail "neutral wrangler directory must be empty"
        # npx also searches ancestors for local packages and executables.
        parent=$neutral
        while :; do
          [[ ! -e $parent/package.json && ! -e $parent/node_modules && ! -e $parent/.git ]] \
            || fail "neutral wrangler directory must be outside checkouts and local npm packages"
          [ "$parent" = / ] && break
          parent=${parent%/*}; parent=${parent:-/}
        done
        local -a wrangler=(npx --yes wrangler@3.114.17)
        deployment=$(cd "$neutral" && CLOUDFLARE_ACCOUNT_ID="$account_id" "${wrangler[@]}" deployments status --name "$name" --json 2>/dev/null) \
          || fail "could not read worker deployment in $worker"
        id=$(jq -er '.versions | select(type == "array" and length == 1) | .[0]
          | select(.percentage == 100) | .version_id | select(type == "string" and length > 0)' <<<"$deployment" 2>/dev/null) \
          || fail "worker deployment must have exactly one version at 100%"
        version=$(cd "$neutral" && CLOUDFLARE_ACCOUNT_ID="$account_id" "${wrangler[@]}" versions view "$id" --name "$name" --json 2>/dev/null) \
          || fail "could not read worker version $id"
        jq -e --arg sha "$sha" --arg tag "${sha:0:12}" \
          '.annotations["workers/message"] == $sha or .annotations["workers/tag"] == $tag' <<<"$version" >/dev/null 2>&1 \
          || fail "worker version $id does not match merge $sha"
        echo "deployed ok (worker $id)"; return
      fi
      if [[ $REPO == hypertask-ai/docs && $BASE == main ]]; then
        releases=$(gh release list -R "$REPO" --limit 1 --json tagName 2>/dev/null) || fail "could not read releases in $REPO"
        jq -e 'length == 0' <<<"$releases" >/dev/null || fail "no release found in $REPO"
        docs_deploy_ok "$sha"
        echo "deployed ok (workflow)"; return
      fi
      [[ $REPO == hypertask-ai/analytics && $BASE == master ]] || fail "no release found in $REPO"
      releases=$(gh release list -R "$REPO" --limit 1 --json tagName 2>/dev/null) || fail "could not read releases in $REPO"
      jq -e 'length == 0' <<<"$releases" >/dev/null || fail "no release found in $REPO"
      runs=$(gh api "repos/$REPO/actions/workflows/deploy.yml/runs?head_sha=$sha&per_page=100" 2>/dev/null) \
        || fail "could not read workflow runs for $sha"
      id=$(jq -r --arg sha "$sha" '[.workflow_runs[] | select(.path == ".github/workflows/deploy.yml"
        and .name == "Publish hypertask.app" and (.event == "push" or .event == "workflow_dispatch") and .head_branch == "master"
        and .head_sha == $sha and .conclusion == "success")] | first | .id // empty' <<<"$runs") \
        || fail "could not read publishing workflow identity for $sha"
      [ -n "$id" ] || fail "no successful production publishing run for $sha"
      # This workflow can succeed with its production deploy job disabled.
      jobs=$(gh api "repos/$REPO/actions/runs/$id/jobs?per_page=100" 2>/dev/null) || fail "could not read publishing jobs for $sha"
      jq -e 'any(.jobs[]; .name == "deploy" and .conclusion == "success")' <<<"$jobs" >/dev/null \
        || fail "no successful production deploy job for $sha"
      echo "deployed ok (workflow)"; return
    fi
    cmp=$(gh api "repos/$REPO/compare/$sha...$tag" --jq .status 2>/dev/null) || fail "could not compare $sha with release $tag"
    [[ $cmp == ahead || $cmp == identical ]] || fail "latest release $tag of $REPO does not contain $sha yet"
    echo "deployed ok (release $tag)"; return
  fi
  local ignored
  ignored=$(gh api "repos/$REPO/commits/$sha/status" --jq '[.statuses[] | select(.context == "Vercel")][0]
    | select(.state == "success" and ((.description // "") | contains("Ignored Build Step"))) | .description' 2>/dev/null) \
    || fail "could not read Vercel commit status for $sha"
  if [ -n "$ignored" ]; then
    echo "deployed ok (no app build needed)"; return
  fi
  id=$(gh api "repos/$REPO/deployments?sha=$sha&environment=Production" --jq '.[0].id // empty' 2>/dev/null) \
    || fail "could not read deployments for $sha"
  local live
  if [ -z "$id" ]; then
    # Vercel can skip a merge's build and ship it inside the next Production deploy.
    live=$(live_production_sha_containing "$sha") || fail "no Production deployment for $sha"
    echo "deployed ok (live in ${live:0:9})"; return
  fi
  state=$(gh api "repos/$REPO/deployments/$id/statuses" --jq '.[0].state // empty' 2>/dev/null) \
    || fail "could not read deployment status for $sha"
  if [ "$state" != success ]; then
    # A failed build can still go live inside the next successful Production deploy.
    live=$(live_production_sha_containing "$sha") || fail "Production deployment for $sha is \"$state\""
    echo "deployed ok (live in ${live:0:9})"; return
  fi
  echo "deployed ok"
}

live_production_sha_containing() {
  local live cmp
  live=$(newest_successful_production_sha) || return 1
  cmp=$(gh api "repos/$REPO/compare/$1...$live" --jq .status 2>/dev/null) || return 1
  [[ $cmp == ahead || $cmp == identical ]] || return 1
  echo "$live"
}

check_docs() {
  dropped_ok docs "$1" && return 0
  nochange_ok docs "$1" && return 0
  local n title type prs sha cmts owner
  # On the duplicate path the docs PR belongs to the ticket that shipped the fix.
  owner=$(pr_owner "$1")
  n=$(bound_pr "$1")
  [ -n "$n" ] || fail "no PR bound for $1; run ship-check bind $1 <pr number> right after opening it"
  title=$(gh pr view "$n" -R "$REPO" --json title --jq .title 2>/dev/null) || fail "cannot read PR $n title"
  [[ $title =~ $TITLE_RE || $title =~ $OLD_TITLE_RE ]] || fail "PR $n title must be PREFIX-NNNN [TYPE] description"
  [[ $title =~ \[([^]]+)\] ]]; type=${BASH_REMATCH[1]}
  if [[ $type != FEATURE && $type != IMPROVE ]]; then
    echo "docs ok (not needed for [$type])"; return
  fi
  prs=$(gh pr list -R hypertask-ai/docs --base main --state merged --search "$owner in:title" --limit 100 --json number,title,mergeCommit,baseRefName,state 2>/dev/null) \
    || fail "could not read docs PRs"
  while read -r n sha; do
    [ -n "$n" ] || continue
    if ( docs_deploy_ok "$sha" ) >/dev/null 2>&1; then echo "docs ok (docs PR $n)"; return; fi
  done < <(jq -r --arg t "$owner" '.[] | select(.state == "MERGED" and .baseRefName == "main"
    and (.title | test("(^|[^A-Z0-9])" + $t + "([^A-Z0-9]|$)")))
    | select(.mergeCommit.oid != null) | "\(.number) \(.mergeCommit.oid)"' <<<"$prs")
  cmts=$(hypertask comment list "$1" --limit 100 --json 2>/dev/null) || fail "cannot read comments of $1"
  if jq -e '.comments | any(.[]; (.text // "") | gsub("<[^>]*>|&nbsp;|&#160;|&#xa0;"; "")
      | test("^\\s*No user-visible change:\\s*\\S"))' >/dev/null <<<"$cmts"; then
    echo "docs ok (no user-visible change)"; return
  fi
  fail "[$type] ticket $1 has no merged and deployed docs PR in hypertask-ai/docs titled with $owner, and no \"No user-visible change:\" comment"
}

newest_successful_production_sha() {
  local d s
  for d in $(gh api "repos/$REPO/deployments?environment=Production&per_page=10" --jq '.[] | "\(.id):\(.sha)"' 2>/dev/null); do
    s=$(gh api "repos/$REPO/deployments/${d%%:*}/statuses" --jq '.[0].state // empty' 2>/dev/null) || return 1
    [ "$s" = success ] && { echo "${d#*:}"; return 0; }
  done
  return 1
}

check_proof() {
  local d="$EVID/$1" p="$EVID/$1/proof.md" sha run line f n=0
  dropped_ok proof "$1" && return 0
  elsewhere_ok proof "$1" && return 0
  nochange_ok proof "$1" && return 0
  [ -s "$p" ] || fail "missing $p (verify-qa evidence contract)"
  sha=$(merge_sha "$1") || { echo "$sha"; exit 1; }
  grep -qE '^[[:space:]]*Feature map: \.claude/skills/verify-qa/reference/feature-map/[a-z0-9-]+\.md' "$p" \
    || fail "proof.md has no 'Feature map: .claude/skills/verify-qa/reference/feature-map/<page>.md' line"
  grep -qE "^[[:space:]]*Doctor:.*${sha:0:9}.*success" "$p" \
    || fail "proof.md 'Doctor:' line must name the latest merge sha ${sha:0:9} and 'success' (stale proof?)"
  run=$(sed -nE 's/^[[:space:]]*Run:[[:space:]]*([0-9]{4}-[0-9]{2}-[0-9]{2}-qa-run-[0-9]+)[[:space:]]*$/\1/p' "$p" | head -1)
  [ -n "$run" ] && [ -d "$d/$run" ] || fail "proof.md needs a 'Run: <YYYY-MM-DD>-qa-run-<n>' line naming a folder under $d"
  grep -qE '^[[:space:]]*## Cases' "$p" || fail "proof.md has no '## Cases' section"
  ! grep -qE '^[[:space:]]*- FAIL:' "$p" || fail "proof.md still lists a FAIL case"
  # Every PASS bullet must end in "-> <file>" and that file must be non-empty inside the current run folder.
  while IFS= read -r line; do
    n=$((n+1))
    [[ $line =~ -\>[[:space:]]*([A-Za-z0-9._/-]+)[[:space:]]*$ ]] || fail "PASS line without a single evidence file: $line"
    f=${BASH_REMATCH[1]}
    [[ $f != *..* ]] && [ -s "$d/$run/$f" ] || fail "PASS evidence \"$f\" is missing or empty in $d/$run"
  done < <(grep -E '^[[:space:]]*- PASS:' "$p")
  [ "$n" -gt 0 ] || fail "proof.md has no '- PASS: <case> -> <evidence file>' line"
  [ -n "$(find "$d/$run" -name '*.png' -size +0 -print -quit)" ] || fail "no screenshot (*.png) in $d/$run"
  echo "proof ok"
}

check_completion() {
  local t=$1 section_title=$2 explicit=${3:-false} explicit_base=${4:-false} c out checks
  if [ -s "$EVID/$t/repo" ]; then
    if [ "$explicit" = false ]; then
      REPO=$(cat "$EVID/$t/repo") || { echo "ship-check blocked moving $t: could not read bound repo." >&2; exit 2; }
    fi
    if [ "$explicit_base" = false ] && [ -s "$EVID/$t/base" ]; then
      BASE=$(cat "$EVID/$t/base") || { echo "ship-check blocked moving $t: could not read bound base." >&2; exit 2; }
    fi
  fi
  checks="merged deployed docs"; [[ $t == HTPR-* ]] && checks="merged deployed proof docs"
  for c in $checks; do
    if [ "$c" = docs ]; then
      out=$(check_docs "$t") || { echo "ship-check blocked moving $t to \"$section_title\": ${out#FAIL: }. Merge a docs PR titled with $t or post a No user-visible change: <reason> ticket comment." >&2; exit 2; }
      continue
    fi
    out=$("check_$c" "$t") || { echo "ship-check blocked moving $t to \"$section_title\": ${out#FAIL: }. Follow .claude/skills/verify-qa/SKILL.md first." >&2; exit 2; }
  done
}

check_blocked_handoff() {
  local comments text
  comments=$(hypertask comment list "$1" --sort createdAt:desc --limit 1 --json 2>/dev/null) \
    || fail "cannot read the blocked handoff for $1"
  text=$(jq -er 'select(.success == true and (.comments | type) == "array") |
    .comments | sort_by(.createdAt) | last | .text // ""' <<<"$comments") \
    || fail "cannot parse the blocked handoff for $1"
  python3 - "$text" <<'PYCODE'
import html
import re
import sys
text = html.unescape(re.sub(r"</(?:p|li|div)>|<br\s*/?>", "\n", sys.argv[1], flags=re.I))
text = re.sub(r"<[^>]*>", "", text)
killed = r"\bsigkill\b|exit(?:\s+code)?[ :]*(?:137|9)\b|\bkilled\b|\boom\b"
check = r"\btests?\b|\bchecks?\b|node|npm|pytest|tsc"
def local_failure(statement):
    if not re.search(check, statement, re.I):
        return False
    environments = list(re.finditer(r"\blocal\b|\bvps\b|\bCI\b", statement, re.I))
    for failure in re.finditer(killed, statement, re.I):
        preceding = [environment for environment in environments if environment.start() < failure.start()]
        environment = preceding[-1] if preceding else next(iter(environments), None)
        if environment and environment.group().lower() != "ci":
            return True
    return False

statements = re.split(r"[.!?](?:\s+|$)|[;\n]+", text)
if any(local_failure(statement) for statement in statements):
    blockers = re.findall(r"^\s*Blocker:\s*(.+)$", text, re.I | re.M)
    if not any(not any(local_failure(part) for part in re.split(r"[.!?](?:\s+|$)|[;\n]+", blocker))
               for blocker in blockers):
        print("FAIL: a killed local check is not a blocker; push and let CI decide. "
              "For an independent failure, add Blocker: <exact error>.")
        sys.exit(1)
PYCODE
}

check_move() {
  local ref=${1:-} section=${2:-} project=${3:-} destination=${4:-} t rc
  local -a args=(tasks get "$ref" --json)
  [ -z "$project" ] || args+=(--project "$project")
  t=$(hypertask "${args[@]}" 2>/dev/null | jq -er --arg prefixes "^($PREFIXES)-[0-9]+$" \
    '.tasks | select(length == 1) | .[0].ticketNumber | select(test($prefixes))') || fail "cannot resolve ticket $ref for completion checks"
  local title="$section" board=${destination:-$project}
  if [[ $section =~ ^[0-9]+$ ]]; then
    [ -n "$board" ] || board=$(hypertask tasks get "$t" --json | jq -er '.tasks[0].boardId // .tasks[0].projectId') \
      || fail "cannot read the board of $t"
    title=$(hypertask section list --project "$board" --json |
      jq -er --arg id "$section" '.sections[] | select((.id | tostring) == $id) | .section_title') \
      || fail "cannot resolve destination column $section"
  fi
  if [[ $title == "Agent Blocked"* ]]; then check_blocked_handoff "$t" || return 1; fi
  is_done_section "$t" "$section" "${destination:-$project}"; rc=$?
  [ "$rc" != 3 ] || fail "cannot resolve destination column $section; refusing section change"
  if [ "$rc" = 0 ]; then
    local explicit=false explicit_base=false
    [ "${SHIP_REPO+x}" != x ] || explicit=true
    [ "${SHIP_BASE+x}" != x ] || explicit_base=true
    check_completion "$t" "$section" "$explicit" "$explicit_base"
  fi
  echo "move ok"
}

is_done_section() {
  local t=$1 title=$2 board=${3:-} sections is_done
  title=${title//\"/}
  title=${title//\'/}
  title=${title//\\/}
  [ "$title" = Done ] && return 0
  [ -n "$board" ] || board=$(hypertask tasks get "$t" --json 2>/dev/null |
    jq -r '.tasks[0].boardId // .tasks[0].projectId // empty')
  [ -n "$board" ] || return 3
  sections=$(hypertask section list --project "$board" --json 2>/dev/null) || return 3
  is_done=$(jq -r --arg title "$title" '
    [.sections[] | select(.section_title == $title or (.id | tostring) == $title)] as $matches |
    if ($matches | length) != 1 then "unknown"
    elif $matches[0].isDone == null then ($matches[0].section_title | test("^(done|shipped|live|released)$"; "i") | tostring)
    else ($matches[0].isDone == true | tostring) end
  ' <<<"$sections") || return 3
  [ -n "$is_done" ] || return 3
  [ "$is_done" != unknown ] || return 3
  [ "$is_done" = true ]
}

check_done() {
  local section rc
  section=$(hypertask tasks get "$1" --json 2>/dev/null | jq -r '.tasks[0].section // empty')
  [ -n "$section" ] || fail "cannot read the section of $1"
  is_done_section "$1" "$section"; rc=$?
  [ "$rc" = 3 ] && fail "cannot match \"$section\" against the columns of the board holding $1; retry when the board answers"
  [ "$rc" = 0 ] || fail "$1 is in \"$section\", which is not the board's done column"
  echo "done ok"
}

cleaned_branch_checks() {
  local repo=$1 b=$2 rc wt
  wt=$(git -C "$repo" worktree list --porcelain) || fail "cannot list worktrees in $repo"
  grep -qxF "branch refs/heads/$b" <<<"$wt" && fail "a worktree still uses $b; run /clean-up"
  git -C "$repo" show-ref --verify --quiet "refs/heads/$b"; rc=$?
  [ "$rc" = 0 ] && fail "local branch $b still exists; run /clean-up"
  [ "$rc" = 1 ] || fail "cannot check local branch $b (git exit $rc)"
  git -C "$repo" ls-remote --exit-code --heads origin "$b" >/dev/null 2>&1; rc=$?
  [ "$rc" = 0 ] && fail "GitHub branch $b still exists; run /clean-up"
  [ "$rc" = 2 ] || fail "cannot check GitHub branch $b (git exit $rc)"
}

check_cleaned() {
  local b repo=${SHIP_CHECKOUT:-} session=${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}} record
  [[ $session =~ ^[A-Za-z0-9_-]+$ ]] || fail "cleanup needs this session's full id"
  record="$EVID/$1/cleanup/$session"
  [ -s "$record" ] || fail "record this session's branches first: ship-check branch $1 <branch>, or none if you created none"
  if [ -z "$repo" ]; then
    [ "$REPO" = hypertask-ai/hypertask ] || fail "set SHIP_CHECKOUT to the local checkout of $REPO"
    repo=$HOME/projects/hypertask
  fi
  while IFS= read -r b; do
    [[ $b =~ ^[A-Za-z0-9._/-]+$ ]] || fail "invalid recorded cleanup branch"
    [ "$b" = none ] || cleaned_branch_checks "$repo" "$b"
  done < "$record"
  echo "cleaned ok (this session's branches only)"
}

check_premerge() {
  echo 'test click removed (Valentin 2026-10-21)'
}

check_premerge_status() (
  [ "$REPO" = hypertask-ai/hypertask ] || return 0
  local sha current lock state=success description rc=0
  local state_dir=${PREMERGE_STATUS_STATE:-$HOME/.local/state/premerge-evidence}
  mkdir -p "$state_dir" && exec {lock}>"$state_dir/publish.lock" \
    && flock -x -w 600 "$lock" || fail "cannot lock premerge publisher; no success posted"
  local query='select(.state == "OPEN" and .baseRefName == "production").headRefOid'
  sha=$(gh pr view "$1" -R "$REPO" --json headRefOid,baseRefName,state --jq "$query" 2>/dev/null) \
    || fail "cannot read PR $1 head; no success posted"
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || fail "premerge status requires an open production PR with a full head sha; no status posted"
  description=$(check_premerge)
  current=$(gh pr view "$1" -R "$REPO" --json headRefOid,baseRefName,state --jq "$query" 2>/dev/null) || current=''
  if [ "$current" != "$sha" ]; then
    state=failure; description='cannot confirm unchanged PR head; retry'; rc=1
  fi
  gh api "repos/$REPO/statuses/$sha" --method POST -f context=premerge-evidence \
    -f "state=$state" -f "description=${description:0:140}" >/dev/null 2>&1 \
    || fail "cannot post premerge-evidence for PR $1; retry before merging"
  echo "premerge-evidence: $state ($description)"
  return "$rc"
)

guard() {
  local cmd seg rest t c pr out checks setting v part unquoted input cwd target explicit explicit_base unresolved moved=false section_title done_section
  local fragment="(\"[^\"]*\"|'[^']*'|[^[:space:]\"']+)" assignment
  assignment="^([A-Za-z_][A-Za-z0-9_]*)=($fragment*)[[:space:]]+"
  local checkout=${SHIP_CHECKOUT:-} worker=${SHIP_WORKER:-} deploy=${SHIP_DEPLOY:-}
  local SHIP_CHECKOUT=$checkout SHIP_WORKER=$worker SHIP_DEPLOY=$deploy
  export SHIP_CHECKOUT SHIP_WORKER SHIP_DEPLOY
  local merge='gh[[:space:]]+pr[[:space:]]+merge([[:space:]]|$)'
  local section_flag="--section([[:space:]]+|=)(\"[^\"]*\"|'[^']*'|[^[:space:]]+)"
  local done="vcc[[:space:]]+tasks?[[:space:]]+(move|update)[[:space:]]+[\"']?($PREFIXES)-[0-9]+[\"']?[[:space:]].*$section_flag"
  input=$(cat)
  cmd=$(jq -er '.tool_input.command | select(type == "string")' <<<"$input") || {
    echo "ship-check blocked: cannot read the hook command." >&2; exit 2;
  }
  cwd=$(jq -r '.cwd | if type == "string" then . else "" end' <<<"$input")
  # Reset to process defaults so segment overrides cannot leak into later commands.
  while IFS= read -r seg; do
    REPO=${SHIP_REPO:-hypertask-ai/hypertask}; BASE=${SHIP_BASE:-production}
    SHIP_CHECKOUT=$checkout; SHIP_WORKER=$worker; SHIP_DEPLOY=$deploy
    explicit=false; [ "${SHIP_REPO+x}" != x ] || explicit=true
    explicit_base=false; [ "${SHIP_BASE+x}" != x ] || explicit_base=true
    [[ $seg =~ ^[[:space:]]* ]]; rest=${seg:${#BASH_REMATCH[0]}}
    while [[ $rest =~ $assignment ]]; do
      setting=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
      rest=${rest:${#BASH_REMATCH[0]}}
      unquoted=""
      while [[ $v =~ ^$fragment ]]; do
        part=${BASH_REMATCH[0]}; v=${v:${#part}}
        [[ $part == \"* || $part == \'* ]] && part=${part:1:${#part}-2}
        unquoted+=$part
      done
      case $setting in
        SHIP_REPO) REPO=$unquoted; explicit=true ;;
        SHIP_BASE) BASE=$unquoted; explicit_base=true ;;
        SHIP_CHECKOUT|SHIP_WORKER|SHIP_DEPLOY) printf -v "$setting" '%s' "$unquoted" ;;
      esac
    done
    # A cd earlier in the command means the hook cwd no longer names the merge repo.
    # Any cd word counts (builtin cd, command cd, env ... cd): fail closed, never guess.
    [[ $rest =~ (^|[[:space:]\"\'])(cd|pushd|popd)([[:space:]\"\']|$) ]] && moved=true
    # Unparseable assignment prefixes must not hide a protected command.
    if [[ $seg =~ ^[[:space:]]*[^[:space:]]*= && ! $rest =~ ^$merge && ! $rest =~ ^$done \
      && ( $seg =~ (^|[[:space:]])$merge || $seg =~ (^|[[:space:]])$done ) ]]; then
      echo "ship-check blocked: cannot parse the leading environment assignments before the protected command." >&2; exit 2
    fi
    # PR merge: the PR must be named right and its ticket must exist.
    if [[ $rest =~ ^$merge ]]; then
      # Only a positively resolved foreign repo may bypass the Hypertask checks.
      target=$(python3 - "$rest" "$cwd" "$REPO" "$explicit" "$moved" <<'PY'
import re, shlex, subprocess, sys
command, cwd, repo, explicit, moved = sys.argv[1:]
try:
    tokens = shlex.split(command, comments=True)
    flag = False
    for i, token in enumerate(tokens):
        if token == '--':
            break
        if token in ('-R', '--repo'):
            repo = tokens[i + 1]
            if repo.startswith('-'):
                raise ValueError('missing repo flag value')
            flag = True
        elif token.startswith('--repo='):
            repo = token.split('=', 1)[1]
            flag = True
        elif token.startswith('-R'):
            repo = token[2:].removeprefix('=')
            flag = True
        # Only the PR argument right after `gh pr merge` names a repo; URLs elsewhere
        # (redirections, here-strings, flag values) are not the merge target.
        elif i == 3 and (url := re.fullmatch(r'(?:https?://)?(?:www\.)?github\.com/([^/]+/[^/]+)/pull/\d+(?:[/?#].*)?', token, re.I)):
            repo = url[1]
            flag = True
    if not flag and explicit != 'true':
        if not cwd or moved == 'true':
            raise ValueError('missing or changed cwd')
        repo = subprocess.check_output(['git', '-C', cwd, 'remote', 'get-url', 'origin'],
                                       stderr=subprocess.DEVNULL, text=True).strip()
        remote = re.fullmatch(r'(?:https?://(?:[^/@]+@)?|ssh://(?:[^/@]+@)?|git://|git@)github\.com[:/]([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?)(?:\.git)?/?', repo, re.I)
        if not remote:
            raise ValueError('unreadable GitHub origin')
        repo = remote[1]
    repo = re.sub(r'^github\.com/', '', repo, flags=re.I)
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repo):
        raise ValueError('unparseable repo')
    print(repo.lower())
except (ValueError, IndexError, OSError, subprocess.CalledProcessError):
    sys.exit(1)
PY
      ) || target=""
      unresolved=""
      if [ -z "$target" ]; then
        REPO=hypertask-ai/hypertask
        unresolved=" Target repo could not be resolved; name it with -R owner/repo or SHIP_REPO=owner/repo."
      else
        REPO=$target
        # valentinyeo/ht-slack moved to hypertask-ai/slack; old checkouts still name it.
        [[ ${REPO,,} == valentinyeo/ht-slack ]] && REPO=hypertask-ai/slack
        [[ ${REPO,,} == hypertask-ai/* || $explicit == true ]] || continue
      fi
      pr=""; [[ $seg =~ merge[[:space:]]+([0-9]+) ]] && pr=${BASH_REMATCH[1]}
      [ -n "$pr" ] || { echo "ship-check blocked the merge: name the PR number.$unresolved" >&2; exit 2; }
      out=$(check_title "$pr") || { echo "ship-check blocked the merge: ${out#FAIL: }. Retitle the PR to PREFIX-NNNN [TYPE] ... (create the ticket via vcc if it does not exist).$unresolved" >&2; exit 2; }
      out=$(check_ci_tests "$pr") || { echo "ship-check blocked the merge: ${out#FAIL: }.$unresolved" >&2; exit 2; }
      out=$(check_premerge_status "$pr") || { echo "ship-check blocked the merge: ${out#FAIL: }.$unresolved" >&2; exit 2; }
    fi
    # Move to the board's done column, by task move or task update --section: needs merge, deploy and
    # docs (FEATURE/IMPROVE); app tickets also need proof.md.
    if [[ $rest =~ ^$done ]]; then
      [[ $rest =~ ($PREFIXES)-[0-9]+ ]]; t=${BASH_REMATCH[0]}
      [[ $rest =~ $section_flag ]]; section_title=${BASH_REMATCH[2]}
      section_title=${section_title#\"}; section_title=${section_title%\"}
      section_title=${section_title#\'}; section_title=${section_title%\'}
      is_done_section "$t" "$section_title"; done_section=$?
      [ "$done_section" = 3 ] && { echo "ship-check blocked moving $t to \"$section_title\": cannot match it against the columns of the ticket's board; retry when the board answers, or name the column exactly as the board shows it." >&2; exit 2; }
      if [ "$done_section" = 0 ]; then
        check_completion "$t" "$section_title" "$explicit" "$explicit_base"
      fi
    fi
  done < <(awk '
    BEGIN { sq = "\047" }
    {
      line = $0; out = ""; n = length(line); q = ""
      for (i = 1; i <= n; i++) {
        c = substr(line, i, 1); two = substr(line, i, 2)
        if (two == "&&" || two == "||") { print out; out = ""; i++; q = ""; continue }
        if (c == ";" || c == "|" || c == "&") { print out; out = ""; q = ""; continue }
        if (q == "" && (c == "(" || c == ")")) { print out; out = ""; continue }
        if (q == "" && (c == "\"" || c == sq)) { q = c; out = out c; continue }
        if (q != "" && c == q) { q = ""; out = out c; continue }
        out = out c
      }
      print out
    }' <<<"$cmd")
  exit 0
}

case "${1:-}" in
  pr|merged|deployed|docs|proof|done|cleaned|elsewhere)
    if [ "${SHIP_REPO+x}" != x ] && [ -s "$EVID/${2:-}/repo" ]; then
      REPO=$(cat "$EVID/$2/repo") || fail "could not read bound repo for $2"
    fi
    if [ "${SHIP_BASE+x}" != x ] && [ -s "$EVID/${2:-}/base" ]; then
      BASE=$(cat "$EVID/$2/base") || fail "could not read bound base for $2"
    fi ;;
esac

case "${1:-}" in
  bind) check_bind "$2" "$3" ;;
  branch) check_branch "$2" "${3:-}" ;;
  duplicate) check_duplicate "$2" "$3" "$4" ;;
  dropped) check_dropped "$2" "$3" ;;
  elsewhere) check_elsewhere "$2" "${3:-}" ;;
  nochange) check_nochange "${2:-}" ;;
  premerge) check_title "$2"; check_premerge "$2" ;;
  premerge-status) check_premerge_status "$2" ;;
  title) check_title "$2" ;;
  ci-tests) check_ci_tests "$2" ;;
  ticket) check_ticket "$2" ;;
  deeper) check_deeper "${2:-}" ;;
  pr) check_pr "$2" ;;
  merged) check_merged "$2" ;;
  deployed) check_deployed "$2" ;;
  docs) check_docs "$2" ;;
  proof) check_proof "$2" ;;
  done) check_done "$2" ;;
  cleaned) check_cleaned "$2" ;;
  move) check_move "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
  guard) guard ;;
  *) sed -n '2,25p' "$0"; exit 1 ;;
esac
