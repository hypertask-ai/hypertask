#!/usr/bin/env bash
# ship-gates HTPR-NNNN [more tickets...]: write the standard /ship gates into this session's unlazy ledger.
# Several tickets (or "6857, 6856") each get their own gates in the same ledger; a bare number means HTPR-.
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: ship-gates HTPR-NNNN [more tickets...]" >&2; exit 1; }
if [ $# -gt 1 ] || [[ $1 == *,* ]]; then
  for t in $(printf '%s ' "$@" | tr ',' ' '); do "$0" "$t"; done
  exit 0
fi
T=$1
[[ $T =~ ^[0-9]+$ ]] && T=HTPR-$T
[[ $T =~ ^(HTPR|HYFA|YPER4)-[0-9]+$ ]] || { echo "ticket must look like HTPR-1234, HYFA-12 or YPER4-12" >&2; exit 1; }
ID=${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}}
[ -n "$ID" ] || { echo "ship-gates needs CLAUDE_CODE_SESSION_ID, CODEX_SESSION_ID or CODEX_THREAD_ID" >&2; exit 1; }
[[ ${ID:0:8} =~ ^[A-Za-z0-9._-]+$ ]] || { echo "ship-gates: invalid session id prefix" >&2; exit 1; }
# The ledger is private working state: one folder per ticket under the home folder, never in the
# project, so a project stays clean and a copied file cannot leak.
STATE=${SHIP_STATE_ROOT:-$HOME}
[[ $STATE == /* && $STATE != *$'\n'* ]] || { echo "ship-gates: SHIP_STATE_ROOT must be an absolute path" >&2; exit 1; }
L=$STATE/.unlazy/ledgers/$T/GATES.md
C=$HOME/.agents/skills/ship/scripts/ship-check
U=$HOME/.agents/skills/unlazy/scripts
# Other repos (CLI, docs, verify): every CHECK carries the repo settings, or it would read the app repo.
ENVP=
if [ -n "${SHIP_REPO:-}" ] && [ "$SHIP_REPO" != hypertask-ai/hypertask ]; then
  [ -n "${SHIP_BASE:-}" ] && [ -n "${SHIP_CHECKOUT:-}" ] || { echo "ship-gates: SHIP_REPO=$SHIP_REPO also needs SHIP_BASE and SHIP_CHECKOUT (the local checkout)" >&2; exit 1; }
  [[ $SHIP_REPO =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ && $SHIP_BASE =~ ^[A-Za-z0-9._/-]+$ && $SHIP_CHECKOUT =~ ^/[A-Za-z0-9._/\ -]+$ ]] \
    || { echo "ship-gates: invalid SHIP_REPO, SHIP_BASE or SHIP_CHECKOUT" >&2; exit 1; }
  ENVP="SHIP_REPO=$SHIP_REPO SHIP_BASE=$SHIP_BASE SHIP_CHECKOUT='$SHIP_CHECKOUT' "
  if [ -n "${SHIP_WORKER:-}" ]; then
    [[ $SHIP_WORKER =~ ^[A-Za-z0-9._/\ -]+$ && $SHIP_WORKER != /* && /$SHIP_WORKER/ != *'/../'* ]] \
      || { echo "ship-gates: SHIP_WORKER must be a relative worker directory inside SHIP_CHECKOUT" >&2; exit 1; }
    ENVP+="SHIP_WORKER='$SHIP_WORKER' "
  fi
fi
node --input-type=module - "$L" "$ID" "$T" "$C" "$U" "$PWD" "$ENVP" "$STATE" <<'JS'
import { dirname, join } from 'node:path';
import { readdirSync } from 'node:fs';
const [ledger, session, ticket, check, scripts, root, envPrefix, state] = process.argv.slice(2);
const { parseGates, readStableRegularFile, withFileLock, writeAtomic } = await import(`${scripts}/lib/gates.mjs`);
const quote = (s) => "'" + s.replaceAll("'", "'\\''") + "'";
const gates = {
  ticket: ['The ticket exists on the board', 'ticket ok'],
  deeper: ['A Deeper: agent activity names the field, raw source, method and outside proof, and its proof gate is a runnable CHECK', 'deeper ok'],
  pr: ['The PR is named HTPR-NNNN [TYPE] description', 'title ok'],
  merged: ['The PR is merged into production', 'merged ok'],
  deployed: ['The Production deployment for the merge is success', 'deployed ok'],
  proof: ['Live QA proof.md follows the verify-qa contract for the latest merge, with screenshots', 'proof ok'],
  docs: ['Docs page change is merged and live on docs.hypertask.ai, or a No user-visible change reason is recorded', 'docs ok'],
  done: ["The ticket is in the done column its board names", 'done ok'],
  cleaned: ['This session removed its worktree and branch for the ticket (/clean-up)', 'cleaned ok'],
};
if (/[\r\n\0]/.test(session + root + check + envPrefix + state) || Buffer.byteLength(session) > 4095) throw new Error('invalid session id or path');
const read = (file) => {
  try { return readStableRegularFile(file, { root: state }); }
  catch (error) { if (error.code === 'ENOENT') return ''; throw error; }
};
// The gate ship-gates writes for <ticket>.<name>, or null for any other gate.
const standardGate = (id) => {
  const match = (id || '').match(/^((?:HTPR|HYFA|YPER4)-[0-9]+)\.(ticket|deeper|pr|merged|deployed|proof|docs|done|cleaned)$/);
  if (!match || match[1] !== ticket || (match[2] === 'proof' && !ticket.startsWith('HTPR-'))) return null;
  return gates[match[2]] ? match[2] : null;
};
// Never let --approve authorize a CHECK added by another ledger author.
// Allowed: the bare ship-check call, optionally behind the exact env prefix ship-gates writes for other repos.
const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const generatedCheck = new RegExp(`^(SHIP_REPO=[A-Za-z0-9._-]+/[A-Za-z0-9._-]+ SHIP_BASE=[A-Za-z0-9._/-]+ SHIP_CHECKOUT='/[A-Za-z0-9._/ -]+' (SHIP_WORKER='[A-Za-z0-9._/ -]+' )?)?${escape(quote(check))} [a-z]+ (HTPR|HYFA|YPER4)-[0-9]+$`);
const isGenerated = (gate) => {
  const name = standardGate(gate.id);
  return Boolean(name) && generatedCheck.test(gate.check || '') &&
    gate.check.endsWith(`${quote(check)} ${name} ${ticket}`) && gate.expect === gates[name][1];
};
// One gate is its "- [ ] id:" line plus the indented lines under it.
const gateBlocks = (source) => {
  const blocks = [];
  let current = null;
  for (const [index, line] of source.split('\n').entries()) {
    const head = line.match(/^- \[[ xX]\] (\S+?):/);
    if (head) blocks.push(current = { id: head[1], start: index, lines: [line] });
    else if (/^[^ ]/.test(line)) current = null;
    else if (current) current.lines.push(line);
  }
  for (const block of blocks) while (block.lines.length > 1 && !block.lines.at(-1).trim()) block.lines.pop();
  return blocks.map((block) => ({ id: block.id, start: block.start, text: block.lines.join('\n') }));
};
const withoutGates = (source, ids) => {
  const lines = source.split('\n');
  const drop = new Set();
  for (const block of gateBlocks(source)) {
    if (!ids.has(block.id)) continue;
    for (let i = block.start; i < block.start + block.text.split('\n').length; i++) drop.add(i);
  }
  return lines.filter((_, index) => !drop.has(index)).join('\n');
};
// A session that started before the move still has its gates inside the project it works in.
// Read them so a ticket obligation is carried over or named, never silently dropped.
const legacyTicketGates = () => {
  const found = [];
  let entries = [];
  try { entries = readdirSync(join(root, '.unlazy'), { withFileTypes: true }); } catch { return found; }
  const folders = entries.filter((entry) => entry.isDirectory() && /^s-[A-Za-z0-9._-]{1,8}$/.test(entry.name))
    .map((entry) => entry.name).sort();
  for (const folder of folders) {
    const file = join(root, '.unlazy', folder, 'GATES.md');
    let legacy = '';
    try { legacy = readStableRegularFile(file, { label: 'project ledger' }); } catch { continue; }
    let doc;
    try { doc = parseGates(legacy); } catch { continue; }
    if (doc.errors.length) continue;
    for (const block of gateBlocks(legacy)) {
      if (!block.id.startsWith(`${ticket}.`)) continue;
      const gate = doc.gates.find((candidate) => candidate.id === block.id);
      if (!gate || isGenerated(gate)) continue;
      found.push({ id: block.id, text: block.text, file });
    }
  }
  return found;
};
await withFileLock(state, ledger, () => {
  const binding = `${dirname(ledger)}/session`;
  const adoptedFile = `${dirname(ledger)}/adopted`;
  const adopted = new Set(read(adoptedFile).split('\n').map((line) => line.trim()).filter(Boolean));
  const bound = read(binding).trim();
  let text = read(ledger);
  // The ticket owns its ledger, so a later session continues it instead of needing a new folder,
  // and this session moves it to another checkout when it removes the worktree for /clean-up.
  // Either way the gates ship-gates wrote itself are dropped and written again here: they cannot
  // keep the previous worktree, repository or an earlier result.
  const own = text ? parseGates(text).gates.filter(isGenerated) : [];
  const handover = bound && bound !== session.trim() && text;
  const moved = !handover && process.env.SHIP_LEDGER_MOVE === '1' && own.some((gate) => gate.cwd !== root);
  if (handover || moved) {
    const stale = new Set(own.map((gate) => gate.id));
    text = withoutGates(text, stale);
    if (!/^- \[[ xX]\] \S+:/m.test(text)) text = '';
    process.stderr.write(handover
      ? `ship-gates: ${ticket} ledger moved from session ${bound} to ${session.trim()}; ${stale.size} generated gates written again at ${root}\n`
      : `ship-gates: ${ticket} ledger checkout moved to ${root}; ${stale.size} generated gates written again\n`);
  }
  const carried = text ? [] : legacyTicketGates();
  if (carried.length && process.env.SHIP_LEDGER_ADOPT !== '1') {
    throw new Error(`ship-gates: ${carried.map((gate) => gate.id).join(', ')} in ${carried[0].file} are not in ${ledger}; run with SHIP_LEDGER_ADOPT=1 to carry them over, or finish them there`);
  }
  const doc = parseGates(text, { requireGates: !!text });
  if (doc.errors.length) throw new Error(doc.errors.join('; '));
  for (const gate of doc.gates) {
    if (adopted.has(gate.id)) continue;
    if (isGenerated(gate)) {
      if (gate.cwd !== root) throw new Error(`ship-gates: ${ticket} ledger holds gates written in ${gate.cwd}; run ship-gates there, or with SHIP_LEDGER_MOVE=1 to move them here and earn them again`);
      continue;
    }
    if (!gate.check) continue;
    throw new Error(`ship-gates: refusing to approve non-generated gate ${gate.id}; put extra gates in gates/extra.md and review them separately`);
  }
  if (!text) text = '# Gates: /ship\n\nScope: take this session\'s tickets end to end, live and verified.\n';
  for (const [name, [title, expect]] of Object.entries(gates)) {
    if (name === 'proof' && !ticket.startsWith('HTPR-')) continue;
    const id = `${ticket}.${name}`;
    if (doc.gates.some((gate) => gate.id === id)) continue;
    text += `\n- [ ] ${id}: ${title}\n  CHECK: ${envPrefix}${quote(check)} ${name} ${ticket}\n  EXPECT: ${expect}\n  CWD: ${root}\n  EVIDENCE: pending\n`;
  }
  for (const gate of carried) text += `\n${gate.text}\n`;
  if (carried.length) {
    process.stderr.write(`ship-gates: carried ${carried.map((gate) => gate.id).join(', ')} over from ${carried[0].file}\n`);
    writeAtomic(adoptedFile, [...new Set([...adopted, ...carried.map((gate) => gate.id)])].sort().join('\n') + '\n', { root: state });
  }
  writeAtomic(ledger, text, { root: state });
  writeAtomic(binding, session + '\n', { root: state });
});
JS
status=0
node "$U/gate-check.mjs" --approve "$L" --root "$(dirname "$L")" >&2 || status=$?
printf '%s\n' "$L"
# Unmet ship steps are expected when creating the ledger.
[ "$status" -le 1 ] || exit "$status"
