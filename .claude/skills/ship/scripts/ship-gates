#!/usr/bin/env bash
# ship-gates HTPR-NNNN [more tickets...]: write the standard /ship gates into this session's unlazy ledger.
# Several tickets (or "6857, 6856") each get their own gates in the same ledger; a bare number means HTPR-.
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: ship-gates HTPR-NNNN [more tickets...]" >&2; exit 1; }
if [ $# -gt 1 ] || [[ $1 == *,* ]]; then
  for t in $(printf '%s ' "$@" | tr ',' ' '); do "$0" "$t"; done
  exit 0
fi
T=$1
[[ $T =~ ^[0-9]+$ ]] && T=HTPR-$T
[[ $T =~ ^(HTPR|HYFA|YPER4)-[0-9]+$ ]] || { echo "ticket must look like HTPR-1234, HYFA-12 or YPER4-12" >&2; exit 1; }
ID=${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}}
[ -n "$ID" ] || { echo "ship-gates needs CLAUDE_CODE_SESSION_ID, CODEX_SESSION_ID or CODEX_THREAD_ID" >&2; exit 1; }
[[ ${ID:0:8} =~ ^[A-Za-z0-9._-]+$ ]] || { echo "ship-gates: invalid session id prefix" >&2; exit 1; }
# The ledger is private working state: one folder per ticket under the home folder, never in
# the project. Locks and extra gates live in the same folder, so a project stays clean.
STATE=${SHIP_STATE_ROOT:-$HOME}
[[ $STATE == /* && $STATE != *$'\n'* ]] || { echo "ship-gates: SHIP_STATE_ROOT must be an absolute path" >&2; exit 1; }
L=$STATE/.unlazy/ledgers/$T/GATES.md
C=$HOME/.agents/skills/ship/scripts/ship-check
U=$HOME/.agents/skills/unlazy/scripts
# Other repos (CLI, docs, verify): every CHECK carries the repo settings, or it would read the app repo.
ENVP=
if [ -n "${SHIP_REPO:-}" ] && [ "$SHIP_REPO" != hypertask-ai/hypertask ]; then
  [ -n "${SHIP_BASE:-}" ] && [ -n "${SHIP_CHECKOUT:-}" ] || { echo "ship-gates: SHIP_REPO=$SHIP_REPO also needs SHIP_BASE and SHIP_CHECKOUT (the local checkout)" >&2; exit 1; }
  [[ $SHIP_REPO =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ && $SHIP_BASE =~ ^[A-Za-z0-9._/-]+$ && $SHIP_CHECKOUT =~ ^/[A-Za-z0-9._/\ -]+$ ]] \
    || { echo "ship-gates: invalid SHIP_REPO, SHIP_BASE or SHIP_CHECKOUT" >&2; exit 1; }
  ENVP="SHIP_REPO=$SHIP_REPO SHIP_BASE=$SHIP_BASE SHIP_CHECKOUT='$SHIP_CHECKOUT' "
  if [ -n "${SHIP_WORKER:-}" ]; then
    [[ $SHIP_WORKER =~ ^[A-Za-z0-9._/\ -]+$ && $SHIP_WORKER != /* && /$SHIP_WORKER/ != *'/../'* ]] \
      || { echo "ship-gates: SHIP_WORKER must be a relative worker directory inside SHIP_CHECKOUT" >&2; exit 1; }
    ENVP+="SHIP_WORKER='$SHIP_WORKER' "
  fi
fi
node --input-type=module - "$L" "$ID" "$T" "$C" "$U" "$PWD" "$ENVP" "$STATE" <<'JS'
import { existsSync, readdirSync, rmdirSync, unlinkSync } from 'node:fs';
import { dirname } from 'node:path';
const [ledger, session, ticket, check, scripts, root, envPrefix, state] = process.argv.slice(2);
const { parseGates, readStableRegularFile, withFileLock, writeAtomic } = await import(`${scripts}/lib/gates.mjs`);
const quote = (s) => "'" + s.replaceAll("'", "'\\''") + "'";
const APP_REPO = 'hypertask-ai/hypertask';
const currentRepo = process.env.SHIP_REPO || APP_REPO;
const gates = {
  ticket: ['The ticket exists on the board', 'ticket ok'],
  deeper: ['A Deeper: agent activity names the field, raw source, method and outside proof, and its proof gate is a runnable CHECK', 'deeper ok'],
  pr: ['The PR is named HTPR-NNNN [TYPE] description', 'title ok'],
  merged: ['The PR is merged into production', 'merged ok'],
  deployed: ['The Production deployment for the merge is success', 'deployed ok'],
  proof: ['Live QA proof.md follows the verify-qa contract for the latest merge, with screenshots', 'proof ok'],
  docs: ['Docs page change is merged and live on docs.hypertask.ai, or a No user-visible change reason is recorded', 'docs ok'],
  done: ["The ticket is in the done column its board names", 'done ok'],
  cleaned: ['This session removed its worktree and branch for the ticket (/clean-up)', 'cleaned ok'],
};
if (/[\r\n\0]/.test(session + root + check + envPrefix + state) || Buffer.byteLength(session) > 4095) throw new Error('invalid session id or path');
const read = (file) => {
  try { return readStableRegularFile(file, { root: state }); }
  catch (error) { if (error.code === 'ENOENT') return ''; throw error; }
};
// This ticket's gate blocks from one ledger file, split into what moves and what stays.
// A moved block drops the old result: its check now runs from this ledger and checkout.
const splitTicketGates = (source, ticket, cwd, accept) => {
  const lines = source.split(/\r?\n/);
  const held = new Set();
  for (const gate of parseGates(source, { requireGates: false }).gates) {
    if (!gate.id.startsWith(`${ticket}.`) || !accept(gate)) continue;
    for (let i = gate.line; i < lines.length && (i === gate.line || /^[ \t]+\S/.test(lines[i])); i += 1) held.add(i);
  }
  const moved = [];
  const kept = [];
  for (let i = 0; i < lines.length; i += 1) {
    if (!held.has(i)) { kept.push(lines[i]); continue; }
    const line = lines[i];
    if (/^- \[[ xX]\] /.test(line)) moved.push(line.replace(/^- \[[ xX]\] /, '- [ ] '));
    else if (/^ {2}CWD: /.test(line)) moved.push(`  CWD: ${cwd}`);
    else if (/^ {2}EVIDENCE: /.test(line)) moved.push('  EVIDENCE: pending');
    else moved.push(line);
  }
  return { moved: moved.join('\n').trim(), kept: kept.join('\n') };
};
await withFileLock(state, ledger, () => {
  const binding = `${dirname(ledger)}/session`;
  const bound = read(binding).trim();
  const handedOver = !!bound && bound !== session.trim();
  // One folder per ticket: a new session continues the ticket's ledger instead of failing,
  // because the ticket owns the ledger and ship-claim owns the work.
  if (handedOver) {
    process.stderr.write(`ship-gates: ${ticket} ledger moved from session ${bound} to ${session.trim()}\n`);
  }
  let text = read(ledger);
  // A new session owns new worktrees, so an earlier session's cleanup result would be a false
  // done. Clear that gate and its evidence whenever the ledger changes hands.
  if (handedOver && text) {
    const lines = text.split('\n');
    let inside = false;
    for (let i = 0; i < lines.length; i += 1) {
      const head = lines[i].match(/^- \[[ xX]\] (\S+?):/);
      if (head) inside = head[1] === `${ticket}.cleaned`;
      else if (/^[^ ]/.test(lines[i])) inside = false;
      if (!inside) continue;
      if (/^- \[[ xX]\] /.test(lines[i])) lines[i] = lines[i].replace(/^- \[[ xX]\] /, '- [ ] ');
      else if (/^ {2}EVIDENCE: /.test(lines[i])) lines[i] = '  EVIDENCE: pending';
    }
    text = lines.join('\n');
  }
  let doc = parseGates(text, { requireGates: !!text });
  if (doc.errors.length) throw new Error(doc.errors.join('; '));
  // Never let --approve authorize a CHECK added by another ledger author.
  // Allowed: the bare ship-check call, optionally behind the exact env prefix ship-gates writes for other repos.
  const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const generatedCheck = new RegExp(`^(SHIP_REPO=[A-Za-z0-9._-]+/[A-Za-z0-9._-]+ SHIP_BASE=[A-Za-z0-9._/-]+ SHIP_CHECKOUT='/[A-Za-z0-9._/ -]+' (SHIP_WORKER='[A-Za-z0-9._/ -]+' )?)?${escape(quote(check))} [a-z]+ (HTPR|HYFA|YPER4)-[0-9]+$`);
  const gateId = /^((?:HTPR|HYFA|YPER4)-[0-9]+)\.(ticket|deeper|pr|merged|deployed|proof|docs|done|cleaned)$/;
  const generated = (gate) => {
    const match = gate.id.match(gateId);
    if (!match || (match[2] === 'proof' && !match[1].startsWith('HTPR-'))) return false;
    return generatedCheck.test(gate.check ?? '') &&
      gate.check.endsWith(`${quote(check)} ${match[2]} ${match[1]}`) &&
      gate.expect === gates[match[2]][1];
  };
  const repoOf = (gate) => (gate.check.startsWith('SHIP_REPO=') ? gate.check.split(' ')[0].replace('SHIP_REPO=', '') : APP_REPO);
  // A ledger written before this change sits inside the project, where a session that is already
  // mid-ticket would lose its gates. Adopt this ticket's gates from every old session folder, then
  // delete what is left: the project must stay clean, and a copied file can still leak.
  const stateDir = `${root}/.unlazy`;
  const pendingRemovals = [];
  const touched = [];
  const adoptProjectLedger = () => {
    const source = (file) => {
      try { return readStableRegularFile(file, { root }); } catch (error) {
        if (error.code === 'ENOENT') return '';
        throw error;
      }
    };
    let sessions = [];
    try { sessions = readdirSync(stateDir).filter((name) => name.startsWith('s-')).sort(); } catch (error) {
      if (error.code !== 'ENOENT') throw error;
    }
    for (const name of sessions) {
      const project = `${stateDir}/${name}`;
      const extraDir = `${project}/gates`;
      let extras = [];
      try { extras = readdirSync(extraDir).filter((file) => file.endsWith('.md')).sort(); } catch (error) {
        if (error.code !== 'ENOENT') throw error;
      }
      // The generated gates are rewritten below from this checkout, so the old copy only has to
      // prove it belongs to this repository before it goes.
      const main = splitTicketGates(source(`${project}/GATES.md`), ticket, root, (gate) => {
        if (!generated(gate)) return false;
        if (repoOf(gate) !== currentRepo) {
          throw new Error(`ship-gates: ${ticket} ledger belongs to ${repoOf(gate)}, not ${currentRepo}; run those gates from that repository`);
        }
        return true;
      });
      let adopted = main.moved ? 1 : 0;
      if (main.moved) pendingRemovals.push([`${project}/GATES.md`, main.kept]);
      for (const extra of extras) {
        const file = `${extraDir}/${extra}`;
        const split = splitTicketGates(source(file), ticket, root, () => true);
        if (!split.moved) continue;
        // The home copy is written before the project one goes: a failed write must never be the
        // only copy of a gate a person wrote by hand.
        const dest = `${dirname(ledger)}/gates/${extra}`;
        const existing = read(dest);
        writeAtomic(dest, `${existing ? `${existing.replace(/\n+$/, '')}\n\n` : ''}${split.moved}\n`, { root: state });
        pendingRemovals.push([file, split.kept]);
        adopted += 1;
      }
      if (!adopted) continue;
      touched.push(project);
      process.stderr.write(`ship-gates: ${ticket} ledger adopted from ${project}\n`);
    }
  };
  adoptProjectLedger();
  // Only once the ticket's gates live in the home folder is the project copy dropped, together
  // with the session binding a legacy ledger kept beside it.
  const pruneProjectLedgers = () => {
    for (const [file, kept] of pendingRemovals) {
      if (/^- \[[ xX]\] /m.test(kept)) writeAtomic(file, `${kept.replace(/\n+$/, '')}\n`, { root });
      else unlinkSync(file);
    }
    for (const project of touched) {
      const extraDir = `${project}/gates`;
      try { rmdirSync(extraDir); } catch (error) {
        if (!['ENOENT', 'ENOTEMPTY', 'EEXIST'].includes(error.code)) throw error;
      }
      if (existsSync(`${project}/GATES.md`) || existsSync(extraDir)) continue;
      try { unlinkSync(`${project}/session`); } catch (error) {
        if (error.code !== 'ENOENT') throw error;
      }
      for (const dir of [project, stateDir]) {
        try { rmdirSync(dir); } catch (error) {
          if (!['ENOENT', 'ENOTEMPTY', 'EEXIST'].includes(error.code)) throw error;
        }
      }
    }
  };
  // The ticket owns the ledger, so a later session may resume it from its own worktree. Those
  // gates run where that session works, but only when the session asks for the move: an edited
  // CWD is never re-approved by accident.
  const strays = doc.gates.filter((gate) => generated(gate) && gate.cwd !== root);
  if (strays.length && process.env.SHIP_LEDGER_MOVE !== '1') {
    throw new Error(`ship-gates: ${ticket} ledger was written from ${strays[0].cwd}; re-run with SHIP_LEDGER_MOVE=1 to run its gates in ${root}`);
  }
  if (strays.length) {
    const rewritten = new Map();
    for (const gate of strays) {
      const [, gateTicket, name] = gate.id.match(gateId);
      if (repoOf(gate) !== currentRepo) {
        throw new Error(`ship-gates: ${ticket} ledger belongs to ${repoOf(gate)}, not ${currentRepo}; run those gates from that repository`);
      }
      rewritten.set(gate.id, `  CHECK: ${envPrefix}${quote(check)} ${name} ${gateTicket}`);
    }
    const lines = text.split('\n');
    let current = '';
    for (let i = 0; i < lines.length; i += 1) {
      const head = lines[i].match(/^- \[[ xX]\] ([^:]+):/);
      if (head) current = head[1];
      else if (/^[^ ]/.test(lines[i])) current = '';
      if (rewritten.has(current) && /^ {2}CHECK: /.test(lines[i])) lines[i] = rewritten.get(current);
      else if (rewritten.has(current) && /^ {2}CWD: /.test(lines[i])) lines[i] = `  CWD: ${root}`;
    }
    text = lines.join('\n');
    doc = parseGates(text, { requireGates: true });
    if (doc.errors.length) throw new Error(doc.errors.join('; '));
    process.stderr.write(`ship-gates: ${ticket} ledger gates moved from ${strays[0].cwd} to ${root}\n`);
  }
  for (const gate of doc.gates) {
    if (!gateId.test(gate.id) && !gate.check) continue;
    if (!generated(gate) || gate.cwd !== root) {
      throw new Error(`ship-gates: refusing to approve non-generated gate ${gate.id}; put extra gates in ${dirname(ledger)}/gates/extra.md and review them separately`);
    }
    // The ticket folder outlives the session that filled it, and a handover in the same directory
    // changes the session but not the CWD: the repository still has to match.
    if (repoOf(gate) !== currentRepo) {
      throw new Error(`ship-gates: ${ticket} ledger belongs to ${repoOf(gate)}, not ${currentRepo}; run those gates from that repository`);
    }
  }
  if (!text) text = '# Gates: /ship\n\nScope: take this session\'s tickets end to end, live and verified.\n';
  for (const [name, [title, expect]] of Object.entries(gates)) {
    if (name === 'proof' && !ticket.startsWith('HTPR-')) continue;
    const id = `${ticket}.${name}`;
    if (doc.gates.some((gate) => gate.id === id)) continue;
    text += `\n- [ ] ${id}: ${title}\n  CHECK: ${envPrefix}${quote(check)} ${name} ${ticket}\n  EXPECT: ${expect}\n  CWD: ${root}\n  EVIDENCE: pending\n`;
  }
  writeAtomic(binding, session + '\n', { root: state });
  writeAtomic(ledger, text, { root: state });
  pruneProjectLedgers();
});
JS
status=0
node "$U/gate-check.mjs" --approve "$L" --root "$(dirname "$L")" >&2 || status=$?
printf '%s\n' "$L"
# Unmet ship steps are expected when creating the ledger.
[ "$status" -le 1 ] || exit "$status"
