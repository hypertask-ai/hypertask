#!/usr/bin/env bash
# ship-gates HTPR-NNNN [more tickets...]: write the standard /ship gates into this session's unlazy ledger.
# Several tickets (or "6857, 6856") each get their own gates in the same ledger; a bare number means HTPR-.
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: ship-gates HTPR-NNNN [more tickets...]" >&2; exit 1; }
if [ $# -gt 1 ] || [[ $1 == *,* ]]; then
  for t in $(printf '%s ' "$@" | tr ',' ' '); do "$0" "$t"; done
  exit 0
fi
T=$1
[[ $T =~ ^[0-9]+$ ]] && T=HTPR-$T
[[ $T =~ ^(HTPR|HYFA|YPER4)-[0-9]+$ ]] || { echo "ticket must look like HTPR-1234, HYFA-12 or YPER4-12" >&2; exit 1; }
ID=${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}}
[ -n "$ID" ] || { echo "ship-gates needs CLAUDE_CODE_SESSION_ID, CODEX_SESSION_ID or CODEX_THREAD_ID" >&2; exit 1; }
[[ ${ID:0:8} =~ ^[A-Za-z0-9._-]+$ ]] || { echo "ship-gates: invalid session id prefix" >&2; exit 1; }
L=$PWD/.unlazy/s-${ID:0:8}/GATES.md
C=$HOME/.agents/skills/ship/scripts/ship-check
U=$HOME/.agents/skills/unlazy/scripts
# CLI tickets (SHIP_REPO=hypertask-ai/cli): every CHECK carries the repo settings, or it would read the app repo.
ENVP=
if [ -n "${SHIP_REPO:-}" ] && [ "$SHIP_REPO" != hypertask-ai/hypertask ]; then
  [ -n "${SHIP_BASE:-}" ] && [ -n "${SHIP_CHECKOUT:-}" ] || { echo "ship-gates: SHIP_REPO=$SHIP_REPO also needs SHIP_BASE and SHIP_CHECKOUT (the local checkout)" >&2; exit 1; }
  [[ $SHIP_REPO =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ && $SHIP_BASE =~ ^[A-Za-z0-9._/-]+$ && $SHIP_CHECKOUT =~ ^/[A-Za-z0-9._/\ -]+$ ]] \
    || { echo "ship-gates: invalid SHIP_REPO, SHIP_BASE or SHIP_CHECKOUT" >&2; exit 1; }
  ENVP="SHIP_REPO=$SHIP_REPO SHIP_BASE=$SHIP_BASE SHIP_CHECKOUT='$SHIP_CHECKOUT' "
fi
node --input-type=module - "$L" "$ID" "$T" "$C" "$U" "$PWD" "$ENVP" <<'JS'
import { dirname } from 'node:path';
const [ledger, session, ticket, check, scripts, root, envPrefix] = process.argv.slice(2);
const { parseGates, readStableRegularFile, withFileLock, writeAtomic } = await import(`${scripts}/lib/gates.mjs`);
const quote = (s) => "'" + s.replaceAll("'", "'\\''") + "'";
const gates = {
  ticket: ['The ticket exists on the board', 'ticket ok'],
  pr: ['The PR is named HTPR-NNNN [TYPE] description', 'title ok'],
  merged: ['The PR is merged into production', 'merged ok'],
  deployed: ['The Production deployment for the merge is success', 'deployed ok'],
  proof: ['Live QA proof.md follows the verify-qa contract for the latest merge, with screenshots', 'proof ok'],
  done: ['The ticket is in Done', 'done ok'],
  cleaned: ['This session removed its worktree and branch for the ticket (/clean-up)', 'cleaned ok'],
};
if (/[\r\n\0]/.test(session + root + check + envPrefix) || Buffer.byteLength(session) > 4095) throw new Error('invalid session id or path');
const read = (file) => {
  try { return readStableRegularFile(file, { root }); }
  catch (error) { if (error.code === 'ENOENT') return ''; throw error; }
};
await withFileLock(root, ledger, () => {
  const binding = `${dirname(ledger)}/session`;
  const bound = read(binding);
  if (bound && bound.trim() !== session.trim()) throw new Error('ship-gates: session prefix collision');
  let text = read(ledger);
  const doc = parseGates(text, { requireGates: !!text });
  if (doc.errors.length) throw new Error(doc.errors.join('; '));
  // Never let --approve authorize a CHECK added by another ledger author.
  // Allowed: the bare ship-check call, optionally behind the exact env prefix ship-gates writes for CLI tickets.
  const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const generatedCheck = new RegExp(`^(SHIP_REPO=[A-Za-z0-9._-]+/[A-Za-z0-9._-]+ SHIP_BASE=[A-Za-z0-9._/-]+ SHIP_CHECKOUT='/[A-Za-z0-9._/ -]+' )?${escape(quote(check))} [a-z]+ (HTPR|HYFA|YPER4)-[0-9]+$`);
  for (const gate of doc.gates) {
    const match = gate.id.match(/^((?:HTPR|HYFA|YPER4)-[0-9]+)\.(ticket|pr|merged|deployed|proof|done|cleaned)$/);
    if (!match && !gate.check) continue;
    if (!match || (match[2] === 'proof' && !match[1].startsWith('HTPR-')) ||
        !generatedCheck.test(gate.check) || !gate.check.endsWith(`${quote(check)} ${match[2]} ${match[1]}`) ||
        gate.expect !== gates[match[2]][1] || gate.cwd !== root) {
      throw new Error(`ship-gates: refusing to approve non-generated gate ${gate.id}; put extra gates in gates/extra.md and review them separately`);
    }
  }
  if (!text) text = '# Gates: /ship\n\nScope: take this session\'s tickets end to end, live and verified.\n';
  for (const [name, [title, expect]] of Object.entries(gates)) {
    if (name === 'proof' && !ticket.startsWith('HTPR-')) continue;
    const id = `${ticket}.${name}`;
    if (doc.gates.some((gate) => gate.id === id)) continue;
    text += `\n- [ ] ${id}: ${title}\n  CHECK: ${envPrefix}${quote(check)} ${name} ${ticket}\n  EXPECT: ${expect}\n  CWD: ${root}\n  EVIDENCE: pending\n`;
  }
  writeAtomic(binding, session + '\n', { root });
  writeAtomic(ledger, text, { root });
});
JS
status=0
node "$U/gate-check.mjs" --approve "$L" >&2 || status=$?
printf '%s\n' "$L"
# Unmet ship steps are expected when creating the ledger.
[ "$status" -le 1 ] || exit "$status"
