#!/usr/bin/env python3
"""Reconcile board 15's Flags column; read-only unless --go is supplied."""
import argparse
import json
import subprocess
import sys

sys.dont_write_bytecode = True
from ticket_flags import read_flags, require_everyone


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--go", action="store_true", help="move all-Everyone tickets to Done")
    args = parser.parse_args()
    board = json.loads(subprocess.check_output([
        "vcc", "task", "list", "--project", "15", "--section", "Flags",
        "--limit", "100", "--json"], text=True))
    tasks = board["tasks"]
    if board.get("success") is not True or not isinstance(tasks, list) or len(tasks) != board["total"]:
        raise ValueError("Flags list is incomplete or invalid; no tickets moved (limit 100)")
    flags = read_flags()
    for task in tasks:
        ticket = task["ticketNumber"]
        if task["section"] != "Flags":
            continue
        try:
            require_everyone(ticket, flags, json.dumps(task), require_flags=True)
        except ValueError as error:
            print(f"ht-flags-sweep: leave {ticket} in Flags: {error}")
            continue
        if args.go:
            # Recheck the section so a human move since the list is not overwritten.
            current = json.loads(subprocess.check_output(["vcc", "task", "get", ticket, "--json"], text=True))
            if current.get("success") is not True or len(current["tasks"]) != 1:
                raise ValueError(f"cannot read current section of {ticket}")
            if current["tasks"][0]["section"] != "Flags":
                print(f"ht-flags-sweep: leave {ticket}: no longer in Flags")
                continue
            subprocess.run(["vcc", "task", "move", ticket, "--section", "Done"], check=True)
            print(f"ht-flags-sweep: moved {ticket} from Flags to Done (all flags Everyone)")
        else:
            print(f"ht-flags-sweep: would move {ticket} from Flags to Done (all flags Everyone); use --go")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError) as error:
        print(f"ht-flags-sweep: {error}; stopped", file=sys.stderr)
        sys.exit(1)
