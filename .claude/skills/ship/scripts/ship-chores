#!/usr/bin/env python3
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request

ROOT = Path.home() / '.local/state/ship-chores/fleet'


def run(*args, **kwargs):
    return subprocess.run(list(args), text=True, capture_output=True, timeout=180, **kwargs)


def gh(*args):
    result = run('gh', *args)
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    return json.loads(result.stdout or 'null')


def rebase(base):
    if run('git', 'status', '--porcelain').stdout.strip():
        raise RuntimeError('dirty worktree; nothing changed')
    branch = run('git', 'symbolic-ref', '--short', 'HEAD')
    if branch.returncode or branch.stdout.strip() == base:
        raise RuntimeError('need a ticket branch')
    if run('git', 'check-ref-format', 'refs/heads/' + base).returncode:
        raise RuntimeError('invalid base')
    subprocess.run(['git', 'fetch', 'origin', base], check=True)
    try:
        result = run('git', '-c', 'core.hooksPath=/dev/null', 'rebase', f'origin/{base}')
    except subprocess.TimeoutExpired:
        subprocess.run(['git', 'rebase', '--abort'], check=True)
        raise
    if result.returncode:
        conflicts = run('git', 'diff', '--name-only', '--diff-filter=U').stdout
        subprocess.run(['git', 'rebase', '--abort'], check=True)
        raise RuntimeError('rebase refused; original branch restored: ' + conflicts + result.stderr)
    return 'REBASED'


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def live(url, expect, timeout):
    if urllib.parse.urlsplit(url).scheme != 'https':
        raise RuntimeError('live check needs HTTPS')
    request = urllib.request.Request(url, headers={'User-Agent': 'ship-chores'})
    with urllib.request.build_opener(NoRedirect).open(request, timeout=timeout) as response:
        if response.status != 200 or expect not in response.read(2_000_000).decode('utf-8', 'replace'):
            raise RuntimeError('live response did not match')
    return 'LIVE'


def pull(repo, number):
    return gh('pr', 'view', str(number), '-R', repo, '--json',
              'state,isDraft,mergeable,baseRefName,headRefOid,mergeCommit')


def checks(repo, number):
    result = run('gh', 'pr', 'checks', str(number), '-R', repo, '--required', '--json', 'name,state,link')
    if result.returncode not in (0, 1, 8):
        raise RuntimeError(result.stderr)
    rows = json.loads(result.stdout)
    if not rows:
        raise RuntimeError('no required checks found')
    return rows


def decide(pr, rows, head, base):
    if pr['headRefOid'] != head or pr['baseRefName'] != base or pr['isDraft']:
        return 'HOLD'
    if pr['state'] == 'MERGED':
        return 'DEPLOY'
    if pr['state'] != 'OPEN' or pr['mergeable'] == 'CONFLICTING':
        return 'CONFLICT'
    if any(c['state'] in ('FAILURE', 'TIMED_OUT', 'CANCELLED', 'ERROR', 'ACTION_REQUIRED', 'STARTUP_FAILURE') for c in rows):
        return 'RERUN'
    if pr['mergeable'] != 'MERGEABLE' or any(c['state'] != 'SUCCESS' for c in rows):
        return 'WAIT'
    return 'MERGE'


def rerun(repo, rows, state):
    ids = set()
    for row in rows:
        if row['state'] not in ('FAILURE', 'TIMED_OUT', 'CANCELLED'):
            continue
        match = re.fullmatch(r'https://github.com/' + re.escape(repo) + r'/actions/runs/(\d+)(?:/job/\d+)?', row['link'])
        if not match:
            return 'RED'
        ids.add(match[1])
    if not ids:
        return 'RED'
    for ident in sorted(ids):
        info = gh('api', f'repos/{repo}/actions/runs/{ident}')
        if info['head_sha'] != state['head'] or info['run_attempt'] != 1 or ident in state.get('reran', []):
            return 'RED'
        state.setdefault('reran', []).append(ident)
    return sorted(ids)


def save(path, state):
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(state))
    temporary.replace(path)


def bound(ticket, number):
    folder = Path(os.environ.get('VCC_EVIDENCE_DIR', Path.home() / '.local/state/vcc-evidence')) / ticket
    return all((folder / k).is_file() and (folder / k).read_text().strip() == v for k, v in
               dict(pr=str(number), repo='hypertask-ai/hypertask', base='production').items())


def step(state, path):
    repo, number = state['repo'], state['pr']
    if not bound(state['ticket'], number):
        return 'HOLD'
    pr = pull(repo, number)
    rows = [] if pr['state'] == 'MERGED' else checks(repo, number)
    action = decide(pr, rows, state['head'], state['base'])
    if action == 'RERUN':
        ids = rerun(repo, rows, state)
        if ids == 'RED':
            return 'RED'
        save(path, state)
        for ident in ids:
            subprocess.run(['gh', 'run', 'rerun', ident, '-R', repo, '--failed'], check=True, timeout=120)
        return 'WAIT'
    if action == 'MERGE':
        guard = Path.home() / '.local/lib/hypertask/merge-guard/gh-merge-guard'
        subprocess.run([str(guard), '--', '/usr/bin/gh', 'pr', 'merge', str(number), '-R', repo, '--squash',
                        '--match-head-commit', state['head']], check=True, timeout=180)
        return 'WAIT'
    if action == 'DEPLOY':
        result = run(str(Path.home() / '.agents/skills/ship/scripts/ship-check'), 'deployed', state['ticket'])
        if result.returncode:
            return 'WAIT_DEPLOY'
        live(state['url'], state['expect'], 20)
        subprocess.run(['vcc', 'activity', 'add', state['ticket'], '--text',
                        f'Scripted chores complete: https://github.com/{repo}/pull/{number}; deployment proof and live HTTP check passed. Feature-specific QA remains with the owning runner.'], check=True, timeout=120)
        return 'LIVE'
    return action


def discover():
    prs = gh('pr', 'list', '-R', 'hypertask-ai/hypertask', '--base', 'production', '--limit', '100', '--json',
             'number,title,headRefOid,isDraft,author,files,changedFiles')
    protected = ('.claude/skills/ship/scripts/ship-gates', '.claude/skills/ship/scripts/ship-check',
                 '.claude/skills/ship/scripts/ship-identity', '.claude/skills/ship/scripts/gh-merge-guard', '.claude/skills/vcc/', '.claude/skills/unlazy/',
                 '.claude/hooks/', '.claude/settings.json', 'CLAUDE.md', 'AGENTS.md')
    for pr in prs:
        ticket = re.match(r'([A-Z][A-Z0-9]*-\d+) \[', pr['title'])
        if not ticket or pr['isDraft'] or pr['author']['login'].removeprefix('app/').removesuffix('[bot]') != 'hypertask-runners':
            continue
        if len(pr['files']) != pr['changedFiles'] or any(f['path'].startswith(protected) for f in pr['files']):
            continue
        path = ROOT / f'{ticket[1]}.json'
        if path.exists() or not bound(ticket[1], pr['number']):
            continue
        save(path, dict(STATE_TEMPLATE, pr=pr['number'], ticket=ticket[1], head=pr['headRefOid']))


STATE_TEMPLATE = dict(repo='hypertask-ai/hypertask', base='production', url='https://app.hypertask.ai/login',
                      expect='Sign in', at=0, status='WAIT')


def main():
    parser = argparse.ArgumentParser(description='Model-free release chores, one read per five-minute tick. Never bypasses the installed gh merge guard.')
    parser.add_argument('command', choices=('rebase', 'live', 'sweep'))
    parser.add_argument('--base', default=os.environ.get('SHIP_BASE', 'production'))
    parser.add_argument('--url')
    parser.add_argument('--expect', default='')
    args = parser.parse_args()
    if args.command == 'rebase':
        print(rebase(args.base))
        return
    if args.command == 'live':
        print(live(args.url or '', args.expect, 20))
        return
    if not os.environ.get('SHIP_SESSION_NAME'):
        raise RuntimeError('queue requires the owning SHIP_SESSION_NAME')
    if not (Path.home() / '.local/lib/hypertask/merge-guard/gh-merge-guard').is_file():
        raise RuntimeError('installed merge guard missing')
    token = run(str(Path.home() / '.local/bin/gh-app-token'))
    if token.returncode or not token.stdout.strip():
        raise RuntimeError('runner App token unavailable; no saved-login fallback')
    os.environ['GH_TOKEN'] = token.stdout.strip()
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / 'tick.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        discover()
        for path in sorted(ROOT.glob('*.json')):
            state = json.loads(path.read_text())
            if state['status'] in ('LIVE', 'RED', 'CONFLICT', 'HOLD', 'ERROR') or time.time() - state['at'] < 300:
                continue
            state['at'] = time.time()
            save(path, state)
            try:
                os.environ.update(SHIP_REPO=state['repo'], SHIP_BASE=state['base'])
                state['status'] = step(state, path)
            except Exception as error:
                state.update(status='ERROR', error=str(error))
            save(path, state)
            print(state['ticket'], state['status'], state.get('error', ''))
        flag = Path.home() / '.local/state/fleet/one-run.on'
        flag.parent.mkdir(parents=True, exist_ok=True)
        if any(json.loads(p.read_text())['status'] == 'ERROR' for p in ROOT.glob('*.json')):
            flag.unlink(missing_ok=True)
            raise RuntimeError('chore failed; picker hold disabled, inspect job error')
        flag.touch()


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
