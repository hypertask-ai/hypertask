#!/usr/bin/env bash
set -euo pipefail

fail() { printf 'ht-flag: %s\n' "$*" >&2; exit 1; }
usage() { fail 'usage: ht-flag get [KEY] [--dry-run] | ht-flag set KEY MODE (--reason URL | --review ID | --failure URL) [--dry-run] | ht-flag review KEY everyone --ai-review URL --independent TEXT --live-qa URL [--dry-run]; reason must link to a clear yes from Valentin within 7 days: his thumbs up on a switch question, his own ticket yes after exactly one switch question, or an in-chat record of his exact words from HT Product Lead (#comment-<id>); questions name Switch <flag-key> to <mode>'; }

dry_run=false
args=()
for arg in "$@"; do
  if [ "$arg" = --dry-run ]; then dry_run=true; else args+=("$arg"); fi
done
set -- "${args[@]}"
[ "$#" -gt 0 ] || usage
command=$1
shift
url="${HT_BASE_URL:-https://app.hypertask.ai}"
url="${url%/}/api/mcp/flags"
body=''
key=''
case "$command" in
  get)
    [ "$#" -le 1 ] || usage
    method=GET
    if [ "$#" -eq 1 ]; then key=$1; fi
    ;;
  set)
    [ "$#" -eq 4 ] || usage
    method=PATCH
    key=$1
    [ -n "$key" ] || usage
    case "$2" in
      OFF|off) mode=OFF ;;
      EVERYONE|everyone) mode=EVERYONE ;;
      OWNER_AND_QA|owner-qa) mode=OWNER_AND_QA ;;
      OWNER_ONLY|only-me) mode=OWNER_ONLY ;;
      *) fail 'invalid mode' ;;
    esac
    case "$3" in
      --reason)
        reason=$4
        node -e '
          const value = process.argv[1];
          if (value.length > 500 || !/^https:\/\/app\.hypertask\.ai\/detail\/project-([1-9]\d{0,8})\/([1-9]\d{0,8})#comment-([1-9]\d{0,8})$/.test(value)) process.exit(1);
        ' "$reason" || fail 'reason must link to a clear yes from Valentin within 7 days: his thumbs up on a switch question, his own ticket yes after exactly one switch question, or an in-chat record of his exact words from HT Product Lead (#comment-<id>); questions name Switch <flag-key> to <mode> (max 500 characters)'
        body=$(jq -nc --arg key "$key" --arg mode "$mode" --arg reason "$reason" '{key:$key,mode:$mode,reason:$reason}')
        ;;
      --review)
        [ "$mode" = EVERYONE ] || fail 'review is only allowed for everyone'
        [[ $4 =~ ^[1-9][0-9]*$ ]] || fail 'invalid review id'
        node -e 'if (!Number.isSafeInteger(Number(process.argv[1]))) process.exit(1)' "$4" || fail 'invalid review id'
        body=$(jq -nc --arg key "$key" --arg mode "$mode" --argjson review "$4" '{key:$key,mode:$mode,review:$review}')
        ;;
      --failure)
        [ "$mode" = OFF ] || fail 'failure is only allowed for off'
        node -e 'const u=process.argv[1]; if (u.length > 300 || !URL.canParse(u) || new URL(u).protocol !== "https:") process.exit(1)' "$4" || fail 'failure must be an https URL (max 300 characters)'
        body=$(jq -nc --arg key "$key" --arg mode "$mode" --arg failure "$4" '{key:$key,mode:$mode,failure:$failure}')
        ;;
      *) usage ;;
    esac
    ;;
  review)
    [ "$#" -eq 8 ] || usage
    key=$1
    [ -n "$key" ] || usage
    [[ $2 = everyone || $2 = EVERYONE ]] || fail 'review is only allowed for everyone'
    shift 2
    ai_review=''
    independent=''
    live_qa=''
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --ai-review) [ -z "$ai_review" ] || usage; ai_review=$2 ;;
        --independent) [ -z "$independent" ] || usage; independent=$2 ;;
        --live-qa) [ -z "$live_qa" ] || usage; live_qa=$2 ;;
        *) usage ;;
      esac
      shift 2
    done
    node -e '
      const [ai, text, qa] = process.argv.slice(1);
      if (ai.length > 300 || !/^https:\/\/github\.com\/hypertask-ai\/hypertask\/pull\/[1-9]\d*$/.test(ai)
        || !text.trim() || text.length > 300 || qa.length > 300 || !URL.canParse(qa) || new URL(qa).protocol !== "https:") process.exit(1);
    ' "$ai_review" "$independent" "$live_qa" || fail 'review requires an AI review PR URL, independent text (1-300 characters), and an https live QA URL (max 300 characters)'
    method=POST
    url+=/reviews
    body=$(jq -nc --arg key "$key" --arg ai "$ai_review" --arg text "$independent" --arg qa "$live_qa" \
      '{key:$key,mode:"EVERYONE",aiReviewUrl:$ai,independentReview:$text,liveQaUrl:$qa,inboxCycle:"passed"}')
    ;;
  *) usage ;;
esac
if [ -n "$key" ]; then
  [[ ${#key} -le 100 && $key =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail 'invalid feature flag key'
  if [ "$method" = GET ]; then url+="?key=$key"; fi
elif [ "$#" -gt 0 ]; then
  fail 'invalid feature flag key'
fi
if [ "$dry_run" = true ]; then
  jq -nc --arg method "$method" --arg url "$url" --arg body "$body" \
    '{method:$method,url:$url,body:(if $body == "" then null else ($body | fromjson) end)}'
  exit 0
fi

TOKEN_FILE="$HOME/.config/hypertask-agents/credentials/valentins-claude-code-agent-token"
IDENTITY='Valentins Claude Code'
if [ -x "$HOME/.agents/skills/ship/scripts/ship-identity" ]; then
  IFS=$'\t' read -r IDENTITY TOKEN_FILE < <("$HOME/.agents/skills/ship/scripts/ship-identity")
fi
[ -r "$TOKEN_FILE" ] || fail 'agent identity credential is unavailable'
token=$(cat "$TOKEN_FILE")
[[ $token =~ ^[A-Za-z0-9._-]+$ ]] || fail 'invalid agent identity credential'
response=$(mktemp)
trap 'rm -f "$response"' EXIT
# Feed the credential through stdin so it never appears in curl arguments.
code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
  curl --config - --silent --show-error --connect-timeout 10 --max-time 30 \
    --request "$method" --header 'Content-Type: application/json' \
    --data "$body" --output "$response" --write-out '%{http_code}' "$url") || fail 'request failed'
jq . "$response" || fail "HTTP $code: invalid JSON response"
[[ $code == 2?? ]] || fail "HTTP $code"
if [ "$command" = review ]; then
  review_id=$(jq -er '.review.id' "$response") || fail 'missing review id in response'
  printf 'review %s\n' "$review_id"
fi
