#!/usr/bin/env bash
# drain-board gates <project-id>: one unlazy gate per open ticket, in this session's ledger.
# drain-board check <TICKET>:      prints "settled" when the ticket is Done or in Valentin Review.
set -euo pipefail
SETTLED=${DRAIN_SETTLED:-Done|Valentin Review}
SELF=$(readlink -f "$0")

section() { hypertask tasks get "$1" --json 2>/dev/null | jq -r '.tasks[0] | if .archived then "archived" else (.section // "missing") end' 2>/dev/null || echo missing; }

case "${1:-}" in
  check)
    [ -n "${2:-}" ] || { echo "usage: drain-board check <TICKET>" >&2; exit 2; }
    s=$(section "$2")
    if [[ "$s" =~ ^($SETTLED|archived|missing)$ ]]; then echo settled; else echo "open: $2 is in \"$s\""; exit 1; fi ;;
  gates)
    P=${2:?usage: drain-board gates <project-id>}
    ID=${CLAUDE_CODE_SESSION_ID:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}}
    [ -n "$ID" ] || { echo "drain-board needs CLAUDE_CODE_SESSION_ID, CODEX_SESSION_ID or CODEX_THREAD_ID" >&2; exit 1; }
    F=$PWD/.unlazy/s-${ID:0:8}/gates/drain-$P.md
    mkdir -p "$(dirname "$F")"
    [ -f "$F" ] || printf '# Drain board %s\n' "$P" > "$F"
    n=0
    while IFS=$'\t' read -r t title; do
      grep -q "^- \[.\] drain-$P\.$t:" "$F" && continue
      printf '\n- [ ] drain-%s.%s: %s\n  CHECK: %s check %s\n  EXPECT: settled\n  CWD: %s\n  EVIDENCE: pending\n' \
        "$P" "$t" "${title//$'\n'/ }" "$SELF" "$t" "$PWD" >> "$F"
      n=$((n+1))
    done < <(hypertask tasks list --project "$P" --limit 500 --json | jq -r --arg s "$SETTLED" \
      '(.tasks // .)[] | select(.archived != true) | select((.section // "") | test("^(" + $s + ")$") | not) | [.ticketNumber, .title] | @tsv')
    node "$HOME/.agents/skills/unlazy/scripts/gate-check.mjs" --approve "$F" >/dev/null
    echo "$F: $n new ticket gates, $(grep -c '^- \[ \] drain-' "$F") open" ;;
  *) echo "usage: drain-board gates <project-id> | check <TICKET>" >&2; exit 2 ;;
esac
