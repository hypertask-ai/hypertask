#!/usr/bin/env bash
# vcc: Hypertask CLI as "Valentins Claude Code" (Valentin's hand-run sessions).
set -euo pipefail

helper_run() {
  [ "${VCC_HELPER:-}" = 1 ] && return 0
  local pid=$PPID root=${VCC_HELPER_PROC_ROOT:-/proc} comm stat parent arg
  while [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ]; do
    IFS= read -r comm 2>/dev/null < "$root/$pid/comm" || break
    if [ "$comm" = hax ] && [ -r "$root/$pid/cmdline" ]; then
      while IFS= read -r -d '' arg; do
        case "$arg" in -p|--prompt|--print) return 0 ;; esac
      done < "$root/$pid/cmdline"
    fi
    IFS= read -r stat 2>/dev/null < "$root/$pid/stat" || break
    # The comm field can contain spaces and parentheses.
    read -r _ parent _ <<< "${stat##*) }"
    [[ $parent =~ ^[0-9]+$ ]] && [ "$parent" != "$pid" ] || break
    pid=$parent
  done
  return 1
}

if helper_run; then
  case "${1:-}" in
    --help|help|--version) ;;
    *) case "${2:-}" in
      get|list|search|last) ;;
      *) printf '%s\n' 'vcc: helpers never write to the board; report to your runner' >&2; exit 3 ;;
    esac ;;
  esac
fi

VCC_DEV_WORDS='(?i)\bsrc/[^\s]*|\b[\w./-]+\.(?:tsx?|js|md)\b|[^\s]*/api/[^\s]*|\b(?:endpoint|route|bearer|OAuth|prefilter|regex|schema|migration|CodeQL|token audience)\b'
question_check() {
  jq -nr --arg text "$1" --arg markdown "${2:-false}" --arg dev "$VCC_DEV_WORDS" '
    def visible:
      gsub("<[^>]*>"; "") | gsub("&nbsp;|&#160;"; " ") |
      gsub("&quot;"; "\"") | gsub("&amp;"; "&") | gsub("^\\s+|\\s+$"; "");
    def unmention:
      sub("^\\s*(<p\\b[^>]*>\\s*)?<span\\b(?=[^>]*data-type=[\"\u0027]mention[\"\u0027])[^>]*>Valentin Yeo</span>\\s*"; "");
    ($markdown == "true") as $md |
    (if $md then $text | split("\n") | map(gsub("^\\s+|\\s+$"; "") | select(length > 0))
     else [$text | scan("<p\\b[^>]*>(.*?)</p>"; "s") | .[0]] end) as $paragraphs |
    ($paragraphs | map(if $md then gsub("\\*\\*"; "") else visible end)) as $plain |
    (if $md then $text | gsub("\\[(?<label>[^\\]]*)\\]\\([^\\s)]*\\)"; "\(.label)")
     else $text | visible end) as $visible |
    (if $md then $text | gsub("\\[[^\\]]*\\]\\([^\\s)]*\\)"; "")
     else $text | gsub("<a\\b[^>]*>.*?</a>"; ""; "is") | visible end) as $unlinked |
    [
      (if any($paragraphs[];
        (if $md then . else unmention end) |
        [capture(if $md then "^Question:\\s*\\*\\*(?<question>.*?)\\*\\*"
          else "^\\s*(?:<[^>]*>\\s*)*Question:\\s*<strong\\b[^>]*>(?<question>.*?)</strong>" end; "s").question |
          (if $md then . else visible end) | endswith("?")] | any)
       then empty else "Question: <strong>yes/no question?</strong> (Markdown: Question: **yes/no question?**)" end),
      ("Yes:", "No:", "My recommendation:") as $part |
        if any($plain[]; startswith($part)) then empty else $part end
    ] + [
      (if any($plain[]; startswith("Why:") or (startswith("My recommendation:") and test("\\bWhy:")))
       then empty else "Why:" end),
      ($visible | scan($dev)),
      ($visible | scan("\\bCI\\b")),
      ($unlinked | scan("(?i)\\bPR ?#?[0-9]+\\b|#[0-9]+\\b"))
    ] | unique | join("; ")
  '
}
question_refuse() {
  printf 'vcc: Question refused: %s; rewrite it for a product owner (pospeak)\n' "$1" >&2
  exit 5
}
question_comment() {
  case "${1:-} ${2:-}" in 'comment add'|'comments add') ;; *) return 0 ;; esac
  local kind='' text='' file='' markdown=false reason
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind|--text|--body|--file)
        case "$1" in
          --kind) kind=${2:-} ;;
          --text|--body) text=${2:-}; file='' ;;
          --file) file=${2:-}; text='' ;;
        esac
        shift; [ "$#" -gt 0 ] || break ;;
      --kind=*) kind=${1#*=} ;;
      --text=*|--body=*) text=${1#*=}; file='' ;;
      --file=*) file=${1#*=}; text='' ;;
      --markdown) markdown=true ;;
    esac
    shift
  done
  [ "$kind" = question ] || return 0
  if [ -n "$file" ]; then
    text=$(cat -- "$file" 2>/dev/null) || question_refuse 'cannot read --file'
  fi
  reason=$(question_check "$text" "$markdown") || question_refuse 'cannot check Question'
  [ -z "$reason" ] || question_refuse "$reason"
}
people_content() {
  local mode='' kind='' text='' file='' description='' description_file='' mentioned=false arg status
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project|--team) [ "$#" -ge 2 ] || return 0; shift 2 ;;
      --json|--human|--project=*|--team=*) shift ;;
      *) break ;;
    esac
  done
  case "${1:-} ${2:-}" in
    'comment add'|'comments add') mode=comment ;;
    'task create'|'tasks create'|'task update'|'tasks update') mode=description ;;
    *) return 0 ;;
  esac
  shift 2
  while [ "$#" -gt 0 ]; do
    arg=$1
    case "$arg" in
      --kind|--text|--body|--file|--description|--description-file|--mentions)
        [ "$#" -ge 2 ] || break
        case "$arg" in
          --kind) kind=$2 ;;
          --text|--body) text=$2; file='' ;;
          --file) file=$2; text='' ;;
          --description) description=$2 ;;
          --description-file) description_file=$2 ;;
          --mentions) mentioned=true ;;
        esac
        shift ;;
      --kind=*) kind=${arg#*=} ;;
      --text=*|--body=*) text=${arg#*=}; file='' ;;
      --file=*) file=${arg#*=}; text='' ;;
      --description=*) description=${arg#*=} ;;
      --description-file=*) description_file=${arg#*=} ;;
      --mentions=*) mentioned=true ;;
    esac
    shift
  done
  if [ "$mode" = description ]; then
    text=$description; file=$description_file
  fi
  if [ -n "$file" ]; then
    text=$(cat -- "$file" 2>/dev/null) || { printf '%s\n' 'vcc: cannot read people content file' >&2; exit 5; }
  fi
  if [ "$mode" = comment ]; then
    case "$kind" in question|qa|done) ;; *)
      if [ "$mentioned" != true ] && ! [[ "$text" =~ data-type[[:space:]]*=[[:space:]]*[\"\']mention[\"\']|(^|[[:space:]])@[[:alnum:]] ]]; then return 0; fi ;;
    esac
  fi
  status=0
  jq -en --arg text "$text" '($text + " " + ($text | gsub("<[^>]*>"; ""))) | test("tmux\\s+attach|claude\\s+--resume|codex\\s+resume|hax\\s+--resume|Helpers\\s*:|Branch/PR\\s*:|Outputs\\s*:|Gates\\s*:|GATES\\.md|\\.unlazy/|/home/|~/"; "i")' >/dev/null || status=$?
  if [ "$status" != 1 ]; then
    printf '%s\n' 'vcc: agent detail belongs in vcc activity add' >&2
    exit 5
  fi
}
people_content "$@"
question_comment "$@"

voice_check() {
  jq -nr --arg text "$1" --arg markdown "${2:-false}" --arg dev "$VCC_DEV_WORDS" '
    def visible:
      gsub("<[^>]*>"; "") | gsub("&nbsp;|&#160;"; " ") | gsub("&quot;"; "\"") |
      gsub("&#39;|&apos;"; "\u0027") | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&amp;"; "&");
    ($markdown == "true") as $md |
    def lines:
      (if $md then gsub("@Valentin Yeo|\\*\\*|__"; " ")
       else gsub("<span\\b[^>]*data-type=[\"\u0027]mention[\"\u0027][^>]*>.*?</span>"; " "; "is")
         | gsub("<br\\s*/?>|</(?:p|li|h[1-6]|div|blockquote|tr)>|<li\\b[^>]*>"; "\n"; "i") | visible end)
      | gsub("https?://[^\\s<>\"]+"; " ");
    ($text | if $md then gsub("\\[(?<l>[^\\]]*)\\]\\([^\\s)]*\\)"; "\(.l)") else . end | lines) as $plain |
    ($text | if $md then gsub("\\[[^\\]]*\\]\\([^\\s)]*\\)"; " ") else gsub("<a\\b[^>]*>.*?</a>"; " "; "is") end | lines) as $countable |
    (if $md then $text | gsub("\\[[^\\]]*\\]\\([^\\s)]*\\)"; " ")
     else $text | gsub("<a\\b[^>]*>.*?</a>"; " "; "is") | visible end) as $unlinked |
    [$countable | gsub("\\b[A-Z][A-Z0-9]{1,9}-[0-9]+\\b"; " ") | gsub("\"[^\"\n]+\"|\u201c[^\u201d\n]+\u201d"; " ") | split("\n")[]
      | sub("^\\s*(?:[-*+]|[0-9]+[.)])\\s+"; "")
      | splits("(?<=[.!?;])\\s+")
      | sub("^\\s*(?:Question|My recommendation|Recommendation|Why|Yes|No|Next|Problem|Fix|Done when|Risk|Decision|Result|Done|QA|Proof|Live|Status)\\s*:\\s*"; ""; "i")
      | select([scan("\\S*[[:alnum:]]\\S*")] | length > 8)
      | ([scan("\\S+")][:6] | join(" ")) + " ..."] as $long |
    [
      (if ($long | length) > 0 then "\($long | length) sentence(s) over 8 words, e.g. \"\($long[0])\"" else empty end),
      (if $text | test("<code\\b|<pre\\b|`") then "code formatting" else empty end),
      ($plain | scan($dev)),
      ($plain | scan("\\bCI\\b")),
      ($plain | scan("\\b[a-z][a-z0-9]*_[a-z0-9_]+\\b|\\b[a-z]{2,}[A-Z][a-z]+[A-Za-z0-9]*\\b|\\b[A-Za-z_][A-Za-z0-9_.]*\\(\\)|(?<![\\w.])~?/[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+|\\b[A-Za-z0-9_./-]+\\.(?:jsx?|mjs|cjs|tsx?|md|json|ya?ml|zig|sh|py|sql|toml|css|html?)\\b")),
      ($unlinked | scan("(?i)\\bPR ?#?[0-9]+\\b|#[0-9]+\\b"))
    ] | unique | join("; ")
  '
}
voice_refuse() {
  printf 'vcc: Human lane refused (%s): %s; rewrite it for a product owner (pospeak): caveman, max 8 words per sentence, no file paths or code words. Agent detail goes to vcc activity add <TICKET> "<text>".\n' "$1" "$2" >&2
  exit 5
}
voice_logged=false
voice_lint() {
  local reason
  if [ -n "${VCC_VOICE_BYPASS:-}" ]; then
    if [ "$voice_logged" = false ]; then
      voice_logged=true
      { mkdir -p "$HOME/.local/state/vcc" &&
        printf '%s\t%s\t%s\t%s\n' "$(date -Is)" "${SHIP_SESSION_NAME:-unknown}" "$1" "$VCC_VOICE_BYPASS" >> "$HOME/.local/state/vcc/voice-bypass.log"; } 2>/dev/null || true
    fi
    return 0
  fi
  reason=$(voice_check "$2" "$3") || voice_refuse "$1" 'cannot check text'
  [ -z "$reason" ] || voice_refuse "$1" "$reason"
}
html_plain() {
  jq -nr --arg t "$1" '$t | gsub("<a\\b[^>]*href=[\"\u0027](?<u>[^\"\u0027]*)[\"\u0027][^>]*>(?<l>.*?)</a>"; "\(.l) (\(.u))"; "is") | gsub("<br\\s*/?>|</(?:p|li|h[1-6]|div|blockquote|tr)>"; "\n"; "i") | gsub("<[^>]*>"; "") |
    gsub("&nbsp;|&#160;"; " ") | gsub("&quot;"; "\"") | gsub("&#39;|&apos;"; "\u0027") | gsub("&lt;"; "<") |
    gsub("&gt;"; ">") | gsub("&amp;"; "&") | gsub("\\n\\s*\\n+"; "\n") | gsub("^\\s+|\\s+$"; "")'
}
VOICE_REROUTE=()
VOICE_JSON=false
voice_route() {
  local -a pos=() unsupported=()
  local kind='' text='' file='' markdown=false human=false title='' desc='' descfile='' has_title=false has_desc=false arg ticket plain
  while [ "$#" -gt 0 ]; do
    arg=$1
    case "$arg" in
      --kind|--text|--body|--file|--title|--description|--description-file|--reply-to-comment-id|--reply-to-invocation-id|--attach|--mentions|--project|--improve-command|--priority|--estimate|--labels|--due|--parent-task|--section|--assignee|--to|--to-section)
        [ "$#" -ge 2 ] || { unsupported+=("$arg"); break; }
        case "$arg" in
          --title|--description|--description-file|--project|--improve-command|--priority|--estimate|--labels|--due|--parent-task|--section|--assignee|--to|--to-section) unsupported+=("$arg") ;;
        esac
        case "$arg" in
          --kind) kind=$2 ;;
          --text|--body) text=$2; file='' ;;
          --file) file=$2; text='' ;;
          --title) title=$2; has_title=true ;;
          --description) desc=$2; has_desc=true ;;
          --description-file) descfile=$2 ;;
          --reply-to-comment-id|--reply-to-invocation-id|--attach|--mentions) human=true ;;
        esac
        shift ;;
      --kind=*) kind=${arg#*=} ;;
      --text=*|--body=*) text=${arg#*=}; file='' ;;
      --file=*) file=${arg#*=}; text='' ;;
      --title=*) unsupported+=("${arg%%=*}"); title=${arg#*=}; has_title=true ;;
      --description=*) unsupported+=("${arg%%=*}"); desc=${arg#*=}; has_desc=true ;;
      --description-file=*) unsupported+=("${arg%%=*}"); descfile=${arg#*=} ;;
      --reply-to-comment-id=*|--reply-to-invocation-id=*|--attach=*|--mentions=*) human=true ;;
      --markdown) markdown=true ;;
      --json) VOICE_JSON=true ;;
      --help|-h) return 0 ;;
      --) unsupported+=("$arg"); shift; pos+=("$@"); break ;;
      -*) unsupported+=("$arg") ;;
      *) pos+=("$arg") ;;
    esac
    shift
  done
  case "${pos[0]:-} ${pos[1]:-}" in
    'comment add'|'comments add')
      if [ -n "$file" ]; then text=$(cat -- "$file" 2>/dev/null) || voice_refuse comment 'cannot read --file'; fi
      [ -z "$kind" ] || human=true
      [[ "$text" =~ data-type[[:space:]]*=[[:space:]]*[\"\']mention[\"\']|(^|[[:space:]])@[[:alnum:]] || $text =~ data-type=[\"\']mention || $text =~ (^|[[:space:]>])@[A-Za-z] ]] && human=true
      if [ "$human" = true ]; then voice_lint comment "$text" "$markdown"; return 0; fi
      ticket=${pos[2]:-}
      [[ $ticket =~ ^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$ ]] || return 0
      if [ "$markdown" = true ]; then plain=$text; else plain=$(html_plain "$text"); fi
      [ -n "${plain//[[:space:]]/}" ] || return 0
      if [ "${#pos[@]}" -gt 3 ]; then unsupported+=("${pos[3]}"); fi
      if [ "${#unsupported[@]}" -gt 0 ]; then
        printf "vcc: unsupported reroute option: %s\n" "${unsupported[0]}" >&2
        exit 2
      fi
      VOICE_REROUTE=(activity add "$ticket" "$plain")
      printf 'vcc: no --kind, @mention or reply target: sent to the agent lane (vcc activity add %s), not a visible comment. For a person use --kind question|qa|done, an @mention, or --reply-to-comment-id.\n' "$ticket" >&2 ;;
    'task create'|'tasks create'|'task update'|'tasks update')
      if [ -n "$descfile" ]; then desc=$(cat -- "$descfile" 2>/dev/null) || voice_refuse description 'cannot read --description-file'; has_desc=true; fi
      [ "$has_title" = false ] || voice_lint title "$title" false
      [ "$has_desc" = false ] || [ -z "$desc" ] || voice_lint description "$desc" "$markdown" ;;
  esac
}
voice_route "$@"

completion_move() {
  local section='' project='' destination='' target_section='' out arg checker="$HOME/.agents/skills/ship/scripts/ship-check"
  local -a positional=()
  while [ "$#" -gt 0 ]; do
    arg=$1
    [[ $arg != -?* || $arg == --* ]] || arg="-$arg"
    case "$arg" in
      --section|--project|--to|--to-section)
        [ "$#" -ge 2 ] || return 0
        case "$arg" in
          --section) section=$2 ;;
          --project) project=$2 ;;
          --to) destination=$2 ;;
          --to-section) target_section=$2 ;;
        esac
        shift ;;
      --section=*) section=${arg#*=} ;;
      --to-section=*) target_section=${arg#*=} ;;
      --project=*) project=${arg#*=} ;;
      --to=*) destination=${arg#*=} ;;
      --) shift; positional+=("$@"); break ;;
      --*=*|--help|--h|--version|--V|--json|--human|--force|--all|--all-boards|--enabled|--disabled|--confirm|--clear|--restore|--stdin|--off|--has-due-date|--summary|--markdown|--clear-due|--clear-parent|--comment|--html|--canvas|--dry-run|--apply|--clear-description|--running|--default|--clear-labels|--clear-assignees|--add|--self) ;;
      -*) [ "$#" -lt 2 ] || shift ;;
      *) positional+=("$arg") ;;
    esac
    shift
  done
  case "${positional[0]:-} ${positional[1]:-}" in 'task move'|'tasks move'|'task update'|'tasks update') ;; *) return 0 ;; esac
  if [ -z "$section" ] && [ "${positional[1]}" = move ]; then section=${target_section:-$destination}; fi
  [ -n "$target_section" ] || destination=''
  [ -n "$section" ] || return 0
  [ -x "$checker" ] || { printf '%s\n' 'vcc: completion checker unavailable; refusing section change' >&2; exit 2; }
  out=$("$checker" move "${positional[2]:-}" "$section" "$project" "$destination") || { printf '%s\n' "$out" >&2; exit 2; }
}

# Identity: the session's own name if a token exists for it, else Valentins Claude Code (ship-identity).
TOKEN_FILE="$HOME/.config/hypertask-agents/credentials/valentins-claude-code-agent-token"
IDENTITY="Valentins Claude Code"
if [ -x "$HOME/.agents/skills/ship/scripts/ship-identity" ]; then
  IFS=$'\t' read -r IDENTITY TOKEN_FILE < <("$HOME/.agents/skills/ship/scripts/ship-identity")
fi
# A runner writes as its own agent or not at all: ship-identity falls back to Valentin when no
# token exists, which would post a runner's words under his name (YPER4-960).
case "$(printf '%s' "${SHIP_SESSION_NAME:-}" | tr '[:upper:]' '[:lower:]')" in
  *runner*)
    [ "$IDENTITY" = "${SHIP_SESSION_NAME%% | *}" ] \
      || { printf 'vcc: %s has no board login; refusing to write as %s\n' "$SHIP_SESSION_NAME" "$IDENTITY" >&2; exit 2; } ;;
esac
HT_TOKEN="$(cat "$TOKEN_FILE")"
[ -n "${HT_TOKEN//[[:space:]]/}" ] || { printf 'vcc: empty board login for %s; refusing to write\n' "$IDENTITY" >&2; exit 2; }
export HT_TOKEN
completion_move "$@"
review_refuse() {
  printf 'vcc: Valentin Review needs one plain Question comment first: "Question: <strong>yes/no question?</strong>", "Yes:", "No:", "My recommendation:" and "Why:" paragraphs. Post it with vcc comment add %s --kind question, then move.%s\n' "$1" "${2:+ ($2)}" >&2
  exit 5
}
review_move() {
  case "${1:-} ${2:-}" in 'task move'|'tasks move') ;; *) return 0 ;; esac
  local ticket='' section='' comments newest reason
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --section) section=${2:-}; shift; [ "$#" -gt 0 ] || break ;;
      --section=*) section=${1#--section=} ;;
      *) if [[ $1 =~ ^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$ ]]; then ticket=$1; fi ;;
    esac
    shift
  done
  [ -n "$ticket" ] || return 0
  section=${section#"${section%%[![:space:]]*}"}
  section=${section%"${section##*[![:space:]]}"}
  [ "${section,,}" = 'valentin review' ] || return 0
  comments=$(hypertask comments list "$ticket" --json 2>/dev/null) || review_refuse "$ticket" 'cannot read comments'
  newest=$(jq -cs '
    if length == 1 then .[0] else error("expected one comments response") end |
    if (.comments | type) == "array" and all(.comments[];
      (.createdAt | type) == "string" and (.createdAt | test("^\\d{4}-\\d\\d-\\d\\dT")) and (.text | type) == "string")
    then .comments | max_by(.createdAt) else error("invalid comments") end
  ' <<< "$comments" 2>/dev/null) || review_refuse "$ticket" 'cannot parse comments'
  reason=$(question_check "$(jq -r '.text // ""' <<< "$newest")") || review_refuse "$ticket" 'cannot check Question'
  [ -z "$reason" ] || review_refuse "$ticket" "$reason; rewrite it for a product owner (pospeak)"
}
[ "${#VOICE_REROUTE[@]}" = 0 ] || set -- "${VOICE_REROUTE[@]}"
if [ "${1:-}" != activity ]; then
  review_move "$@"
  exec /usr/bin/env -S hypertask "$@"
fi

fail() { echo "vcc activity: $*" >&2; exit 1; }
[ "$#" -ge 3 ] || fail 'usage: vcc activity add <TICKET> "<text>" | vcc activity last <TICKET>'
command=$2; ticket=$3
[[ $ticket =~ ^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$ ]] || fail 'expected a ticket number'
ticket=${ticket^^}
case "$command" in
  add) [ "$#" = 4 ] && [ -n "${4//[[:space:]]/}" ] || fail 'add needs one non-empty text argument' ;;
  last) [ "$#" = 3 ] || fail 'last needs only a ticket number' ;;
  *) fail "unknown activity command: $command" ;;
esac

body=$(mktemp)
trap 'rm -f "$body"' EXIT
# Keep the token out of curl's arguments and logs.
request() {
  local method=$1 path=$2 data=${3:-}
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$HT_TOKEN" |
    curl --config - --silent --show-error --connect-timeout 10 --max-time 30 \
      --request "$method" --header 'Content-Type: application/json' \
      ${activity_key:+--header "Idempotency-Key: $activity_key"} \
      --data "$data" --output "$body" --write-out '%{http_code}' \
      "https://app.hypertask.ai/api/mcp/$path") || fail 'request failed'
}
success() {
  [[ $code == 2?? ]] && jq -e '.success == true' "$body" >/dev/null 2>&1 \
    || fail "HTTP $code: $(jq -r '.error // .message // "request failed"' "$body" 2>/dev/null || echo 'request failed')"
}

if [ "$command" = last ]; then
  path="tasks/$ticket/agent-activity?limit=1"
  # Board checks use the immutable claimant id; normal last reads every agent.
  if [ -n "${VCC_ACTIVITY_AGENT_ID:-}" ]; then
    path+="&agent_id=$(jq -rn --arg id "$VCC_ACTIVITY_AGENT_ID" '$id | @uri')"
  fi
  request GET "$path"
  if [ "$code" = 404 ]; then
    echo 'vcc activity last: ticket activity route is not deployed yet (HTTP 404), or is unavailable for this ticket/caller.' >&2
    exit 4
  fi
  success
  jq -er '.activities | if length == 0 then "" else .[0] | [.createdAt, .agentName] | @tsv end' "$body" | sed '/^$/d'
  exit 0
fi

# One run per identity per ticket, so two runners never share a run.
slug=$(printf '%s' "$IDENTITY" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
cache="$HOME/.local/state/vcc-runs/$slug/$ticket"
umask 077
mkdir -p "$(dirname "$cache")"
run=''
if [ -s "$cache" ]; then
  run=$(cat "$cache")
  [[ $run =~ ^[A-Za-z0-9-]+$ ]] || fail 'invalid cached run id'
fi
open_run() {
  local task_id
  task_id=$(hypertask tasks get "$ticket" --json | jq -er '.tasks[0].id') || fail "cannot read $ticket"
  request POST agents/runs "$(jq -nc --argjson id "$task_id" '{taskId:$id,source:"runtime"}')"
  success
  run=$(jq -er '.run.id | select(type == "string" and test("^[A-Za-z0-9-]+$"))' "$body") || fail 'open returned no run id'
  printf '%s\n' "$run" > "$cache"
}
if [ -n "$run" ]; then
  request GET "agents/runs/$run"
  if [ "$code" = 404 ]; then
    run=''
  else
    success
    jq -e '.run.status | IN("active", "stale")' "$body" >/dev/null || run=''
  fi
fi
[ -n "$run" ] || open_run
activity_key=$(cat /proc/sys/kernel/random/uuid)
data=$(jq -nc --arg text "$4" '{type:"thought",text:$text}')
request POST "agents/runs/$run/activities" "$data"
# A cached run can be stopped/deleted between the read and the write.
if [ "$code" = 404 ] || { [ "$code" = 409 ] && jq -e '.error | test("(not|no longer) active"; "i")' "$body" >/dev/null; }; then
  open_run
  request POST "agents/runs/$run/activities" "$data"
fi
success
if [ "${#VOICE_REROUTE[@]}" -gt 0 ] && [ "$VOICE_JSON" = true ]; then
  jq -e '.activity | select(.id != null) | {activity: .}' "$body"
else
  jq -er '.activity.id' "$body"
fi
