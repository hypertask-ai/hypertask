#!/usr/bin/env bash
# vcc: Hypertask CLI as "Valentins Claude Code" (Valentin's hand-run sessions).
set -euo pipefail

helper_run() {
  [ "${VCC_HELPER:-}" = 1 ] && return 0
  local pid=$PPID root=${VCC_HELPER_PROC_ROOT:-/proc} comm stat parent arg
  while [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ]; do
    IFS= read -r comm 2>/dev/null < "$root/$pid/comm" || break
    if [ "$comm" = hax ] && [ -r "$root/$pid/cmdline" ]; then
      while IFS= read -r -d '' arg; do
        case "$arg" in -p|--prompt|--print) return 0 ;; esac
      done < "$root/$pid/cmdline"
    fi
    IFS= read -r stat 2>/dev/null < "$root/$pid/stat" || break
    # The comm field can contain spaces and parentheses.
    read -r _ parent _ <<< "${stat##*) }"
    [[ $parent =~ ^[0-9]+$ ]] && [ "$parent" != "$pid" ] || break
    pid=$parent
  done
  return 1
}

if helper_run; then
  case "${1:-}" in
    --help|help|--version) ;;
    *) case "${2:-}" in
      get|list|search|last) ;;
      *) printf '%s\n' 'vcc: helpers never write to the board; report to your runner' >&2; exit 3 ;;
    esac ;;
  esac
fi

question_check() {
  jq -nr --arg text "$1" --arg markdown "${2:-false}" '
    def visible:
      gsub("<[^>]*>"; "") | gsub("&nbsp;|&#160;"; " ") |
      gsub("&quot;"; "\"") | gsub("&amp;"; "&") | gsub("^\\s+|\\s+$"; "");
    def unmention:
      sub("^\\s*(<p\\b[^>]*>\\s*)?<span\\b(?=[^>]*data-type=[\"\u0027]mention[\"\u0027])[^>]*>Valentin Yeo</span>\\s*"; "");
    ($markdown == "true") as $md |
    (if $md then $text | split("\n") | map(gsub("^\\s+|\\s+$"; "") | select(length > 0))
     else [$text | scan("<p\\b[^>]*>(.*?)</p>"; "s") | .[0]] end) as $paragraphs |
    ($paragraphs | map(if $md then gsub("\\*\\*"; "") else visible end)) as $plain |
    (if $md then $text | gsub("\\[(?<label>[^\\]]*)\\]\\([^\\s)]*\\)"; "\(.label)")
     else $text | visible end) as $visible |
    (if $md then $text | gsub("\\[[^\\]]*\\]\\([^\\s)]*\\)"; "")
     else $text | gsub("<a\\b[^>]*>.*?</a>"; ""; "is") | visible end) as $unlinked |
    [
      (if any($paragraphs[];
        (if $md then . else unmention end) |
        [capture(if $md then "^Question:\\s*\\*\\*(?<question>.*?)\\*\\*"
          else "^\\s*(?:<[^>]*>\\s*)*Question:\\s*<strong\\b[^>]*>(?<question>.*?)</strong>" end; "s").question |
          (if $md then . else visible end) | endswith("?")] | any)
       then empty else "Question: <strong>yes/no question?</strong> (Markdown: Question: **yes/no question?**)" end),
      ("Yes:", "No:", "My recommendation:") as $part |
        if any($plain[]; startswith($part)) then empty else $part end
    ] + [
      (if any($plain[]; startswith("Why:") or (startswith("My recommendation:") and test("\\bWhy:")))
       then empty else "Why:" end),
      ($visible | scan("(?i)\\bsrc/[^\\s]*|\\b[\\w./-]+\\.(?:tsx?|js|md)\\b|[^\\s]*/api/[^\\s]*|\\b(?:endpoint|route|bearer|OAuth|prefilter|regex|schema|migration|CodeQL|token audience)\\b")),
      ($visible | scan("\\bCI\\b")),
      ($unlinked | scan("(?i)\\bPR ?#?[0-9]+\\b|#[0-9]+\\b"))
    ] | unique | join("; ")
  '
}
question_refuse() {
  printf 'vcc: Question refused: %s; rewrite it for a product owner (pospeak)\n' "$1" >&2
  exit 5
}
question_blocker=false
question_comment() {
  case "${1:-} ${2:-}" in 'comment add'|'comments add') ;; *) return 0 ;; esac
  local kind='' text='' file='' markdown=false reason
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind|--text|--body|--file)
        case "$1" in
          --kind) kind=${2:-} ;;
          --text|--body) text=${2:-}; file='' ;;
          --file) file=${2:-}; text='' ;;
        esac
        shift; [ "$#" -gt 0 ] || break ;;
      --kind=*) kind=${1#*=} ;;
      --text=*|--body=*) text=${1#*=}; file='' ;;
      --file=*) file=${1#*=}; text='' ;;
      --markdown) markdown=true ;;
    esac
    shift
  done
  [ "$kind" = question ] || return 0
  if [ -n "$file" ]; then
    text=$(cat -- "$file" 2>/dev/null) || question_refuse 'cannot read --file'
  fi
  reason=$(question_check "$text" "$markdown") || question_refuse 'cannot check Question'
  [ -z "$reason" ] || question_refuse "$reason"
  if jq -ne --arg text "$text" '
    [$text | scan("<span\\b[^>]*>"; "i") |
      select(test("\\bdata-type=[\"\u0027]mention[\"\u0027]"; "i") and
        test("\\bdata-label=[\"\u0027]name-6[\"\u0027]"; "i"))] | length > 0
  ' >/dev/null; then
    question_blocker=true
  fi
}
question_comment "$@"

# Identity: the session's own name if a token exists for it, else Valentins Claude Code (ship-identity).
TOKEN_FILE="$HOME/.config/hypertask-agents/credentials/valentins-claude-code-agent-token"
IDENTITY="Valentins Claude Code"
if [ -x "$HOME/.agents/skills/ship/scripts/ship-identity" ]; then
  IFS=$'\t' read -r IDENTITY TOKEN_FILE < <("$HOME/.agents/skills/ship/scripts/ship-identity")
fi
HT_TOKEN="$(cat "$TOKEN_FILE")"
export HT_TOKEN
review_refuse() {
  printf 'vcc: Valentin Review needs one plain Question comment first: "Question: <strong>yes/no question?</strong>", "Yes:", "No:", "My recommendation:" and "Why:" paragraphs. Post it with vcc comment add %s --kind question, then move.%s\n' "$1" "${2:+ ($2)}" >&2
  exit 5
}
review_move() {
  case "${1:-} ${2:-}" in 'task move'|'tasks move') ;; *) return 0 ;; esac
  local ticket='' section='' comments newest reason
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --section) section=${2:-}; shift; [ "$#" -gt 0 ] || break ;;
      --section=*) section=${1#--section=} ;;
      *) if [[ $1 =~ ^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$ ]]; then ticket=$1; fi ;;
    esac
    shift
  done
  [ -n "$ticket" ] || return 0
  section=${section#"${section%%[![:space:]]*}"}
  section=${section%"${section##*[![:space:]]}"}
  [ "${section,,}" = 'valentin review' ] || return 0
  comments=$(hypertask comments list "$ticket" --json 2>/dev/null) || review_refuse "$ticket" 'cannot read comments'
  newest=$(jq -cs '
    if length == 1 then .[0] else error("expected one comments response") end |
    if (.comments | type) == "array" and all(.comments[];
      (.createdAt | type) == "string" and (.createdAt | test("^\\d{4}-\\d\\d-\\d\\dT")) and (.text | type) == "string")
    then .comments | max_by(.createdAt) else error("invalid comments") end
  ' <<< "$comments" 2>/dev/null) || review_refuse "$ticket" 'cannot parse comments'
  reason=$(question_check "$(jq -r '.text // ""' <<< "$newest")") || review_refuse "$ticket" 'cannot check Question'
  [ -z "$reason" ] || review_refuse "$ticket" "$reason; rewrite it for a product owner (pospeak)"
}
if [ "${1:-}" != activity ]; then
  review_move "$@"
  if [ "$question_blocker" = true ]; then
    receipt=$(mktemp)
    marker=$(mktemp)
    trap 'rm -f "$receipt" "$marker"' EXIT
    hypertask "$@" --json > "$receipt" || { status=$?; cat "$receipt"; exit "$status"; }
    ids=$(jq -er 'select(.success == true) | [.comment.id, (.url | capture("/detail/project-(?<project>[1-9][0-9]*)/(?<index>[1-9][0-9]*)$") | .project, .index)] |
      if (.[0] | type == "number" and . > 0 and floor == .) then @tsv else error("missing comment id") end' "$receipt") \
      || { echo 'vcc: question receipt missing comment IDs/link; blocker not set' >&2; exit 5; }
    IFS=$'\t' read -r comment_id project_id task_index <<< "$ids"
    task_id=$(hypertask tasks get "$task_index" --project "$project_id" --json |
      jq -er '.tasks | select(length == 1) | .[0].id | select(type == "number" and . > 0 and floor == .)') \
      || { printf 'vcc: question saved as comment %s; cannot resolve task; blocker not set\n' "$comment_id" >&2; exit 5; }
    payload=$(jq -nc --argjson task "$task_id" --argjson comment "$comment_id" \
      '{taskId:$task,userId:6,blockerCommentId:$comment}')
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$HT_TOKEN" |
      curl --config - --silent --show-error --connect-timeout 10 --max-time 30 \
        --request POST --header 'Content-Type: application/json' \
        --data "$payload" --output "$marker" --write-out '%{http_code}' \
        'https://app.hypertask.ai/api/mcp/tasks/waiting-on') || code=000
    if [[ $code != 2?? ]] || ! jq -e --argjson task "$task_id" --argjson comment "$comment_id" \
      '.success == true and .task.id == $task and .task.waitingOnUserId == 6 and .task.blockerCommentId == $comment' "$marker" >/dev/null; then
      printf 'vcc: question saved as comment %s; blocker not set (HTTP %s). Repair this comment, do not repost.\n' "$comment_id" "$code" >&2
      exit 5
    fi
    cat "$receipt"
    exit 0
  fi
  exec /usr/bin/env -S hypertask "$@"
fi

fail() { echo "vcc activity: $*" >&2; exit 1; }
[ "$#" -ge 3 ] || fail 'usage: vcc activity add <TICKET> "<text>" | vcc activity last <TICKET>'
command=$2; ticket=$3
[[ $ticket =~ ^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$ ]] || fail 'expected a ticket number'
ticket=${ticket^^}
case "$command" in
  add) [ "$#" = 4 ] && [ -n "${4//[[:space:]]/}" ] || fail 'add needs one non-empty text argument' ;;
  last) [ "$#" = 3 ] || fail 'last needs only a ticket number' ;;
  *) fail "unknown activity command: $command" ;;
esac

body=$(mktemp)
trap 'rm -f "$body"' EXIT
# Keep the token out of curl's arguments and logs.
request() {
  local method=$1 path=$2 data=${3:-}
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$HT_TOKEN" |
    curl --config - --silent --show-error --connect-timeout 10 --max-time 30 \
      --request "$method" --header 'Content-Type: application/json' \
      ${activity_key:+--header "Idempotency-Key: $activity_key"} \
      --data "$data" --output "$body" --write-out '%{http_code}' \
      "https://app.hypertask.ai/api/mcp/$path") || fail 'request failed'
}
success() {
  [[ $code == 2?? ]] && jq -e '.success == true' "$body" >/dev/null 2>&1 \
    || fail "HTTP $code: $(jq -r '.error // .message // "request failed"' "$body" 2>/dev/null || echo 'request failed')"
}

if [ "$command" = last ]; then
  path="tasks/$ticket/agent-activity?limit=1"
  # Board checks use the immutable claimant id; normal last reads every agent.
  if [ -n "${VCC_ACTIVITY_AGENT_ID:-}" ]; then
    path+="&agent_id=$(jq -rn --arg id "$VCC_ACTIVITY_AGENT_ID" '$id | @uri')"
  fi
  request GET "$path"
  if [ "$code" = 404 ]; then
    echo 'vcc activity last: ticket activity route is not deployed yet (HTTP 404), or is unavailable for this ticket/caller.' >&2
    exit 4
  fi
  success
  jq -er '.activities | if length == 0 then "" else .[0] | [.createdAt, .agentName] | @tsv end' "$body" | sed '/^$/d'
  exit 0
fi

# One run per identity per ticket, so two runners never share a run.
slug=$(printf '%s' "$IDENTITY" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
cache="$HOME/.local/state/vcc-runs/$slug/$ticket"
umask 077
mkdir -p "$(dirname "$cache")"
run=''
if [ -s "$cache" ]; then
  run=$(cat "$cache")
  [[ $run =~ ^[A-Za-z0-9-]+$ ]] || fail 'invalid cached run id'
fi
open_run() {
  local task_id
  task_id=$(hypertask tasks get "$ticket" --json | jq -er '.tasks[0].id') || fail "cannot read $ticket"
  request POST agents/runs "$(jq -nc --argjson id "$task_id" '{taskId:$id,source:"runtime"}')"
  success
  run=$(jq -er '.run.id | select(type == "string" and test("^[A-Za-z0-9-]+$"))' "$body") || fail 'open returned no run id'
  printf '%s\n' "$run" > "$cache"
}
if [ -n "$run" ]; then
  request GET "agents/runs/$run"
  if [ "$code" = 404 ]; then
    run=''
  else
    success
    jq -e '.run.status | IN("active", "stale")' "$body" >/dev/null || run=''
  fi
fi
[ -n "$run" ] || open_run
activity_key=$(cat /proc/sys/kernel/random/uuid)
data=$(jq -nc --arg text "$4" '{type:"thought",text:$text}')
request POST "agents/runs/$run/activities" "$data"
# A cached run can be stopped/deleted between the read and the write.
if [ "$code" = 404 ] || { [ "$code" = 409 ] && jq -e '.error | test("(not|no longer) active"; "i")' "$body" >/dev/null; }; then
  open_run
  request POST "agents/runs/$run/activities" "$data"
fi
success
jq -er '.activity.id' "$body"
