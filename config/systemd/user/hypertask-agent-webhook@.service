[Unit]
Description=Hypertask %i signed webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hypertask-agents/%i.env
EnvironmentFile=%h/.config/hypertask-agents/%i.conf
Environment=HT_AGENT_SLUG=%i
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/lib/hypertask-agent-worker/worker.py serve
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state
RestrictSUIDSGID=true
LockPersonality=true
KillMode=control-group

[Install]
WantedBy=default.target
