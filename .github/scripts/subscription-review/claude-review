#!/usr/bin/env bash
set -euo pipefail

[ "$#" -eq 0 ] || { echo "claude-review accepts review context on stdin only" >&2; exit 64; }
cd /home/aireviewer

schema=$(tr -d '\n' </etc/hypertask-ai-review/review-schema.json)
review_root=/home/aireviewer/.cache/hypertask-review
mkdir -p -m 700 "$review_root"
find "$review_root" -mindepth 1 -maxdepth 1 -type d -mmin +60 -exec rm -rf -- {} +
review_tmp=$(mktemp -d "$review_root/claude.XXXXXX")
trap 'rm -rf -- "$review_tmp"' EXIT
trap 'exit 143' TERM INT HUP

cat >"$review_tmp/request.json"
node - "$review_tmp/request.json" "$review_tmp/instructions.txt" "$review_tmp/context.txt" <<'NODE'
const fs = require('node:fs')
const [requestPath, instructionsPath, contextPath] = process.argv.slice(2)
const request = JSON.parse(fs.readFileSync(requestPath, 'utf8'))
if (typeof request.instructions !== 'string' || !request.instructions.trim()) throw new Error('Missing trusted reviewer instructions')
if (typeof request.context !== 'string' || !request.context.trim()) throw new Error('Missing untrusted review context')
fs.writeFileSync(instructionsPath, request.instructions, { mode: 0o600 })
fs.writeFileSync(contextPath, request.context, { mode: 0o600 })
NODE

exec /home/aireviewer/.local/bin/claude \
  -p \
  --system-prompt-file "$review_tmp/instructions.txt" \
  --output-format json \
  --json-schema "$schema" \
  --tools "" \
  --disable-slash-commands \
  --no-session-persistence \
  --safe-mode \
  --model opus \
  --effort high \
  <"$review_tmp/context.txt"
