#!/usr/bin/env bash
set -euo pipefail

[ "$#" -eq 0 ] || { echo "claude-review accepts review context on stdin only" >&2; exit 64; }
cd /home/aireviewer

review_root=/home/aireviewer/.cache/hypertask-review
mkdir -p -m 700 "$review_root"
find "$review_root" -mindepth 1 -maxdepth 1 -type d -mmin +60 -exec rm -rf -- {} +
review_tmp=$(mktemp -d "$review_root/claude.XXXXXX")
trap 'rm -rf -- "$review_tmp"' EXIT
trap 'exit 143' TERM INT HUP

cat >"$review_tmp/request.json"
request_schema=$(node /usr/local/libexec/hypertask-review-request "$review_tmp/request.json" "$review_tmp")
schema_file=${request_schema:-/etc/hypertask-ai-review/review-schema.json}
schema=$(tr -d '\n' <"$schema_file")

exec /home/aireviewer/.local/bin/claude \
  -p \
  --system-prompt-file "$review_tmp/instructions.txt" \
  --output-format json \
  --json-schema "$schema" \
  --tools "" \
  --disable-slash-commands \
  --no-session-persistence \
  --safe-mode \
  --model opus \
  --effort high \
  <"$review_tmp/context.txt"
