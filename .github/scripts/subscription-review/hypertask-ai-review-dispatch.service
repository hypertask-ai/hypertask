[Unit]
Description=Discover Hypertask PRs needing trusted AI review
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=reviewdispatch
Group=reviewdispatch
ExecStart=/usr/local/libexec/hypertask-dispatch-scan
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypertask-ai-review
